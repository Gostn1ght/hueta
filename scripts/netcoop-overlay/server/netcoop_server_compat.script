-- Lost Zone: dedicated server guards for base-game single-player Actor callbacks.
--
-- The dedicated server simulates remote co-op Actors but has no locally
-- controlled Actor, so db.actor stays nil. The engine still reports jump,
-- landing, eating, HUD animation and condition events for those Actors, and
-- base-game's handlers are client feedback (sounds, HUD, effects) written for
-- db.actor. They belong to the owning client, so they are skipped here.
--
-- Installed from the end of _g.script by scripts/patch-gamma-netcoop-server.ps1.

local installed = false
local skipped = {}

-- Actor ids with admin god mode enabled (toggled by netanomaly_server "god").
god_mode = {}

local function no_local_actor()
	return db.actor == nil
end

-- netcoop.cpp runs NPC dialogues for a remote player on the server. base-game
-- dialogue conditions and actions use db.actor, so it points at that
-- player's Actor for the duration of one dialogue step, then is restored.
local bound = false
local bound_previous = nil

-- Last player Actor the engine bound, by id: server-wide scripts (time
-- events) use it as db.actor. Looked up again every time, so a player who
-- left is never used.
local last_player_id = nil

local function any_player()
	local obj = last_player_id and level.object_by_id(last_player_id)
	if obj and obj:clsid() == clsid.script_actor then return obj end
	last_player_id = nil
	return nil
end

-- base-game scripts recognise "the player" by AC_ID (0, the story Actor) and keep
-- its state in db.storage[AC_ID]. While a player is served, AC_ID is that
-- player's id and the player has a storage table.
local STORY_AC_ID = AC_ID or 0

function bind_actor(obj)
	if obj then
		local id = obj:id()
		last_player_id = id
		if not bound then
			bound_previous = rawget(db, "actor")
			bound = true
		end
		db.actor = obj
		_G.AC_ID = id
		if type(db.storage) == "table" and db.storage[id] == nil then
			db.storage[id] = { pstor = {}, object = obj }
		end
	elseif bound then
		db.actor = bound_previous
		_G.AC_ID = STORY_AC_ID
		bound_previous = nil
		bound = false
	end
end

----------------------------------------------------------------------
-- base-game callbacks: one failing handler must not skip the others
----------------------------------------------------------------------
-- axr_main.make_callback calls every handler of a callback in one loop, so a
-- handler that failed (world setup scripts that belong to the other side of
-- the connection) ended the loop and the remaining mods never ran. Handlers
-- are wrapped when registered; the first error of each is logged.
local wrapped_callbacks = {}
local failed_callbacks = {}

local function isolate_callbacks()
	local am = axr_main
	if type(am) ~= "table" or am.__netcoop_isolated or not am.callback_set then return end
	am.__netcoop_isolated = true
	local set, unset = am.callback_set, am.callback_unset
	am.callback_set = function(name, handler)
		if handler == nil then return set(name, handler) end
		local by_name = wrapped_callbacks[name]
		if not by_name then
			by_name = {}
			wrapped_callbacks[name] = by_name
		end
		local wrapper = by_name[handler]
		if not wrapper then
			wrapper = function(...)
				local ok, err
				if type(handler) == "function" then
					ok, err = pcall(handler, ...)
				elseif handler[name] then
					ok, err = pcall(handler[name], handler, ...)
				else
					ok = true
				end
				if not ok and not failed_callbacks[wrapper] then
					failed_callbacks[wrapper] = true
					printf("[Lost Zone] %s handler failed: %s", tostring(name), tostring(err))
				end
			end
			by_name[handler] = wrapper
		end
		return set(name, wrapper)
	end
	am.callback_unset = function(name, handler)
		local by_name = wrapped_callbacks[name]
		return unset(name, by_name and by_name[handler] or handler)
	end
end

local function install_actor_conditions()
	if type(xr_conditions) ~= "table" then return end
	-- There may be no player during death/respawn or on an empty server.
	-- Actor-dependent meet conditions have no target then; ambient NPC AI remains active.
	for _, name in ipairs({"actor_enemy", "actor_friend", "actor_neutral", "see_actor"}) do
		local original = xr_conditions[name]
		if type(original) == "function" then
			xr_conditions[name] = function(actor, npc, ...)
				if not actor or not npc then return false end
				return original(actor, npc, ...)
			end
		end
	end
end

function install()
	if installed then return end
	-- Lost Zone: the dedicated anchor has no player binder, but spawning its
	-- torch still reads Actor persistent variables before any player connects.
	-- Give it storage without making it db.actor or replacing saved values.
	if type(db.storage) == "table" and db.storage[STORY_AC_ID] == nil then
		db.storage[STORY_AC_ID] = { pstor = {} }
	end
	install_actor_conditions()
	installed = true
	isolate_callbacks()

	-- schemes_ai_gamma calls IsActor, which no base-game script defines. On a
	-- co-op server every player Actor is "the actor".
	if rawget(_G, "IsActor") == nil then
		_G.IsActor = function(o)
			return o ~= nil and o.clsid ~= nil and o:clsid() == clsid.script_actor
		end
	end

	-- A player's survival (hunger, thirst, sleep, psy, stamina, injuries,
	-- hit effects) runs on that player's client. On the server these
	-- callbacks ran for whichever player db.actor was bound to, with one
	-- shared state for all: with two players hunger and thirst ticked twice
	-- as fast and took health from both (s99). Only what quests and trade
	-- need still runs here.
	local server_actor_callbacks = {
		actor_on_info_callback = true,
		actor_on_trade = true,
		actor_on_item_take = true,
		actor_on_item_take_from_box = true,
		actor_on_item_put_in_box = true,
		actor_on_item_drop = true,
	}
	local send = _G.SendScriptCallback
	_G.SendScriptCallback = function(name, ...)
		-- World events (emission, psi storm: actor_on_interaction "anomalies")
		-- are not client feedback: GAMMA refills artefacts on them. Blocked,
		-- no artefact ever respawned on a server (2026-10-10).
		if name == "actor_on_interaction" and select(1, ...) == "anomalies" then
			return send(name, ...)
		end
		if type(name) == "string" and string.find(name, "^actor_on_") and not server_actor_callbacks[name] then
			if not skipped[name] then
				skipped[name] = true
				printf("[Lost Zone] dedicated: skipping client feedback callback %s", name)
			end
			return
		end
		return send(name, ...)
	end

	-- These read db.actor directly instead of going through SendScriptCallback.
	-- Admin god mode (netanomaly_server "god") cancels hits on that Actor here,
	-- where the server applies all damage.
	local before_hit = _G.CActor__BeforeHitCallback
	_G.CActor__BeforeHitCallback = function(actor, shit, bone_id)
		if actor and netcoop_admin_god_enabled(actor:id()) then return false end
		-- base-game's actor damage script zeroes the engine hit and takes health
		-- from db.actor itself; on the server that did not reach the player
		-- who was hit. The engine applies the hit (with armour) here.
		return true
	end

	printf("[Lost Zone] dedicated server compatibility layer installed")
end

-- Diagnostic: every 10 s the log shows whether NPC logic is actually running
-- on the server (binder updates, positions, active schemes).
local diag_updates = {}
local diag_next = 0

local function diag_tick(npc, st)
	if not npc then return end
	local id = npc:id()
	local entry = diag_updates[id]
	if not entry then
		entry = { name = npc:name(), count = 0 }
		diag_updates[id] = entry
	end
	entry.count = entry.count + 1
	local pos = npc:position()
	if entry.pos then entry.moved = (entry.moved or 0) + pos:distance_to(entry.pos) end
	entry.pos = pos
	entry.scheme = st and st.active_scheme or "none"

	local now = time_global()
	if now < diag_next then return end
	diag_next = now + 10000

	local total, shown, moving = 0, 0, 0
	for oid, e in pairs(diag_updates) do
		total = total + 1
		if (e.moved or 0) > 1 then moving = moving + 1 end
		if shown < 6 and e.pos then
			shown = shown + 1
			printf(string.format("[Lost Zone][npc] %s updates=%d moved=%.1f pos=%.1f,%.1f,%.1f scheme=%s",
				e.name, e.count, e.moved or 0, e.pos.x, e.pos.y, e.pos.z, tostring(e.scheme)))
		end
		e.count, e.moved = 0, 0
	end
	printf(string.format("[Lost Zone][npc] %d NPCs updated, %d moved over 1 m in the last 10 s", total, moving))
end

local function install_npc_diagnostic()
	RegisterScriptCallback("npc_on_update", diag_tick)
	printf("[Lost Zone][npc] NPC update diagnostic installed")
end

-- A normal game processes time events (CreateTimeEvent) from a level call
-- that the Actor binder's reinit registers. The server has no Actor binder.
local event_errors = 0
local function server_event_queue()
	local player = any_player()
	if player then bind_actor(player) end
	local ok, done = pcall(ProcessEventQueue)
	if player then bind_actor(nil) end
	if not ok then
		event_errors = event_errors + 1
		if event_errors <= 20 then
			printf("[Lost Zone] time event error: %s", tostring(done))
		end
		return false
	end
	return done
end

-- base-game keeps one task manager (task_manager.random_task). Each player gets
-- their own, chosen by db.actor, which the engine points at the player being
-- served (dialogue, task updates, NPC scripts). A task another player is
-- doing cannot be taken at the same time.
local player_tasks = {}

local restored_players = {} -- actor id -> its saved character state was applied
local first_seen, state_sent = {}, {}
local send_player_state

-- Engine (GameTaskManager, netcoop_cluster.inc): a generated task whose
-- target is on another map cannot be done on this location server. It is
-- cancelled like a player's cancel (on_cancel, no fail penalty).
function cancel_task_on_other_map(task_id, level_name)
	local manager = task_manager and task_manager.get_task_manager and task_manager.get_task_manager()
	if not (manager and manager.task_info and manager.task_info[task_id]) then return false end
	manager:set_task_cancelled(task_id)
	printf("[Lost Zone][tasks] %s cancelled: its target is on %s", task_id, tostring(level_name))
	return true
end

function capture_character_state(actor)
    local id = actor:id()
    local storage = db.storage[id] or {}
    local state = {pstor=storage.pstor or {}, pstor_ctime=storage.pstor_ctime or {}}
    -- Conditions the server owns (owner 2026-10-05: player states persist).
    state.netcoop_respawn = not actor:alive()
    state.netcoop_conditions = state.netcoop_respawn and {radiation=0, psy_health=1} or
        {radiation=actor.radiation, psy_health=actor.psy_health}
    if not state.netcoop_respawn then
        state.netcoop_admin = {
            god = netcoop_admin_god_enabled and netcoop_admin_god_enabled(id) or false,
            ammo = netcoop_admin_ammo_enabled and netcoop_admin_ammo_enabled(id) or false,
        }
        state.netcoop_faction = netcoop_factions and netcoop_factions.true_faction(actor) or nil
    end
    task_manager.save_state(state)
    return marshal.encode(state)
end

function restore_character_state(actor, encoded, respawn)
    local state = marshal.decode(encoded)
    local id = actor:id()
    db.storage[id] = db.storage[id] or {object=actor}
    db.storage[id].pstor = state.pstor or {}
    db.storage[id].pstor_ctime = state.pstor_ctime or {}
    player_tasks[id] = task_manager.CRandomTask()
    task_manager.load_state(state)
    -- A new body must not inherit the lethal radiation/psy state. The
    -- explicit flag also handles saves made before this schema change.
    local new_body = respawn or state.netcoop_respawn
    local conditions = new_body and {radiation=0, psy_health=1} or state.netcoop_conditions
    -- Nor the old body's hunger, stamina and thirst (the client's saved
    -- player state): a player who starved or died of thirst got a new body
    -- just as hungry and died again (owner 2026-10-09). Progress stays.
    if new_body then
        local pstor=db.storage[id].pstor
        pstor.netcoop_player_state = nil
        for key in pairs(pstor) do
            if type(key)=="string" and (key:find("^health%.") or key:find("^timedhp%.")) then pstor[key]=nil end
        end
    end
    if conditions then
        if conditions.radiation then actor.radiation = conditions.radiation end
        if conditions.psy_health then actor.psy_health = conditions.psy_health end
    end
    if state.netcoop_faction then db.storage[id].pstor.netcoop_own_faction = state.netcoop_faction end
    local admin = not new_body and type(state.netcoop_admin) == "table" and state.netcoop_admin or {}
    if netcoop_admin_god_set then netcoop_admin_god_set(id, admin.god == true) end
    if netcoop_admin_ammo_set then netcoop_admin_ammo_set(id, admin.ammo == true) end
    restored_players[id] = false -- equipment placement has not been acknowledged yet
end

-- The engine calls this only after saved items, progress and equipment are ready.
function character_ready(actor, new_life)
    local id = actor:id()
    if new_life then
        local st = db.storage[id] or {object=actor}; db.storage[id] = st
        st.pstor, st.pstor_ctime = {}, {}
        player_tasks[id] = task_manager.CRandomTask()
        if netcoop_admin_god_set then netcoop_admin_god_set(id, false) end
        if netcoop_admin_ammo_set then netcoop_admin_ammo_set(id, false) end
    end
    if new_life and netcoop_factions and netcoop_factions.reset_life then
        if not netcoop_factions.reset_life(actor) then return false end
    end
    restored_players[id], state_sent[id], first_seen[id] = true, nil, nil
    local god = netcoop_admin_god_enabled and netcoop_admin_god_enabled(id) or false
    local ammo = netcoop_admin_ammo_enabled and netcoop_admin_ammo_enabled(id) or false
    netcoop_send_to_actor(id, "netcoop_admin_state", (god and "1" or "0") .. "|" .. (ammo and "1" or "0"))
    if netcoop_factions and netcoop_factions.character_ready then netcoop_factions.character_ready(actor) end
    if send_player_state then send_player_state(id) end
    if netcoop_survival then netcoop_survival.complete(actor) end
    return true
end

local function install_player_tasks()
	local tm = task_manager
	if not (tm and tm.CRandomTask and tm.get_task_manager) then return end
	local shared = tm.get_task_manager
	tm.get_task_manager = function()
		local a = db.actor
		if not a then return shared() end
		local id = a:id()
		local own = player_tasks[id]
		if not own then
			own = tm.CRandomTask()
			player_tasks[id] = own
		end
		return own
	end

	local give = tm.CRandomTask.give_task
	tm.CRandomTask.give_task = function(self, task_id, giver_id)
		local a = db.actor
		if a and netcoop_task_taken(a:id(), tostring(task_id)) then
			printf("[Lost Zone] task %s is already taken by another player", tostring(task_id))
			pcall(function()
				a:give_game_news(game.translate_string("st_tip"),
					game.translate_string("st_netcoop_task_taken"), "ui_inGame2_PD_Lider", 0, 7000)
			end)
			return
		end
		return give(self, task_id, giver_id)
	end
	printf("[Lost Zone] per-player task managers installed")
end

-- Dialogue actions open trade/repair windows after hide_hud_inventory()
-- succeeds. The server has no HUD; the player's client opens the window
-- (npc:start_trade on the server is routed there by the engine). Installed
-- here because ui_inventory replaces hide_hud_inventory when it loads.
local function server_hide_hud()
	return true
end

-- ui_inventory assigns its own version in its on_game_start, after ours;
-- this is re-applied from the per-player update.
local function install_hide_hud()
	if _G.hide_hud_inventory ~= server_hide_hud then
		_G.hide_hud_inventory = server_hide_hud
	end
end

-- A normal game initialises these from the Actor binder's net_spawn, which
-- the server does not have. on_game_load waits for the first player, as its
-- handlers expect db.actor.
-- The emission and psi-storm managers are created by the ALife save load in
-- a normal game; the weather's change_period reads their last event times
-- and failed every game hour on the server, so the weather never changed
-- period. They are initialised here; emissions themselves stay off until
-- the master module drives them for all players.
local function init_event_managers()
	for _, m in ipairs({ { surge_manager, "get_surge_manager" }, { psi_storm_manager, "get_psi_storm_manager" } }) do
		local module, getter = m[1], m[2]
		if module and module[getter] then
			local ok, err = pcall(function()
				local mgr = module[getter]()
				if not mgr._state_loaded then
					mgr:initialize()
					mgr._state_loaded = true
				end
				mgr._delta = 1000000000
			end)
			if not ok then printf("[Lost Zone] %s init failed: %s", getter, tostring(err)) end
		end
	end
end

-- The NPC a player talks with on the server (netcoop.cpp server_on_talk):
-- GAMMA's get_speaker reads used_npc_id, which only the single-player use
-- callback set; task offers then indexed a nil speaker id.
local talk_speakers = {}
function talk_speaker(npc_id)
	if npc_id ~= 65535 then ensure_task_cache() end
	if not (SetEvent and GetEvent) then return end
	if npc_id ~= 65535 then
		talk_speakers[#talk_speakers + 1] = { id = GetEvent("used_npc_id") }
		SetEvent("used_npc_id", npc_id)
	elseif #talk_speakers > 0 then
		local previous = table.remove(talk_speakers)
		SetEvent("used_npc_id", previous.id)
	end
end

-- Remote dialogue bypasses motivator_binder:use_callback, which normally
-- updates conditions and supplies before the player opens trade.
function prepare_trade(npc_id, dialog_trade)
	local npc = level.object_by_id(npc_id)
	if not (npc and db.actor and trade_manager) then return "Trade state is not ready" end
	if zz_netcoop_sandbox then zz_netcoop_sandbox.configure_trader(npc) end
	if netcoop_traders then netcoop_traders.configure(npc) end
	-- GAMMA's trade_manager.trade_init returns without db.actor, and NPCs
	-- come online on the server with no player in scope: their trade profile
	-- was never made ("This character does not trade", owner 2026-10-17).
	-- The player is in scope now: the same profile xr_logic would have made.
	if trade_manager.trade_init and npc:alive() then
		local st = db.storage[npc_id]
		local ini, logic = st and st.ini, st and st.section_logic
		-- Saved profiles can outlive their ini cache. trade_init's same-profile
		-- branch reopens that cache without resetting the supply/restock state.
		local trade_ini = trade_manager.get_trade_profile(npc_id, "cfg_ltx") or
			(ini and logic and ini.r_string_ex and ini:r_string_ex(logic, "trade")) or "items\\trade\\trade_generic.ltx"
		local ok, err = pcall(trade_manager.trade_init, npc, trade_ini)
		if not ok then printf("[Lost Zone] trade profile for %s failed: %s", npc:name(), tostring(err)) end
	end
	trade_manager.update(npc)
	local cfg = trade_manager.get_trade_profile(npc_id, "cfg_ltx")
	-- xr_meet in this pack disables native trade unconditionally. Re-evaluate
	-- the actual meet policy for the requesting player before the native gate.
	local storage = db.storage[npc_id]
	local meet = storage and storage.meet
	local refusal = not cfg and "Trader profile is unavailable" or not npc:alive() and "Trader is not alive" or ""
	if refusal == "" and not dialog_trade and meet and meet.trade_enable and not (zz_netcoop_sandbox and zz_netcoop_sandbox.mini_profile(npc)) then
		if xr_logic.pick_section_from_condlist(db.actor, npc, meet.trade_enable) ~= "true" then
			refusal = "Trading is disabled by this dialogue"
		end
	end
	if refusal == "" and xr_wounded and xr_wounded.is_wounded(npc) then refusal = "Trader is wounded" end
	if refusal == "" and npc:relation(db.actor) == game_object.enemy then refusal = "Trader is hostile to your character" end
	if refusal == "" then npc:enable_trade() else npc:disable_trade() end
	if cfg and netcoop_send_to_actor then
		-- The conditions this server picked (they follow the player's infos,
		-- goodwill and time): the client's window must use the same ones, or it
		-- offers items the server then refuses (owner 2026-10-19).
		local profile = trade_manager.get_trade_profile(npc_id) or {}
		netcoop_send_to_actor(db.actor:id(), "trade_cfg", string.format("%s %s|%s|%s|%s", npc_id, cfg,
			tostring(profile.current_buy_condition or ""), tostring(profile.current_sell_condition or ""),
			tostring(profile.current_buy_item_condition_factor or "")))
	end
	return refusal
end

-- The price can be positive for an item hidden/rejected by GAMMA's UI.
-- Apply the same actual policy to forged/stale server requests, before money
-- or transfer events change. The native caller also checks CanTrade().
function trade_item_allowed(npc_id, item, actor_sells)
	local npc = level.object_by_id(npc_id)
	if not (npc and npc:alive() and item and db.actor and trade_manager and utils_item) then return false end
	local profile = trade_manager.get_trade_profile(npc_id)
	if type(profile) ~= "table" or type(profile.cfg_ltx) ~= "string" then return false end
	local list = profile[actor_sells and "current_buy_condition" or "current_sell_condition"]
	if type(list) ~= "string" or list == "" then return false end
	local threshold = actor_sells and tonumber(profile.current_buy_item_condition_factor) or nil
	if actor_sells and (not threshold or threshold ~= threshold or threshold < 0 or threshold > 1) then return false end
	return utils_item.get_item_trade_status(item, {
		mode = actor_sells and 1 or 2, cfg = profile.cfg_ltx, list = list, cond_factor = threshold
	}) == 4
end

-- GAMMA fills this static config cache from load_state. Dedicated worlds
-- load their own state instead; without it every trader offers zero jobs.
local task_cache_ready = false
function ensure_task_cache()
	if task_cache_ready then return end
	local manager = axr_task_manager
	if not (manager and manager.generate_cache and manager.CFG_CACHE) then return end
	if next(manager.CFG_CACHE) == nil then manager.generate_cache() end
	task_cache_ready = next(manager.CFG_CACHE) ~= nil
	if task_cache_ready then printf("[Lost Zone] server task offer cache initialized") end
end

local game_loaded = false
-- Anomalies hurt players in their whole field (owner 2026-10-18: "anomalies
-- do no damage"). GAMMA's NPC pathfinding fix (aaaa_script_fixes_mp)
-- ignores everyone but the single-player Actor (id 0) outside the field's
-- radius minus 1.1 m; every player here has another id, so a small field
-- never touched him. Living players get the single-player Actor's rule.
local zone_players_installed = false
function install_zone_players()
	if zone_players_installed or type(_G.CCustomZone_BeforeActivateCallback) ~= "function" then return end
	zone_players_installed = true
	local decide = _G.CCustomZone_BeforeActivateCallback
	_G.CCustomZone_BeforeActivateCallback = function(zone, obj)
		local result = decide(zone, obj)
		if not result and obj and obj.clsid and obj:clsid() == clsid.actor and obj.alive and obj:alive() then return true end
		return result
	end
end

local function server_game_load()
	if game_loaded then return end
	game_loaded = true
	init_event_managers()
	ensure_task_cache()
	install_zone_players()
	-- Faction relations: in a single player new game the faction select
	-- window sets them and marks new_game_relations; the server has no such
	-- window, so game_relations.reset_all_relations ran and read the
	-- relation table by its own faction order, which differs from base-game's
	-- column order - Clear Sky and loners became enemies of their own
	-- (community relation -2000, s99-s101). The engine already loaded the
	-- table correctly; keep it.
	local sok, serr = pcall(function()
		local state = alife_storage_manager.get_state()
		if state and not state.new_game_relations then
			state.new_game_relations = true
		end
	end)
	if not sok then printf("[Lost Zone] relations flag failed: %s", tostring(serr)) end
	local wok, werr = pcall(function() level_weathers.get_weather_manager():reset() end)
	if not wok then printf("[Lost Zone] weather manager reset error: %s", tostring(werr)) end
	local ok, err = pcall(SendScriptCallback, "on_game_load")
	if not ok then printf("[Lost Zone] on_game_load error: %s", tostring(err)) end
	printf("[Lost Zone] server on_game_load sent")
end

-- World systems a normal game updates from the Actor binder: the server
-- chooses the weather with base-game's weather manager and sends it to clients.
local world_next = 0
local server_debug_file
local weather_sent, weather_next = nil, 0
local weather_forced = false

-- Admin: the same weather for everyone (netanomaly_server "weather").
function set_server_weather(name, now)
	if not (name and name ~= "") then return "! no weather name" end
	local wm = level_weathers and level_weathers.get_weather_manager()
	if wm then wm.weather_file = name end
	local ok, err = pcall(level.set_weather, name, now and true or false)
	if not ok then return "! " .. tostring(err) end
	weather_sent, weather_next, weather_forced = nil, 0, now and true or false
	return string.format("* weather %s%s for all players", name, now and " (now)" or "")
end
-- Location cluster (doc 43 J01-J03): one weather for the whole Zone. GAMMA
-- picks the next weather cycle at random every game hour, so every server
-- had its own sky. With a cluster each server derives the cycle from the
-- shared calendar: the chain is replayed from a fixed start over the last
-- 24 game hours with an hour-seeded random, and presets within the hour use
-- the same seed, so all servers agree whenever they started.
local cluster_weather
local function in_cluster()
	if cluster_weather == nil then
		local path = getFS and getFS():update_path("$app_data_root$", "netcoop_cluster.ltx")
		local file = path and io.open(path, "r")
		cluster_weather = file ~= nil
		if file then file:close() end
	end
	return cluster_weather
end
-- Game hours since 2012-01-01. diffSec returns a float: counted from year 0
-- (about 6e10 s) it moved in ~1.1-hour steps, which broke the emission
-- schedule and the weather hour (2026-10-06); from 2012 it is exact to seconds.
local function hours_since_2012()
	local base = game.CTime()
	if base.set then base:set(2012, 1, 1, 0, 0, 0, 0) end
	return game.get_game_time():diffSec(base) / 3600
end
local function cluster_hour()
	return math.floor(hours_since_2012())
end
local function hour_seed(hour) math.randomseed((hour % 1000003) * 7919 + 104729) end
local function install_cluster_weather(wm)
	if wm.__netcoop_cluster or not in_cluster() or type(wm.get_next_weather_cycle) ~= "function" then return end
	wm.__netcoop_cluster = true
	local next_cycle = wm.get_next_weather_cycle
	wm.get_next_weather_cycle = function(self, current)
		local hour, cycle = cluster_hour(), "clear"
		for h = hour - 24, hour do
			hour_seed(h)
			local ok, value = pcall(next_cycle, self, cycle)
			if ok and value then cycle = value end
		end
		return cycle
	end
end

-- With the master GAMMA never picks a cycle itself: the master changes it.
function install_master_weather(wm)
	if wm.__netcoop_master then return end
	wm.__netcoop_master = true
	wm.is_next_change_date = function() return false end
	wm.get_next_weather_cycle = function(self, current)
		return netcoop_master.weather_cycle(netcoop_master.state()) or current
	end
end

-- The cycle a weather preset belongs to: an administrator picks a preset in
-- the debug menu or the weather editor and the master keeps it as the target.
local function preset_cycle(wm, name)
	local plain = string.gsub(name, "_large$", "")
	for cycle, presets in pairs(wm.presets or {}) do
		if presets[name] or presets[plain] then return cycle, presets[name] and name or plain end
	end
end

-- The source of an administrator's weather order: what the Zone shows now.
function master_weather_source()
	local wm = level_weathers and level_weathers.get_weather_manager()
	return netcoop_master.weather_cycle(netcoop_master.state()) or (wm and wm.cycle) or "clear"
end

-- The master's weather target is a cycle (the director's), a preset of a
-- cycle or a weather the cycles do not list (the administrator's). Every map
-- shows it at the same game time; a transition shorter than a game minute
-- switches at once, as the administrator's "now" did on one map.
local master_weather_key
local function apply_master_weather(wm, master)
	local target = netcoop_master.weather_cycle(master)
	if not target then return end
	local w = master.weather
	local cycle, preset = target, nil
	if not (wm.presets and wm.presets[target]) then cycle, preset = preset_cycle(wm, target) end
	local key = tostring(w.id) .. ":" .. target
	local fresh = key ~= master_weather_key
	if not fresh then
		-- GAMMA's hourly reselect must not leave the master's weather.
		if cycle and wm.cycle == cycle and (not preset or wm.preset == preset) then return end
		if not cycle and wm.weather_file == target then return end
	end
	master_weather_key = key
	local now = fresh and w.settled and w.transition and w.settled - w.transition < 60000 or false
	local ok, err = true, nil
	hour_seed(cluster_hour())
	if cycle then
		wm.cycle = cycle
		wm.preset = preset or random_key_table(wm.presets[cycle])
		wm.transition_period = not now and not preset
		ok, err = pcall(wm.select_weather, wm, now)
	else
		wm.weather_file = target
		ok, err = pcall(level.set_weather, target, now)
	end
	math.randomseed(os.time() + time_global())
	weather_sent, weather_next, weather_forced = nil, 0, now
	if not ok then printf("[Lost Zone] master weather error: %s", tostring(err)) end
	printf("[Lost Zone][master] weather %s%s", target, now and " (now)" or "")
end

-- The weather editor's live changes (owner 2026-10-23: what an administrator
-- changed in the weather editor reached only his own screen). The editor
-- pauses the sky's blending and sets values of the current sky; the
-- administrator's client sends each change here ("weather_edit ..."), the
-- state goes to the cluster's shared store, and every location sends it to
-- its players (new ones get it too). Unpausing gives everyone the normal sky.
--   weather_edit/zone  { seq, paused, sun = { h, m }, values = { par = { k = "n"|"v"|"s", ... } } }
local EDIT_BUCKET, EDIT_KEY, EDIT_VALUES = "weather_edit", "zone", 64
local edit_text_sent, edit_next, edit_resend = nil, 0, 0
local function finite(n) return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge end
local edit_ranges={rain_density={0,1},fog_density={0,1},fog_distance={10,1000},far_plane={50,1500},
 wind_velocity={0,30},wind_direction={0,360},sky_rotation={0,360},thunderbolt_period={1,120},
 thunderbolt_duration={0.01,2},sun_shafts_intensity={0,1},water_intensity={0,5},tree_amplitude_intensity={0,2}}
local edit_colors={sky_color=3,fog_color=3,rain_color=3,ambient_color=3,sun_color=3,clouds_color=4,hemisphere_color=4}
local function edit_allowed(par,entry)
 if type(entry)~="table" then return false end
 local range=edit_ranges[par]
 if entry.k=="n" then return range and #entry==1 and finite(entry[1]) and entry[1]>=range[1] and entry[1]<=range[2] end
 if entry.k~="v" or not edit_colors[par] or (#entry~=3 and #entry~=edit_colors[par]) then return false end
 for _,n in ipairs(entry) do if not finite(n) or n<0 or n>4 then return false end end
 return true
end

local function edit_read()
	local text = netcoop_store_read and netcoop_store_read(EDIT_BUCKET, EDIT_KEY) or ""
	if text == "" then return nil, text end
	local ok, v = pcall(netcoop_transit.deserialize, text)
	if not ok or type(v)~="table" then return nil,text end
	-- Old stored editor sessions may contain asset paths. Never resend them.
	if type(v.values)~="table" then v.values={} end
	for par,entry in pairs(v.values) do if not edit_allowed(par,entry) then v.values[par]=nil end end
	return v, text
end

local function edit_change(fn)
	for _ = 1, 10 do
		local state, old = edit_read()
		state = state or { seq = 0, paused = false, values = {} }
		state.values = state.values or {}
		local result = fn(state)
		if result then return result end
		state.seq = (tonumber(state.seq) or 0) + 1
		if netcoop_store_swap(EDIT_BUCKET, EDIT_KEY, old, netcoop_transit.serialize(state)) then
			edit_next = 0
			return nil
		end
	end
	return "! the weather edit could not be stored, try again"
end

-- Admin: weather_edit pause <0|1> | sun <h> <m> | num <par> <v> | vec <par> <x> <y> <z> [w] | str <par> <value>
function weather_edit(args)
	local verb, rest = string.match(args or "", "^(%a+)%s*(.*)$")
	if not (netcoop_store_read and netcoop_store_swap and netcoop_transit) then return "! no shared store on this server" end
	local err
	if verb == "pause" and (rest == "0" or rest == "1") then
		err = edit_change(function(s)
			s.paused = rest == "1"
			if not s.paused then s.values, s.sun = {}, nil end
		end)
	elseif verb == "sun" then
		local h, m = string.match(rest, "^(%d+)%s+(%d+)$")
		h, m = tonumber(h), tonumber(m)
		if not (h and m and h < 24 and m < 60) then return "! usage: weather_edit sun <hour> <minute>" end
		err = edit_change(function(s) s.sun = { h = h, m = m } end)
	elseif verb == "num" or verb == "vec" or verb == "str" then
		local par, value = string.match(rest, "^([%w_]+)%s+(.+)$")
		if not par or #par > 48 then return "! usage: weather_edit " .. verb .. " <parameter> <value>" end
		local entry
		if verb == "str" then
			return "! weather asset paths cannot be changed online"
		else
			local numbers = {}
			for n in string.gmatch(value, "%S+") do numbers[#numbers + 1] = tonumber(n) end
			local want = verb == "num" and { [1] = true } or { [3] = true, [4] = true }
			if not want[#numbers] then return "! bad weather value" end
			for _, n in ipairs(numbers) do if not finite(n) then return "! bad weather value" end end
			entry = { k = verb == "num" and "n" or "v", unpack(numbers) }
		end
		if not edit_allowed(par,entry) then return "! weather parameter is unsupported or outside safe bounds" end
		err = edit_change(function(s)
			local count = 0
			for _ in pairs(s.values) do count = count + 1 end
			if not s.values[par] and count >= EDIT_VALUES then return "! too many weather values; unpause to start again" end
			s.values[par] = entry
		end)
	else
		return "! usage: weather_edit pause <0|1> | sun <h> <m> | num|vec|str <parameter> <value>"
	end
	return err or "* weather edit sent to every location"
end

-- Every world tick: the shared state to this location's players (at once
-- when it changed, every 5 s for players who came in since).
local function weather_edit_tick(now)
	if not (netcoop_store_read and netcoop_broadcast) or now < edit_next then return end
	edit_next = now + 2000
	local state, text = edit_read()
	if not state then return end
	if text ~= edit_text_sent or now >= edit_resend then
		edit_text_sent, edit_resend = text, now + 5000
		netcoop_broadcast("weather_edit", netcoop_transit.serialize(state))
	end
end

local function server_world_tick()
	local now = time_global()
	if now < world_next then return end
	world_next = now + 500 -- a weather change reaches everyone within ~0.5 s
	-- Allow world diagnostics and cleanup after the last player disconnects.
	-- There is deliberately no implicit Actor context in that case.
	if not db.actor and server_debug_file then server_debug_file() end
	netcoop_emission.update_world()
	if netcoop_artefacts then
		local art_ok, art_err = pcall(netcoop_artefacts.update_world)
		if not art_ok then printf("[Lost Zone] artefact update error: %s", tostring(art_err)) end
	end
	if netcoop_barter then
		local barter_ok, barter_err = pcall(netcoop_barter.update)
		if not barter_ok then printf("[Lost Zone] barter error: %s", tostring(barter_err)) end
	end
	local psi_ok, psi_err = pcall(netcoop_psi_storm.update_world)
	if not psi_ok then printf("[Lost Zone] psi storm error: %s", tostring(psi_err)) end
	if netcoop_pdanet then
		local net_ok, net_err = pcall(netcoop_pdanet.update_world)
		if not net_ok then printf("[Lost Zone] PDA network error: %s", tostring(net_err)) end
	end
	if netcoop_map_known then
		local map_ok, map_err = pcall(netcoop_map_known.update_world)
		if not map_ok then printf("[Lost Zone] map places error: %s", tostring(map_err)) end
	end

	local wm = level_weathers and level_weathers.get_weather_manager()
	if not wm then return end
	-- The world master's weather cycle (owner 2026-10-12): every map of the
	-- Zone switches to it at the same game time; presets within the cycle use
	-- the hour seed below, so all maps pick the same one.
	local master, master_required = netcoop_master.state()
	if master or master_required then
		install_master_weather(wm)
		if master then apply_master_weather(wm, master) end
	else
		install_cluster_weather(wm)
	end
	if in_cluster() or master then hour_seed(cluster_hour()) end
	local ok, err = pcall(wm.update, wm)
	if in_cluster() or master then math.randomseed(os.time() + time_global()) end
	if not ok then printf("[Lost Zone] weather update error: %s", tostring(err)) end
	local edit_ok, edit_err = pcall(weather_edit_tick, now)
	if not edit_ok then printf("[Lost Zone] weather edit error: %s", tostring(edit_err)) end
	local weather = wm.weather_file or (level.get_weather and level.get_weather()) or ""
	if weather ~= "" and (weather ~= weather_sent or now >= weather_next) then
		weather_sent, weather_next = weather, now + 5000
		-- "name|1": switch at once (admin "now"); otherwise a transition.
		if netcoop_broadcast then netcoop_broadcast("weather", weather .. (weather_forced and "|1" or "")) end
		weather_forced = false
	end
end

-- Local debug channel: the server runs gamma-runtime/netcoop_debug.lua
-- (then empties it) and logs the result. Only someone with access to the
-- server's files can use it; it needs no game window. With several location
-- servers in one runtime the first one took the file: netcoop_debug_<map>.lua
-- is for the server of that map only.
local debug_next = 0
local function debug_take(name)
	local f = io.open(name, "r")
	if not f then return nil end
	local code = f:read("*a")
	f:close()
	if not code or code == "" then return nil end
	-- os.remove is not available to base-game scripts: empty the file instead.
	local w = io.open(name, "w")
	if w then w:close() end
	return code
end
server_debug_file = function()
	local now = time_global()
	if now < debug_next then return end
	debug_next = now + 2000
	local code = debug_take("netcoop_debug_" .. tostring(level.name()) .. ".lua") or debug_take("netcoop_debug.lua")
	if not code then return end
	local chunk, err = loadstring(code)
	if not chunk then printf("[Lost Zone][debug] compile error: %s", tostring(err)) return end
	local ok, res = pcall(chunk)
	printf("[Lost Zone][debug] %s: %s", ok and "result" or "error", tostring(res))
	if get_console then get_console():execute("flush") end
end

-- NPC voices with no player near (2026-10-06): GAMMA's sound themes measure
-- the distance to db.actor for the PDA copy of a line, and an NPC update
-- with no player to bind ended in a Lua panic that took the server down
-- (sound_theme.script:217) once smart terrains gave online NPCs their jobs
-- on an empty server. The hidden anchor Actor stands in for db.actor, as in
-- the world tick; a failing line is logged, never fatal.
local voice_errors = 0
local function with_anchor(name, f)
	return function(...)
		if rawget(db, "actor") then return f(...) end
		db.actor = level.object_by_id(0)
		local r = {pcall(f, ...)}
		db.actor = nil
		if r[1] then return unpack(r, 2) end
		voice_errors = voice_errors + 1
		if voice_errors <= 20 then printf("[Lost Zone] NPC voice error in %s: %s", name, tostring(r[2])) end
	end
end

function install_npc_voices()
	if not xr_sound or xr_sound.netcoop_voices then return end
	xr_sound.netcoop_voices = true
	for _, name in ipairs({"set_sound_play", "play_sound_looped"}) do
		if type(xr_sound[name]) == "function" then xr_sound[name] = with_anchor(name, xr_sound[name]) end
	end
end

local world_errors = 0
local function server_world_loop()
	-- This level call continues even with no connected players. World
	-- weather/emissions must finish when their initiating player leaves.
	server_debug_file()
	if not game_loaded then
		-- The world runs without players too (emissions on schedule, weather,
		-- corpse cleanup, factions): before, it waited for the first player
		-- after every start, so an empty server's world stood still
		-- (2026-10-06). The hidden anchor Actor stands in for db.actor, as in
		-- the world tick below; a few seconds after the level is up.
		if time_global() < 15000 then return false end
		local previous = rawget(db, "actor")
		if not previous then db.actor = any_player() or level.object_by_id(0) end
		local ok, err = pcall(server_game_load)
		db.actor = previous
		if not ok then printf("[Lost Zone] world start without players failed: %s", tostring(err)) end
		if not game_loaded then return false end
		printf("[Lost Zone] world scripts running (no player needed)")
	end
	local previous = rawget(db, "actor")
	if not previous then db.actor = any_player() or level.object_by_id(0) end
	local ok, err = pcall(server_world_tick)
	db.actor = previous
	if not ok then
		world_errors = world_errors + 1
		if world_errors <= 20 then printf("[Lost Zone] world update error: %s", tostring(err)) end
	end
	return false
end

-- Engine (netcoop.cpp) every 0.5 s for each player, with db.actor bound.
function update_player_tasks()
	local a = db.actor
	if not a then return end
	server_game_load()
	if zz_netcoop_sandbox then zz_netcoop_sandbox.update() end
	install_hide_hud()
	server_world_tick()
	netcoop_emission.update_player(a)
	local psi_ok, psi_err = pcall(netcoop_psi_storm.update_player, a)
	if not psi_ok then printf("[Lost Zone] psi storm player error: %s", tostring(psi_err)) end
	server_debug_file()
	-- Forget managers of players who left.
	for id in pairs(player_tasks) do
		if id ~= a:id() and not level.object_by_id(id) then player_tasks[id] = nil end
	end
	task_manager.get_task_manager():update()
end

-- axr_main calls on_game_start of every script once all scripts are loaded.
-- The trade window on a client needs the NPC's trade profile (what it buys
-- and sells), which NPC logic sets up on the server only. Send it before the
-- window opens (same ordered channel as "open_ui").
local function install_trade_profiles()
	if not (dialogs and dialogs.npc_is_trader and trade_manager) then return end
	local npc_is_trader = dialogs.npc_is_trader
	dialogs.npc_is_trader = function(a, b)
		local npc = dialogs.who_is_npc(a, b)
		if zz_netcoop_sandbox then zz_netcoop_sandbox.configure_trader(npc) end
		local player = db.actor
		local cfg = npc and trade_manager.get_trade_profile(npc:id(), "cfg_ltx")
		if player and cfg and netcoop_send_to_actor then
			netcoop_send_to_actor(player:id(), "trade_cfg", npc:id() .. " " .. cfg)
		end
		return npc_is_trader(a, b)
	end
end

local squad_attackers = {}

-- Native server AI calls this only for nearby witnesses of a squad attack.
function on_squad_attacked(npc_id, attacker_id)
	local npc, attacker = level.object_by_id(npc_id), level.object_by_id(attacker_id)
	if not npc or not attacker or not npc:alive() or not attacker:alive() then return end
	local previous = squad_attackers[npc_id]
	squad_attackers[npc_id] = {id = attacker_id, until_time = time_global() + 300000}
	if not previous or previous.id ~= attacker_id or previous.until_time < time_global() then
		printf("[Lost Zone][AI] squad witness %s confronts attacker %s", npc_id, attacker_id)
	end
end

function before_npc_hit(npc_id, attacker_id)
	local npc = level.object_by_id(npc_id)
	if not npc or not npc:alive() then return end
	if netcoop_traders and netcoop_traders.is_service_npc(npc) then npc:invulnerable(true); return end
	on_squad_attacked(npc_id, attacker_id)
	-- Re-evaluate the live freeplay protection policy rather than retaining
	-- the last scheduled value while the NPC changes camp/combat state.
	if stalker_generic and stalker_generic.update_invulnerability then
		stalker_generic.update_invulnerability(npc)
	end
end

local function on_camp_member_hit(victim, amount, direction, attacker)
	if not victim or not attacker or amount <= 0 or attacker:clsid() ~= clsid.script_actor then return end
	local community = victim:character_community()
	for id, storage in pairs(db.storage) do
		local npc = storage.object
		if npc and id ~= victim:id() and npc:clsid() == clsid.script_stalker and npc:alive()
			and npc:character_community() == community then
			local distance = npc:position():distance_to_sqr(victim:position())
			if distance < 64 or (distance < 900 and (npc:see(victim) or npc:see(attacker))) then
				on_squad_attacked(id, attacker:id())
				npc:set_relation(game_object.enemy, attacker)
			end
		end
	end
end

local function witnessed_enemy(npc, enemy)
	local event = npc and squad_attackers[npc:id()]
	if not event then return false end
	local attacker = level.object_by_id(event.id)
	if not attacker or not attacker:alive() or time_global() > event.until_time then
		squad_attackers[npc:id()] = nil
		return false
	end
	return (not enemy or enemy:id() == event.id) and npc:position():distance_to_sqr(attacker:position()) < 3600
end

local function install_squad_witnesses()
	if stalker_generic then
		local protection = stalker_generic.is_need_invulnerability
		stalker_generic.is_need_invulnerability = function(npc)
			if netcoop_traders and netcoop_traders.is_service_npc(npc) then return true end
			local attacked = npc and squad_attackers[npc:id()]
			local storage = npc and db.storage[npc:id()]
			-- Generic simulation camp jobs use safe_restr protection. Once
			-- attacked, that generated safe-zone guard must not make the
			-- fighting squad immortal. Keep explicit story protection.
			if attacked and attacked.until_time >= time_global() and storage and storage.ini
				and not get_object_story_id(npc:id()) then
				local rule = storage.ini:r_string_ex(storage.section_logic, "invulnerable")
					or storage.active_section and storage.ini:r_string_ex(storage.active_section, "invulnerable")
				if rule and npc:section():find("^sim_default") and rule:find("npc_in_zone", 1, true)
					and rule:find("safe_restr", 1, true) then return false end
			end
			return protection(npc)
		end
	end
	if not xr_combat_ignore then return end
	local is_enemy = xr_combat_ignore.is_enemy
	xr_combat_ignore.is_enemy = function(npc, enemy, ...)
		if witnessed_enemy(npc, enemy) then return true end
		return is_enemy(npc, enemy, ...)
	end
	local ignore = xr_combat_ignore.ignore_enemy_by_overrides
	xr_combat_ignore.ignore_enemy_by_overrides = function(npc, enemy, ...)
		if witnessed_enemy(npc, enemy) then return false end
		return ignore(npc, enemy, ...)
	end
	local safe = xr_combat_ignore.npc_in_safe_zone
	xr_combat_ignore.npc_in_safe_zone = function(npc)
		if witnessed_enemy(npc) then return false end
		return safe(npc)
	end
end

----------------------------------------------------------------------
-- NPC inventories and loot (stage 5, plan section 7)
----------------------------------------------------------------------
-- GAMMA made a corpse's loot when the player first opened it
-- (motivator use_callback -> death_manager.create_release_item). On a
-- netcoop client that runs without alife(), so corpses kept only what the
-- NPC carried; it also rerolled the weapon's condition at that moment.
--
-- Now an NPC gets its whole GAMMA inventory when it first comes online:
-- community and private items (food, drinks, medicine, ammunition, tools,
-- valuables...), ammunition for its weapon, ammo parts and artefacts. Every
-- item that wears gets a condition: weapons and armour from the NPC's rank
-- (GAMMA's dph_loot_cond ranges), devices a battery charge. The NPC lives
-- with it: the engine wears its weapons with every shot and it uses its
-- medicine when wounded. Ammunition stays endless in a fight (the engine's
-- NPC ammo; the owner's choice), but a corpse carries little of it: at death
-- each calibre is cut to 20-100 % of one box. Nothing else is generated at
-- death: the corpse holds what the NPC still had, plus the outfit it wore.
-- Everything draws from a seed made of the world seed and the NPC id.
-- NPCs with a story id (traders, quest givers) keep GAMMA's death loot.
local WORLD_SEED = (os.time() % 100000) * 7919
local function world_loot_seed()
	return netcoop_loot_policy and netcoop_loot_policy.world_seed() or WORLD_SEED
end
local CONDITION_DEFAULT = { -- percent, used when MCM has no value
	novice = { 25, 65 }, trainee = { 30, 70 }, experienced = { 40, 80 }, professional = { 45, 85 },
	veteran = { 55, 90 }, expert = { 60, 92 }, master = { 65, 95 }, legend = { 70, 95 }, zombied = { 5, 30 },
}
local BATTERY_CHARGE = { 15, 90 } -- percent, devices an NPC carries
local LOOT_GENERATORS = { "create_item_list", "try_spawn_ammo", "try_spawn_powders", "try_spawn_bullets",
	"try_spawn_casings", "try_spawn_sin_artefacts" }
local pending_inventory = {} -- npc id -> { at = time, step = 1 build | 2 condition }

local function seeded_random(seed)
	local state = seed % 2147483647
	if state <= 0 then state = state + 2147483646 end
	return function(lo, hi)
		state = (state * 16807) % 2147483647
		local r = (state - 1) / 2147483646
		return lo + math.floor(r * (hi - lo + 1))
	end
end

local function rank_condition_range(npc, kind)
	local key = (character_community(npc) == "zombied") and "zombied" or (ranks.get_obj_rank_name(npc) or "novice")
	local lo = ui_mcm and ui_mcm.get("dph_loot_cond/" .. kind .. "/" .. key .. "_min")
	local hi = ui_mcm and ui_mcm.get("dph_loot_cond/" .. kind .. "/" .. key .. "_max")
	local default = CONDITION_DEFAULT[key] or CONDITION_DEFAULT.novice
	lo, hi = tonumber(lo) or default[1], tonumber(hi) or default[2]
	if hi < lo then hi = lo end
	return clamp(lo, 5, 100), clamp(hi, 5, 100)
end

-- Condition of every item that wears, once per NPC life.
local function condition_npc_items(npc, roll)
	local w_lo, w_hi = rank_condition_range(npc, "weapon")
	local o_lo, o_hi = rank_condition_range(npc, "outfit")
	local devices = item_device and item_device.dev_consumption or {}
	local counts = { weapon = 0, armour = 0, device = 0 }
	npc:iterate_inventory(function(_, item)
		if not item then return end
		if IsWeapon(item) and not IsAmmo(item) then
			item:set_condition(roll(w_lo, w_hi) / 100); counts.weapon = counts.weapon + 1
		elseif IsOutfit(item) or IsHeadgear(item) then
			item:set_condition(roll(o_lo, o_hi) / 100); counts.armour = counts.armour + 1
		elseif devices[item:section()] then
			item:set_condition(roll(BATTERY_CHARGE[1], BATTERY_CHARGE[2]) / 100); counts.device = counts.device + 1
		end
	end, npc)
	return counts
end

local function count_items(npc)
	local n = 0
	npc:iterate_inventory(function() n = n + 1 end, npc)
	return n
end

local function with_player_bound(fn, ...)
	local bound_here = false
	if not rawget(db, "actor") then
		local player = any_player()
		if player then bind_actor(player); bound_here = true end
	end
	local ok, err = pcall(fn, ...)
	if bound_here then bind_actor(nil) end
	return ok, err
end

local function no_loot_spawn(npc)
	local ini = npc:spawn_ini()
	if ini and ini:section_exist("dont_spawn_loot") then return true end
	local st = db.storage[npc:id()]
	return st and st.ini and st.section_logic and st.ini:line_exist(st.section_logic, "dont_spawn_loot")
end

local function build_npc_inventory(npc)
	local id, name = npc:id(), npc:name()
	if not (npc:alive() and death_manager) or se_load_var(id, name, "netcoop_inventory") then return end
	if get_object_story_id and get_object_story_id(id) then return end
	local before = count_items(npc)
	local dm = death_manager
	local context = netcoop_loot_policy and netcoop_loot_policy.context_for(npc)
	local function allowed(stage) return not context or netcoop_loot_policy.allows(context, stage) end
	local function generate()
		if not no_loot_spawn(npc) then
			local comm, rank = character_community(npc), ranks.get_obj_rank_name(npc)
			if allowed("ammo") then dm.try_spawn_ammo(npc) end
			if allowed("powders") then dm.try_spawn_powders(npc) end
			if allowed("bullets") then dm.try_spawn_bullets(npc) end
			if allowed("casings") then dm.try_spawn_casings(npc) end
			if allowed("sin_artefacts") then dm.try_spawn_sin_artefacts(npc) end
			if allowed("community") and not (dm.get_items_by_npc and dm.get_items_by_npc(id)) then dm.create_item_list(npc, comm, rank, false) end
			if allowed("private") then dm.create_item_list(npc, comm, rank, true) end
		end
	end
	if not context then math.randomseed(world_loot_seed() + id * 7) end
	local ok, err = with_player_bound(function()
		if not context then return generate() end
		local good, result = netcoop_loot_policy.with_random(context, generate)
		if not good then error(result) end
	end)
	if not context then math.randomseed(os.time() + id) end
	se_save_var(id, name, "netcoop_inventory", true)
	printf("[Lost Zone][loot] npc %s inventory %s: %s -> %s items", name, ok and "made" or ("failed: " .. tostring(err)), before,
		count_items(npc))
end

-- Its items spawn after it: look a moment later, then condition what it has
-- (the new items spawn a frame later again).
-- Defined further down; the per-frame loop in on_game_start calls them.
-- Without these forward declarations the loop called nil globals and none of
-- them ever ran (check-netcoop-lua-scope.py).
local owned_objects_update, stash_visits_update, keep_switch_distance

-- GAMMA fills a stash it marked (treasure_manager.caches: box id -> its
-- items) when the player uses the box, from the box's use callback. A
-- client opens a box on its own side: that callback never ran on the server
-- and every stash stayed empty (owner 2026-10-24, spec 5.1). The server fills
-- a marked stash when a player comes within STASH_FILL_NEAR of it, with that
-- player as db.actor, before he can open it.
local STASH_FILL_NEAR, STASH_FILL_EVERY = 15, 2000
local stash_fill_next = 0
local function stash_fill_update()
	local tm = treasure_manager
	if not (tm and tm.caches and tm.try_spawn_treasure) or time_global() < stash_fill_next then return end
	stash_fill_next = time_global() + STASH_FILL_EVERY
	local players = {}
	for id in string.gmatch(netcoop_players and netcoop_players() or "", "%d+") do
		local obj = level.object_by_id(tonumber(id))
		if obj and obj:alive() then players[#players + 1] = obj end
	end
	if #players == 0 then return end
	for box_id, items in pairs(tm.caches) do
		local box = type(items) == "string" and level.object_by_id(box_id)
		if box then
			for _, player in ipairs(players) do
				if player:position():distance_to(box:position()) <= STASH_FILL_NEAR then
					local ok, err = with_player_bound(function() tm.try_spawn_treasure(box) end, player)
					printf("[Lost Zone][stash] %s filled for %s%s", tostring(box_id), player:character_name(), ok and "" or (": " .. tostring(err)))
					break
				end
			end
		end
	end
end

local function process_pending_inventory()
	local now = time_global()
	for id, entry in pairs(pending_inventory) do
		if now >= entry.at then
			local npc = level.object_by_id(id)
			if not (npc and IsStalker(npc) and npc:alive()) then
				pending_inventory[id] = nil
			elseif entry.step == 1 then
				build_npc_inventory(npc)
				entry.step, entry.at = 2, now + 2000
			else
				pending_inventory[id] = nil
				if not se_load_var(id, npc:name(), "netcoop_item_cond") then
					local c = condition_npc_items(npc, seeded_random(world_loot_seed() + id * 131))
					se_save_var(id, npc:name(), "netcoop_item_cond", true)
					printf("[Lost Zone][loot] npc %s conditioned: weapons %s, armour %s, devices %s", npc:name(), c.weapon, c.armour, c.device)
				end
			end
		end
	end
end

local function on_npc_net_spawn(npc)
	if npc and IsStalker(npc) then pending_inventory[npc:id()] = { at = time_global() + 2000, step = 1 } end
end

-- A corpse's ammunition: per calibre at most one box, 20-100 % of it.
local function cap_corpse_ammo(npc, roll)
	local boxes = {}
	npc:iterate_inventory(function(_, item)
		if item and IsAmmo(item) then
			local sec = item:section()
			boxes[sec] = boxes[sec] or {}
			table.insert(boxes[sec], item)
		end
	end, npc)
	local kept, removed = 0, 0
	for sec, list in pairs(boxes) do
		local box = ini_sys:r_float_ex(sec, "box_size") or 30
		local allowed = roll(math.max(1, math.floor(box * 0.2)), math.max(1, math.floor(box)))
		for _, item in ipairs(list) do
			local count = item:ammo_get_count()
			if allowed <= 0 then
				removed = removed + count
				alife_release(item)
			elseif count > allowed then
				item:ammo_set_count(allowed)
				removed = removed + count - allowed
				kept = kept + allowed
				allowed = 0
			else
				kept = kept + count
				allowed = allowed - count
			end
		end
	end
	return kept, removed
end

local function on_npc_death_loot(victim)
	if not (victim and IsStalker(victim) and death_manager and death_manager.create_release_item) then return end
	pending_inventory[victim:id()] = nil
	if se_load_var(victim:id(), victim:name(), "death_dropped") then return end
	local before = count_items(victim)
	local dm = death_manager
	-- An NPC that lived with its inventory: GAMMA's death routine still
	-- dresses the corpse (outfit, story items, releases animation props) but
	-- generates nothing new.
	local lived = se_load_var(victim:id(), victim:name(), "netcoop_inventory")
	local saved = {}
	if lived then
		for _, name in ipairs(LOOT_GENERATORS) do saved[name] = dm[name]; dm[name] = function() end end
	end
	math.randomseed(world_loot_seed() + victim:id() * 7)
	local ok, err = with_player_bound(dm.create_release_item, victim)
	math.randomseed(os.time() + victim:id())
	for name, fn in pairs(saved) do dm[name] = fn end
	local kept, removed = cap_corpse_ammo(victim, seeded_random(world_loot_seed() + victim:id() * 17))
	printf("[Lost Zone][loot] npc %s died: %s loot %s, %s -> %s items, ammo %s left (%s removed)", victim:name(),
		lived and "lived" or "generated", ok and "ok" or ("failed: " .. tostring(err)), before, count_items(victim), kept, removed)
end

local function install_npc_loot()
	if not (death_manager and RegisterScriptCallback) or death_manager.__netcoop_loot then return end
	death_manager.__netcoop_loot = true
	-- A conditioned NPC's weapon keeps its real (worn) condition at death.
	local drop_condition = death_manager.set_weapon_drop_condition
	if drop_condition then
		death_manager.set_weapon_drop_condition = function(npc, item)
			local keep = npc and item and se_load_var(npc:id(), npc:name(), "netcoop_item_cond") and item:condition()
			drop_condition(npc, item)
			if keep then item:set_condition(keep) end
		end
	end
	RegisterScriptCallback("npc_on_net_spawn", on_npc_net_spawn)
	RegisterScriptCallback("npc_on_death_callback", on_npc_death_loot)
	printf("[Lost Zone] NPC inventories, item condition and death loot run on the server")
end

----------------------------------------------------------------------
-- Companions belong to the player who recruited them (owner 2026-10-05)
----------------------------------------------------------------------
-- GAMMA sends a companion squad to target 0 (AC_ID), which on the server is
-- its own authority Actor, not the player who hired the squad. The server
-- records the recruiting player's login (world script state, saved with the
-- world) and sends the squad to that player's current Actor; while the
-- player is offline the squad waits where it is. After a restart or a
-- reconnect the player gets the same squad back.
local function companion_owners()
	local state = alife_storage_manager.get_state()
	state.netcoop_companion_owner = state.netcoop_companion_owner or {}
	return state.netcoop_companion_owner
end

local function online_actor_of(login)
	if not (login and netcoop_players and netcoop_actor_login) then return nil end
	for id in string.gmatch(netcoop_players(), "%d+") do
		local actor_id = tonumber(id)
		if netcoop_actor_login(actor_id) == login then return actor_id end
	end
	return nil
end

local function remember_owner(squad)
	local actor = db.actor
	if not (squad and actor and netcoop_actor_login) then return end
	local login = netcoop_actor_login(actor:id())
	if login ~= "" then
		companion_owners()[squad.id] = login
		printf("[Lost Zone][companions] squad %s now follows %s", squad.id, login)
	end
end

function companion_owner(squad_id)
	return companion_owners()[squad_id]
end

local function install_companions()
	local ac = axr_companions
	local class = sim_squad_scripted and sim_squad_scripted.sim_squad_scripted
	if not (ac and class) or ac.__netcoop_owners then return end
	ac.__netcoop_owners = true
	local add_npc = ac.add_to_actor_squad
	ac.add_to_actor_squad = function(npc)
		add_npc(npc)
		remember_owner(npc and get_object_squad(npc))
	end
	local add_squad = ac.add_special_squad
	ac.add_special_squad = function(squad, ...)
		add_squad(squad, ...)
		remember_owner(squad)
	end
	local remove_npc = ac.remove_from_actor_squad
	ac.remove_from_actor_squad = function(npc)
		local squad = npc and get_object_squad(npc)
		remove_npc(npc)
		if squad and not ac.companion_squads[squad.id] then companion_owners()[squad.id] = nil end
	end
	local target = class.get_script_target
	class.get_script_target = function(self)
		local id = target(self)
		if id == 0 and ac.companion_squads[self.id] then
			local login = companion_owners()[self.id]
			if login then return online_actor_of(login) or self.id end
		end
		return id
	end
	printf("[Lost Zone] companions follow the player who recruited them")
end

function on_game_start()
	install_squad_witnesses()
	RegisterScriptCallback("npc_on_hit_callback", on_camp_member_hit)
	-- The dedicated server skips the single-player Actor binder constructor,
	-- which normally loads these themes before NPC net_spawn initializes its
	-- voices. Camps and scripted NPC speech still need that initialization.
	if sound_theme and sound_theme.load_sound then
		sound_theme.load_sound()
		printf("[Lost Zone] server NPC sound themes loaded")
	end
	install_npc_voices()
	-- GAMMA's dynamic news runs from time events and checks db.actor: with no
	-- player on this server every check failed (hoster's log 2026-10-23,
	-- dynamic_news_manager.script:1039). No player here, no news.
	local news = dynamic_news_manager and dynamic_news_manager.DynamicNewsManager
	if news and type(news.NewsToggle) == "function" and not news.__netcoop then
		news.__netcoop = true
		local toggle = news.NewsToggle
		news.NewsToggle = function(self, ...)
			if not rawget(db, "actor") then return true end
			return toggle(self, ...)
		end
	end
	-- SMR reads its options through MCM; log what the server actually sees
	-- (a civil war setting would turn every stalker against its own squad).
	local ok, res = pcall(function()
		return string.format("smr_enabled=%s civil_war=%s ui_mcm=%s",
			tostring(smr_amain_mcm and smr_amain_mcm.get_config("smr_enabled")),
			tostring(smr_stalkers_mcm and smr_stalkers_mcm.get_config("civil_war")),
			tostring(ui_mcm ~= nil))
	end)
	printf("[Lost Zone] server SMR options: %s", tostring(res))
	install_hide_hud()
	install_trade_profiles()
	install_player_tasks()
	if death_manager and death_manager.init_drop_settings then
		local ok, err = pcall(death_manager.init_drop_settings)
		if not ok then printf("[Lost Zone] death_manager init error: %s", tostring(err)) end
	end
	install_npc_diagnostic()
	install_npc_loot()
	if netcoop_box_contents then netcoop_box_contents.install() end
	if netcoop_distant_battles then netcoop_distant_battles.install() end
	install_companions()
	-- Sleep deprivation is cut from multiplayer (owner 2026-10-05).
	if actor_status_sleep and actor_status_sleep.toggle_feature then
		local toggle = actor_status_sleep.toggle_feature
		pcall(toggle, false)
		actor_status_sleep.toggle_feature = function() pcall(toggle, false) end
	end
	if AddUniqueCall and ProcessEventQueue then
		AddUniqueCall(server_event_queue)
		AddUniqueCall(server_world_loop)
		AddUniqueCall(function() process_pending_inventory(); owned_objects_update(); stash_visits_update(); stash_fill_update(); keep_switch_distance(); if netcoop_transit then netcoop_transit.update() end; if netcoop_factions then netcoop_factions.update_online() end; if netcoop_ranks then netcoop_ranks.update() end; if netcoop_squads then netcoop_squads.update() end; if netcoop_corpses then netcoop_corpses.update() end; if netcoop_traders then netcoop_traders.update() end; if netcoop_box_contents then netcoop_box_contents.update() end; if netcoop_mines then netcoop_mines.update() end; return false end)
		printf("[Lost Zone] server time event queue installed")
	end
	-- base-game's NPC vision hook reads db.actor (torch, flashlight) for every
	-- observed object. Serve it with the observed player as db.actor, and use
	-- the engine's own formula for NPC-to-NPC visibility.
	local vmm = visual_memory_manager
	local visible_value = vmm and vmm.get_visible_value
	if visible_value then
		vmm.get_visible_value = function(npc, who, time_delta, time_quant, luminocity, velocity_factor, velocity,
		                                 distance, object_distance, always_visible_distance)
			if not no_local_actor() then
				return visible_value(npc, who, time_delta, time_quant, luminocity, velocity_factor, velocity,
				                     distance, object_distance, always_visible_distance)
			end
			if who and who:clsid() == clsid.script_actor then
				bind_actor(who)
				local ok, value = pcall(visible_value, npc, who, time_delta, time_quant, luminocity,
				                        velocity_factor, velocity, distance, object_distance, always_visible_distance)
				bind_actor(nil)
				if ok and value then return value end
			end
			local span = distance - always_visible_distance
			if span <= 0 or time_quant <= 0 then return 0 end
			return time_delta / time_quant * luminocity * (1 + velocity_factor * velocity) *
				(distance - object_distance) / span
		end
	end
end

----------------------------------------------------------------------
-- Item actions a player's client asks the server to run (stage 3,
-- netcoop_items.inc server_on_item_action). The engine has checked that
-- the items are in the player's inventory; db.actor and AC_ID are that
-- player while this runs. Returns "" or the reason for a refusal.
----------------------------------------------------------------------
-- Menu functors (useN_action_functor) the server performs. The client sends
-- these instead of running them (netcoop_client_compat SERVER_ITEM_ACTIONS,
-- keep both lists equal).
local SERVER_MENU_ACTIONS = {
	["txr_mines.func_prox_plant"] = true,
	["txr_mines.func_timer_plant_10"] = true,
	["txr_mines.func_timer_plant_30"] = true,
	["item_device.func_battery"] = true, -- take the battery out of a device
}

local function section_has_functor(section, functor)
	for i = 1, 10 do
		local value = ini_sys:r_string_ex(section, "use" .. i .. "_action_functor")
		if value and value == functor then return true end
	end
	return false
end

-- item_device's drag-and-drop of a battery on a device, with alife().
local function battery_swap(battery, device)
	local dev = item_device
	if not (dev and dev.device_battery and dev.dev_consumption and dev.dev_critical) then return "devices are not loaded" end
	local sec_b, sec_d = battery:section(), device:section()
	if sec_b ~= dev.device_battery or not dev.dev_consumption[sec_d] then return "this battery does not fit" end
	local con_b, con_d = battery:condition(), device:condition()
	if con_d > con_b then return game.translate_string("ui_st_battery_more_power") end
	if con_d > (dev.dev_critical[sec_d] or 0) then
		alife_create_item(dev.device_battery, db.actor, { cond = con_d })
	end
	alife_release(battery)
	device:set_condition(con_b)
	printf("[Lost Zone] battery %s (%s) -> %s (was %s)", sec_b, con_b, sec_d, con_d)
	return ""
end

-- item_repair's repair window, computed by the server from the kit's
-- settings (the client only chooses kit, item and optional part). Same
-- formula as UIRepair:OnItemSelect and the GAMMA OnRepair override.
local REPAIR_DEGRADE = 0.2 -- item_repair's local degrade_factor

local function repair(actor_id, kit, target, part)
	local sec = kit:section()
	if not IsItem("repair", sec) then return "not a repair kit" end
	local repair_only = parse_list(ini_sys, sec, "repair_only", true)
	local main_section = ini_sys:r_string_ex(target:section(), "repair_type") or target:section()
	if not (repair_only and repair_only[main_section]) then return "this kit does not repair this item" end
	local con = math.ceil(target:condition() * 100)
	local min_c = ini_sys:r_float_ex(sec, "repair_min_condition") or 0
	local max_c = ini_sys:r_float_ex(sec, "repair_max_condition") or 0
	if con < min_c * 100 or con > max_c * 100 then return "the item's condition is outside this kit's range" end
	local bonus = 0
	if part then
		local holder = part:parent()
		if not (holder and holder:id() == actor_id) then return "the part is not in your inventory" end
		if part:id() == target:id() or part:id() == kit:id() then return "invalid part" end
		if not ini_sys:r_bool_ex(sec, "repair_use_parts", false) then return "this kit uses no parts" end
		local match = ini_sys:r_bool_ex(sec, "repair_parts_match", false) and part:section() == target:section()
		local parts = parse_list(ini_sys, sec, "repair_parts_sections", true)
		if not match and not (parts and parts[part:section()]) then return "this part does not fit" end
		bonus = match and part:condition() or ini_sys:r_float_ex(part:section(), "repair_part_bonus")
			or ini_sys:r_float_ex(sec, "repair_part_bonus") or 0
		if game_achievements and game_achievements.has_achievement("mechanized_warfare") then bonus = bonus + 0.02 end
		bonus = clamp(math.floor(bonus * 100) * (ini_sys:r_float_ex(sec, "repair_parts_multi") or 1), 0, 100)
	end
	local result = clamp(con + bonus + math.floor((ini_sys:r_float_ex(sec, "repair_add_condition") or 0) * 100), 0, 100)
	if IsItem("part", nil, target) then result = utils_item.get_cond_static(result) end
	local before = target:condition()
	target:set_condition(result / 100)
	if part then utils_item.discharge(part) end
	if IsItem("multiuse", nil, kit) then utils_item.discharge(kit) else utils_item.degrade(kit, REPAIR_DEGRADE) end
	if game_statistics and game_statistics.increment_statistic then pcall(game_statistics.increment_statistic, "self_repairs") end
	printf("[Lost Zone] repair %s with %s: %s -> %s", target:section(), sec, before, result / 100)
	return ""
end

----------------------------------------------------------------------
-- Player-owned objects: furniture and backpack stashes (owner 2026-10-05)
----------------------------------------------------------------------
-- GAMMA places furniture and makes stashes in Lua with alife(), which a
-- client does not have: nothing was ever created on the server. Clients now
-- ask (netcoop_client_compat), the server checks and creates, and records
-- the owner in the world's script state (saved with the world, W1):
--   netcoop_owned[id] = { owner = login, kind = "furniture"|"stash",
--                         name = text, section = item to give back, access = { login = true } }
-- Only the owner (and players on the object's access list) may open,
-- pick up or use an owned object. Furniture goes indoors only, never into
-- safe zones (trader rooms, faction bases).
local FURNITURE_REACH = 6
local ROOF_RANGE = 15 -- an indoor spot has static geometry above within this
-- Safe zones: restrictors whose names match, and areas around these NPCs.
local SAFE_ZONE_PATTERNS = { "_no_assault", "_no_weapon", "safe_zone", "_sr_safe" }
local SAFE_STORY_NPCS = { -- story id = radius, m
	esc_2_12_stalker_trader = 25, -- Sidorovich's bunker
	bar_visitors_barman_stalker_trader = 45, -- the 100 Rads bar
	mar_base_owl_stalker_trader = 45, -- Clear Sky base, Swamps
	mar_base_stalker_tech = 45,
	mar_base_stalker_barmen = 45,
	zat_a2_stalker_barmen = 45, -- Skadovsk
	jup_a6_stalker_barmen = 45, -- Yanov
	bar_dolg_leader = 30,
	mil_smart_terrain_7_7_freedom_leader_stalker = 30,
}
-- Safe zones that are a faction's base (doc 47 section 6): there the leader, the
-- deputies and members the leader allowed place furniture and items freely
-- (indoors or not). A restrictor zone belongs to the base of the nearest of
-- these within 150 m.
local SAFE_ZONE_FACTION = {
	mar_base_owl_stalker_trader = "csky",
	mar_base_stalker_tech = "csky",
	mar_base_stalker_barmen = "csky",
	bar_dolg_leader = "dolg",
	mil_smart_terrain_7_7_freedom_leader_stalker = "freedom",
}
local sent_spots = {} -- actor id -> true once its stash spots were sent

local function owned()
	local state = alife_storage_manager.get_state()
	state.netcoop_owned = state.netcoop_owned or {}
	return state.netcoop_owned
end

function can_access(object_id, login)
	local entry = owned()[object_id]
	if not entry then return true end
	return entry.owner == login or (entry.access ~= nil and entry.access[login] == true)
end

local function indoor(pos)
	if not ray_pick then return true end
	local rq = ray_pick()
	rq:set_position(vector():set(pos.x, pos.y + 0.3, pos.z))
	rq:set_direction(vector():set(0, 1, 0))
	rq:set_range(ROOF_RANGE)
	rq:set_flags(rq_target.rqtStatic)
	return rq:query()
end

local function in_safe_zone(pos)
	for name, zone in pairs(db.zone_by_name or {}) do
		for _, pattern in ipairs(SAFE_ZONE_PATTERNS) do
			if string.find(name, pattern, 1, true) and zone.inside and zone:inside(pos) then return name end
		end
	end
	for story_id, radius in pairs(SAFE_STORY_NPCS) do
		local npc = get_story_object and get_story_object(story_id)
		if npc and npc:position():distance_to(pos) <= radius then return story_id end
	end
	return nil
end

-- A fresh body returns to the closest service/safe area on this level.
-- Choose actual walkable vertices around the NPC instead of spawning in
-- its model or behind a counter. The engine applies crowd separation too.
function respawn_point(origin)
 local best,distance
 local function consider(vertex,accept)
  if not level.valid_vertex(vertex) then return end
  for _,angle in ipairs({0,90,180,270,45,135,225,315}) do
   local near=level.vertex_in_direction(vertex,vector():setHP(angle*math.pi/180,0),4)
   if near and level.valid_vertex(near) then
    local pos=level.vertex_position(near)
    if not accept or accept(pos) then
     local d=pos:distance_to_sqr(origin)
     if not distance or d<distance then best,distance=pos,d end
    end
   end
  end
 end
 for name,zone in pairs(db.zone_by_name or {}) do
  local safe=false
  for _,pattern in ipairs(SAFE_ZONE_PATTERNS) do if name:find(pattern,1,true) then safe=true end end
  if safe and zone.position and zone.inside and level.vertex_id then
   consider(level.vertex_id(zone:position()),function(pos)return zone:inside(pos) end)
  end
 end
 for story_id,radius in pairs(SAFE_STORY_NPCS) do
  local npc=get_story_object and get_story_object(story_id)
  if npc then consider(npc:level_vertex_id(),function(pos)return pos:distance_to(npc:position())<=radius end) end
 end
 if best then return best end
 -- Some maps have no authored safe restrictor: use their service NPC.
 for _,storage in pairs(db.storage or {}) do
  local npc=storage.object
  if npc and npc.alive and npc:alive() and netcoop_traders and netcoop_traders.is_service_npc(npc) then consider(npc:level_vertex_id()) end
 end
 if best then return best end
 local anchor=alife() and alife():actor()
 return anchor and anchor.position or origin
end


local function zone_faction(pos)
	local best, best_d
	for story_id, faction in pairs(SAFE_ZONE_FACTION) do
		local npc = get_story_object and get_story_object(story_id)
		local d = npc and npc:position():distance_to(pos)
		if d and d <= 150 and (not best_d or d < best_d) then best, best_d = faction, d end
	end
	return best
end

local function furniture_forbidden(pos, actor)
	local zone = in_safe_zone(pos)
	if zone then
		local faction = zone_faction(pos)
		if faction and actor and netcoop_factions and netcoop_factions.may_place_in_zone(actor, faction) then return nil end
		return "furniture cannot be placed in a safe zone (" .. zone .. ")"
	end
	if not indoor(pos) then return "furniture can be placed only indoors" end
	return nil
end

local function send_stash_spot(actor_id, id, name)
	if netcoop_send_to_actor then netcoop_send_to_actor(actor_id, "stash_spot", tostring(id) .. "|" .. tostring(name)) end
end

local function furniture_place(actor, item, args, login)
	local x, y, z, h, p, b = string.match(args or "", "^(%S+) (%S+) (%S+) (%S+) (%S+) (%S+)$")
	x, y, z, h, p, b = tonumber(x), tonumber(y), tonumber(z), tonumber(h), tonumber(p), tonumber(b)
	if not (x and y and z and h and p and b) then return "bad placement" end
	local pos = vector():set(x, y, z)
	if pos:distance_to(actor:position()) > FURNITURE_REACH then return "too far to place" end
	local section = ini_sys:r_string_ex(item:section(), "placeable_section")
	if not section then return "this item is not furniture" end
	local why = furniture_forbidden(pos, actor)
	if why then return why end
	local pf = placeable_furniture
	if not (pf and pf.create_object) then return "furniture is not loaded on the server" end
	local id = pf.create_object(section, pos, vector():set(h, p, b), actor:level_vertex_id(), actor:game_vertex_id())
	if not id then return "could not place" end
	pf.transfer_item_data(item:id(), id)
	owned()[id] = { owner = login, kind = "furniture", section = item:section(), access = {} }
	alife_release(item)
	SendScriptCallback("hf_on_furniture_place", id)
	printf("[Lost Zone][furniture] %s placed %s (%s) at %s %s %s", login, section, id, x, y, z)
	return ""
end

local function furniture_pickup(actor, obj, login)
	local entry = owned()[obj:id()]
	if entry and entry.owner ~= login then return "only the player who placed it can pick it up" end
	local wrapper = bind_hf_base and bind_hf_base.get_wrapper(obj:id())
	if not wrapper then return "this is not furniture" end
	if not wrapper:is_pickupable() then return "this cannot be picked up" end
	if obj:clsid() == clsid.inventory_box and not obj:is_inv_box_empty() then return "empty it first" end
	wrapper:pickup()
	owned()[obj:id()] = nil
	printf("[Lost Zone][furniture] %s picked up %s (%s)", login, obj:section(), obj:id())
	return ""
end

local function new_stash(actor, item_section, name, login)
	local pos, lvid, gvid = actor:position(), actor:level_vertex_id(), actor:game_vertex_id()
	if netcoop_ground then pos, lvid, gvid = netcoop_ground.safe_point(pos, lvid, gvid) end -- doc 43 L11
	local se = alife_create("inv_backpack", pos, lvid, gvid)
	if not se then return nil end
	if not name or name == "" then
		name = strformat(game.translate_string("st_itm_stash_of_character"), actor:character_name())
	end
	local state = alife_storage_manager.get_state()
	state.player_created_stashes = state.player_created_stashes or {}
	state.player_created_stashes[se.id] = item_section
	owned()[se.id] = { owner = login, kind = "stash", name = name, section = item_section, access = {} }
	SendScriptCallback("actor_on_stash_create", { stash_id = se.id, stash_name = name, stash_section = item_section })
	send_stash_spot(actor:id(), se.id, name)
	printf("[Lost Zone][stash] %s made stash %s '%s'", login, se.id, name)
	return se
end

-- A stash item (item_backpack's UICreateStash): a stash at the player.
local function stash_create(actor, item, name, login)
	name = string.sub(string.gsub(name or "", "[|%c]", ""), 1, 40)
	if not new_stash(actor, item:section(), name, login) then return "could not make a stash" end
	alife_release(item)
	return ""
end

-- The worn backpack used (itm_actor_backpack): a stash with the rucksack's
-- contents, as item_backpack.actor_on_item_use does.
local function backpack_deploy(actor, login)
	local backpack = actor:item_in_slot(13)
	if not backpack then return "no backpack is worn" end
	local se = new_stash(actor, backpack:section(), nil, login)
	if not se then return "could not make a stash" end
	local backpack_id = backpack:id()
	alife_release(backpack)
	local keep = {}
	local ini = ini_file("items\\settings\\backpack_stash.ltx")
	if ini and utils_data then keep = utils_data.collect_section(ini, "actor_backpack_keep_items", true) or {} end
	local actor_id = actor:id()
	CreateTimeEvent("netcoop_backpack", tostring(se.id), 0, function(stash_id)
		local box, owner = level.object_by_id(stash_id), level.object_by_id(actor_id)
		if not (box and owner) then return false end
		owner:iterate_inventory(function(_, it)
			if it and it:id() ~= backpack_id and keep[it:section()] == nil
				and not (IsAmmo(it) and item_backpack and item_backpack.is_ammo_for_wpn and item_backpack.is_ammo_for_wpn(it:section()))
				and ini_sys:r_string_ex(it:section(), "kind") ~= "i_medical"
				and not ini_sys:r_bool_ex(it:section(), "quest_item", false)
				and not owner:is_on_belt(it) and not (item_backpack and item_backpack.is_in_slot and item_backpack.is_in_slot(it)) then
				owner:transfer_item(it, box)
			end
		end)
		return true
	end, se.id)
	return ""
end

-- Engine (netcoop_transfer.inc) after something was taken from a box.
function on_box_changed(box_id, actor_id)
	local box = level.object_by_id(box_id)
	local entry = owned()[box_id]
	if not (box and entry and entry.kind == "stash" and box:section() == "inv_backpack" and box:is_inv_box_empty()) then return end
	local actor = level.object_by_id(actor_id)
	if actor and entry.section and ini_sys:section_exist(entry.section) then alife_create_item(entry.section, actor) end
	local state = alife_storage_manager.get_state()
	if state.player_created_stashes then state.player_created_stashes[box_id] = nil end
	owned()[box_id] = nil
	if netcoop_send_to_actor then netcoop_send_to_actor(actor_id, "stash_spot_remove", tostring(box_id)) end
	alife_release(alife_object(box_id))
	printf("[Lost Zone][stash] stash %s emptied and packed up", box_id)
end

-- Access list of an owned object: "access_add <login>" / "access_remove <login>".
local function access_change(obj, args, login)
	local entry = owned()[obj:id()]
	if not entry then return "nobody owns this" end
	if entry.owner ~= login then return "only the owner can change who may use this" end
	local op, who = string.match(args or "", "^(%S+) (%S+)$")
	if not who or #who > 40 then return "bad name" end
	entry.access = entry.access or {}
	entry.access[who] = (op == "add") and true or nil
	printf("[Lost Zone][furniture] %s %s access to %s for %s", login, op, obj:id(), who)
	return ""
end

-- Owners see their stashes on the PDA map, also after reconnecting.
-- The client's own saved state goes back to it once the character was
-- fully restored; elapsed time alone is not proof that it is ready.
send_player_state = function(actor_id)
	if state_sent[actor_id] == true then return end
	local now = time_global()
	if state_sent[actor_id] and now - state_sent[actor_id] < 2000 then return end
	first_seen[actor_id] = first_seen[actor_id] or time_global()
    if not restored_players[actor_id] then return end
	state_sent[actor_id] = now
	local st = db.storage[actor_id]
	local saved = st and st.pstor and st.pstor.netcoop_player_state
	netcoop_send_to_actor(actor_id, "player_state", "@" .. actor_id .. "|" .. (saved or "-"))
end

function request_player_state(actor_id, verb)
	if not restored_players[actor_id] then return end
	if verb == "ack" then
		state_sent[actor_id] = true
	elseif verb == "get" and state_sent[actor_id] ~= true then
		send_player_state(actor_id)
	end
end

local function send_owner_spots()
	if not (netcoop_players and netcoop_actor_login) then return end
	local online = {}
	for id in string.gmatch(netcoop_players(), "%d+") do
		local actor_id = tonumber(id)
		online[actor_id] = true
		send_player_state(actor_id)
		if not sent_spots[actor_id] then
			sent_spots[actor_id] = true
			local login = netcoop_actor_login(actor_id)
			for stash_id, entry in pairs(owned()) do
				if entry.kind == "stash" and entry.owner == login and alife_object(stash_id) then
					send_stash_spot(actor_id, stash_id, entry.name or "")
				end
			end
		end
	end
	for actor_id in pairs(sent_spots) do if not online[actor_id] then sent_spots[actor_id] = nil end end
	for actor_id in pairs(state_sent) do
		if not online[actor_id] then state_sent[actor_id], first_seen[actor_id], restored_players[actor_id] = nil, nil, nil end
	end
end

local next_spot_scan = 0
function owned_objects_update()
	if time_global() < next_spot_scan then return end
	next_spot_scan = time_global() + 1000
	pcall(send_owner_spots)
end

----------------------------------------------------------------------
-- World stashes change slowly (owner 2026-10-05, doc 43 L14/L37)
----------------------------------------------------------------------
-- Now and then a stalker near a world stash takes something from it or
-- puts something of his own into it. Nothing is created or destroyed: the
-- items move with their identity (the same transfer events as a player's),
-- so the loot a player finds later really came from someone. Rules match
-- the world backend (backend/lostzone/scavenging.py): at most one visit per
-- stash in 6 game hours, 8 % chance per look, deposits never weapons,
-- armour or artefacts. Happens only with an NPC within reach of the box
-- and no player close enough to watch; player stashes, story and closed
-- boxes are never touched.
local STASH_VISIT = {
	check_ms = 600000, -- real time between looks at the stashes
	min_game_hours = 6,
	chance = 0.08,
	npc_reach = 2, -- actual interaction reach; never move loot across 60 metres
	player_clear = 50, -- no player this close
	max_items = 2,
	deposit_kinds = { i_food = true, i_drink = true, i_medical = true, i_mutant_raw = true, i_mutant_part = true,
		i_misc = true, i_tool = true, i_kit = true, i_arty_junk = false },
}
local stash_boxes, stash_scan_at, next_stash_look = nil, 0, 0

local function visit_state()
	local state = alife_storage_manager.get_state()
	state.netcoop_stash_visits_v2 = state.netcoop_stash_visits_v2 or {}
	return state.netcoop_stash_visits_v2
end

local function game_hours()
	return hours_since_2012()
end

-- World stash ids, rebuilt every game hour (boxes are few and static).
local function world_stash_ids()
	if stash_boxes and time_global() < stash_scan_at then return stash_boxes end
	stash_scan_at = time_global() + 3600000
	stash_boxes = {}
	local sim = alife()
	if not sim then return stash_boxes end
	for id = 1, 65534 do
		local se = sim:object(id)
		if se and se:clsid() == clsid.inventory_box then stash_boxes[#stash_boxes + 1] = id end
	end
	return stash_boxes
end

local function protected_box(box)
	local id = box:id()
	if owned()[id] then return true end -- a player's stash or furniture
	if get_object_story_id and get_object_story_id(id) then return true end
	local m = alife_storage_manager.get_state()
	if m.player_created_stashes and m.player_created_stashes[id] then return true end
	return box.inventory_box_closed ~= nil and box:inventory_box_closed() == true
end

local function deposit_allowed(item)
	local sec = item:section()
	if ini_sys:r_bool_ex(sec, "quest_item", false) then return false end
	if IsWeapon(item) or IsOutfit(item) or IsHeadgear(item) or IsArtefact(item) then return false end
	if IsAmmo(item) then return true end
	return STASH_VISIT.deposit_kinds[ini_sys:r_string_ex(sec, "kind") or ""] == true
end

local function take_allowed(item)
	return not ini_sys:r_bool_ex(item:section(), "quest_item", false)
end

local function players_near(pos, radius)
	for id in string.gmatch(netcoop_players and netcoop_players() or "", "%d+") do
		local actor = level.object_by_id(tonumber(id))
		if actor and actor:position():distance_to(pos) <= radius then return true end
	end
	return false
end

local function visitor_near(box)
	local best, best_d = nil, STASH_VISIT.npc_reach
	for _, id in ipairs(db.OnlineStalkers or {}) do
		local npc = level.object_by_id(id)
		if npc and npc:alive() and IsStalker(npc) and not npc:best_enemy() and not npc:wounded()
			and not npc:critically_wounded() and not (get_object_story_id and get_object_story_id(id))
			and not (axr_companions and axr_companions.non_task_companions and axr_companions.non_task_companions[id]) then
			local d = npc:position():distance_to(box:position())
			if d < best_d then best, best_d = npc, d end
		end
	end
	return best
end

-- FactionAccessible (doc 43 L15): a world box at a faction's base (a smart
-- terrain with base props within 60 m) belongs to the faction holding that
-- base; only its own NPCs visit it. nil: anyone may.
local BASE_REACH = 60
local base_owner_cache = {} -- box id -> { faction or false, at }
local function base_faction(box)
	local id = box:id()
	local c = base_owner_cache[id]
	if c and time_global() - c.at < 600000 then return c.faction or nil end
	local best, best_d = nil, BASE_REACH
	local pos = box:position()
	local board = SIMBOARD and SIMBOARD.smarts
	for _, v in pairs(board or {}) do
		local smart = v.smrt
		if smart and smart.props and (smart.props.base or 0) > 0 and smart.position
			and game_graph and game_graph():vertex(smart.m_game_vertex_id):level_id() == game_graph():vertex(box:game_vertex_id()):level_id() then
			local d = smart.position:distance_to(pos)
			if d < best_d then best, best_d = smart, d end
		end
	end
	local faction = best and (best.faction or best.default_faction) or false
	base_owner_cache[id] = { faction = faction, at = time_global() }
	return faction or nil
end

-- One look at one stash; returns what happened (for the log and tests).
function stash_visit(box, roll)
	if not box or protected_box(box) then return "protected" end
	local visits = visit_state()
	local now = game_hours()
	local last = visits[box:id()]
	-- Older saves used a fictitious 31-day calendar. Migrate conservatively:
	-- retain their visit evidence and wait one real cooldown after conversion.
	local legacy = alife_storage_manager.get_state().netcoop_stash_visits
	if last == nil and legacy and legacy[box:id()] ~= nil then
		visits[box:id()] = now
		return "too soon"
	end
	if last and now - last < STASH_VISIT.min_game_hours then return "too soon" end
	if players_near(box:position(), STASH_VISIT.player_clear) then return "watched" end
	local npc = visitor_near(box)
	if not npc then return "nobody near" end
	local owner = base_faction(box)
	if owner and character_community and character_community(npc) ~= owner then return "faction stash" end
	if players_near(npc:position(), STASH_VISIT.player_clear) then return "watched" end
	-- Persist an eligible attempt, including a failed roll/empty inventory.
	-- Otherwise restart or the next scan rerolls the same opportunity until
	-- the nominally rare visit succeeds. Watched/protected/busy boxes do not
	-- consume an opportunity: no NPC could interact with them in that case.
	visits[box:id()] = now
	if roll() >= STASH_VISIT.chance then return "no visit" end
	local in_box, on_npc = {}, {}
	box:iterate_inventory_box(function(_, item) if item and take_allowed(item) then in_box[#in_box + 1] = item end end, box)
	npc:iterate_inventory(function(_, item)
		if item and deposit_allowed(item) and not npc:is_on_belt(item) then on_npc[#on_npc + 1] = item end
	end, npc)
	local deposit = #on_npc > 0 and (#in_box == 0 or roll() < 0.5)
	local from, list = deposit and npc or box, deposit and on_npc or in_box
	if #list == 0 then return "nothing to move" end
	local moved = 0
	for _ = 1, math.min(STASH_VISIT.max_items, #list) do
		local index = math.floor(roll() * #list) + 1
		local item = table.remove(list, index)
		if deposit then from:transfer_item(item, box) else box:transfer_item(item, npc) end
		moved = moved + 1
	end
	printf("[Lost Zone][stash] %s %s %s item(s) %s stash %s", npc:name(), deposit and "put" or "took", moved,
		deposit and "into" or "from", box:id())
	return deposit and "deposit" or "take"
end

function stash_visits_update()
	if time_global() < next_stash_look then return end
	next_stash_look = time_global() + STASH_VISIT.check_ms
	for _, id in ipairs(world_stash_ids()) do
		local box = level.object_by_id(id) -- online boxes only: near players, never watched
		if box then pcall(stash_visit, box, math.random) end
	end
end


----------------------------------------------------------------------
-- Simulation radius above the observable distance (doc 43 C07/E21)
----------------------------------------------------------------------
-- An NPC exists for the clients only while ALife keeps it online, within
-- switch_distance of the nearest player. GAMMA's 450 m let NPCs appear at
-- ~405 m, inside what a player sees in the open or through a scope. The
-- netcoop server keeps them online to 650 m; beyond 250 m they think at the
-- reduced rate (CCustomMonster::shedule_Scale), the cheap "Reduced" level.
-- xr_patch sets its own value on load; it is put back after it.
local WORLD_SWITCH_DISTANCE = 650
local next_switch_check = 0

function keep_switch_distance()
	if time_global() < next_switch_check then return end
	next_switch_check = time_global() + 10000
	local sim = alife()
	if sim and sim.switch_distance and math.abs(sim:switch_distance() - WORLD_SWITCH_DISTANCE) > 1 then
		sim:set_switch_distance(WORLD_SWITCH_DISTANCE)
		printf("[Lost Zone][world] ALife switch distance %s m", tostring(WORLD_SWITCH_DISTANCE))
	end
end

function item_action(actor_id, kind, item_id, target_id, action, login)
	local item = level.object_by_id(item_id)
	local target = target_id ~= 65535 and level.object_by_id(target_id) or nil
	if not item or (target_id ~= 65535 and not target) then return "item is not available" end
	if kind == 0 then
		if not SERVER_MENU_ACTIONS[action] then return "this action is not run by the server" end
		if not section_has_functor(item:section(), action) then return "this item has no such action" end
		if string.sub(action, 1, 10) == "txr_mines." then return netcoop_mines.plant(actor_id, item, action, login) end
		local module, name = string.match(action, "^([%w_]+)%.([%w_]+)$")
		local fn = module and _G[module] and _G[module][name]
		if type(fn) ~= "function" then return "action is not loaded on the server" end
		local ok, err = pcall(fn, item)
		if not ok then printf("! [Lost Zone] item action %s failed: %s", action, tostring(err)); return "server script error" end
		return ""
	elseif kind == 1 and action == "battery_swap" and target then
		return battery_swap(item, target)
	elseif kind == 1 and string.match(action, "^furniture_place ") then
		return furniture_place(level.object_by_id(actor_id), item, string.sub(action, 17), login or "")
	elseif kind == 1 and string.match(action, "^stash_create") then
		return stash_create(level.object_by_id(actor_id), item, string.sub(action, 14), login or "")
	elseif kind == 1 and action == "backpack_deploy" then
		return backpack_deploy(level.object_by_id(actor_id), login or "")
	elseif kind == 2 and string.match(action, "^mloot_") then
		return netcoop_mutant_loot.action(level.object_by_id(actor_id), item, action) or "unknown item action"
	elseif kind == 2 and action == "furniture_pickup" then
		return furniture_pickup(level.object_by_id(actor_id), item, login or "")
	elseif kind == 2 and string.match(action, "^access ") then
		return access_change(item, string.sub(action, 8), login or "")
	elseif kind == 1 and (action == "arty_pack" or action == "arty_unpack" or action == "combine" or action == "package" or string.match(action, "^withdraw %d+$")) then
		if target and item_id == target_id then return "invalid target" end
		return netcoop_item_use.container_action(action, item, target) or "unknown item action"
	elseif (kind == 1 or kind == 2) and string.match(action, "^craft %d+ %d+$") and not target then
		-- workshop crafting from a toolkit (1) or a vise / furniture workshop nearby (2)
		return netcoop_workshop.craft(actor_id, kind, item, action)
	elseif kind == 2 and string.match(action, "^m%a+ %d+") and not target then
		-- a mechanic NPC nearby: repair, upgrades (GAMMA's "repair" window)
		return netcoop_workshop.mechanic(actor_id, item, action)
	elseif kind == 1 and string.match(action, "^wpart_") then
		-- weapon/outfit parts: maintenance, field strip, a part dragged onto the item
		if target and item_id == target_id then return "invalid target" end
		return netcoop_weapon_parts.action(actor_id, item, target, action)
	elseif kind == 1 and action == "disassemble" and target then
		if item_id == target_id then return "invalid target" end
		return netcoop_workshop.disassemble(item, target)
	elseif kind == 1 and string.match(action, "^upgrade %d+ [%d%. ]+$") and not target then
		return netcoop_workshop.upgrade(actor_id, item, action)
	elseif kind == 1 and action == "recipe_read" and not target then
		return netcoop_workshop.read_recipe(actor_id, item)
	elseif kind == 1 and target and string.match(action, "^repair %d+$") then
		local part_id = tonumber(string.match(action, "%d+"))
		local part = part_id ~= 65535 and level.object_by_id(part_id) or nil
		if part_id ~= 65535 and not part then return "the part is not available" end
		return repair(actor_id, item, target, part)
	end
	return "unknown item action"
end
