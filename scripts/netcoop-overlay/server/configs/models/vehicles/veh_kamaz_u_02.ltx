;------ Gearbox ----------------------------------------------------------------

main_gear_ratio    		= 23.2         ; Передаточное отношение
auto_transmission  		= on            ; Автоматическая коробка (on/off)

[transmission_gear_ratio]
										; shift down/ shift up. (rpm, необходимое для переключения)
R	= 3.60, 1700, 3890	
N1	= 3.60, 1700, 3890
N2	= 1.87, 1700, 3890
N3	= 1.11, 1800, 3890
N4	= 0.72, 1900, 3890

