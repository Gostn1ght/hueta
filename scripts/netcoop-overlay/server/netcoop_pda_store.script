-- Map pins travel with the physical PDA's persistent item UID.
local CHUNK, MAX_HEX = 3000, 2 * 65536
local pending = {}

local function device(id)
 local char = netcoop_actor_character and netcoop_actor_character(id) or ""
 if char == "" or not netcoop_pdanet then return nil end
 local d = netcoop_pdanet.held_device(id, char)
 if not d or (not d.own and not d.rec.hacked[char]) or netcoop_pdanet.is_locked(id, d.uid) then return nil end
 return d, char
end

local function store(bucket, key, data)
 for _ = 1, 8 do
  local old = netcoop_store_read(bucket, key) or ""
  if netcoop_store_swap(bucket, key, old, data) then return true end
 end
 return false
end

-- Migrate legacy character pins once, to the first owned PDA that asks.
-- A replacement device must not inherit the previous device's map.
local function saved(d, char)
 local data = netcoop_store_read("pda_marks", d.uid) or ""
 if netcoop_store_read("pda_marks_ready",d.uid)=="1" then return data end
 local claim=netcoop_store_read("pda_profile_migrated",char) or ""
 if claim=="" then claim=netcoop_store_read("pda_migrated",char) or "" end
 if claim=="" and netcoop_store_swap("pda_migrated",char,"",d.uid) then claim=d.uid end
 local legacy=claim==d.uid and (netcoop_store_read("pda",char) or "") or ""
 if data=="" and legacy~="" then
  if not store("pda_marks",d.uid,legacy) then return nil end
  data=legacy
 end
 if not store("pda_marks_ready",d.uid,"1") then return nil end
 return data
end

function command(id, args)
 local d, char = device(id)
 if not d then pending[id] = nil; netcoop_send_to_actor(id, "pda", "none"); return "" end
 local verb, rest = string.match(args or "", "^(%S+)%s*(.*)$")
 if verb == "get" then
  local data = saved(d, char)
  if data == nil then return "" end
  local total = math.max(1, math.ceil(#data / CHUNK))
  for n = 1, total do
   netcoop_send_to_actor(id, "pda", d.uid .. "|" .. d.item .. "|" .. n .. "/" .. total .. "|" .. string.sub(data, (n-1)*CHUNK+1, n*CHUNK))
  end
 elseif verb == "put" then
  local uid, n, total, hex = string.match(rest, "^(%S+) (%d+) (%d+) (%x*)$")
  n, total = tonumber(n), tonumber(total)
  if uid ~= d.uid or not (n and total and total >= 1 and n >= 1 and n <= total and (total-1)*CHUNK < MAX_HEX and #hex <= CHUNK) then return "" end
  local p = pending[id]
  if n == 1 or not p or p.uid ~= uid or p.total ~= total then p = {uid=uid,total=total,parts={}}; pending[id] = p end
  p.parts[n] = hex
  for i = 1, total do if not p.parts[i] then return "" end end
  pending[id] = nil
  local data = table.concat(p.parts)
  if #data <= MAX_HEX and #data % 2 == 0 and store("pda_marks", uid, data) then netcoop_send_to_actor(id, "pda", uid .. "|saved") end
 end
 return ""
end
