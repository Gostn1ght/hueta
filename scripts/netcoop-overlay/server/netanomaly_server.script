-- Lost Zone: server-side player/admin commands.
--
-- Engine entry point (xrServer.cpp M_NETANOMALY_CMD, console "sv_cmd"):
--   on_client_command(cid, name, entity_id, text, role) -> reply string
-- role comes from the account bound to the connection by the engine
-- ("admin", "player"); the local server console is always "admin".
-- Clients reach this with netcoop_command(text) or the console "srv <text>".

local HELP_PLAYER = table.concat({
	"~ commands: help, whoami, money",
}, "\n")

local HELP_ADMIN = table.concat({
	"~ commands: help, whoami, money",
	"~ registration is open: no administrator approval required",
	"~          spawn <section> [count]           - into own inventory",
	"~          spawn_at <section> <x> <y> <z>    - in the world",
	"~          give_money <amount>               - change own balance",
	"~          find <text> [limit]               - search sections",
	"~          weather <name> [now]              - weather for everyone (now = no transition)",
	"~          emission start                    - start a shared emission",
	"~          cmd <console command>             - run on the server",
	"~          lua <code>                        - run Lua on the server (debug)",
	"~          faction pardon <login>_<slot>     - a renegade becomes a loner, bounty cleared",
}, "\n")

local function server_actor(entity_id)
	if not entity_id or entity_id == 65535 then return nil, nil end
	local obj = level.object_by_id(entity_id)
	local se = alife():object(entity_id)
	return obj, se
end

-- A door a player used (netcoop_client_compat): its logic runs here (ph_door
-- toggles it for any user), every client sees it move and the other players
-- the hand reaching for it (netcoop_consumption, mod_system_lz_nw_gestures).
local DOOR_REACH, DOOR_EVERY = 3.5, 600
local door_next = {}
local function use_door(entity_id, args)
	local obj = server_actor(entity_id)
	local id = tonumber(args)
	local door = id and id >= 0 and id < 65535 and level.object_by_id(id)
	if not (obj and obj:alive() and door and db.level_doors and db.level_doors[id]) then return end
	if obj:position():distance_to(door:position()) > DOOR_REACH then return end
	local now = time_global()
	if now < (door_next[entity_id] or 0) then return end
	door_next[entity_id] = now + DOOR_EVERY
	door:use(obj)
	if netcoop_broadcast then
		netcoop_broadcast("netcoop_consumption", string.format("%d|255|%s|anim_door_open", entity_id, obj:name()))
	end
end

-- Drivable cars (doc 100) have a cost too, but stand in the world.
local VEHICLE_CLASSES = { SCRPTCAR = true, C_NIVA = true }
local function is_vehicle_section(section)
	return VEHICLE_CLASSES[ini_sys:r_string_ex(section, "class") or ""] == true
end

local function is_item_section(section)
	-- Items have an inventory cost; creatures, squads and props do not.
	return ini_sys:line_exist(section, "cost") and not ini_sys:line_exist(section, "npc_in_squad")
		and not is_vehicle_section(section)
end

local function spawn_items(entity_id, section, count)
	local obj, se = server_actor(entity_id)
	if not (obj and se) then return "! your Actor is not on the server" end
	local made = 0
	for _ = 1, count do
		if alife():create(section, obj:position(), obj:level_vertex_id(), obj:game_vertex_id(), entity_id) then
			made = made + 1
		end
	end
	return string.format("* spawned %d x %s", made, section)
end

-- The nearest point on a ring around pos with no vehicle within 6 m, lifted
-- 0.8 m above its level vertex (the ground there).
function free_vehicle_point(pos, lvid)
	local cars = {}
	local sim = alife()
	for id = 1, 65534 do
		local o = level.object_by_id(id)
		local se = not o and sim:object(id)
		if o and is_vehicle_section(o:section()) then cars[#cars + 1] = o:position()
		elseif se and is_vehicle_section(se:section_name()) then cars[#cars + 1] = se.position end -- offline ones too
	end
	local function taken(p)
		for _, c in ipairs(cars) do if c:distance_to(p) < 6 then return true end end
		return false
	end
	local candidates = { vector():set(pos.x, pos.y, pos.z) }
	for ring = 1, 3 do
		for k = 0, 7 do
			local a = k * math.pi / 4
			candidates[#candidates + 1] = vector():set(pos.x + math.cos(a) * 6 * ring, pos.y, pos.z + math.sin(a) * 6 * ring)
		end
	end
	for _, p in ipairs(candidates) do
		local v = level.vertex_id(p)
		if v and v < 4294967295 then
			local ground = level.vertex_position(v)
			local at = vector():set(p.x, math.max(p.y, ground.y) + 0.8, p.z)
			if not taken(at) then return at, v end
		end
	end
	local ground = lvid and lvid < 4294967295 and level.vertex_position(lvid) or pos
	return vector():set(pos.x, math.max(pos.y, ground.y) + 0.8, pos.z), lvid
end

local function spawn_world(entity_id, section, x, y, z)
	local obj = server_actor(entity_id)
	local pos = vector():set(x, y, z)
	local lvid = level.vertex_id(pos)
	if not lvid or lvid >= 4294967295 then
		if not obj then return "! no valid position" end
		pos = obj:position()
		lvid = obj:level_vertex_id()
	end
	local gvid = obj and obj:game_vertex_id() or 0
	-- An item is put on the ground below the point (doc 43 L11).
	if is_item_section(section) and netcoop_ground then
		pos, lvid, gvid = netcoop_ground.safe_point(pos, lvid, gvid)
	end
	-- A vehicle stands a little above the ground and never inside another one
	-- (owner 2026-10-19: cars half in the terrain, two cars in each other -
	-- the earlier ones are saved in the world at the same spawn point).
	if is_vehicle_section(section) then
		pos, lvid = free_vehicle_point(pos, lvid)
	end
	local se = alife():create(section, pos, lvid, gvid)
	if not se then return "! cannot create " .. section end
	if is_item_section(section) and netcoop_ground then netcoop_ground.settle(se) end

	-- A squad section creates an empty group: fill it like the debug spawner.
	if se.create_npc then
		pcall(function() se:create_npc(nil, pos, lvid, gvid) end)
		pcall(function() se:set_squad_relation() end)
		pcall(function() SIMBOARD:assign_squad_to_smart(se, nil) end)
	end
	return string.format("* spawned %s at %.1f %.1f %.1f", section, pos.x, pos.y, pos.z)
end

local function find_sections(mask, limit)
	local out, n = {}, 0
	mask = string.lower(mask)
	pcall(function()
		ini_sys:section_for_each(function(section)
			if n < limit and string.find(string.lower(section), mask, 1, true) then
				n = n + 1
				out[#out + 1] = "~   " .. section
			end
		end)
	end)
	if n == 0 then return "~ nothing found" end
	return string.format("~ %d section(s):\n", n) .. table.concat(out, "\n")
end

-- Weather, emissions, psi storms, the calendar and the time scale belong to
-- the world master when there is one (owner 2026-10-23: an administrator's
-- change reached one map only). nil: no master here, the map decides itself.
local function master_order(account, order, source, target, a, b, c, d)
	if not netcoop_master.governs() then return nil end
	if netcoop_world_order and netcoop_world_order(account or "", order, source or "", target or "", a or 0, b or 0, c or 0, d or 0) then
		return "* sent to the world master: every location follows it"
	end
	return "! the world master is not reachable from this location; nothing changed"
end

-- An emission or psi storm for the whole Zone: the master's three phases
-- span the event's real length at the world's time scale.
local function master_event(account, order, module)
	local s = netcoop_master.state()
	local total = module.real_duration() * ((s and s.scale) or level.get_time_factor())
	return master_order(account, order, "", "", total / 3, total / 3, total / 3, 1)
end

function on_client_command(cid, name, entity_id, text, role)
	local admin = role == "admin"
	text = string.gsub(text or "", "^%s*(.-)%s*$", "%1")
	local cmd, args = string.match(text, "^(%S+)%s*(.*)$")
	-- Fold ASCII command names without changing bytes inside UTF-8 aliases.
	cmd = string.gsub(cmd or "help", "[A-Z]", string.lower)
	args = args or ""
	-- A client's own player state (netcoop_client_compat, every 30 s): kept in
	-- the character's pstor, saved with the character. No reply, no log line.
	if cmd == "player_state" then
		if args == "get" or args == "ack" then
			netcoop_server_compat.request_player_state(entity_id, args)
			return ""
		end
		local obj = server_actor(entity_id)
		if obj and #args < 3000 and not string.find(args, "[^%w_=;{}%.%-%+]") then
			local st = db.storage[entity_id] or { object = obj }
			db.storage[entity_id] = st
			st.pstor = st.pstor or {}
			st.pstor.netcoop_player_state = args
		end
		return ""
	end
	-- The PDA task board: NPC offers near the player and players' jobs.
	if cmd == "taskboard" then
		if netcoop_taskboard then return netcoop_taskboard.command(entity_id, args) end
		return ""
	end
	-- The player's personal PDA (map pins), in chunks: no reply, no log line.
	if cmd == "pda" then
		if netcoop_pda_store then netcoop_pda_store.command(entity_id, args) end
		return ""
	end
	-- Walkie-talkie: "radio get" / "radio <freq> <0|1>", kept with the character;
	-- the engine checks the radio item itself when relaying (netcoop_voice.inc).
	if cmd == "radio" then
		local obj = server_actor(entity_id)
		if not obj then return "" end
		local st = db.storage[entity_id] or { object = obj }
		db.storage[entity_id] = st
		st.pstor = st.pstor or {}
		local lo = ini_sys:r_float_ex("netcoop_voice", "min_freq") or 3000
		local hi = ini_sys:r_float_ex("netcoop_voice", "max_freq") or 5995
		local f, o = string.match(args, "^(%d+) ([01])$")
		if f and tonumber(f) >= lo and tonumber(f) <= hi then
			st.pstor.netcoop_radio = f .. " " .. o
		end
		local saved = st.pstor.netcoop_radio or ""
		local sf, so = string.match(saved, "^(%d+) ([01])$")
		if sf and netcoop_voice_radio_set then netcoop_voice_radio_set(entity_id, tonumber(sf), so == "1") end
		if args == "get" and sf and netcoop_send_to_actor then netcoop_send_to_actor(entity_id, "radio", saved) end
		return ""
	end
	-- Weapon/outfit parts kept by the server (netcoop_weapon_parts).
	if cmd == "wparts" then
		if netcoop_weapon_parts and server_actor(entity_id) then netcoop_weapon_parts.command(entity_id, args) end
		return ""
	end
	-- Recipes this character has learned from books (netcoop_workshop).
	if cmd == "recipes" then
		if netcoop_workshop and server_actor(entity_id) then netcoop_workshop.command(entity_id, args) end
		return ""
	end
	-- PDA network: contacts, general channel, chats (netcoop_pdanet).
	if cmd == "pdanet" then
		if netcoop_pdanet then netcoop_pdanet.command(entity_id, args) end
		return ""
	end
	if cmd == "door" then
		use_door(entity_id, args)
		return ""
	end
	-- Barter between players (netcoop_barter): no reply, the module answers.
	if cmd == "barter" then
		if netcoop_barter then netcoop_barter.command(entity_id, args) end
		return ""
	end
	printf("[Lost Zone] command '%s' from %s (%s)", cmd, tostring(name), tostring(role))

	if cmd == "help" or cmd == "?" then
		return admin and HELP_ADMIN or HELP_PLAYER

	elseif cmd == "respawn" then
		-- A dead player's client asks for a new Actor (after its countdown).
		if not entity_id or entity_id == 65535 then return "! your Actor is not on the server" end
		if netcoop_respawn and netcoop_respawn(entity_id) then return "* respawn" end
		return "! you are alive"

	elseif cmd == "whoami" then
		return string.format("~ %s, role %s, entity %s", tostring(name), tostring(role), tostring(entity_id))

	elseif cmd == "faction" or cmd == "group" then
		-- Faction membership (doc 47): apply, leave; leaders decide.
		if not netcoop_factions then return "! factions are not installed" end
		return netcoop_factions.command(server_actor(entity_id), args, admin)

	elseif cmd == "contract" or cmd == "contracts" then
		-- Faction contacts' contracts (doc 47): take/done next to the contact.
		if not netcoop_contracts then return "! contracts are not installed" end
		return netcoop_contracts.command(server_actor(entity_id), args)

	elseif cmd == "squad" then
		-- Loner squads (doc 47 stage 8): invite, accept, leave.
		if not netcoop_squads then return "! squads are not installed" end
		return netcoop_squads.command(server_actor(entity_id), args)
	elseif cmd == "bounty" or cmd == "wanted" then
		if not netcoop_ranks then return "! ranks are not installed" end
		return netcoop_ranks.command(server_actor(entity_id))

	elseif cmd == "money" then
		local obj = server_actor(entity_id)
		if not obj then return "! your Actor is not on the server" end
		return string.format("~ balance: %d RU", obj:money())
	end

	if not admin then
		return "! administrator account required"
	end

-- Compatibility reply for an obsolete moderation command.
	if cmd == "approve_registration" or cmd == "reject_registration" or cmd == "\239\240\232\237\255\242\252" or cmd == "\208\191\209\128\208\184\208\189\209\143\209\130\209\140" or cmd == "\238\242\234\235\238\237\232\242\252" or cmd == "\208\190\209\130\208\186\208\187\208\190\208\189\208\184\209\130\209\140" then
        return "* registration is open; administrator approval is no longer required"
    end

	if cmd == "faction_leader" then
		local faction, login, slot = string.match(args, "^([%w_]+)%s+([%w_.%-]+)%s*(%d*)$")
		if not faction then return "! usage: faction_leader <faction> <login> [slot]" end
		local ok, message = netcoop_factions.set_leader(faction, login, slot)
		return (ok and "* " or "! ") .. tostring(message)
	end

	if cmd == "spawn" then
		local section, count = string.match(args, "^([%w_%.%-]+)%s*(%d*)$")
		count = tonumber(count) or 1
		if not section or not ini_sys:section_exist(section) then return "! unknown section" end
		if count < 1 or count > 50 then return "! count must be 1-50" end
		if not is_item_section(section) then
			local obj = server_actor(entity_id)
			if not obj then return "! your Actor is not on the server" end
			local p = obj:position()
			if is_vehicle_section(section) then
				-- A car 5 m in front of the player, not on top of them.
				local d = obj:direction()
				return spawn_world(entity_id, section, p.x + d.x * 5, p.y + 0.5, p.z + d.z * 5)
			end
			return spawn_world(entity_id, section, p.x + 2, p.y, p.z + 2)
		end
		return spawn_items(entity_id, section, count)

	elseif cmd == "spawn_at" then
		local section, x, y, z = string.match(args, "^([%w_%.%-]+)%s+(%-?[%d%.]+)%s+(%-?[%d%.]+)%s+(%-?[%d%.]+)$")
		if not section or not ini_sys:section_exist(section) then return "! unknown section" end
		return spawn_world(entity_id, section, tonumber(x), tonumber(y), tonumber(z))

	elseif cmd == "admin_teleport" then
		local a,b,c = string.match(args, "^(%S+)%s+(%S+)%s+(%S+)$")
		local x,y,z = tonumber(a),tonumber(b),tonumber(c)
		if not x or not y or not z or x ~= x or y ~= y or z ~= z
			or math.abs(x) > 50000 or math.abs(y) > 50000 or math.abs(z) > 50000 then
			return "! usage: admin_teleport <x> <y> <z>"
		end
		return netcoop_admin_teleport(entity_id, vector():set(x,y,z))
			and "* admin teleport accepted" or "! ADMIN teleport rejected"

	elseif cmd == "noclip" or cmd == "noyclip" then
		local obj=server_actor(entity_id)
		if not obj then return "! your Actor is not on the server" end
		local st=db.storage[entity_id] or {object=obj};db.storage[entity_id]=st
		local value=args=="on" or args=="1" or (args=="" and not st.netcoop_noclip)
		if args~="" and args~="on" and args~="off" and args~="1" and args~="0" then return "! usage: noclip [on|off]" end
		if not netcoop_admin_noclip(entity_id,value) then return "! noclip rejected" end
		st.netcoop_noclip=value
		return value and "* noclip enabled" or "* noclip disabled"
	elseif cmd == "god" then
		if not entity_id or entity_id == 65535 then return "! your Actor is not on the server" end
		if args ~= "" and args ~= "on" and args ~= "off" and args ~= "1" and args ~= "0" then
			return "! usage: god [on|off]"
		end
		local value = args == "on" or args == "1" or (args == "" and not netcoop_admin_god_enabled(entity_id))
		if not netcoop_admin_god_set(entity_id, value) then return "! ADMIN Actor unavailable" end
		return value and "* god mode ON" or "* god mode OFF"

	elseif cmd == "unlimited" then
		-- Admin unlimited ammo for his own weapons (the F7 toggle).
		if not entity_id or entity_id == 65535 then return "! your Actor is not on the server" end
		local value = args == "on" or args == "1" or (args == "" and not netcoop_admin_ammo_enabled(entity_id))
		if not netcoop_admin_ammo_set(entity_id, value) then return "! ADMIN Actor unavailable" end
		return value and "* unlimited ammo ON" or "* unlimited ammo OFF"

	elseif cmd == "give_money" then
		local amount = tonumber(args)
		if not amount or amount ~= math.floor(amount) or math.abs(amount) > 100000000 then
			return "! invalid amount"
		end
		local obj = server_actor(entity_id)
		if not obj then return "! your Actor is not on the server" end
		if obj:money() + amount < 0 then return "! balance cannot become negative" end
		obj:give_money(amount)
		return string.format("* balance: %d RU", obj:money())

	elseif cmd == "emission" then
		if args ~= "start" then return "! usage: emission start" end
		local sent = master_event(name, "emission", netcoop_emission)
		if sent then return sent end
		return netcoop_emission.start() and "* emission started for all players" or "! emission already active or unavailable here"
	elseif cmd == "psi" or cmd == "psi_storm" then
		if args ~= "start" then return "! usage: psi start" end
		local sent = master_event(name, "psi_storm", netcoop_psi_storm)
		if sent then return sent end
		return netcoop_psi_storm.start() and "* psi storm started for all players" or "! psi storm already active or unavailable here"
	elseif cmd == "weather" then
		local wname, now = string.match(args, "^([%w_%.%-]+)%s*(%a*)$")
		if not wname then return "! usage: weather <name> [now]" end
		-- A short transition is the "now" of every location (netcoop_server_compat).
		local sent = master_order(name, "weather", netcoop_server_compat.master_weather_source(), wname, now == "now" and 1 or 600)
		if sent then return sent end
		return netcoop_server_compat.set_server_weather(wname, now == "now")
	elseif cmd == "weather_edit" then
		return netcoop_server_compat.weather_edit(args)
	elseif cmd == "time" then
		-- time <hours> | <hours> <minutes> | <days> <hours> <minutes>: forward.
		local v = {}
		for n in string.gmatch(args, "%d+") do v[#v + 1] = tonumber(n) end
		if #v == 1 then v = { 0, v[1], 0 } elseif #v == 2 then v = { 0, v[1], v[2] } end
		if #v ~= 3 or string.find(args, "[^%d%s]") then return "! usage: time <days> <hours> <minutes> (forward)" end
		local seconds = v[1] * 86400 + v[2] * 3600 + v[3] * 60
		if seconds <= 0 or seconds > 30 * 86400 then return "! time moves forward, at most 30 days" end
		local sent = master_order(name, "advance", "", "", seconds)
		if sent then return sent end
		level.change_game_time(v[1], v[2], v[3])
		return string.format("* time moved forward %dd %dh %dm on this location", v[1], v[2], v[3])
	elseif cmd == "timescale" then
		local value = tonumber(string.match(args, "^(%d+%.?%d*)$"))
		if not value or value <= 0 or value > 1000 then return "! usage: timescale <game seconds per real second>" end
		local sent = master_order(name, "scale", "", "", value)
		if sent then return sent end
		level.set_time_factor(value)
		return string.format("* time scale %.2f on this location", value)

	elseif cmd == "find" then
		local mask, limit = string.match(args, "^(%S+)%s*(%d*)$")
		if not mask then return "! usage: find <text> [limit]" end
		return find_sections(mask, math.min(tonumber(limit) or 30, 100))

	elseif cmd == "lua" then
		-- Admin debugging: run a Lua chunk on the server, return its result.
		if args == "" then return "! usage: lua <code>" end
		local chunk, err = loadstring(args)
		if not chunk then chunk, err = loadstring("return " .. args) end
		if not chunk then return "! " .. tostring(err) end
		local ok, res = pcall(chunk)
		return (ok and "~ " or "! ") .. tostring(res)

	elseif cmd == "cmd" then
		if args == "" or string.find(args, "[\r\n;]") then return "! invalid console command" end
		local first = string.lower(string.match(args, "^(%S+)") or "")
		if first == "srv" or first == "sv_cmd" or first == "quit" then return "! command not allowed" end
		get_console():execute(args)
		return "* executed on the server: " .. args
	end

	return "! unknown command, see help"
end
