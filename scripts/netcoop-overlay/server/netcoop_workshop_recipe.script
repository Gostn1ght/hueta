-- A stable identifier for a configured recipe, independent of menu order.
-- The server resolves it only against its own recipes and checks all costs.
function key(recipe)
    if not recipe or type(recipe.sec) ~= "string" then return nil end
    local parts = {recipe.sec, tostring(recipe.tool), tostring(recipe.rsp)}
    for slot = 1, 4 do
        local item = recipe[slot]
        parts[#parts + 1] = item and item[1] or ""
        parts[#parts + 1] = item and tostring(item[2]) or ""
    end
    local image = table.concat(parts, "\0")
    local first, second = 0, 0
    for i = 1, #image do
        local byte = image:byte(i)
        first = (first * 257 + byte) % 2147483647
        second = (second * 263 + byte) % 2147483629
    end
    return string.format("%08x%08x", first, second)
end
