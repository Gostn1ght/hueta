----------------------------------------------------------------------
-- NPCs searching corpses on the server (doc 43 L16, README stage 2в).
-- GAMMA's xr_corpse_detection takes every lootable item from a corpse at
-- once; it only stops an NPC that is already over 30 kg from searching
-- again (utils_item.is_overweight). Here the NPC keeps what it can carry:
-- right after GAMMA's search (same server frame) the least valuable of the
-- items it just took (cost x condition) go back into the corpse until the
-- NPC is within GAMMA's 30 kg, so a corpse is not emptied into an endless
-- inventory and the rest stays there for players.
-- GAMMA's "don't loot near the actor" (npc_loot_distance) measured to the
-- server's own Actor, never to a player, so NPCs searched corpses in front
-- of players: it is measured to the nearest living player here.
-- The dedicated completion path uses the selected corpse and NPC directly.
----------------------------------------------------------------------

local MAX_WEIGHT = 30 -- utils_item.is_overweight

local taken = {} -- npc id -> { corpse = id, items = { id, ... } }

local function value(obj)
	local ok, v = pcall(function() return obj:cost() * obj:condition() end)
	return ok and v or 0
end

local function owner_id(item)
	local entity = alife_object(item:id())
	return entity and entity.parent_id
end

-- after GAMMA's search: give back what does not fit, least valuable first
function settle(npc_id)
	local t = taken[npc_id]
	taken[npc_id] = nil
	local npc = t and level.object_by_id(npc_id)
	local corpse = npc and level.object_by_id(t.corpse)
	if not (npc and corpse and npc:alive()) then return true end
	local weight = npc:get_total_weight()
	if weight <= MAX_WEIGHT then return true end
	local items = {}
	for _, id in ipairs(t.items) do
		local it = level.object_by_id(id)
		if it and owner_id(it) == npc_id then items[#items + 1] = it end
	end
	table.sort(items, function(a, b) return value(a) < value(b) end)
	local back = 0
	for _, it in ipairs(items) do
		if weight <= MAX_WEIGHT then break end
		npc:transfer_item(it, corpse)
		if owner_id(it) == corpse:id() then
			weight = weight - (it:weight() or 0)
			back = back + 1
		end
	end
	if back > 0 then printf("[Lost Zone][loot] %s left %s item(s) in %s: no room", npc:name(), tostring(back), corpse:name()) end
	return true
end

-- GAMMA calls this for each item of the corpse right before taking it
local function on_get(npc, corpse, item, lootable)
	if not (lootable and npc and corpse and item) then return end
	local id = npc:id()
	local t = taken[id]
	if not t or t.corpse ~= corpse:id() then
		t = { corpse = corpse:id(), items = {} }
		taken[id] = t
	end
	t.items[#t.items + 1] = item:id()
	CreateTimeEvent("netcoop_npc_loot", tostring(id), 0, settle, id)
end

-- "not near the actor": within the option's distance of any living player
function near_player(obj)
	local dist = tonumber(ui_options and ui_options.get("gameplay/general/npc_loot_distance"))
	if not (dist and dist > 0 and obj) then return false end
	local pos = obj:position()
	for id in string.gmatch(netcoop_players and netcoop_players() or "", "%d+") do
		local p = level.object_by_id(tonumber(id))
		if p and p:alive() and p:position():distance_to(pos) < dist then return true end
	end
	return false
end

local function available(corpse, item, lootable)
	return lootable[item:section()] and owner_id(item) == corpse:id()
end

local function search_corpse(scheme, npc)
	local storage = db.storage[npc:id()]
	local state = storage and storage.corpse_detection
	local id = state and state.selected_corpse_id
	if not id then return end
	local corpse_state = db.storage[id]
	local corpse = level.object_by_id(id)
	if corpse_state then corpse_state.corpse_already_selected = nil end
	state.selected_corpse_id, state.__stimer, state.mutant_analysed = nil, nil, nil
	state.vertex_id, state.vertex_position, state.state = nil, nil, nil
	state.nearest_id, state.nearest_corpse_dist = nil, nil
	state.nearest_corpse_vertex, state.nearest_corpse_position = nil, nil
	state.index = 1
	if not (corpse and corpse:id() ~= 0 and not corpse:alive() and npc:alive()) or near_player(corpse) then return end
	-- Same squared tolerance as the original corpse vertex selection.
	if npc:position():distance_to_sqr(corpse:position()) > 16 then return end
	if corpse:is_monster() then
		if netcoop_mutant_loot then netcoop_mutant_loot.npc_take(npc, corpse) end
		return
	end
	if not IsStalker(corpse) then return end
	local class = corpse:clsid()
	-- Player bodies use the character restore and reservation flow.
	if class == clsid.script_actor or class == clsid.actor then return end
	scheme.set_valuable_loot(id, false)
	local lootable = scheme.lootable_table or {}
	local ids = {}
	corpse:iterate_inventory(function(_, item)
		if available(corpse, item, lootable) then ids[#ids + 1] = item:id() end
	end, corpse)
	for _, item_id in ipairs(ids) do
		local item = level.object_by_id(item_id)
		if item and available(corpse, item, lootable) then
			SendScriptCallback("npc_on_get_all_from_corpse", npc, corpse, item, true)
			corpse:transfer_item(item, npc)
		end
	end
	if item_money then item_money.npc_on_loot_money(npc, corpse) end
	local count = tonumber(load_var(npc, "s_loot_count")) or 0
	save_var(npc, "s_loot_count", math.min(count + 1, 255))
	if game_statistics then game_statistics.increment_npc_statistic(npc, "corpse_looted") end
end

local function hook_corpses(scheme)
	if not scheme or scheme.__netcoop_search or not scheme.get_all_from_corpse then return end
	local original = scheme.get_all_from_corpse
	scheme.__netcoop_search = true
	scheme.near_actor = near_player
	scheme.get_all_from_corpse = function(npc) search_corpse(scheme, npc) end
	-- Some animations capture the function before the scripts start.
	local animations = state_mgr_animation_list and state_mgr_animation_list.animations
	for _, name in ipairs({"search_corpse", "field_dress"}) do
		local animation = animations and animations[name]
		for _, sequence in pairs(animation and animation.into or {}) do
			for _, command in ipairs(sequence) do
				if type(command) == "table" and command.f == original then command.f = scheme.get_all_from_corpse end
			end
		end
	end
end

----------------------------------------------------------------------
-- NPCs picking items up from the ground keep the same item (doc 43 L17).
-- GAMMA's xr_gather_items.gather_item never picks the item up: a weapon is
-- cloned (alife_clone_weapon: new object, old one released) and anything
-- else, artefacts included, is created anew in the NPC and the ground one
-- released. The weapon an NPC changes to, the artefact it finds, the ammo
-- box (with its real count) changed ID, lost its upgrades/parts state and
-- its persistent identity. Here the NPC takes that very object (Modded
-- Exes npc:take_item, a normal ownership event on the server); GAMMA's
-- own code runs unchanged, only these three calls inside xr_gather_items
-- are shadowed in its module table. An item someone picked up meanwhile is
-- left with them (GAMMA released it from their inventory and gave the NPC a
-- copy). An exe without take_item keeps GAMMA's behaviour otherwise.
----------------------------------------------------------------------

local NO_PARENT = 65535

local function take(npc_id, item_id)
	local npc = level.object_by_id(npc_id)
	local item = level.object_by_id(item_id)
	if not (npc and item and npc.take_item and npc:alive()) then return false end
	if item:parent() then return false end
	npc:take_item(item)
	return true
end

local deferred -- gather_item's alife_create_item(section, npc), waiting for its release

local function flush(create)
	local d = deferred
	deferred = nil
	if d then create(d.section, d.where, d.props) end
end

function hook_gather(m)
	if not m or m.netcoop_same_item then return end
	m.netcoop_same_item = true
	local clone, create, release = alife_clone_weapon, alife_create_item, alife_release
	m.alife_clone_weapon = function(se, section, parent_id)
		if se and parent_id and se.parent_id == NO_PARENT and (section == nil or section == se:section_name())
		and take(parent_id, se.id) then
			return se
		end
		return clone(se, section, parent_id)
	end
	m.alife_create_item = function(section, where, props)
		flush(create)
		local object = type(where) == "userdata" or type(where) == "table" and where.id ~= nil
		if props == nil and object then
			deferred = {section = section, where = where, props = props}
			return
		end
		return create(section, where, props)
	end
	m.alife_release = function(se, ...)
		local d = deferred
		if d and se and se.parent_id ~= NO_PARENT and se:section_name() == d.section then
			-- someone (a player) picked it up first: GAMMA would release it
			-- from their inventory and give the NPC a copy
			deferred = nil
			return false
		end
		if d and se and se.parent_id == NO_PARENT and se:section_name() == d.section then
			local ok, npc_id = pcall(function() return d.where:id() end)
			if ok and npc_id and take(npc_id, se.id) then
				deferred = nil
				printf("[Lost Zone][loot] %s picked up %s (id %s kept)", tostring(d.where:name()), d.section, tostring(se.id))
				return true
			end
		end
		flush(create)
		return release(se, ...)
	end
end

function on_game_start()
	if not (netcoop_enabled and netcoop_enabled()) or (netcoop_pure_client and netcoop_pure_client()) then return end
	RegisterScriptCallback("npc_on_get_all_from_corpse", on_get)
	hook_corpses(xr_corpse_detection)
	if xr_gather_items then
		xr_gather_items.near_actor = near_player
		hook_gather(xr_gather_items)
	end
end
