----------------------------------------------------------------------
-- PDA network: UID, contacts, general channel, private and group chats
-- (owner 2026-10-10, after New Way's PDA; plan docs/audit/89)
----------------------------------------------------------------------
-- Every physical PDA has its own name and a 6-digit network UID. There is no public
-- list of who is online: two players see each other's status only after
-- both added the other's UID. Strangers appear as "UID nnnnnn"; contacts by
-- name and avatar. History of the general channel and of every chat lives
-- in the cluster's shared store, so it survives relogs and restarts on any
-- server, and a message to an offline player waits for him.
--
-- Records (netcoop_store, compare-and-swap):
--   pda_prof/<device uid>  { uid, name, icon, contacts = {uid=true}, chats = {cid=read_seq}, seen,
--                      requests = {uid=os time} - who added me and is not my contact yet }
--   pda_uid/<uid>    <device uid>
--   pda_chat/<cid>   { seq, kind = "general"|"d"|"g", members = {uid=true}, name, icon, msgs = {...} }
--   pda_note/<device uid>  { cid = seq } - the newest message of each chat for him (delivery across servers)
--   pda_pay/<char>   { sum } - money sent to him, paid out by the server he plays on
--   pda_memo/<device uid>  { {id, title, text, t, g}, ... } - his notes ("Р—Р°РјРµС‚РєРё")
--   pda_audio/<aid>  { cid, parts, secs, by } and pda_audio/<aid>.<n> - a voice
--                    message / dictaphone record (engine recording, base64)
--   pda_photo/<pid>  { cid, parts, by, place, g } and pda_photo/<pid>.<n> - a
--                    photo sent to a chat (engine DDS, base64; netcoop_photo.inc)
-- A message: { s = seq, f = sender uid ("" anonymous), k = kind, x = text, d = data, t = os time, g = game minutes }
-- Client -> server: netcoop command "pdanet <verb> <args>".
-- Server -> client: channel "pdanet", chunks "n/total|<verb>|<serialized>".

local HISTORY = 150          -- messages kept per chat
local TEXT = 400             -- characters per message
local ONLINE = 90            -- seconds since the last heartbeat
local HEARTBEAT = 30
local CHUNK = 7000
local MAX_CONTACTS, MAX_CHATS, MAX_GROUP = 200, 100, 20
-- "transfer" only by "pay", "photo" only by a photo upload ("pbeg")
local KINDS = { text = true, point = true, voice = true, task = true }
local MAX_PAY = 1000000
local NOTES, NOTE_TITLE, NOTE_TEXT = 40, 60, 1200
local AUDIO_MAX_PARTS, AUDIO_PART, AUDIO_SECS = 700, 56000, 600
local PHOTO_MAX_PARTS = 190 -- 3800 characters each: a 640x360 photo is ~41 parts

local ser = function(v) return netcoop_transit.serialize(v) end
local function de(text)
	if not text or text == "" then return nil end
	local ok, v = pcall(netcoop_transit.deserialize, text)
	return ok and v or nil
end

-- Read-modify-write of one record; fn(value) returns the new value or nil (no change).
local function update(bucket, key, fn)
	for _ = 1, 10 do
		local old = netcoop_store_read(bucket, key) or ""
		local value = fn(de(old))
		if value == nil then return de(old), false end
		local text = ser(value)
		if netcoop_store_swap(bucket, key, old, text) then return value, true end
	end
	return nil, false
end
local function read(bucket, key) return de(netcoop_store_read(bucket, key)) end

local held_device, device_view -- assigned below; used by physical profiles
local function char_of(id) return netcoop_actor_character and netcoop_actor_character(id) or "" end
local function now() return os.time() end
local function game_minutes()
	local base = game.CTime()
	if base.set then base:set(2012, 1, 1, 0, 0, 0, 0) end
	return math.floor(game.get_game_time():diffSec(base) / 60)
end

----------------------------------------------------------------------
-- Profiles and UIDs
----------------------------------------------------------------------
local function new_uid(char)
	for _ = 1, 50 do
		local uid = tostring(math.random(100000, 999999))
		if netcoop_store_swap("pda_uid", uid, "", char) then return uid end
	end
	return nil
end

-- Old character records are claimed by one physical device only. Every
-- bucket is copied idempotently after the claim, so an interrupted migration
-- can finish on another location without giving a replacement the same data.
local function migrate_device(d, character)
	if not d.own then return true end
	if netcoop_store_read("pda_profile_ready",d.uid)=="1" then return true end
	local claim = netcoop_store_read("pda_profile_migrated", character) or ""
	if claim == "" and netcoop_store_swap("pda_profile_migrated", character, "", d.uid) then claim = d.uid end
	if claim ~= d.uid then return true end
	for _, bucket in ipairs({"pda_prof", "pda_note", "pda_memo", "pda_lock", "pda_stash", "map_known"}) do
		local old = netcoop_store_read(bucket, character) or ""
		if old ~= "" and (netcoop_store_read(bucket,d.uid) or "")=="" and not netcoop_store_swap(bucket,d.uid,"",old) then return false end
	end
	local old = read("pda_prof", d.uid)
	if old and old.uid then netcoop_store_swap("pda_uid", old.uid, character, d.uid) end
	return netcoop_store_read("pda_profile_ready",d.uid)=="1" or netcoop_store_swap("pda_profile_ready",d.uid,"","1")
end

-- Second result is a physical storage key, never an account/character key.
function profile(id)
	local character = char_of(id)
	if character == "" then return nil end
	local d = held_device(id, character)
	if not d then return nil end
	if netcoop_pda_storage and not netcoop_pda_storage.recover(d.uid) then return nil end
	d=held_device(id,character)
	if not migrate_device(d, character) then return nil end
	local actor = level.object_by_id(id)
	local name = actor and actor:character_name() or character
	local icon = actor and actor.character_icon and actor:character_icon() or ""
	local p = update("pda_prof", d.uid, function(p)
		p = p or {}
		local changed = false
		if not p.uid then p.uid = new_uid(d.uid); changed = true end
		if d.own and (p.name ~= name or p.icon ~= icon) then p.name, p.icon = name, icon; changed = true end
		if (d.own or d.rec.hacked[character]) and (not p.seen or now() - p.seen >= HEARTBEAT) then p.seen = now(); changed = true end
		p.contacts, p.chats = p.contacts or {}, p.chats or {}
		return changed and p or nil
	end)
	return p, d.uid
end

local function profile_by_uid(uid)
	local char = netcoop_store_read("pda_uid", tostring(uid))
	if not char or char == "" then return nil end
	return read("pda_prof", char), char
end

local function online(p) return p and p.seen and now() - p.seen < ONLINE or false end

-- How "me" sees uid: a mutual contact gets name, avatar and status; a
-- contact I added gets name and avatar; a stranger only the UID.
local function view(me, uid)
	local other = profile_by_uid(uid)
	local v = { uid = uid }
	if me.contacts[uid] and other then
		v.name, v.icon = other.name, other.icon
		if other.contacts and other.contacts[me.uid] then v.online = online(other); v.friend = true end
	end
	return v
end

----------------------------------------------------------------------
-- Delivery
----------------------------------------------------------------------
local function send(id, verb, value)
	local d = held_device and held_device(id, char_of(id))
	local header = d and (d.item .. "@" .. d.uid .. "|") or "0@none|"
	local data = header .. verb .. "|" .. (type(value) == "string" and value or ser(value or {}))
	local total = math.max(1, math.ceil(#data / CHUNK))
	for n = 1, total do
		netcoop_send_to_actor(id, "pdanet", n .. "/" .. total .. "|" .. string.sub(data, (n - 1) * CHUNK + 1, n * CHUNK))
	end
end

-- Player Actors on this server: char -> Actor id.
local function local_players()
	local out = {}
	for id in string.gmatch(netcoop_players and netcoop_players() or "", "%d+") do
		id = tonumber(id)
		local char = char_of(id)
		local d = char ~= "" and held_device(id, char)
		if d then out[d.uid] = id end
	end
	return out
end

local function note(char, cid, seq)
	update("pda_note", char, function(n)
		n = n or {}
		if (n[cid] or 0) >= seq then return nil end
		n[cid] = seq
		return n
	end)
end

-- Append a message to a chat; tells every member (and the general channel's
-- readers by polling). Returns the stored message or nil, reason.
local function post(cid, from_uid, kind, text, data)
	local msg
	local chat = update("pda_chat", cid, function(c)
		if not c then return nil end
		if c.kind ~= "general" and not c.members[from_uid] then return nil end
		c.seq = (c.seq or 0) + 1
		msg = { s = c.seq, f = from_uid, k = kind, x = string.sub(text or "", 1, TEXT), d = data, t = now(), g = game_minutes() }
		c.msgs = c.msgs or {}
		c.msgs[#c.msgs + 1] = msg
		while #c.msgs > HISTORY do table.remove(c.msgs, 1) end
		return c
	end)
	if not chat or not msg then return nil, "no such chat" end
	if chat.kind ~= "general" then
		for uid in pairs(chat.members) do
			local char = netcoop_store_read("pda_uid", uid)
			if char and char ~= "" then note(char, cid, msg.s) end
		end
	end
	return msg
end

local function ensure_general()
	if netcoop_store_read("pda_chat", "general") == "" then
		netcoop_store_swap("pda_chat", "general", "", ser({ seq = 0, kind = "general", members = {}, msgs = {} }))
	end
end

local function dm_id(a, b)
	if a > b then a, b = b, a end
	return "d_" .. a .. "_" .. b
end

-- Chat summary for the list: name/icon as "me" sees it, last message, unread.
local function summary(me, cid)
	local c = read("pda_chat", cid)
	if not c then return nil end
	local s = { id = cid, kind = c.kind, seq = c.seq or 0, unread = math.max(0, (c.seq or 0) - (me.chats[cid] or 0)) }
	if c.kind == "g" then
		s.name, s.icon = c.name, c.icon
		local n, on = 0, 0
		for uid in pairs(c.members) do
			n = n + 1
			if uid ~= me.uid and view(me, uid).online then on = on + 1 end
		end
		s.members, s.online = n, on + 1
	else
		for uid in pairs(c.members) do
			if uid ~= me.uid then s.peer = view(me, uid) end
		end
	end
	local last = c.msgs and c.msgs[#c.msgs]
	if last then s.last = { f = last.f, k = last.k, x = string.sub(last.x or "", 1, 40), t = last.t, g = last.g } end
	return s
end

-- The device in the slot; a failure there never takes the network down.
local function holding(id, char)
	local ok, d = pcall(held_device, id, char)
	if ok then return d end
	printf("! [Lost Zone] pdanet device: %s", tostring(d))
end

local function state(id, me)
	local char = char_of(id)
	local d = holding(id, char)
	send(id, "device", device_view(id, char, d))
	if not d or (not d.own and not d.rec.hacked[char]) then
		send(id, "state", { uid = "", name = "", icon = "", contacts = {}, chats = {}, requests = {}, foreign = true })
		return
	end
	local contacts, chats = {}, {}
	local here = local_players()
	for uid in pairs(me.contacts) do
		local contact = view(me, uid)
		if contact.friend then
			local _, char = profile_by_uid(uid)
			local actor_id = char and here[char]
			local actor = actor_id and level.object_by_id(actor_id)
			if actor then contact.actor_id, contact.actor_name = actor_id, actor:character_name() end
		end
		contacts[#contacts + 1] = contact
	end
	for cid in pairs(me.chats) do
		local s = summary(me, cid)
		if s then chats[#chats + 1] = s end
	end
	-- Friend requests (owner 2026-10-18: "I never saw the request"): a
	-- player who added my UID shows his name to me; accepting is adding back.
	local requests = {}
	for uid, at in pairs(me.requests or {}) do
		if not me.contacts[uid] then
			local other = profile_by_uid(uid)
			if other then requests[#requests + 1] = { uid = uid, name = other.name, icon = other.icon, t = at } end
		end
	end
	local lock = d and read("pda_lock", d.uid)
	-- a locked PDA shows nothing of its owner's network
	if lock and is_locked(id, d.uid) then
		send(id, "state", { uid = me.uid, name = me.name, icon = me.icon, contacts = {}, chats = {}, requests = {}, locked = true, has_lock = true })
		return
	end
	send(id, "state", { uid = me.uid, name = me.name, icon = me.icon, contacts = contacts, chats = chats, requests = requests,
		has_lock = lock ~= nil })
end

local function requests_key(p)
	local out = {}
	for uid in pairs(p and p.requests or {}) do out[#out + 1] = uid end
	table.sort(out)
	return table.concat(out, ",")
end

-- Messages as "me" sees them: names only for contacts.
local function shown(me, msgs, from)
	local out = {}
	for _, m in ipairs(msgs or {}) do
		if m.s > (from or 0) then
			local who = m.f ~= "" and view(me, m.f) or { uid = "" }
			out[#out + 1] = { s = m.s, f = m.f, n = who.name, i = who.icon, k = m.k, x = m.x, d = m.d, t = m.t, g = m.g, own = m.f == me.uid }
		end
	end
	return out
end

local function mark_read(char, cid, seq)
	update("pda_prof", char, function(p)
		if not p or (p.chats[cid] or 0) >= seq then return nil end
		p.chats[cid] = seq
		return p
	end)
end

----------------------------------------------------------------------
-- Commands
----------------------------------------------------------------------
local handlers = {}

function handlers.hello(id, me, char)
	ensure_general()
	state(id, me)
	local d = holding(id, char_of(id))
	if not d or (not d.own and not d.rec.hacked[char_of(id)]) or is_locked(id, d.uid) then return end
	local g = read("pda_chat", "general")
	send(id, "general", shown(me, g and g.msgs, math.max(0, (g and g.seq or 0) - 60)))
end

function handlers.add(id, me, char, args)
	local uid = string.match(args, "^(%d%d%d%d%d%d)$")
	if not uid or uid == me.uid then return "invalid UID" end
	if not profile_by_uid(uid) then return "no such UID" end
	local added = false
	update("pda_prof", char, function(p)
		local n = 0
		for _ in pairs(p.contacts) do n = n + 1 end
		if p.contacts[uid] or n >= MAX_CONTACTS then return nil end
		p.contacts[uid] = true
		if p.requests then p.requests[uid] = nil end -- an accepted request
		added = true
		return p
	end)
	-- the other side sees a request until he adds me back or declines
	local _, other_char = profile_by_uid(uid)
	if added and other_char then
		update("pda_prof", other_char, function(p)
			if not p or p.contacts[me.uid] or (p.requests and p.requests[me.uid]) then return nil end
			p.requests = p.requests or {}
			local n = 0
			for _ in pairs(p.requests) do n = n + 1 end
			if n >= MAX_CONTACTS then return nil end
			p.requests[me.uid] = now()
			return p
		end)
		local other_id = local_players()[other_char]
		if other_id then state(other_id, read("pda_prof", other_char)) end
	end
	state(id, read("pda_prof", char))
end

-- deny <uid>: a friend request is declined (the sender is not told)
function handlers.deny(id, me, char, args)
	local uid = string.match(args, "^(%d+)$")
	update("pda_prof", char, function(p)
		if not (uid and p.requests and p.requests[uid]) then return nil end
		p.requests[uid] = nil
		return p
	end)
	state(id, read("pda_prof", char))
end

function handlers.del(id, me, char, args)
	local uid = string.match(args, "^(%d+)$")
	update("pda_prof", char, function(p)
		if not (uid and p.contacts[uid]) then return nil end
		p.contacts[uid] = nil
		return p
	end)
	state(id, read("pda_prof", char))
end

-- say <0|1 anonymous> <text>
function handlers.say(id, me, char, args)
	local anon, text = string.match(args, "^([01]) (.+)$")
	if not text then return "empty message" end
	ensure_general()
	post("general", anon == "1" and "" or me.uid, "text", text)
end

-- dm <uid> : open (or make) the private chat with a UID
function handlers.dm(id, me, char, args)
	local uid = string.match(args, "^(%d%d%d%d%d%d)$")
	if not uid or uid == me.uid or not profile_by_uid(uid) then return "no such UID" end
	local cid = dm_id(me.uid, uid)
	if netcoop_store_read("pda_chat", cid) == "" then
		netcoop_store_swap("pda_chat", cid, "", ser({ seq = 0, kind = "d", members = { [me.uid] = true, [uid] = true }, msgs = {} }))
	end
	for _, who in ipairs({ char, (select(2, profile_by_uid(uid))) }) do
		update("pda_prof", who, function(p)
			if not p or p.chats[cid] then return nil end
			p.chats[cid] = 0
			return p
		end)
	end
	handlers.open(id, read("pda_prof", char), char, cid)
	state(id, read("pda_prof", char))
end

-- group <name>|<icon>|uid,uid,...  (members must be my contacts)
function handlers.group(id, me, char, args)
	local name, icon, list = string.match(args, "^([^|]*)|([^|]*)|(.*)$")
	if not name then return "bad group" end
	local members, n = { [me.uid] = true }, 1
	for uid in string.gmatch(list, "%d%d%d%d%d%d") do
		if me.contacts[uid] and not members[uid] and n < MAX_GROUP then members[uid] = true; n = n + 1 end
	end
	if n < 2 then return "choose at least one contact" end
	if icon ~= "" and not string.match(icon, "^ui_mm_faction_%a+$") then icon = "" end
	local cid
	for _ = 1, 20 do
		cid = "g_" .. math.random(10000000, 99999999)
		if netcoop_store_swap("pda_chat", cid, "", ser({ seq = 0, kind = "g", members = members, msgs = {},
			name = string.sub(name ~= "" and name or "Group", 1, 40), icon = string.sub(icon, 1, 60) })) then break end
		cid = nil
	end
	if not cid then return "try again" end
	for uid in pairs(members) do
		local c = netcoop_store_read("pda_uid", uid)
		if c and c ~= "" then
			update("pda_prof", c, function(p)
				if not p then return nil end
				p.chats[cid] = 0
				return p
			end)
			note(c, cid, 0)
		end
	end
	state(id, read("pda_prof", char))
end

-- open <cid> : history, marked read
function handlers.open(id, me, char, args)
	local cid = string.match(args, "^([%w_]+)$")
	local c = cid and read("pda_chat", cid)
	if not c or (c.kind ~= "general" and not c.members[me.uid]) then return "no such chat" end
	send(id, "chat", { id = cid, summary = summary(me, cid), msgs = shown(me, c.msgs) })
	if c.kind ~= "general" then mark_read(char, cid, c.seq or 0) end
end

-- msg <cid> <kind> <text>[\t<data>]
function handlers.msg(id, me, char, args)
	local cid, kind, rest = string.match(args, "^([%w_]+) (%a+) (.*)$")
	if not (cid and KINDS[kind]) then return "bad message" end
	if not me.chats[cid] then return "no such chat" end
	local text, data = string.match(rest, "^([^\t]*)\t?(.*)$")
	local place = "^[%w_]+ %-?[%d%.]+ %-?[%d%.]+ %-?[%d%.]+$"
	if kind == "point" and not string.match(data or "", place) then return "bad point" end
	-- a task: its title, and where it points if it has a target
	if kind == "task" and ((text or "") == "" or (data ~= "" and not string.match(data, place))) then return "bad task" end
	local msg, err = post(cid, me.uid, kind, text, data ~= "" and data or nil)
	if not msg then return err end
	mark_read(char, cid, msg.s)
end

-- delete <cid> : a private chat leaves my list; a group is deleted for all
function handlers.delete(id, me, char, args)
	local cid = string.match(args, "^([%w_]+)$")
	local c = cid and me.chats[cid] and read("pda_chat", cid)
	if not c then return "no such chat" end
	local holders = c.kind == "g" and c.members or { [me.uid] = true }
	for uid in pairs(holders) do
		local who = netcoop_store_read("pda_uid", uid)
		if who and who ~= "" then
			update("pda_prof", who, function(p)
				if not p or not p.chats[cid] then return nil end
				p.chats[cid] = nil
				return p
			end)
		end
	end
	if c.kind == "g" then
		local old = netcoop_store_read("pda_chat", cid)
		netcoop_store_swap("pda_chat", cid, old, "")
	end
	state(id, read("pda_prof", char))
end

-- typing <cid> : shown to members online on this server (never stored)
function handlers.typing(id, me, char, args)
	local cid = string.match(args, "^([%w_]+)$")
	local c = cid and me.chats[cid] and read("pda_chat", cid)
	if not c then return end
	local here = local_players()
	for uid in pairs(c.members) do
		local who = uid ~= me.uid and netcoop_store_read("pda_uid", uid)
		local actor = who and here[who]
		if actor then send(actor, "typing", { id = cid, uid = me.uid }) end
	end
end

-- pay <cid> <amount> : money to the other member of a private chat. The
-- sender's server takes it now; the receiver's server pays it out (also
-- when he comes online later). The chat shows the transfer to both.
function handlers.pay(id, me, char, args)
	local cid, amount = string.match(args, "^([%w_]+) (%d+)$")
	amount = tonumber(amount)
	if not (cid and amount and amount >= 1 and amount <= MAX_PAY) then return "bad amount" end
	local c = me.chats[cid] and read("pda_chat", cid)
	if not c or c.kind ~= "d" or not c.members[me.uid] then return "no such chat" end
	local peer
	for uid in pairs(c.members) do if uid ~= me.uid then peer = uid end end
	local peer_device = peer and netcoop_store_read("pda_uid", peer)
	local peer_record = peer_device and read("pda_dev", peer_device)
	local pchar = peer_record and peer_record.owner
	if not pchar or pchar == "" then return "no such UID" end
	local actor = level.object_by_id(id)
	if not (actor and actor:money() >= amount) then return "not enough money" end
	actor:give_money(-amount)
	local _, ok = update("pda_pay", pchar, function(v) return { sum = ((v and tonumber(v.sum)) or 0) + amount } end)
	if not ok then
		actor:give_money(amount)
		return "try again"
	end
	local msg = post(cid, me.uid, "transfer", "", tostring(amount))
	if msg then mark_read(char, cid, msg.s) end
	printf("[Lost Zone] pdanet transfer %s -> %s: %s RU", char, pchar, amount)
	send(id, "paid", { amount = -amount })
end

-- members <cid> : who is in a group ("РЎРѕСЃС‚Р°РІ"), as I see them
function handlers.members(id, me, char, args)
	local cid = string.match(args, "^([%w_]+)$")
	local c = cid and me.chats[cid] and read("pda_chat", cid)
	if not c or not c.members[me.uid] then return "no such chat" end
	local out = {}
	for uid in pairs(c.members) do
		local v = uid == me.uid and { uid = uid, name = me.name, icon = me.icon, online = true, own = true } or view(me, uid)
		out[#out + 1] = v
	end
	table.sort(out, function(a, b) return a.uid < b.uid end)
	send(id, "members", { id = cid, list = out })
end

-- Notes: notes (list), note <id>|<title>|<text> (new: id "new"), note_del <id>
local function send_notes(id, char)
	send(id, "notes", read("pda_memo", char) or {})
end
function handlers.notes(id, me, char)
	send_notes(id, char)
end
function handlers.note(id, me, char, args)
	local nid, title, body = string.match(args, "^([%w]+)|([^|]*)|(.*)$")
	if not nid then return "bad note" end
	title = string.sub(title, 1, NOTE_TITLE)
	body = string.sub(string.gsub(body, "\t", "    "), 1, NOTE_TEXT)
	if title == "" and body == "" then return "empty note" end
	local err
	update("pda_memo", char, function(list)
		list = list or {}
		if nid == "new" then
			if #list >= NOTES then err = "too many notes"; return nil end
			local n = 0
			for _, x in ipairs(list) do n = math.max(n, tonumber(x.id) or 0) end
			table.insert(list, 1, { id = tostring(n + 1), title = title, text = body, t = now(), g = game_minutes() })
			return list
		end
		for _, x in ipairs(list) do
			if x.id == nid then x.title, x.text, x.t, x.g = title, body, now(), game_minutes(); return list end
		end
		err = "no such note"
		return nil
	end)
	if err then return err end
	send_notes(id, char)
end
function handlers.note_del(id, me, char, args)
	local nid = string.match(args, "^(%w+)$")
	update("pda_memo", char, function(list)
		for i, x in ipairs(list or {}) do
			if x.id == nid then table.remove(list, i); return list end
		end
		return nil
	end)
	send_notes(id, char)
end

----------------------------------------------------------------------
-- Voice messages and photos: the client uploads a recording ("abeg") or a
-- photo ("pbeg") in parts of up to 3800 characters ("aup" for both), the
-- server stores it and posts the message; members of the chat fetch it
-- with "aget" / "pget".
----------------------------------------------------------------------
local uploads = {} -- entity id -> { kind, aid, cid, secs, place, total, parts, got, at }

-- abeg <aid> <cid> <secs> <parts>
function handlers.abeg(id, me, char, args)
	local aid, cid, secs, total = string.match(args, "^(%x+) ([%w_]+) (%d+) (%d+)$")
	secs, total = tonumber(secs), tonumber(total)
	if not aid or #aid ~= 16 or total < 1 or total > AUDIO_MAX_PARTS or secs < 1 or secs > AUDIO_SECS then return "bad record" end
	local c = me.chats[cid] and read("pda_chat", cid)
	if not c or not c.members[me.uid] then return "no such chat" end -- chats only, not the general channel
	if netcoop_store_read("pda_audio", aid) ~= "" then return "try again" end
	uploads[id] = { kind = "audio", aid = aid, cid = cid, secs = secs, total = total, parts = {}, got = 0, at = time_global(), uid = me.uid, char = char }
end

-- pbeg <pid> <cid> <parts> <level> : a photo for a chat or group
function handlers.pbeg(id, me, char, args)
	local pid, cid, total, place = string.match(args, "^(%x+) ([%w_]+) (%d+) ([%w_]+)$")
	total = tonumber(total)
	if not pid or #pid ~= 16 or total < 1 or total > PHOTO_MAX_PARTS then return "bad photo" end
	local c = me.chats[cid] and read("pda_chat", cid)
	if not c or not c.members[me.uid] then return "no such chat" end
	if netcoop_store_read("pda_photo", pid) ~= "" then return "try again" end
	uploads[id] = { kind = "photo", aid = pid, cid = cid, place = string.sub(place, 1, 40), total = total, parts = {}, got = 0,
		at = time_global(), uid = me.uid, char = char }
end

-- Device libraries share the chunk transport with chat attachments, but have
-- a physical ACL and no chat membership. USB copies indices, never credentials.
function handlers.library(id, me, key)
	send(id, "library", {device=key,photos=read("pda_gallery",key) or {},records=read("pda_records",key) or {},settings=read("pda_settings",key) or {}})
end
local function library_begin(id, me, key, args, kind)
	local aid,total,extra=string.match(args or "", "^(%x+) (%d+) ([%w_]+)$")
	total=tonumber(total)
	local photo=kind=="photo"
	if not aid or #aid~=16 or not total or total<1 or total>(photo and PHOTO_MAX_PARTS or AUDIO_MAX_PARTS) then return "bad record" end
	if not photo and (not tonumber(extra) or tonumber(extra)<1 or tonumber(extra)>AUDIO_SECS) then return "bad record" end
	local bucket=photo and "pda_photo" or "pda_audio"
	if netcoop_store_read(bucket,aid)~="" then return "try again" end
	uploads[id]={kind=kind,aid=aid,total=total,parts={},got=0,at=time_global(),uid=me.uid,char=key,library=true,
		place=photo and extra or nil,secs=not photo and tonumber(extra) or nil}
end
function handlers.gbeg(id, me, key, args) return library_begin(id,me,key,args,"photo") end
function handlers.rbeg(id, me, key, args) return library_begin(id,me,key,args,"audio") end
function handlers.gdel(id, me, key, args)
	local aid=string.match(args or "", "^(%x+)$")
	update("pda_gallery",key,function(list)
		for i,p in ipairs(list or {}) do if p.id==aid then table.remove(list,i);return list end end
	end)
	handlers.library(id,me,key)
end
function handlers.rdel(id, me, key, args)
	local aid=string.match(args or "", "^(%x+)$")
	update("pda_records",key,function(list)
		for i,p in ipairs(list or {}) do if p.id==aid then table.remove(list,i);return list end end
	end)
	handlers.library(id,me,key)
end
function handlers.settings(id, me, key, args)
	local name,value=string.match(args or "", "^([%w_]+) ([%w_]+)$")
	-- Whitelisted PDA preferences only. Never engine settings or credentials.
	if not name or not ({notifications=true,theme=true})[name] or #value>24 then return "bad setting" end
	update("pda_settings",key,function(v) v=v or {};v[name]=value;return v end)
	handlers.library(id,me,key)
end

local function upload_done(id, u)
	uploads[id] = nil
	local photo = u.kind == "photo"
	local bucket = photo and "pda_photo" or "pda_audio"
	local data = table.concat(u.parts)
	-- a photo is a DDS file: base64 of "DDS " starts with "RERT"
	if not string.match(data, "^[%w%+/]+=*$") or (photo and string.sub(data, 1, 4) ~= "RERT") then
		send(id, "err", photo and "bad photo" or "bad record") return
	end
	local n = math.ceil(#data / AUDIO_PART)
	for i = 1, n do
		if not netcoop_store_swap(bucket, u.aid .. "_" .. i, netcoop_store_read(bucket, u.aid .. "_" .. i),
			string.sub(data, (i - 1) * AUDIO_PART + 1, i * AUDIO_PART)) then send(id,"err","try again");return end
	end
	local meta = photo and { device=u.char, library=u.library, cid = u.cid, parts = n, by = u.uid, place = u.place, g = game_minutes() }
		or { device=u.char, library=u.library, cid = u.cid, parts = n, secs = u.secs, by = u.uid }
	if not netcoop_store_swap(bucket, u.aid, "", ser(meta)) then
		send(id, "err", "try again") return
	end
	if u.library then
		local index = photo and "pda_gallery" or "pda_records"
		local _, ok = update(index,u.char,function(list)
			list=list or {}
			for _,p in ipairs(list) do if p.id==u.aid then return nil end end
			table.insert(list,1,{id=u.aid,g=game_minutes(),level=u.place,secs=u.secs,bytes=math.floor(#data*3/4)})
			while #list>(photo and 60 or 20) do table.remove(list) end
			return list
		end)
		if not ok then send(id,"err","try again");return end
		send(id,"stored",{device=u.char,id=u.aid,kind=u.kind})
		return
	end
	local msg
	if photo then msg = post(u.cid, u.uid, "photo", "", u.aid .. " " .. u.place .. " " .. #data)
	else msg = post(u.cid, u.uid, "voice", "", u.aid .. " " .. u.secs) end
	if msg then mark_read(u.char, u.cid, msg.s) end
	send(id, photo and "psent" or "asent", { aid = u.aid, cid = u.cid })
end

-- aup <aid> <n> <part> : no profile work per part (many arrive per second)
local function audio_part(id, args)
	local aid, n, part = string.match(args, "^(%x+) (%d+) ([%w%+/=]+)$")
	local u = uploads[id]
	n = tonumber(n)
	if not (u and aid == u.aid and n and n >= 1 and n <= u.total and #part <= 3800) then return "" end
	if not u.parts[n] then u.parts[n] = part; u.got = u.got + 1 end
	u.at = time_global()
	if u.got == u.total then upload_done(id, u) end
	return ""
end

-- aget <aid> / pget <pid> : the record or photo, for members of its chat
local function fetch(id, me, args, bucket, verb, missing)
	local aid = string.match(args, "^(%x+)$")
	local meta = aid and read(bucket, aid)
	if not meta then return missing end
	local _, key=profile(id)
	local authorized=false
	if meta.library then
		for _,p in ipairs(read(bucket=="pda_photo" and "pda_gallery" or "pda_records",key) or {}) do if p.id==aid then authorized=true end end
	else authorized=me.chats[meta.cid]~=nil or meta.by==me.uid end
	if not authorized and netcoop_pda_storage then authorized=netcoop_pda_storage.attachment(key,bucket=="pda_photo" and "photo" or "voice",aid) end
	if not authorized then return missing end
	local out = {}
	for i = 1, tonumber(meta.parts) or 0 do out[i] = netcoop_store_read(bucket, aid .. "_" .. i) end
	send(id, verb, aid .. "|" .. table.concat(out))
end
function handlers.aget(id, me, char, args) return fetch(id, me, args, "pda_audio", "audio", "no such record") end
function handlers.pget(id, me, char, args) return fetch(id, me, args, "pda_photo", "photo", "no such photo") end

----------------------------------------------------------------------
-- PDA password (owner 2026-10-18): the network tabs of a locked PDA open
-- after "unlock <password>". Three wrong tries hold the PDA for 30 s. A
-- password makes the owner's PDA slower to hack (Devices below).
--   pda_lock/<device uid> { salt, hash }
----------------------------------------------------------------------
local unlocked, tries = {}, {} -- entity id -> true / { n, until_ms }
local LOCK_TRIES, LOCK_HOLD_MS = 3, 30000

-- Salted, iterated two-lane polynomial hash (plain arithmetic: no bit library).
local function lock_hash(salt, password)
	local h1, h2 = 5381, 52711
	local text = salt .. "|" .. password
	for round = 1, 2000 do
		for k = 1, #text do
			local b = string.byte(text, k)
			h1 = (h1 * 131 + b) % 2147483647
			h2 = (h2 * 137 + b + round) % 2147483629
		end
	end
	return string.format("%08x%08x", h1, h2)
end

local function lock_of(char) return read("pda_lock", char) end


function is_locked(id, char)
	return lock_of(char) ~= nil and unlocked[id] ~= char
end

-- unlock <password>
function handlers.unlock(id, me, char, args)
	local lock = lock_of(char)
	if not lock then unlocked[id] = char; state(id, me) return end
	local t = tries[id]
	if not t or t.device ~= char then t = { device = char, n = 0, until_ms = 0 } end
	tries[id] = t
	if time_global() < t.until_ms then return "pda held" end
	if lock_hash(lock.salt, args or "") ~= lock.hash then
		t.n = t.n + 1
		if t.n >= LOCK_TRIES then t.n, t.until_ms = 0, time_global() + LOCK_HOLD_MS end
		return "wrong password"
	end
	t.n = 0
	unlocked[id] = char
	state(id, me)
end

-- lockset <old>|<new>: set, change ("" new = remove); the old one must match
function handlers.lockset(id, me, char, args)
	local old, new = string.match(args or "", "^([^|]*)|([^|]*)$")
	if not old then return "bad password" end
	local lock = lock_of(char)
	if lock and lock_hash(lock.salt, old) ~= lock.hash then return "wrong password" end
	if new ~= "" and (#new < 3 or #new > 32) then return "password 3-32 characters" end
	if new == "" then
		netcoop_store_swap("pda_lock", char, netcoop_store_read("pda_lock", char) or "", "")
	else
		local salt = string.format("%08x", math.random(0, 2147483646))
		local text = ser({ salt = salt, hash = lock_hash(salt, new) })
		if not netcoop_store_swap("pda_lock", char, netcoop_store_read("pda_lock", char) or "", text) then return "try again" end
	end
	unlocked[id] = char
	state(id, read("pda_prof", char) or me)
end

----------------------------------------------------------------------
-- Devices (owner 2026-10-23: "every PDA its own unique ID; after a death
-- the PDA can be picked up and hacked - another player's, an NPC's").
-- Every PDA has a serial number of its own. A player's PDA belongs to the
-- character who first carried it in the PDA slot; in other hands (taken
-- from a body) it is someone else's device: it shows nothing of the new
-- holder's network, and it can be hacked. A hacked PDA shows what its
-- owner's network held until it left him (contacts, chats, notes) and can
-- be reset to serve its new holder. An NPC's PDA (GAMMA's itm_pda_*) keeps
-- GAMMA's messages; an encrypted one opens by hacking or, as in GAMMA, at a
-- technician. Its messages travel with it between the servers.
--   pda_dev/<item uid>   { serial, owner = char ("" reset / an NPC's), npc = { name, comm },
--                          level 1-3, lock = the owner had a password, sealed = os time
--                          it left its owner, hacked = { char = os time } }
--   pda_serial/<serial>  <item uid>
--   pda_npc/<item uid>   GAMMA's { state, contact, msg } of an NPC's PDA
--   pda_stash/<char>     { [stash name] = { l = level, h = hint } } - stashes
--                        an NPC's PDA showed him, until they are opened
----------------------------------------------------------------------
local HACK_SECONDS = { 20, 40, 60 } -- by the device's protection level
local HACK_LOCK_SECONDS = 30        -- more when the owner had a password
local DUMP_CHATS, DUMP_MSGS, DUMP_TEXT = 15, 30, 200
local hacking = {}                  -- entity id -> { uid, item, kind, done_at, total }

local function npc_pda(section)
	local t = item_device and item_device.device_npc_pda
	if t and t[section] then return true end
	return string.find(section, "^itm_pda_") ~= nil
end

local function item_uid(item)
	local uid = item and netcoop_item_uid and netcoop_item_uid(item:id()) or ""
	return uid ~= "" and uid or nil
end

local function protection(section)
	if section == "itm_pda_rare" or string.find(section, "milspec", 1, true) then return 3 end
	if section == "itm_pda_uncommon" then return 2 end
	local n = tonumber(string.match(section, "^device_pda_(%d)"))
	return math.max(1, math.min(3, n or 1))
end

local function new_serial(uid)
	for _ = 1, 50 do
		local serial = string.format("%04X-%04X", math.random(0, 65535), math.random(0, 65535))
		if netcoop_store_swap("pda_serial", serial, "", uid) then return serial end
	end
end

-- The device's record, made on first sight: owner = the player carrying it.
local function device_record(uid, section, owner, npc)
	local r = read("pda_dev", uid)
	if r then return r end
	local serial = new_serial(uid)
	if not serial then return nil end
	local fresh = { serial = serial, owner = owner or "", npc = npc, level = protection(section), hacked = {} }
	if netcoop_store_swap("pda_dev", uid, "", ser(fresh)) then
		printf("[Lost Zone] pdanet: PDA %s (%s) %s", serial, section, owner and ("belongs to " .. owner) or "of an NPC")
		return fresh
	end
	netcoop_store_swap("pda_serial", serial, uid, "") -- another server made it meanwhile
	return read("pda_dev", uid)
end

-- The PDA the player whose Actor is id carries in the PDA slot, bound,
-- sealed or given back as it changes hands.
function held_device(id, char)
	local actor = level.object_by_id(id)
	local item = actor and actor:item_in_slot(8)
	if not item or npc_pda(item:section()) then return nil end
	local uid = item_uid(item)
	local r = uid and device_record(uid, item:section(), char)
	if not r then return nil end
	if r.owner == "" and not r.npc then
		r = update("pda_dev", uid, function(v)
			if v and v.owner == "" then v.owner, v.sealed, v.hacked, v.lock = char, nil, {}, nil return v end
		end)
	elseif r.owner == char and r.sealed then
		-- back with its owner: what others did with it no longer counts
		r = update("pda_dev", uid, function(v)
			if v and v.owner == char and v.sealed then v.sealed, v.hacked, v.lock = nil, {}, nil return v end
		end)
	elseif r.owner ~= char and not r.sealed then
		local lock = read("pda_lock", uid) ~= nil
		r = update("pda_dev", uid, function(v)
			if v and v.owner ~= char and not v.sealed then v.sealed, v.lock = now(), lock return v end
		end)
	end
	if not r then return nil end
	r.hacked = r.hacked or {}
	return { uid = uid, item = item:id(), rec = r, own = r.owner == char }
end

function accessible(id, d)
 local character=char_of(id)
 return d~=nil and (d.own or d.rec.hacked[character]~=nil) and not is_locked(id,d.uid)
end

-- The forward declaration is local for calls made earlier in this module.
-- Map/marks adapters call through the script namespace, so export it too.
getfenv(1).held_device = held_device

local function hack_progress(id, uid, v)
	local h = hacking[id]
	if h and h.uid == uid then v.hack_left, v.hack_total = math.max(0, h.done_at - time_global()), h.total end
	return v
end

-- What the holder sees of his device: its serial; of someone else's also
-- the protection, and the owner's name once it is hacked.
function device_view(id, char, d)
	if not d then return { none = true } end
	local r = d.rec
	local v = { uid = d.uid, item = d.item, serial = r.serial, own = d.own, level = r.level }
	if d.own and netcoop_store_read("pda_profile_migrated",char)==d.uid then
		local old=read("pda_prof",char)
		v.legacy_uid=old and old.uid
	end
	if not d.own then
		v.lock = r.lock == true
		v.hacked = r.hacked[char] ~= nil
		if v.hacked then
			local owner = read("pda_prof", d.uid)
			v.owner = owner and owner.name or "?"
		end
		hack_progress(id, d.uid, v)
	end
	return v
end

-- GAMMA's messages of an NPC's PDA: the record that travels between the
-- servers, merged with this server's GAMMA storage (a technician's unlock,
-- a stash already read here). Stash messages get the stash's name and
-- map, which hold on every server.
local function npc_info(item_id, uid)
	local here = se_load_var(item_id, nil, "info")
	local info = read("pda_npc", uid)
	if not info then info = here end
	if type(info) ~= "table" then return nil end
	if type(here) == "table" and here.state == "default" then info.state = "default" end
	for i, m in ipairs(info.msg or {}) do
		local h = type(here) == "table" and here.msg and here.msg[i]
		if h and h.stash_read then m.stash_read = true end
		if m.stash and not m.stash_name then
			local se = alife_object(m.stash)
			if se then
				m.stash_name = se:name()
				m.stash_level = alife():level_name(game_graph():vertex(se.m_game_vertex_id):level_id())
			end
		end
	end
	return info
end

local function save_npc_info(item_id, uid, info)
	se_save_var(item_id, nil, "info", info)
	update("pda_npc", uid, function() return info end)
end

-- An NPC's PDA the player whose Actor is id carries.
local function npc_device(id, item_id)
	local item = item_id and level.object_by_id(item_id)
	if not (item and npc_pda(item:section())) then return nil end
	local parent = item:parent()
	if not (parent and parent:id() == id) then return nil end
	local uid = item_uid(item)
	if not uid then return nil end
	local info = npc_info(item_id, uid)
	local contact = info and info.contact or {}
	local r = device_record(uid, item:section(), nil, { name = contact.name or "", comm = contact.comm or "" })
	if not r then return nil end
	r.hacked = r.hacked or {}
	return { uid = uid, item = item_id, rec = r, own = false, info = info }
end

local function npc_view(id, d)
	return hack_progress(id, d.uid, { id = d.item, serial = d.rec.serial, level = d.rec.level, info = d.info or false })
end

-- device: the holder's device state again
function handlers.device(id, me, char)
	send(id, "device", device_view(id, char, held_device(id, char)))
end

local function inventory_tool(id, section, requested)
	local actor, found = level.object_by_id(id), nil
	if not (actor and actor.iterate_inventory) then return nil end
	actor:iterate_inventory(function(_, item)
		local parent = item and item:parent()
		if not found and item and item:section() == section and (not requested or item:id() == requested)
			and parent and parent:id() == id then
			local uid = item_uid(item)
			local uses = uid and read("pda_tool", uid)
			if uid and (not uses or (uses.left or 0) > 0) then found = {item = item:id(), uid = uid} end
		end
	end)
	return found
end

-- hack [<NPC PDA item id>]: the PDA in the slot, or an NPC's PDA carried
local function start_hack(id, char, d, kind)
	local h = hacking[id]
	if h and h.uid == d.uid then return end
	local tool = inventory_tool(id, "lz_pda_hack_usb")
	if not tool then return "hack flash drive required" end
	local total = ((HACK_SECONDS[d.rec.level] or 60) + (d.rec.lock and HACK_LOCK_SECONDS or 0)) * 1000
	hacking[id] = { uid = d.uid, item = d.item, kind = kind, tool = tool, total = total, done_at = time_global() + total }
	printf("[Lost Zone] pdanet: %s hacks PDA %s (%s s)", char, d.rec.serial, tostring(total / 1000))
	return nil
end
function handlers.hack(id, me, char, args)
	local item_id = tonumber(args)
	if item_id then
		local d = npc_device(id, item_id)
		if not (d and d.info) then return "no device" end
		if d.info.state ~= "encrypted" then send(id, "npc", npc_view(id, d)) return end
		local err = start_hack(id, char, d, "npc"); if err then return err end
		send(id, "npc", npc_view(id, d))
		return
	end
	local d = held_device(id, char)
	if not d then return "no device" end
	if d.own then return "own device" end
	if not d.rec.hacked[char] then local err = start_hack(id, char, d, "player"); if err then return err end end
	send(id, "device", device_view(id, char, d))
end

function handlers.hack_stop(id, me, char)
	hacking[id] = nil
	send(id, "device", device_view(id, char, held_device(id, char)))
end

local function clip(text, n)
	text = text or ""
	return #text > n and (string.sub(text, 1, n) .. "...") or text
end

-- dump: what a hacked PDA's owner had on it when it left him
function handlers.dump(id, me, char)
	local d = held_device(id, char)
	if not (d and not d.own and d.rec.hacked[char]) then return "not hacked" end
	local owner = read("pda_prof", d.uid)
	if not owner then return "no data" end
	owner.contacts, owner.chats = owner.contacts or {}, owner.chats or {}
	local sealed = now()
	local contacts = {}
	for uid in pairs(owner.contacts) do
		local c = view(owner, uid)
		contacts[#contacts + 1] = { uid = c.uid, name = c.name, icon = c.icon }
	end
	local chats = {}
	for cid in pairs(owner.chats) do
		local c = read("pda_chat", cid)
		if c and c.kind ~= "general" then
			local kept = {}
			for _, m in ipairs(c.msgs or {}) do
				if (m.t or 0) <= sealed then kept[#kept + 1] = m end
			end
			while #kept > DUMP_MSGS do table.remove(kept, 1) end
			if #kept > 0 then
				local msgs = shown(owner, kept)
				for _, m in ipairs(msgs) do m.x, m.d = clip(m.x, DUMP_TEXT), nil end
				local s = summary(owner, cid) or {}
				chats[#chats + 1] = { id = cid, kind = c.kind, name = c.name, peer = s.peer, msgs = msgs, t = kept[#kept].t or 0 }
			end
		end
	end
	table.sort(chats, function(a, b) return a.t > b.t end)
	while #chats > DUMP_CHATS do table.remove(chats) end
	local notes = {}
	for _, n in ipairs(read("pda_memo", d.uid) or {}) do
		if (n.t or 0) <= sealed and #notes < 20 then
			notes[#notes + 1] = { title = n.title, text = clip(n.text, 600), t = n.t, g = n.g }
		end
	end
	printf("[Lost Zone] pdanet: %s read PDA %s of %s", char, d.rec.serial, d.rec.owner)
	send(id, "dump", { serial = d.rec.serial, owner = { name = owner.name, uid = owner.uid, icon = owner.icon },
		sealed = sealed, contacts = contacts, chats = chats, notes = notes })
end

-- Factory reset keeps hardware serial but removes its data and old network ID.
function handlers.wipe(id, me, char)
	local d = held_device(id, char)
	if not (d and not d.own and d.rec.hacked[char]) then return "not hacked" end
	if not netcoop_pda_storage or not netcoop_pda_storage.factory_reset(d,char) then return "try again" end
	unlocked[id] = nil
	printf("[Lost Zone] pdanet: %s reset physical PDA %s", char, d.rec.serial)
	state(id, profile(id))
end

-- npc_open <item id>: GAMMA's messages of an NPC's PDA, from the server
function handlers.npc_open(id, me, char, args)
	local d = npc_device(id, tonumber(args))
	if not d then return "no device" end
	if d.info then save_npc_info(d.item, d.uid, d.info) end
	send(id, "npc", npc_view(id, d))
end

-- Stashes an NPC's PDA showed this player: filled by the server of their
-- map (GAMMA's own loot) and marked on his map until someone opens them.
local stash_sent = {} -- entity id -> { [stash name] = true }
local function stash_spot(id, sid, hint, add)
	send(id, "spot", { id = sid, h = hint or "", add = add })
end
local function stash_here(name)
	local ok, se = pcall(function() return alife():object(name) end)
	return ok and se or nil
end
local function sync_stashes(id, char)
	local list = read("pda_stash", char)
	if not list then return end
	stash_sent[id] = stash_sent[id] or {}
	local gone = {}
	for name, s in pairs(list) do
		if s.l == level.name() then
			local se = stash_here(name)
			local cache = se and treasure_manager and treasure_manager.caches and treasure_manager.caches[se.id]
			if not se or cache == nil or cache == true then
				gone[#gone + 1] = name -- opened (or no stash any more)
				if se and stash_sent[id][name] then stash_spot(id, se.id, "", false) end
				stash_sent[id][name] = nil
			else
				if cache == false then pcall(treasure_manager.set_random_stash, true, s.h, nil, se.id) end
				if not stash_sent[id][name] then stash_spot(id, se.id, s.h, true); stash_sent[id][name] = true end
			end
		end
	end
	if #gone > 0 then
		update("pda_stash", char, function(t)
			if not t then return nil end
			for _, name in ipairs(gone) do t[name] = nil end
			return t
		end)
	end
end

-- npc_stash <item id> <stash id> <hint>: the player read a stash message
function handlers.npc_stash(id, me, char, args)
	local item_id, sid, hint = string.match(args or "", "^(%d+) (%d+) ?(.*)$")
	local d = npc_device(id, tonumber(item_id))
	if not (d and d.info and d.info.state == "default") then return "no device" end
	local found
	for _, m in ipairs(d.info.msg or {}) do
		if m.stash and tostring(m.stash) == sid then found = m end
	end
	if not (found and found.stash_name) then return "no stash" end
	hint = clip(string.gsub(hint or "", "[%c]", " "), 300)
	found.stash_read = true
	save_npc_info(d.item, d.uid, d.info)
	local receiver = held_device(id, char)
	if not receiver or (not receiver.own and not receiver.rec.hacked[char]) then return "no device" end
	update("pda_stash", receiver.uid, function(t)
		t = t or {}
		if t[found.stash_name] then return nil end
		t[found.stash_name] = { l = found.stash_level, h = hint }
		return t
	end)
	printf("[Lost Zone] pdanet: %s learned stash %s (%s) from PDA %s", char, found.stash_name, tostring(found.stash_level), d.rec.serial)
	sync_stashes(id, receiver.uid)
end

-- Every poll: devices changing hands, hacks running, stashes to show.
local device_key, next_stash, foreign_held = {}, {}, {}
local function devices_update(id, char, me)
	local d = held_device(id, char)
	local h = hacking[id]
	if h then
		local still
		if h.kind == "npc" then
			local item = level.object_by_id(h.item)
			local parent = item and item:parent()
			still = parent and parent:id() == id
		else
			still = d and d.uid == h.uid
		end
		local actor = level.object_by_id(id)
		local tool = inventory_tool(id, "lz_pda_hack_usb", h.tool.item)
		if not still or not (actor and actor:alive()) or not tool or tool.uid ~= h.tool.uid then
			hacking[id] = nil
			send(id, "err", "hack interrupted")
		elseif time_global() >= h.done_at then
			local _, consumed = update("pda_tool", h.tool.uid, function(v)
				v = v or {left = 5}
				if v.left <= 0 then return nil end
				v.left = v.left - 1
				return v
			end)
			if not consumed then hacking[id] = nil; send(id, "err", "hack flash drive exhausted"); return end
			local tool_item=level.object_by_id(h.tool.item)
			local uses=read("pda_tool",h.tool.uid)
			if tool_item and tool_item.set_condition and uses then tool_item:set_condition(math.max(0,(uses.left or 0)/5)) end
			hacking[id] = nil
			if h.kind == "npc" then
				local nd = npc_device(id, h.item)
				if nd and nd.info then
					nd.info.state = "default"
					save_npc_info(nd.item, nd.uid, nd.info)
					update("pda_dev", nd.uid, function(v) if v then v.hacked = v.hacked or {}; v.hacked[char] = now() return v end end)
					send(id, "npc", npc_view(id, nd))
				end
			else
				update("pda_dev", h.uid, function(v) if v then v.hacked = v.hacked or {}; v.hacked[char] = now() return v end end)
				if d then d.rec.hacked[char] = now(); unlocked[id] = d.uid end
			end
			printf("[Lost Zone] pdanet: %s hacked PDA %s", char, h.uid)
		elseif h.kind == "npc" then
			local nd = npc_device(id, h.item)
			if nd then send(id, "npc", npc_view(id, nd)) end
		else
			send(id, "device", device_view(id, char, d))
		end
	end
	foreign_held[id] = d ~= nil and not d.own and not d.rec.hacked[char]
	local key = d and (d.uid .. (d.own and "+" or "-") .. (d.rec.hacked[char] and "h" or "")) or ""
	if key ~= device_key[id] then
		device_key[id] = key
		state(id, me)
	end
	if time_global() >= (next_stash[id] or 0) then
		next_stash[id] = time_global() + 10000
		if d then sync_stashes(id, d.uid) end
	end
end

-- Device verbs work whatever the holder's own network is (locked, or
-- someone else's PDA in the slot).
local DEVICE_VERBS = { device = true, hack = true, hack_stop = true, dump = true, wipe = true, npc_open = true, npc_stash = true }

-- Flood limit for what other players see (README В«Р»РёРјРёС‚С‹ СЃРѕРѕР±С‰РµРЅРёР№В»): per
-- player a budget of BURST posts refilled at one per RATE_MS; "aup" parts,
-- reads and lists are not counted.
local LIMITED = { say = true, msg = true, dm = true, group = true, pay = true, abeg = true, pbeg = true, gbeg = true, rbeg = true, add = true, usb_backup = true, usb_restore = true }
local BURST, RATE_MS = 6, 1500
local budget = {} -- entity id -> { n, at }
local function allowed(id)
	local now = time_global()
	local b = budget[id] or { n = BURST, at = now }
	b.n = math.min(BURST, b.n + (now - b.at) / RATE_MS)
	b.at = now
	budget[id] = b
	if b.n < 1 then return false end
	b.n = b.n - 1
	return true
end

function command(entity_id, args)
	local verb, rest = string.match(args or "", "^([%a_]+)%s?(.*)$")
	if verb == "aup" then
		local u = uploads[entity_id]
		local d = held_device(entity_id, char_of(entity_id))
		if not (u and d and d.uid == u.char and (d.own or d.rec.hacked[char_of(entity_id)]) and not is_locked(entity_id, d.uid)) then uploads[entity_id] = nil; return "" end
		return audio_part(entity_id, rest or "")
	end
	local handler = verb and handlers[verb]
	if verb and string.match(verb, "^usb_") and netcoop_pda_storage then
		handler = function(id, me, key, rest)
			local result, err = netcoop_pda_storage.command(id, verb, rest)
			if err then return err end
			if verb=="usb_restore" then uploads[id]=nil end
			send(id, "storage", result)
			if verb == "usb_restore" then state(id, profile(id)); send_notes(id, key); handlers.library(id,me,key) end
		end
	end
	if not handler then return "" end
	if LIMITED[verb] and not allowed(entity_id) then
		send(entity_id, "err", "too many messages, wait a moment")
		return ""
	end
	local me, key = profile(entity_id)
	local character = char_of(entity_id)
	local char = DEVICE_VERBS[verb] and character or key
	if not me and not DEVICE_VERBS[verb] then send(entity_id, "err", "no device"); return "" end
	if character == "" then return "" end
	me = me or {contacts = {}, chats = {}}
	-- someone else's PDA in the slot: only its own verbs
	if verb ~= "hello" and not DEVICE_VERBS[verb] then
		local d = holding(entity_id, character)
		if not d or (not d.own and not d.rec.hacked[character]) then
			send(entity_id, "err", "foreign device")
			return ""
		end
	end
	-- a locked PDA answers only its state and the password
	if verb ~= "hello" and verb ~= "unlock" and verb ~= "lockset" and not DEVICE_VERBS[verb] and is_locked(entity_id, char) then
		send(entity_id, "err", "locked")
		return ""
	end
	local ok, err = pcall(handler, entity_id, me, char, rest or "")
	if not ok then
		printf("! [Lost Zone] pdanet %s failed: %s", verb, tostring(err))
	elseif err then
		send(entity_id, "err", tostring(err))
	end
	return ""
end

----------------------------------------------------------------------
-- Polling (every 2 s): new messages for players here, from any server
----------------------------------------------------------------------
local next_poll, general_seq, pushed = 0, nil, {}
local next_state, shown_requests = {}, {}

-- Money sent to a player here: taken from the store (compare-and-swap, so
-- only one server pays it) and given to his Actor.
local function pay_out(char, id)
	local text = netcoop_store_read("pda_pay", char)
	if text == "" then return end
	local actor = level.object_by_id(id)
	if not actor then return end
	if not netcoop_store_swap("pda_pay", char, text, "") then return end -- changed meanwhile: next poll
	local v = de(text)
	local sum = v and tonumber(v.sum) or 0
	if sum > 0 then
		actor:give_money(sum)
		send(id, "paid", { amount = sum })
		printf("[Lost Zone] pdanet transfer paid to %s: %s RU", char, sum)
	end
end

function update_world()
	if time_global() < next_poll then return end
	next_poll = time_global() + 2000
	for actor_id in string.gmatch(netcoop_players and netcoop_players() or "", "%d+") do
		actor_id = tonumber(actor_id)
		local current = profile(actor_id)
		local ok, err = pcall(devices_update, actor_id, char_of(actor_id), current or {})
		if not ok then printf("! [Lost Zone] pdanet devices: %s", tostring(err)) end
		pay_out(char_of(actor_id), actor_id)
	end
	local here = local_players()
	-- the general channel
	local g = read("pda_chat", "general")
	local seq = g and g.seq or 0
	if general_seq == nil then general_seq = seq end
	if seq > general_seq then
		for char, id in pairs(here) do
			local me = read("pda_prof", char)
			if me and not is_locked(id,char) and not foreign_held[id] then send(id, "general", shown(me, g.msgs, general_seq)) end
		end
		general_seq = seq
	end
	-- private and group chats
	for char, id in pairs(here) do
		local notes = read("pda_note", char) or {}
		local login = pushed[char] == nil -- first look after login: "hello" gave the list
		local seen = pushed[char] or {}
		pushed[char] = seen
		local me
		for cid, s in pairs(notes) do
			-- a chat that appears later (a new group, a first message) is sent whole
			if seen[cid] == nil then seen[cid] = login and s or 0 end
			if s > seen[cid] then
				me = me or read("pda_prof", char)
				local c = read("pda_chat", cid)
				if me and c and me.chats[cid] and not is_locked(id, char) and not foreign_held[id] then
					send(id, "new", { id = cid, summary = summary(me, cid), msgs = shown(me, c.msgs, seen[cid]) })
				end
				seen[cid] = s
			end
		end
		local current = profile(id)
		local requests = current and requests_key(current)
		if current and (time_global() >= (next_state[char] or 0) or (shown_requests[char] and requests ~= shown_requests[char])) then
			state(id, current)
			next_state[char] = time_global() + HEARTBEAT * 1000
		end
		shown_requests[char] = requests
	end
	for char in pairs(pushed) do if not here[char] then pushed[char], next_state[char], shown_requests[char] = nil, nil, nil end end
	local present = {}
	for id in string.gmatch(netcoop_players and netcoop_players() or "", "%d+") do present[tonumber(id)] = true end
	for id in pairs(device_key) do
		if not present[id] then device_key[id], hacking[id], stash_sent[id], next_stash[id], foreign_held[id] = nil, nil, nil, nil, nil end
	end
	for id, u in pairs(uploads) do
		if time_global() - u.at > 60000 then uploads[id] = nil end -- abandoned upload
	end
end
