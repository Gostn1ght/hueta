-- GAMMA modules have process-global caches; character saves must not.
local current_id, current
local fetch_save, fetch_load
local offer_tables = setmetatable({}, {__mode = "k"})

-- Only ordinary item requests are independent instances of one template.
-- Story/world targets and escort squads must keep their exclusive claim.
function personal_task(id)
    local ini = task_manager and task_manager.task_ini
    local text = ini and ini:r_string_ex(id, "on_complete") or ""
    for _, action in ipairs({"fetch_reward_and_remove", "remove_fetch_item", "remove_artefact_item", "multifetch_remove"}) do
        if text:find(action .. "(", 1, true) then return true end
    end
    return false
end

local function install_offers()
    local tm = axr_task_manager
    if not (tm and tm.generate_available_tasks) or tm.__netcoop_offers then return end
    tm.__netcoop_offers = true
    local generate = tm.generate_available_tasks
    tm.generate_available_tasks = function(npc, is_sim)
        if not current then return generate(npc, is_sim) end
        local st = db.storage[npc:id()]
        if not st then return generate(npc, is_sim) end
        current.dyn_quests = current.dyn_quests or {}
        -- A spawn name survives a server restart; runtime network IDs do not.
        local key = npc:name()
        local old = st.dyn_quest_rand
        st.dyn_quest_rand = current.dyn_quests[key]
        local ok, err = pcall(function()
            generate(npc, is_sim)
            if is_sim and #(tm.available_tasks[npc:id()] or {}) == 0 then
                -- A completed/locked old choice and SP's cached "nil" must
                -- not hide all other valid work for this player indefinitely.
                local prefix = st.ini and st.section_logic and st.ini:r_string_ex(st.section_logic, "task_section")
                prefix = prefix and (prefix .. "_task_") or "simulation_task_"
                local candidates = {}
                local history = task_manager.get_task_manager().task_info
                for id in pairs(tm.CFG_CACHE or {}) do
                    if starts_with(id, prefix) and not history[id] and
                        xr_conditions.has_completed_task_prerequisites(nil, nil, {id}) then
                        local communities = parse_list(task_manager.task_ini, id, "sim_communities", true)
                        if communities[character_community(npc)] then candidates[#candidates + 1] = id end
                    end
                end
                table.sort(candidates)
                if #candidates > 0 then
                    st.dyn_quest_rand = candidates[math.random(#candidates)]
                    generate(npc, true) -- retain GAMMA's actual filtering and offer shape
                end
            end
            current.dyn_quests[key] = st.dyn_quest_rand ~= "nil" and st.dyn_quest_rand or nil
        end)
        st.dyn_quest_rand = old
        if not ok then error(err, 0) end
    end
end

local function flush()
    if not current then return end
    if tasks_multifetch and tasks_multifetch.save_state then
        local snapshot = {}; tasks_multifetch.save_state(snapshot)
        current.multifetch = snapshot.multifetch_data or {}
    end
    if axr_task_manager then current.bounties = axr_task_manager.bounties_by_id or {} end
    if fetch_save then
        local snapshot = {}; fetch_save(snapshot)
        current.fetch = snapshot.tasks_fetch_ids or {}
    end
end

function capture(actor)
    if actor and actor:id() == current_id then flush() end
end

function bind_actor(actor)
    install_offers()
    local id = actor and actor:id()
    local storage = id and db.storage[id]
    local context
    if storage then
        storage.pstor = storage.pstor or {}
        context = storage.pstor.netcoop_quest_context
        if type(context) ~= "table" then
            context = {}; storage.pstor.netcoop_quest_context = context
        end
    end
    if current_id == id and current == context then return end
    flush()
    current_id, current = id, context
    if tasks_multifetch and tasks_multifetch.load_state then
        tasks_multifetch.load_state({multifetch_data = context and context.multifetch or {}})
    end
    if axr_task_manager then axr_task_manager.bounties_by_id = context and context.bounties or {} end
    if axr_task_manager then
        local offers = context and offer_tables[context]
        if not offers then
            offers = {}
            if context then offer_tables[context] = offers end
        end
        axr_task_manager.available_tasks = offers
        if axr_task_manager.clear_skipped_tasks then axr_task_manager.clear_skipped_tasks() end
    end
    if fetch_load then fetch_load({tasks_fetch_ids = context and context.fetch or {}}) end
end

-- Fetch's DIALOG_ID is private. Retain its real registered save/load handlers
-- rather than inspecting upvalues or copying GAMMA's item selection code.
function register_callback(name, handler)
    if (name ~= "save_state" and name ~= "load_state") or type(handler) ~= "function" then return end
    local module = rawget(_G, "tasks_fetch")
    if not module or getfenv(handler) ~= module then return end
    if name == "save_state" then fetch_save = handler else fetch_load = handler end
end
