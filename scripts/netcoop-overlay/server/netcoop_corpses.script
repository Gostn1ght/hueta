----------------------------------------------------------------------
-- Corpses (owner 2026-10-06)
----------------------------------------------------------------------
-- A corpse keeps the loot a freeplay NPC has (it can be searched as usual)
-- and disappears, with that loot, as in freeplay:
--   * when the server restarts: corpses of the loaded world are removed;
--   * while it runs: after corpse_time without any player within
--     PLAYER_RANGE (a player coming near starts the count again).
-- Story characters and corpses with quest items stay (as in GAMMA).
-- GAMMA's release_body_manager measured to db.actor, the hidden anchor Actor
-- of the dedicated server, so it is off here; and GAMMA's release queue
-- (safe_release_manager) never ran on the server (it starts from
-- actor_on_reinit): it runs from update() now.

corpse_time = 40 * 60            -- real seconds without a player near (tests may lower it)
local PLAYER_RANGE = 100         -- m
local CHECK_EVERY = 30000        -- ms

local next_check = 0
local restarted = true           -- the first check of this process removes the loaded world's corpses
local removing = {}              -- corpse id -> true: being switched offline, then released with its loot

local function tracked()
	local state = alife_storage_manager.get_state()
	state.netcoop_corpses = state.netcoop_corpses or {}
	return state.netcoop_corpses -- id -> real time a player was last near (death counts as near)
end

local function note_death(victim)
	if victim and victim.id then tracked()[victim:id()] = os.time() end
end

local function player_positions()
	local list = {}
	for id in string.gmatch(netcoop_players and netcoop_players() or "", "%d+") do
		local obj = level.object_by_id(tonumber(id))
		if obj then list[#list + 1] = obj:position() end
	end
	return list
end

local function near_player(pos, players)
	for _, p in ipairs(players) do
		if p:distance_to_sqr(pos) <= PLAYER_RANGE * PLAYER_RANGE then return true end
	end
	return false
end

local function protected(id)
	if netcoop_survival and netcoop_survival.protected_body(id) then return true end
	if get_object_story_id(id) then return true end
	local obj = level.object_by_id(id)
	if obj and utils_item and utils_item.has_quest_item and utils_item.has_quest_item(obj) then return true end
	return false
end

-- Any dead creature. GAMMA's IsMonster() knows the client classes only;
-- server objects of mutants have their own (*_s), so mutant corpses were
-- never recognised (2026-10-06). Player bodies count at a server start too
-- (owner 2026-10-19: they stayed after every restart); while it runs, only
-- tracked NPC/mutant deaths expire (a player goes back for his own body).
local function is_corpse(se, with_players)
	if not (se and se.alive) or se.id == 0 then return false end
	local cls = se:clsid()
	if not with_players and (cls == clsid.actor or cls == clsid.script_actor) then return false end
	local ok, alive = pcall(se.alive, se)
	return ok and alive == false
end

-- Corpses of this map in the loaded world (not only the tracked ones: some
-- died before this module existed).
local function corpses_on_map(sim)
	local list = {}
	local here = level.name()
	local gg = game_graph()
	for i = 1, 65534 do
		local se = sim:object(i)
		if is_corpse(se, true) then
			local vertex = gg:vertex(se.m_game_vertex_id)
			if vertex and sim:level_name(vertex:level_id()) == here then list[#list + 1] = i end
		end
	end
	return list
end

-- Its items and then the body are released. An online body was switched
-- offline first (GAMMA's way), but the server keeps everything within its
-- switch distance online: those corpses waited forever (owner 2026-10-19,
-- 17 of 19 corpses stayed). Releasing an online body works the same.
local function process_removals(sim)
	if not next(removing) then return end
	local children = nil
	for id in pairs(removing) do
		local se = sim:object(id)
		-- Reservation/story protection can appear after the previous frame
		-- queued this corpse. Recheck before releasing it or its children.
		if protected(id) then
			removing[id] = nil
		elseif not se then
			removing[id] = nil
		else
			if not children then
				children = {}
				for i = 1, 65534 do
					local item = sim:object(i)
					if item and item.parent_id and removing[item.parent_id] then
						children[item.parent_id] = children[item.parent_id] or {}
						table.insert(children[item.parent_id], item)
					end
				end
			end
			for _, item in ipairs(children[id] or {}) do sim:release(item, true) end
			sim:release(se, true)
			removing[id] = nil
			tracked()[id] = nil
		end
	end
end

local function remove(id)
	removing[id] = true
end

function update()
	if safe_release_manager and safe_release_manager.execute_destroy_callback then
		safe_release_manager.execute_destroy_callback()
	end
	local sim = alife()
	if not sim then return end
	process_removals(sim)
	local t = time_global()
	if t < next_check then return end
	next_check = t + CHECK_EVERY
	local list = tracked()
	local now = os.time()
	if restarted then
		restarted = false
		local removed = 0
		for _, id in ipairs(corpses_on_map(sim)) do
			if not protected(id) then remove(id); removed = removed + 1 end
		end
		printf("[Lost Zone][corpses] server start: %s corpse(s) of the saved world removed", tostring(removed))
		return
	end
	local players = player_positions()
	local removed = 0
	for id, seen in pairs(list) do
		local se = sim:object(id)
		if not is_corpse(se) then
			list[id] = nil
		elseif not removing[id] then
			if near_player(se.position, players) then
				list[id] = now
			elseif now - seen >= corpse_time and not protected(id) then
				remove(id)
				removed = removed + 1
			end
		end
	end
	if removed > 0 then printf("[Lost Zone][corpses] %s corpse(s) removed (no player near)", tostring(removed)) end
end

function on_game_start()
	if not (netcoop_enabled and netcoop_enabled()) or (netcoop_pure_client and netcoop_pure_client()) then return end
	RegisterScriptCallback("npc_on_death_callback", note_death)
	RegisterScriptCallback("monster_on_death_callback", note_death)
	pcall(function()
		release_body_manager.Crelease_body.clear = function() end
		release_body_manager.get_release_body_manager().clear = function() end
	end)
end
