-- Lost Zone account and character frontend. Firebase credentials travel over
-- HTTPS to Google; the game server verifies the returned identity separately.
-- The native layer remembers a protected refresh token, never the password.

local LAST_FILE = "netcoop_last_server.txt"
local DEF_ADDR  = "127.0.0.1:5446"
local auth_return, auth_message
local wnd
local autojoin_done = false
local function cloud_enabled() return netcoop_firebase_request ~= nil end
local function account_state() return cloud_enabled() and netcoop_firebase_state() or netcoop_account_state() end
local function tr(id) return game.translate_string("st_netcoop_" .. id) end
local function email_valid(email)
    if #email > 254 then return false end
    local part, domain = string.match(email, "^([^@]+)@([^@]+)$")
    if not part or #part > 64 or part:sub(1,1) == "." or part:sub(-1) == "." or part:find("..",1,true) then return false end
    if part:find("[^A-Za-z0-9.!#$%%&'*+/=?^_`{|}~%-]") then return false end
    if not domain:find(".",1,true) or domain:find("[^A-Za-z0-9%.%-]") or domain:sub(1,1) == "." or domain:sub(-1) == "." or domain:find("..",1,true) then return false end
    for label in domain:gmatch("[^.]+") do
        if #label > 63 or label:sub(1,1) == "-" or label:sub(-1) == "-" then return false end
    end
    return true
end
function can_mcm() return netcoop_role and netcoop_role() == 2 end
function on_auth_result(ok, role, message)
    if wnd and wnd.role_probe then
        wnd.role_probe = nil; auth_return = nil
        if ok then auth_message = nil; wnd:ShowCharacters()
        else wnd:SetMsg(message or tr("auth_failed")) end
        return
    end
    if auth_return then auth_return = ok and "characters" or "account"; auth_message = message end
end

local function app_path(name)
	local ok, p = pcall(function() return getFS():update_path("$app_data_root$", name) end)
	return ok and p or name
end

-- Menu actions run through guard(): an error goes to the game log and to
-- appdata\logs\lostzone_menu_errors.log with the element name and the Lua
-- stack, and the menu keeps working. Repeats of one error are written once.
local last_error
local function log_error(element, trace)
	trace = tostring(trace)
	if last_error == element .. trace then return end
	last_error = element .. trace
	printf("! [Lost Zone][menu] %s failed: %s", element, trace)
	local f = io.open(app_path("logs\\lostzone_menu_errors.log"), "a")
	if f then
		local ok, stamp = pcall(os.date, "%Y-%m-%d %H:%M:%S")
		f:write(string.format("[%s] %s\n%s\n\n", ok and stamp or "?", element, trace))
		f:close()
	end
	pcall(function() get_console():execute("flush") end)
end
-- The craft-use tooltip mod (zzz_craft_use_in_tooltip_mcm) reads craft.ltx
-- into a local only at on_game_start; the loadout picker shows item tooltips
-- before any game: "attempt to index upvalue 'ini_craft'" on every tooltip
-- (owner's log 2026-10-10). The mod's own ini is given to it here.
local function craft_tooltip_ready()
	local m = rawget(_G, "zzz_craft_use_in_tooltip_mcm") or zzz_craft_use_in_tooltip_mcm
	if not (m and debug and debug.getupvalue and debug.setupvalue) then return end
	for _, fn_name in ipairs({ "getCraftableItems", "getCookableItems" }) do
		local fn = m[fn_name]
		if type(fn) == "function" then
			for n = 1, 32 do
				local name, value = debug.getupvalue(fn, n)
				if not name then break end
				if name == "ini_craft" and value == nil then debug.setupvalue(fn, n, ini_file("items\\settings\\craft.ltx")) end
				if name == "ini_cook" and value == nil then debug.setupvalue(fn, n, ini_file("items\\settings\\cook.ltx")) end
			end
		end
	end
end

-- Interactive room objects (menu_room object index -> label and action).
-- The objects themselves are the buttons: hover highlights, click activates.
local ROOM_OBJECTS = {
	[0] = {label = "obj_pda", action = "ShowServer"},
	[1] = {label = "obj_radio", action = "ShowRadio"},
	[2] = {label = "obj_character", action = "ShowCharacterView"},
	[3] = {label = "obj_settings", action = "ShowSettings"},
	[4] = {label = "obj_door", action = "DoorAction"},
}
-- The close-up in which one object stays clickable (the door is behind the
-- overview camera and is used from its own view).
local VIEW_OBJECT = {door = 4}
-- Keyboard order, left to right as seen from the room overview.
local KEY_ORDER = {0, 2, 1, 3}
local click_sound
local function play_click()
	pcall(function()
		click_sound = click_sound or sound_object("interface\\inv_button")
		click_sound:play(nil, 0, sound_object.s2d)
	end)
end
local function guard(element, fn)
	return function(...)
		local args = {...}
		local ok, trace = xpcall(function() return fn(unpack(args)) end,
			function(err) return debug.traceback(tostring(err), 2) end)
		if not ok then log_error(element, trace) end
		return ok
	end
end

local function read_last()
	local f = io.open(app_path(LAST_FILE), "r")
	if not f then return nil, nil end
	local line = f:read("*l")
	f:close()
	if not line then return nil, nil end
	local login, addr = string.match(line, "^([^|]*)|(.*)$")
	return login, addr
end

local function write_last(login, addr)
	local f = io.open(app_path(LAST_FILE), "w")
	if not f then return end
	f:write(string.format("%s|%s\n", login, addr))
	f:close()
end

local function check_values(login, pass)
	if login == "" then return "Enter a login" end
	if string.len(login) < 3 or string.len(login) > 20 or not string.match(login, "^[%w_%-%.]+$") then
		return "Login: 3-20 characters, letters, digits, _ - ."
	end
	if pass ~= "" and (string.len(pass) < 4 or string.len(pass) > 64) then return "Password: 4-64 characters" end
	return nil
end

local function parse_addr(addr)
	local ip, port = string.match(addr, "^%s*([%w%.%-]+):(%d+)%s*$")
	if not ip then
		ip = string.match(addr, "^%s*([%w%.%-]+)%s*$")
		port = "5446" -- the world master's entry (owner 2026-10-25)
	end
	return ip, port
end

-- Owner 2026-10-17: players enter only the world master's address. Its entry
-- names the location to connect to: the map the character was on last, Cordon
-- for a new one (owner 2026-10-24). Without a master there (a location
-- address) the address is used as it is. The typed address stays the
-- remembered one.
local function route_addr(ip, port, login, slot)
    if not netcoop_master_entry then return ip, port == "5446" and "1267" or port end -- older native binary
    if port == "1267" then port="5446" end -- remembered pre-gateway address
    local to = netcoop_master_entry(ip .. ":" .. port, login or "", tonumber(slot) or 0) or ""
    local rip, rport = string.match(to, "^([%w%.%-]+):(%d+)$")
    if rip then return rip, rport end
    local kind, state, location, retry = to:match("^(%a+)|([%a_]+)|([%w_]*)|(%d+)$")
    return nil, nil, state or "master_unavailable", location or "", math.max(1, math.min(30, tonumber(retry) or 3)), kind == "error"
end

class "netcoop_login_wnd" (CUIScriptWnd)

function netcoop_login_wnd:__init(owner) super()
	self.owner = owner
	self:SetAutoDelete(false)
	self:SetWndRect(Frect():set(0, 0, 1024, 768))

	local xml = CScriptXmlInit()
	xml:ParseFile("ui_netcoop_login.xml")
	self.account_background = xml:InitStatic("background", self)

	local function cap(path, text)
		local st = xml:InitStatic(path, self)
		st:TextControl():SetText(text)
		return st
	end
	self.title = cap("cap_title", tr("register_title"))
	self.cap_login = cap("cap_login", tr("account_login"))
	self.cap_pass = cap("cap_pass", tr("account_password"))
	self.cap_email = cap("cap_email", tr("email"))
	self.cap_addr = cap("cap_addr", tr("server"))
	self.brand = cap("brand", "LOST ZONE")
	self.brand_help = cap("brand_help", tr("cloud_help"))

	self.cap_code = cap("cap_code", tr("email_code"))
	self.ed_code = xml:InitEditBox("input_code", self)
	self.ed_code:Show(false); self.cap_code:Show(false)
	self.ed_email = xml:InitEditBox("input_email", self)
	self.ed_login = xml:InitEditBox("input_login", self)
	self.ed_pass = xml:InitEditBox("input_pass", self)
	self.cap_pass2 = cap("cap_pass2", tr("password_repeat"))
	self.ed_pass2 = xml:InitEditBox("input_pass2", self)
	self.ed_addr = xml:InitEditBox("input_addr", self)

	self.msg = xml:InitStatic("msg", self)
	self.msg:TextControl():SetText("")

	local function btn(path, text, handler)
		local b = xml:Init3tButton(path, self)
		b:TextControl():SetText(text)
		self:Register(b, path)
		self:Bind(path, handler, path == "btn_back")
		return b
	end
	self.login_button = btn("btn_enter", tr("existing_account"), self.OnLogin)
	self.register_button = btn("btn_reg", tr("register_send"), self.OnRegister)
	self.back_button = btn("btn_back", tr("back"), self.OnBack)
	self.reset_button = btn("btn_reset", tr("reset_password"), self.ResetPassword)
    self.register_tab = btn("tab_register", tr("registration_tab"), self.OpenRegistration)
    self.login_tab = btn("tab_login", tr("login_tab"), self.OpenLogin)
end

function netcoop_login_wnd:ShowAccountControls(show)
    pcall(function() self.ed_email:CaptureFocus(false); self.ed_login:CaptureFocus(false); self.ed_pass:CaptureFocus(false); self.ed_pass2:CaptureFocus(false); self.ed_code:CaptureFocus(false) end)
    for _, item in ipairs({self.account_background,self.brand,self.brand_help,self.title,self.cap_login,self.cap_pass,self.cap_pass2,self.cap_email,self.cap_addr,self.cap_code,
        self.ed_login,self.ed_pass,self.ed_pass2,self.ed_email,self.ed_addr,self.ed_code,self.msg,self.login_button,self.register_button,self.back_button,self.reset_button,self.register_tab,self.login_tab}) do
        item:Show(show)
    end
end
-- A route is checked asynchronously by the native worker. Never connect to
-- another map because the desired map is still starting or manually stopped.
function netcoop_login_wnd:RouteFailure(message)
    self.route_wait, self.role_probe = nil, nil
    auth_return = nil
    self.login_button:Enable(true); self.register_button:Enable(true)
    self.ed_login:Enable(true); self.ed_pass:Enable(true); self.ed_addr:Enable(true)
    self:SetMsg(message)
end
function netcoop_login_wnd:WithRoute(ip, port, login, slot, ready)
    local now = device():time_continual()
    self.route_wait = {ip=ip, port=port, login=login, slot=slot, ready=ready, deadline=now+600000, next_at=now}
    self:PollRoute()
end
function netcoop_login_wnd:PollRoute()
    local pending = self.route_wait
    if not pending then return end
    local now = device():time_continual()
    if now < pending.next_at then return end
    if now >= pending.deadline then return self:RouteFailure(tr("route_timeout")) end
    local ip, port, state, location, retry, failed = route_addr(pending.ip, pending.port, pending.login, pending.slot)
    if ip then self.route_wait=nil; pending.ready(ip, port); return end
    if failed then return self:RouteFailure(tr("route_error_" .. state)) end
    local known = {contacting=true, master_unavailable=true, recovering=true, starting=true, loading=true, running=true,
                   queued=true, memory=true, retry=true, master_wait=true, master_stopped=true, loading_timeout=true, stopped=true, saving=true}
    local caption = location ~= "" and tr("map_" .. location) or tr("route_master")
    self:SetMsg(string.format(tr("route_wait_" .. (known[state] and state or "starting")), caption))
    pending.next_at = now + retry*1000
end

function netcoop_login_wnd:CloseRoomView()
    self.room_view, self.room_pending = nil, nil
    if self.view_index ~= -1 then self.view_index = -1; netcoop_preview_focus(-1) end
    self.settings_pending, self.settings_open = nil, nil
    if self.server_panel then self.server_panel:Show(false) end
    if self.details_panel then self.details_panel:Show(false) end
    if self.radio_panel then self.radio_panel:Show(false) end
    if self.room_back then self.room_back:Show(false) end
end
function netcoop_login_wnd:OpenRoomView(kind, object)
    if self.room_view == kind then return self:CloseRoomView() end
    self:CloseRoomView()
    self.room_view, self.room_pending = kind, kind
    self.view_index = object
    self.hovered = -1
    if netcoop_preview_hover then netcoop_preview_hover(-1) end
    netcoop_preview_focus(object)
    self.room_back:Show(kind ~= "door")
end
-- One action at a time: no clicks while a request runs, a view opens or the
-- room camera moves.
function netcoop_login_wnd:Busy()
    if self.route_wait or auth_return == "pending" or self.settings_pending or self.room_pending then return true end
    return self.mode == "characters" and netcoop_preview_ready ~= nil and not netcoop_preview_ready()
end
-- Every click is logged, ignored while busy (unless always) and guarded.
function netcoop_login_wnd:Bind(id, handler, always)
    self:AddCallback(id, ui_events.BUTTON_CLICKED, guard(id, function()
        if not always and self:Busy() then printf("[Lost Zone][menu] %s ignored: busy", id); return end
        printf("[Lost Zone][menu] click %s", id)
        handler(self)
    end), self)
end
-- Leaving the game always asks first.
function netcoop_login_wnd:AskQuit()
    if not self.quit_box then
        self.quit_box = CUIMessageBoxEx()
        self:Register(self.quit_box, "quit_box")
        self:AddCallback("quit_box", ui_events.MESSAGE_BOX_QUIT_WIN_CLICKED, guard("quit_box", function()
            netcoop_menu_radio.stop(); netcoop_preview_clear(); exec_console_cmd("quit")
        end), self)
    end
    self.quit_box:InitMessageBox("message_box_lostzone_quit")
    self.quit_box:ShowDialog(true)
end
function netcoop_login_wnd:PositionRoomControls()
    local shown = self.mode == "characters" and (not self.room_view or self.room_view == "door")
    for _, arrow in ipairs(self.room_arrows or {}) do arrow:Show(shown); arrow:Enable(not self:Busy()) end
end
-- Both edge arrows turn between the room overview and the door behind us.
function netcoop_login_wnd:TurnRoom()
    if self:Busy() then return end
    if self.room_view == "door" then self:CloseRoomView()
    else self:OpenRoomView("door", 4) end
end
-- A straight leader keeps the translucent caption above the object.
local function place_label(label, leader, object)
    local text = tr(ROOM_OBJECTS[object].label)
    local point = netcoop_preview_point(object)
    local width = math.min(320, 24 + 8.5 * string.len(text))
    label:TextControl():SetText(text)
    label:SetWndSize(vector2():set(width, 30))
    label:SetWndPos(vector2():set(math.max(8, math.min(1016 - width, point.x - width / 2)), math.max(8, math.min(730, point.y - (object == 2 and 170 or 112)))))
    local visible = point.x > -1000
    label:Show(visible)
    if leader then
        local top = label:GetWndPos().y + 30
        leader:SetWndPos(vector2():set(point.x, top))
        leader:SetWndSize(vector2():set(1, math.max(1, point.y - top - 8)))
        leader:Show(visible)
    end
end
-- Hovered object: the one under the cursor, or the one chosen with the arrows
-- until the mouse moves. Nothing is hovered while busy or in a close-up view.
function netcoop_login_wnd:UpdateHover()
    local object = -1
    local active = self.mode == "characters" and not self:Busy() and self:IsShown()
    local only = self.room_view and VIEW_OBJECT[self.room_view]
    if self.room_view and not only then active = false end
    if active and netcoop_preview_pick then
        local cursor = GetCursorPosition()
        local over_arrow = not self.room_view or self.room_view == "door"
        over_arrow = over_arrow and cursor.y >= 344 and cursor.y <= 412 and
            ((cursor.x >= 12 and cursor.x <= 56) or (cursor.x >= 968 and cursor.x <= 1012))
        if self.last_cursor and (math.abs(cursor.x - self.last_cursor.x) > 2 or math.abs(cursor.y - self.last_cursor.y) > 2) then
            self.key_focus = nil
        end
        self.last_cursor = {x = cursor.x, y = cursor.y}
        object = self.key_focus or netcoop_preview_pick(cursor.x, cursor.y)
        if over_arrow or not ROOM_OBJECTS[object] or (only and object ~= only) or (not only and object == 4) then object = -1 end
        active = not only
    end
    if object ~= (self.hovered or -1) then
        self.hovered = object
        if netcoop_preview_hover then netcoop_preview_hover(object) end
        if object >= 0 then play_click() end
    end
    if self.hover_label then
        if object >= 0 and not self.show_all then place_label(self.hover_label, self.hover_leader, object) else self.hover_label:Show(false); self.hover_leader:Show(false) end
        for index, label in pairs(self.tab_labels) do
            if active and self.show_all then place_label(label, self.tab_leaders[index], index) else label:Show(false); self.tab_leaders[index]:Show(false) end
        end
    end
end
-- Arrows move the selection between objects in screen order.
function netcoop_login_wnd:FocusStep(delta)
    local current = self.key_focus or self.hovered or -1
    local position = 0
    for i, object in ipairs(KEY_ORDER) do if object == current then position = i end end
    if position == 0 then position = delta > 0 and 0 or #KEY_ORDER + 1 end
    position = (position - 1 + delta) % #KEY_ORDER + 1
    self.key_focus = KEY_ORDER[position]
end
function netcoop_login_wnd:ActivateObject(object)
    local entry = ROOM_OBJECTS[object]
    if not entry or self:Busy() then return end
    printf("[Lost Zone][menu] object %s", entry.label)
    self.key_focus = nil
    self[entry.action](self)
end
function netcoop_login_wnd:ShowCharacterView() self:OpenRoomView("character", 2) end
function netcoop_login_wnd:EnterDoor() if not self:Busy() then self:AskQuit() end end
-- The door is behind the camera: first turn to it, then confirm quitting.
function netcoop_login_wnd:DoorAction()
    if self.room_view == "door" then return self:EnterDoor() end
    self:OpenRoomView("door", 4)
end
function netcoop_login_wnd:SetMsg(text)
	self.msg:TextControl():SetText(text or "")
    if self.character_msg then self.character_msg:TextControl():SetText(text or "") end
    if self.server_msg then self.server_msg:TextControl():SetText(text or "") end
end

function netcoop_login_wnd:Reset()
    self.route_wait=nil
    if self.room_view or self.room_pending then self:CloseRoomView() end
	self.mode = "account"
	self:ShowAccountControls(true)
	self.ed_code:Show(false); self.cap_code:Show(false)
	if self.profile_panel then self.profile_panel:Show(false) end
	if self.character_panel then self.character_panel:Show(false) end
	netcoop_preview_clear()
	if cloud_enabled() then return self:ResetCloud() end
	self.ed_email:Show(false); self.cap_email:Show(false); self.reset_button:Show(false)
	self.ed_pass2:Show(false); self.cap_pass2:Show(false)
    self.register_tab:Show(false); self.login_tab:Show(false)
	local login, addr = read_last()
	if netcoop_account() ~= "" then login = netcoop_account() end
	self.ed_login:SetText(login or "")
	self.ed_pass:SetText("")
	self.ed_addr:SetText((addr and addr ~= "") and addr or DEF_ADDR)
	local remembered = netcoop_account_state() ~= 0
	self.ed_login:Enable(not remembered); self.ed_pass:Enable(true); self.ed_pass:Show(not remembered); self.cap_pass:Show(not remembered)
	self.register_button:Show(not remembered)
	self.login_button:Enable(true); self.register_button:Enable(true); self.ed_addr:Enable(true)
	self.login_button:TextControl():SetText(tr(remembered and "check_approval" or "existing_account"))
	self.title:TextControl():SetText(tr(remembered and "approval_title" or "register_title"))
	self:SetMsg(tr(remembered and "approval_help" or "register_help"))
	if auth_message == "Registration rejected by administrator" then self:SetMsg(tr("approval_rejected")) end
	if auth_message and auth_message ~= "Registration pending administrator approval" and auth_message ~= "Registration rejected by administrator" then
		self:SetMsg(tr("auth_failed") .. " " .. auth_message)
	end
	pcall(function() self.ed_login:CaptureFocus(true) end)
end

function netcoop_login_wnd:Connect(register)
	if auth_return == "pending" then return end
	if cloud_enabled() then return self:ConnectCloud(register) end
	if register and netcoop_account_state() ~= 0 then return end
	local trim = function(s) return string.gsub(s or "", "^%s*(.-)%s*$", "%1") end
	local login = trim(self.ed_login:GetText())
	local pass = self.ed_pass:GetText() or ""
	local addr = trim(self.ed_addr:GetText())
	if register and (string.len(pass) < 4 or string.len(pass) > 64) then return self:SetMsg(tr("password_invalid")) end

	local err = check_values(login, pass)
	if err then return self:SetMsg(tr("login_invalid")) end
	local ip, port = parse_addr(addr)
	if not ip or tonumber(port) < 1 or tonumber(port) > 65535 then return self:SetMsg(tr("server_invalid")) end

	if not netcoop_login(login, pass, register) then
		return self:SetMsg(tr("key_failed"))
	end
	self.ed_pass:SetText("")
	self.pending_login, self.pending_ip, self.pending_port = login, ip, port
	write_last(login, ip .. ":" .. port)
	netcoop_character(0, "", "stalker", 1, "")
    auth_return=nil;auth_message=nil
    self.login_button:Enable(false); self.register_button:Enable(false)
    self.ed_login:Enable(false); self.ed_pass:Enable(false); self.ed_addr:Enable(false)
    self:WithRoute(ip,port,login,0,function(cip,cport)
        auth_return="pending"
        if not netcoop_frontend_auth(string.format("%s/name=%s/port=%s",cip,login,cport)) then return self:RouteFailure(tr("auth_failed")) end
        self:SetMsg(tr("connecting"))
    end)
end

function netcoop_login_wnd:Update()
	CUIScriptWnd.Update(self)
	if not self.update_guard then self.update_guard = guard("menu update", self.UpdateMenu) end
	self.update_guard(self)
end
function netcoop_login_wnd:UpdateMenu()
    self:PollRoute()
    if self.room_pending and (not netcoop_preview_ready or netcoop_preview_ready()) then
        local kind = self.room_pending; self.room_pending = nil
        if kind == "server" then
            self.server_edit:SetText(self.pending_ip .. ":" .. self.pending_port)
            self.server_panel:Show(true)
        elseif kind == "character" then self.details_panel:Show(true)
        elseif kind == "radio" then self.radio_panel:Show(true); self:RefreshRadio()
        elseif kind == "settings" then self.settings_pending = true end
    end
    if self.settings_pending then
        self.settings_pending = nil
        local ok, error = pcall(function()
            if not self.opt_dlg then self.opt_dlg = ui_options.UIOptions(); self.opt_dlg.owner = self end
            self.settings_open=true
            self:HideDialog(); self:Show(false)
            self.opt_dlg.background:Show(false)
            Register_UI("UIOptions")
            self.opt_dlg:ShowDialog(true)
        end)
        if not ok then
            if self.opt_dlg then self.opt_dlg:HideDialog(); self.opt_dlg:Show(false) end
            self:CloseRoomView(); self:ShowDialog(true); self:Show(true); self:SetMsg(tr("settings_error"))
            printf("[Lost Zone] menu settings error: %s", tostring(error))
        end
        return
    end

	if self.settings_open and self:IsShown() then self.settings_open=nil; self:CloseRoomView() end
    if level.present() then netcoop_menu_radio.stop()
    else netcoop_menu_radio.update() end
    if self.radio_panel and self.radio_panel:IsShown() then self:RefreshRadio() end
    if self.mode=="characters" then self:PositionRoomControls() end
    self:UpdateHover()
    if auth_return and auth_return ~= "pending" then frontend_update(self.owner) end
    self:PollVerification()
    if self.mode == "account" and cloud_enabled() then self:UpdateResend() end
end

function netcoop_login_wnd:EnterCharacter(slot, name, faction, economy, loadout)
    if cloud_enabled() then
        if auth_return == "pending" then return end
        local draft_name = netcoop_draft(slot, "name")
        if draft_name == name then
            faction = netcoop_draft(slot, "faction"); economy = tonumber(netcoop_draft(slot, "economy"))
            loadout = netcoop_draft(slot, "loadout")
            netcoop_character_profile(netcoop_draft(slot, "description"), netcoop_draft(slot, "history"))
        else netcoop_character_profile("", "") end
        self.cloud_join = {slot, name, faction, economy, loadout}
        if self:CloudRequest("refresh") then return end
        self.cloud_join = nil; return
    end
    return self:EnterWorld(slot, name, faction, economy, loadout)
end

function netcoop_login_wnd:EnterWorld(slot, name, faction, economy, loadout)
	if not netcoop_character(slot, name or "", faction or "stalker", economy or 1, loadout or "") then
		return self:SetMsg("! Invalid character selection")
	end
	local login, ip, port = self.pending_login, self.pending_ip, self.pending_port
	write_last(login, ip .. ":" .. port)

    self:WithRoute(ip,port,login,slot,function(cip,cport)
        printf("[Lost Zone][entry] connecting slot %s to %s:%s",tostring(slot),cip,cport)
        self:HideDialog();netcoop_menu_radio.stop();netcoop_preview_clear();exec_console_cmd("main_menu off")
        exec_console_cmd(string.format("start client(%s/name=%s/port=%s)",cip,login,cport))
    end)
end


local function character_cache_path(login, addr)
    local identity = netcoop_firebase_identity and netcoop_firebase_identity() or ""
    if identity ~= "" then login = "cloud_" .. identity end
    return app_path("netcoop_slots_" .. string.lower(login) .. "_" .. string.gsub(addr, "[^%w%-_.]", "_") .. ".txt")
end

function cache_characters(names)
    local login, addr = read_last()
    if not login or not addr then return end
    local f = io.open(character_cache_path(login, addr), "w")
    if f then f:write(names or ""); f:close() end
    f = io.open(character_cache_path(login, addr) .. ".role", "w")
    if f then f:write(tostring(netcoop_role and netcoop_role() or 0)); f:close() end
end

local BASE_MODEL = "actors\\stalker_neutral\\stalker_neutral_1.ogf"
local function preview_cache_path(login, addr) return character_cache_path(login, addr) .. ".preview" end
function cache_previews(data)
    local login, addr = read_last()
    if not login or not addr then return end
    local f = io.open(preview_cache_path(login, addr), "w")
    if f then f:write(data or ""); f:close() end
end
function netcoop_login_wnd:ShowCharacters()
    self.mode = "characters"
    netcoop_preview_clear()
    self:ShowAccountControls(false)
    if self.profile_panel then self.profile_panel:Show(false) end
    local addr = string.lower(self.pending_ip) .. ":" .. self.pending_port
    if netcoop_draft_server then netcoop_draft_server(addr) end
    local f = io.open(character_cache_path(self.pending_login, addr), "r")
    local names = f and f:read("*a") or ""
    if f then f:close() end
    self.names, self.previews = {}, {}
    for name in string.gmatch(names .. "|", "(.-)|") do self.names[#self.names + 1] = name end
    f = io.open(preview_cache_path(self.pending_login, addr), "r")
    local previews = f and f:read("*a") or ""
    if f then f:close() end
    for visual, faction, items in string.gmatch(previews, "([^|\n]*)|([^|\n]*)|([^\n]*)\n") do
        self.previews[#self.previews + 1] = {visual = visual, faction = faction, items = items}
    end
    if cloud_enabled() then
        for slot = 1, self:CharacterLimit() do
            if not self.names[slot] or self.names[slot] == "" then
                self.names[slot] = netcoop_draft(slot, "name")
                local loadout = netcoop_draft(slot, "loadout")
                local visual = BASE_MODEL
                for section in string.gmatch(loadout, "[^,]+") do
                    if ini_sys:section_exist(section) then
                        local outfit = SYS_GetParam(0, section, "actor_visual", "")
                        if outfit ~= "" then visual = outfit end
                    end
                end
                self.previews[slot] = {visual=visual, faction=netcoop_draft(slot, "faction") ~= "" and netcoop_draft(slot, "faction") or "stalker", items=loadout}
            end
        end
    end
    if not self.character_panel then
        local xml = CScriptXmlInit(); xml:ParseFile("ui_netcoop_characters.xml")
        self.character_panel = xml:InitStatic("panel", self)
        self.details_panel = xml:InitStatic("details_panel", self.character_panel)
        local function caption(path, text)
            local item = xml:InitStatic(path, self.details_panel); item:TextControl():SetText(text or ""); return item
        end
        caption("title", "LOST ZONE")
        self.account_caption = caption("account")
        caption("slots_title", tr("characters"))
        self.character_name = caption("name")
        self.character_info = caption("info")
        self.character_msg = caption("status")
        caption("hint", "")
        self.character_description = caption("description")
        self.character_badge = xml:InitStatic("badge", self.details_panel)
        local function button(path, text, handler)
            local b = xml:Init3tButton(path, self.details_panel); b:TextControl():SetText(text)
            self:Register(b, "char_" .. path); self:Bind("char_" .. path, handler, path == "back"); return b
        end
        self.create_button = button("character_create", tr("create_character"), function()
            if cloud_enabled() then self:ShowProfile(self.slot) else self:ShowLoadout(self.slot) end
        end)
        self.room_arrows = {}
        for _, path in ipairs({"previous", "next"}) do
            local b = xml:Init3tButton(path, self.character_panel)
            b:TextControl():SetText(path == "previous" and "<" or ">")
            self:Register(b, "room_" .. path); self:Bind("room_" .. path, self.TurnRoom)
            self.room_arrows[#self.room_arrows + 1] = b
        end
        self.slot_buttons = {}
        for i = 1, 10 do
            local slot = i
            self.slot_buttons[i] = button("slot" .. i, "", function() self.slot = slot; self:ChangeSlot(0) end)
        end
        self.room_buttons = {}
        self.character_badge:Show(false)
        self.character_description:Show(false)
        self.server_panel = xml:InitStatic("server_panel", self)
        self.server_msg = xml:InitStatic("server_status", self.server_panel)
        self.server_edit = xml:InitEditBox("server_edit", self.server_panel)
        local save = xml:Init3tButton("server_save", self.server_panel)
        save:TextControl():SetText(tr("save_server")); self:Register(save, "server_save")
        self:Bind("server_save", self.SaveServer)
        local connect = xml:Init3tButton("server_connect", self.server_panel)
        self.enter = connect
        connect:TextControl():SetText(tr("enter_zone")); self:Register(connect, "server_connect")
        self:Bind("server_connect", function() self:SelectCharacter(self.slot) end)
        local check = xml:Init3tButton("server_check", self.server_panel)
        check:TextControl():SetText("�������� ���������� � ������")
        self:Register(check, "server_check"); self:Bind("server_check", self.CheckServer)
        self.room_back = xml:Init3tButton("room_back", self)
        self.room_back:TextControl():SetText(tr("back")); self:Register(self.room_back, "room_back")
        self:Bind("room_back", self.CloseRoomView, true)
        self.room_back:Show(false); self.server_panel:Show(false)
        self.radio_panel = xml:InitStatic("radio_panel", self)
        self.radio_station = xml:InitStatic("radio_station", self.radio_panel)
        self.radio_track = xml:InitStatic("radio_track", self.radio_panel)
        self.radio_volume = xml:InitStatic("radio_volume", self.radio_panel)
        local function radio_button(path, label, handler)
            local b = xml:Init3tButton(path, self.radio_panel); b:TextControl():SetText(tr(label))
            self:Register(b, path); self:Bind(path, function() handler(); self:RefreshRadio() end)
        end
        radio_button("radio_station_prev", "previous_station", function() netcoop_menu_radio.station(-1) end)
        radio_button("radio_station_next", "next_station", function() netcoop_menu_radio.station(1) end)
        radio_button("radio_track_prev", "previous_track", function() netcoop_menu_radio.track(-1) end)
        radio_button("radio_track_next", "next_track", function() netcoop_menu_radio.track(1) end)
        radio_button("radio_volume_down", "volume_down", function() netcoop_menu_radio.volume(-0.05) end)
        radio_button("radio_volume_up", "volume_up", function() netcoop_menu_radio.volume(0.05) end)
        radio_button("radio_toggle", "music_toggle", function() netcoop_menu_radio.toggle() end)
        self.radio_panel:Show(false); self.details_panel:Show(false)
        self.hover_label = xml:InitStatic("hover_label", self); self.hover_label:Show(false)
        self.hover_leader = xml:InitStatic("hover_leader", self); self.hover_leader:Show(false)
        self.tab_labels, self.tab_leaders = {}, {}
        for object in pairs(ROOM_OBJECTS) do
            self.tab_labels[object] = xml:InitStatic("hover_label", self); self.tab_labels[object]:Show(false)
            self.tab_leaders[object] = xml:InitStatic("hover_leader", self); self.tab_leaders[object]:Show(false)
        end
    end
    self:CloseRoomView()
    self.slot = self.slot or 1; self.character_panel:Show(true); self:ChangeSlot(0)
    self.details_panel:Show(false)
    self:SetMsg(auth_message or "")
    self.account_caption:TextControl():SetText(self.pending_login .. (self:CharacterLimit() == 10 and "  /  �������������" or "  /  �������"))
    for i = 1, 10 do self.slot_buttons[i]:Show(i <= self:CharacterLimit()) end
    for i = 1, self:CharacterLimit() do
        self.slot_buttons[i]:TextControl():SetText(string.format("%d   %s", i, self.names[i] and self.names[i] ~= "" and self.names[i] or tr("empty_slot")))
    end
end
function netcoop_login_wnd:CharacterLimit()
    local addr = string.lower(self.pending_ip or "") .. ":" .. (self.pending_port or "")
    local f = io.open(character_cache_path(self.pending_login or "", addr) .. ".role", "r")
    local role = f and f:read("*a") or ""; if f then f:close() end
    -- Remembered allowance is for presentation only; the server enforces its own role.
    return role == "2" and 10 or 1
end
function netcoop_login_wnd:ChangeSlot(delta)
    local limit = self:CharacterLimit()
    self.slot = ((self.slot - 1 + delta) % limit) + 1
    local name = self.names[self.slot]
    self.create_button:Show(not name or name == "")
    self.character_name:TextControl():SetText(name and name ~= "" and name or tr("create_character"))
    local preview = self.previews[self.slot] or {faction = "stalker", items = ""}
    self.character_info:TextControl():SetText(string.format("%d / %d   |   %s", self.slot, limit, game.translate_string("st_faction_" .. preview.faction)))
    self.enter:TextControl():SetText(tr(name and name ~= "" and "enter_zone" or "create_character"))
    local description, history = "", ""
    if cloud_enabled() then description = netcoop_draft(self.slot, "description"); history = netcoop_draft(self.slot, "history") end
    self.character_description:TextControl():SetText((description ~= "" and description .. "\n\n" or "") .. (history ~= "" and history or "������ ���� ��������. ���������� � �������� ����������� �� ��������� �������."))
    for i = 1, 10 do self.slot_buttons[i]:Enable(i ~= self.slot) end
    self.storage_revision=nil
    if self.room_view == "character" then self.view_index=2; netcoop_preview_focus(2)
    elseif self.view_index ~= -1 then self.view_index=-1; netcoop_preview_focus(-1) end
    local model=preview.visual and preview.visual~="" and preview.visual or BASE_MODEL
    if not netcoop_preview_model(model,-2) then netcoop_preview_model(BASE_MODEL,-2) end
    local weapon=""
    for section in string.gmatch(preview.items or "","[^,]+") do
        if ini_sys:section_exist(section) and string.sub(section,1,4)=="wpn_" and SYS_GetParam(2,section,"slot",0)==2 then weapon=section; break end
    end
    -- The seated pose holds no weapon: a rifle floated in front of the sofa.
    if netcoop_preview_weapon then netcoop_preview_weapon("") end
    self:PositionRoomControls()
end
function netcoop_login_wnd:SetPose(pose)
    local preview=self.previews[self.slot] or {}; netcoop_preview_model(preview.visual or BASE_MODEL,-2)
end
-- Keep the native Show method inherited. Lua virtual overrides have no
-- default Show binding and calling CUIScriptWnd.Show raises pure virtual.

function netcoop_login_wnd:SelectCharacter(slot)
    if slot < 1 or slot > self:CharacterLimit() then return end
    local name = self.names[slot]
    if name and name ~= "" then return self:EnterCharacter(slot, name) end
    if cloud_enabled() then return self:ShowProfile(slot) end
    return self:ShowLoadout(slot)
end

function netcoop_login_wnd:ShowLoadout(slot)
    if not ui_mm_faction_select or not ui_mm_faction_select.UINewGame then
        return self:SetMsg("! Character creation menu is unavailable")
    end
    local rebuild = not self.creator or self.creator.netcoop_creation_slot ~= slot
    local picker = ui_mm_faction_select.UINewGame
    local injector = new_game_loadout_injector_mcm
    if injector and injector._LoadLoadout and not picker.netcoop_loadout_hook then
        local original = picker.LoadLoadout
        picker.LoadLoadout = function(menu, random)
            if menu.netcoop_creation_owner then return injector._LoadLoadout(menu, random) end
            return original(menu, random)
        end
        picker.netcoop_loadout_hook = true
    end
    if not self.creator then
        self.creator = picker(self)
        self.creator:SetAutoDelete(false)
        self.creator:AddCallback("btn_start", ui_events.BUTTON_CLICKED, finish_creation, self.creator)
        self.creator:AddCallback("btn_back", ui_events.BUTTON_CLICKED, cancel_creation, self.creator)
        self.creator.OnStartGame = finish_creation; self.creator.OnQuit = cancel_creation
        local xml = CScriptXmlInit(); xml:ParseFile("ui_mm_faction_select.xml")
        self.creator.netcoop_status = xml:InitStatic("main_dialog:netcoop_status", self.creator.dialog)
    end
    if self.profile_data then self.creator.character_name:SetText(self.profile_data.name) end
    self.creator.netcoop_creation_slot = slot
    self.creator.netcoop_creation_owner = self
    self.creator.netcoop_status:TextControl():SetText("")
    if rebuild then self.creator:LoadLoadout(false) end
    for _, field in ipairs({"ck_story", "ck_warfare", "ck_hardcore", "ck_azazel_mode", "ck_survival", "ck_campfire", "ck_conditions", "ck_routes"}) do
        if self.creator[field] then self.creator[field]:SetCheck(false); self.creator[field]:Enable(false) end
    end
    self.creator.scroll_options:Show(false)
    self.creator.list_map:Show(false)
    self:HideDialog()
    netcoop_preview_clear()
    pcall(craft_tooltip_ready)
    self.creator:ShowDialog(true)
    self.creator:Show(true)
end

-- Called before the freeplay menu writes any global new-game settings.
local function finish_creation_impl(menu)
    if not menu.access then return end
    local name = menu.character_name:GetText()
    if not name or #name < 2 or #name > 63 or string.find(name, "[|\r\n/\\]") then
        menu.netcoop_status:TextControl():SetText(tr("character_name_invalid")); return
    end
    if menu.points_left < 0 then menu.netcoop_status:TextControl():SetText(tr("loadout_points_invalid")); return end
    local items = {}
    for _, cell in pairs(menu.CC.inventory.cell) do
        if cell:IsShown() then
            for _ = 1, cell:CountChilds() + 1 do items[#items + 1] = cell.section end
        end
    end
    table.sort(items)
    local economy = tonumber((string.gsub(menu.selected_economy, "st_econ_", ""))) or 1
    if cloud_enabled() then
        local owner = menu.netcoop_creation_owner
        local profile = owner.profile_data or {}
        if not netcoop_save_draft(menu.netcoop_creation_slot, name, profile.description or "", profile.history or "", menu.selected_faction, economy, table.concat(items, ",")) then
            printf("[Lost Zone][menu] loadout rejected: slot=%s faction=%s economy=%s count=%s", tostring(menu.netcoop_creation_slot), tostring(menu.selected_faction), tostring(economy), tostring(#items))
            menu.netcoop_status:TextControl():SetText(tr("loadout_save_failed")); return
        end
        menu:HideDialog(); menu:Show(false)
        owner.slot = menu.netcoop_creation_slot
        owner:ShowCharacters(); owner:ShowDialog(true); owner:Show(true)
        return
    end
    menu:HideDialog()
    menu:Show(false)
    menu.netcoop_creation_owner:EnterCharacter(menu.netcoop_creation_slot, name, menu.selected_faction, economy, table.concat(items, ","))
end

function finish_creation(menu)
    local ok, trace = xpcall(function() finish_creation_impl(menu) end, function(err) return debug.traceback(tostring(err), 2) end)
    if not ok then
        log_error("continue loadout", trace)
        if menu.netcoop_status then menu.netcoop_status:TextControl():SetText(tr("loadout_error")) end
    end
end
function cancel_creation(menu)
    if not menu.access then return end
    local owner = menu.netcoop_creation_owner
    menu:HideDialog(); menu:Show(false)
    if cloud_enabled() then owner:ShowProfile(menu.netcoop_creation_slot) else owner:ShowCharacters() end
    owner:ShowDialog(true); owner:Show(true)
end
-- Account screens (cloud): "login" and "register" forms, "verify" (waiting for
-- the email link), "change_email" (fix a mistyped address of the same account)
-- and "signed_in" (remembered account: continue or switch). Typed email and
-- passwords survive errors; passwords are cleared once the account answers.
local NOTICE_COLORS = {error = {232, 120, 104}, ok = {150, 214, 140}, info = {221, 204, 177}}
local RESEND_DELAY = 30000
local auth_kind
local function trim_text(s) return (string.gsub(s or "", "^%s*(.-)%s*$", "%1")) end
local function now_ms() return device():time_continual() end
local function login_email() return netcoop_firebase_login_email and netcoop_firebase_login_email() or "" end
function netcoop_login_wnd:SetNotice(text, kind)
    self:SetMsg(text)
    local c = NOTICE_COLORS[kind or "info"] or NOTICE_COLORS.info
    pcall(function() self.msg:TextControl():SetTextColor(GetARGB(255, c[1], c[2], c[3])) end)
end
function netcoop_login_wnd:CloudScreen()
    local state = account_state()
    if self.force_login or state == 0 then
        if self.form_mode ~= "login" and self.form_mode ~= "register" then
            self.form_mode = login_email() ~= "" and "login" or "register"
        end
        return self.form_mode
    end
    if state == 1 then return self.editing_email and "change_email" or "verify" end
    return "signed_in"
end
local function field_rows(self, screen)
    if screen == "login" then
        return {{self.cap_email, self.ed_email, "email"}, {self.cap_pass, self.ed_pass, "account_password"}}
    elseif screen == "register" then
        return {{self.cap_email, self.ed_email, "email"}, {self.cap_login, self.ed_login, "account_login"},
            {self.cap_pass, self.ed_pass, "account_password"}, {self.cap_pass2, self.ed_pass2, "password_repeat"}}
    elseif screen == "change_email" then
        return {{self.cap_email, self.ed_email, "new_email"}, {self.cap_pass, self.ed_pass, "current_password"}}
    end
    return {}
end
-- Button roles per screen: reg = btn_reg, enter = btn_enter, reset = small left button.
local SCREEN_BUTTONS = {
    login = {enter = "login_action", reset = "reset_password", wide = {"enter"}},
    register = {reg = "register_send", wide = {"reg"}},
    verify = {reg = "resend_email", enter = "wrong_email", reset = "sign_out", wide = {"reg", "enter"}},
    change_email = {reg = "save_email", enter = "cancel", wide = {"reg", "enter"}},
    signed_in = {enter = "continue", reset = "switch_account", wide = {"enter"}},
}
local SCREEN_TITLES = {login = "login_title", register = "register_title", verify = "verify_title",
    change_email = "change_email_title", signed_in = "signed_in_title"}
function netcoop_login_wnd:ResetCloud()
    self:ShowAccountControls(true)
    self.mode = "account"
    local screen = self:CloudScreen()
    self.screen, self.resend_text = screen, nil
    local busy = auth_return == "pending"
    for _, w in ipairs({self.cap_email, self.ed_email, self.cap_login, self.ed_login, self.cap_pass, self.ed_pass,
        self.cap_pass2, self.ed_pass2, self.cap_code, self.ed_code, self.cap_addr, self.ed_addr}) do w:Show(false) end
    local _, addr = read_last(); self.ed_addr:SetText(addr or DEF_ADDR)
    if screen == "verify" or screen == "signed_in" then self.ed_pass:SetText(""); self.ed_pass2:SetText("") end
    self.fields = {}
    local y = 272
    for _, row in ipairs(field_rows(self, screen)) do
        row[1]:TextControl():SetText(tr(row[3]))
        row[1]:SetWndPos(vector2():set(282, y)); row[2]:SetWndPos(vector2():set(282, y + 24))
        row[1]:Show(true); row[2]:Show(true); row[2]:Enable(not busy)
        self.fields[#self.fields + 1] = row[2]
        y = y + 66
    end
    local form = screen == "login" or screen == "register"
    self.register_tab:Show(form); self.login_tab:Show(form)
    self.register_tab:Enable(form and not busy); self.login_tab:Enable(form and not busy)
    local function tab_color(tab, on)
        tab:TextControl():SetTextColor(GetARGB(255, on and 231 or 150, on and 213 or 153, on and 181 or 151))
    end
    tab_color(self.register_tab, screen == "register"); tab_color(self.login_tab, screen == "login")
    self.title:TextControl():SetText(tr(SCREEN_TITLES[screen]))

    local layout = SCREEN_BUTTONS[screen]
    local buttons = {reg = self.register_button, enter = self.login_button, reset = self.reset_button}
    for role, button in pairs(buttons) do
        button:Show(layout[role] ~= nil); button:Enable(layout[role] ~= nil and not busy)
        if layout[role] then button:TextControl():SetText(tr(layout[role])) end
    end
    local info = screen == "verify" or screen == "signed_in"
    local msg_height = info and 130 or (#self.fields >= 4 and 44 or 60)
    self.msg:SetWndPos(vector2():set(282, y)); self.msg:SetWndSize(vector2():set(460, msg_height))
    y = y + msg_height + 8
    for _, role in ipairs(layout.wide) do
        buttons[role]:SetWndPos(vector2():set(282, y)); buttons[role]:SetWndSize(vector2():set(460, 36))
        y = y + 44
    end
    self.reset_button:SetWndPos(vector2():set(282, y)); self.reset_button:SetWndSize(vector2():set(274, 30))
    self.back_button:SetWndPos(vector2():set(632, y)); self.back_button:TextControl():SetText(tr("exit"))

    local text, kind = auth_message, auth_kind
    if screen == "verify" then
        local sent = string.format(tr("verify_sent"), netcoop_firebase_email())
        text = (text and text ~= "") and (text .. " " .. sent) or sent
    elseif not text or text == "" then
        kind = "info"
        if screen == "signed_in" then
            text = string.format(tr("signed_in_info"), netcoop_firebase_account(), login_email() ~= "" and login_email() or netcoop_firebase_email())
        elseif screen == "change_email" then text = tr("change_email_help")
        else text = tr(screen == "register" and "registration_help" or "login_help") end
    end
    self:SetNotice(text, kind)
    if screen == "verify" then self:UpdateResend() end

    self.focus_index = nil
    if not busy and #self.fields > 0 then
        local index
        -- UI controls have no __eq (luabind errors on ==): compare identity
        for i, f in ipairs(self.fields) do if rawequal(f, self.focus_field) then index = i end end
        if not index then for i, f in ipairs(self.fields) do if not index and f:GetText() == "" then index = i end end end
        self:FocusField(index or 1)
    end
    self.focus_field = nil
    self.next_verify_poll = self.next_verify_poll or (now_ms() + 5000)
end
function netcoop_login_wnd:FocusField(index)
    self.focus_index = index
    for i, f in ipairs(self.fields or {}) do
        local field = f
        pcall(function() field:CaptureFocus(i == index) end)
    end
end
-- Tab moves to the next field; a mouse click on a field becomes the Tab start.
function netcoop_login_wnd:FocusNextField()
    local count = #(self.fields or {})
    if count > 0 then self:FocusField(((self.focus_index or 0) % count) + 1) end
end
function netcoop_login_wnd:TrackFieldClick()
    for i, f in ipairs(self.fields or {}) do
        local field = f
        local ok, over = pcall(function() return field:IsCursorOverWindow() end)
        if ok and over then self.focus_index = i end
    end
end
function netcoop_login_wnd:FieldError(field, id)
    self:SetNotice(tr(id), "error")
    for i, f in ipairs(self.fields or {}) do if f == field then self:FocusField(i) end end
end
function netcoop_login_wnd:LockForm()
    for _, f in ipairs(self.fields or {}) do f:Enable(false) end
    for _, b in ipairs({self.login_button, self.register_button, self.reset_button, self.register_tab, self.login_tab}) do b:Enable(false) end
end
function netcoop_login_wnd:UpdateResend()
    if self.mode ~= "account" or self.screen ~= "verify" or auth_return == "pending" then return end
    local left = math.ceil(((self.resend_at or 0) - now_ms()) / 1000)
    local text = left > 0 and string.format(tr("resend_wait"), left) or tr("resend_email")
    if text ~= self.resend_text then self.register_button:TextControl():SetText(text); self.resend_text = text end
    self.register_button:Enable(left <= 0)
end
function netcoop_login_wnd:OpenAccountForm(mode)
    if auth_return == "pending" then return end
    if account_state() ~= 0 then self.force_login = true end
    self.form_mode, self.editing_email = mode, false
    auth_message, auth_kind = nil, nil
    if self.ed_email:GetText() == "" then self.ed_email:SetText(login_email()) end
    self:Reset(); self:ShowDialog(true); self:Show(true)
end
function netcoop_login_wnd:OpenRegistration() self:OpenAccountForm("register") end
function netcoop_login_wnd:OpenLogin() self:OpenAccountForm("login") end
-- Enter = the wide button on top of the current screen.
function netcoop_login_wnd:PrimaryAction()
    local screen = self:CloudScreen()
    if screen == "login" or screen == "signed_in" then return self:OnLogin() end
    return self:OnRegister()
end
function netcoop_login_wnd:OnLogin()
    if not cloud_enabled() then return self:Connect(false) end
    if auth_return == "pending" then return end
    local screen = self:CloudScreen()
    if screen == "login" then return self:ConnectCloud(false)
    elseif screen == "verify" then return self:StartEmailChange()
    elseif screen == "change_email" then
        self.editing_email = false; auth_message = nil; self.ed_pass:SetText("")
        return self:ResetCloud()
    elseif screen == "signed_in" then return self:CloudRequest("refresh") end
end
function netcoop_login_wnd:OnRegister()
    if not cloud_enabled() then return self:Connect(true) end
    if auth_return == "pending" then return end
    local screen = self:CloudScreen()
    if screen == "register" then return self:ConnectCloud(true)
    elseif screen == "verify" then
        if (self.resend_at or 0) > now_ms() then return end
        return self:CloudRequest("resend")
    elseif screen == "change_email" then return self:SubmitEmailChange() end
end
function netcoop_login_wnd:ResetPassword()
    if not cloud_enabled() or auth_return == "pending" then return end
    local screen = self:CloudScreen()
    if screen == "login" then
        local email = trim_text(self.ed_email:GetText())
        if not email_valid(email) then return self:FieldError(self.ed_email, "email_invalid") end
        return self:CloudRequest("reset", email)
    elseif screen == "verify" or screen == "signed_in" then return self:SignOut() end
end
function netcoop_login_wnd:StartEmailChange()
    self.editing_email = true; auth_message, auth_kind = nil, nil
    self.ed_email:SetText(netcoop_firebase_email()); self.ed_pass:SetText("")
    self.focus_field = self.ed_email
    self:ResetCloud()
end
function netcoop_login_wnd:SubmitEmailChange()
    local email = trim_text(self.ed_email:GetText())
    if not email_valid(email) then return self:FieldError(self.ed_email, "email_invalid") end
    if string.lower(email) == string.lower(netcoop_firebase_email()) then return self:FieldError(self.ed_email, "change_email_same") end
    local password = self.ed_pass:GetText() or ""
    if #password < 6 or #password > 128 then return self:FieldError(self.ed_pass, "cloud_password_invalid") end
    return self:CloudRequest("change_email", email, password)
end
-- Forget the remembered account. A verification poll in flight would save
-- the session again, so sign-out waits for it.
function netcoop_login_wnd:SignOut()
    if auth_return == "pending" then return end
    if self.verify_poll then self.sign_out_after_poll = true; return self:SetNotice(tr("wait_request"), "info") end
    local email = login_email()
    if netcoop_firebase_logout then
        if not netcoop_firebase_logout() then return self:SetNotice(tr("cloud_network_error"), "error") end
        self.force_login = false
    else
        self.force_login = true
    end
    self.form_mode, self.editing_email, self.resend_at = "login", false, nil
    self.ed_email:SetText(email); self.ed_pass:SetText(""); self.ed_pass2:SetText("")
    auth_message, auth_kind = tr("signed_out"), "info"
    self.focus_field = email ~= "" and self.ed_pass or self.ed_email
    self:ResetCloud()
end

function netcoop_login_wnd:OnBack()
    if self.route_wait then self:RouteFailure(tr("route_cancelled"));return end
	if auth_return == "pending" then return end
    if self.room_view then self:CloseRoomView(); return end
    if cloud_enabled() then
        if self.mode == "profile" then
            local populated = false
            for i = 1, self:CharacterLimit() do if netcoop_draft(i, "name") ~= "" or (self.names and self.names[i] and self.names[i] ~= "") then populated = true end end
            if populated then self:ShowCharacters(); return end
            self.force_login, self.form_mode = false, nil; auth_message = nil
            self:Reset(); return
        end
        if self.mode == "account" and self.editing_email then return self:OnLogin() end
        self:AskQuit(); return
    end
	if netcoop_account_state() == 0 then self:AskQuit(); return end
	netcoop_preview_clear()
	self:HideDialog()
	if self.owner then
		self.owner:ShowDialog(true)
		self.owner:Show(true)
	end
end

function netcoop_login_wnd:OnKeyboard(dik, keyboard_action)
	if keyboard_action == ui_events.WINDOW_KEY_RELEASED and dik == DIK_keys.DIK_TAB then
		self.show_all = false
		return true
	end
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		local room = self.mode == "characters" and not self.room_view
		if self.mode == "account" and cloud_enabled() then
			if dik == DIK_keys.DIK_TAB then self:FocusNextField(); return true end
			if dik == DIK_keys.MOUSE_1 then self:TrackFieldClick() end
		end
		if self.mode == "characters" and self.room_view == "door" and dik == DIK_keys.MOUSE_1 and (self.hovered or -1) == 4 then
			guard("door click", self.EnterDoor)(self)
			return true
		end
		if room and dik == DIK_keys.DIK_TAB then
			self.show_all = true
			return true
		elseif self.mode == "characters" and (not self.room_view or self.room_view == "door") and
            (dik == DIK_keys.DIK_LEFT or dik == DIK_keys.DIK_RIGHT) then
            guard("camera turn", self.TurnRoom)(self)
            return true
        elseif room and dik == DIK_keys.DIK_UP then
			self:FocusStep(-1)
			return true
		elseif room and dik == DIK_keys.DIK_DOWN then
			self:FocusStep(1)
			return true
		elseif room and dik == DIK_keys.MOUSE_1 and (self.hovered or -1) >= 0 then
			printf("[Lost Zone][menu] click object")
			guard("object click", self.ActivateObject)(self, self.hovered)
			return true
		end
		if dik == DIK_keys.DIK_ESCAPE then
			printf("[Lost Zone][menu] key Esc")
			guard("key Esc", self.OnBack)(self)
			return true
		elseif dik == DIK_keys.DIK_RETURN or dik == DIK_keys.DIK_NUMPADENTER then
			if self:Busy() then return true end
			printf("[Lost Zone][menu] key Enter")
			guard("key Enter", function()
				if self.mode == "characters" then
					if self.server_panel:IsShown() then self:SelectCharacter(self.slot)
                    elseif self.room_view == "door" then self:AskQuit()
					elseif not self.room_view and (self.hovered or -1) >= 0 then self:ActivateObject(self.hovered) end
				elseif self.mode == "profile" then self:ContinueProfile()
				elseif cloud_enabled() then self:PrimaryAction()
				elseif account_state() == 0 then self:OnRegister() else self:OnLogin() end
			end)()
			return true
		end
	end
	return CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
end


function show_login(menu, verified)
	if not wnd then
		wnd = netcoop_login_wnd(menu)
	else
		wnd.owner = menu
	end
	if menu then
		menu:HideDialog()
		menu:Show(false)
	end
    if cloud_enabled() then
        if verified then
            local _, addr = read_last()
            local ip, port = parse_addr(addr or DEF_ADDR)
            wnd.pending_login, wnd.pending_ip, wnd.pending_port = netcoop_firebase_account(), ip, port
            write_last(wnd.pending_login, ip .. ":" .. port)
            wnd:ShowCharacters()
            local populated = false
            for i = 1, wnd:CharacterLimit() do if wnd.names[i] and wnd.names[i] ~= "" then populated = true end end
            if not populated then wnd:ShowProfile(1) end
            -- Test entry without clicks (owner 2026-10-12: "start a location and
            -- join it"): -netcoop_autojoin enters the first character of the last
            -- server, or creates a test stalker there.
            if not autojoin_done and string.find(command_line(), "-netcoop_autojoin", 1, true) then
                autojoin_done = true
                local slot
                for i = 1, wnd:CharacterLimit() do if wnd.names[i] and wnd.names[i] ~= "" then slot = i; break end end
                printf("[Lost Zone] autojoin: %s", slot and ("character " .. slot) or "new test character")
                if slot then wnd:SelectCharacter(slot) else wnd:EnterCharacter(1, "Tester", "stalker", 1, "") end
            end
        else
            wnd:Reset()
            if account_state() ~= 0 then wnd:CloudRequest("refresh") end
        end
        wnd:ShowDialog(true); return
    end
	if netcoop_account_state() == 2 and verified then
		local login, addr = read_last()
		local ip, port = parse_addr(addr or DEF_ADDR)
		wnd.pending_login, wnd.pending_ip, wnd.pending_port = netcoop_account(), ip, port
		wnd:ShowCharacters()
	else
		wnd:Reset()
		if netcoop_account_state() == 2 and not verified then wnd:Connect(false) end
	end
	wnd:ShowDialog(true)
end

function frontend_update(menu)
    local admin = can_mcm()
    menu.netcoop_menu_role = admin
    if level.present() then return false end
    if auth_return and auth_return ~= "pending" then
        local verified = auth_return == "characters"
        auth_return = nil
        menu.netcoop_first_screen = true
        if verified then show_login(menu, true)
        else
            if not wnd then wnd = netcoop_login_wnd(menu) else wnd.owner = menu end
            menu:HideDialog(); menu:Show(false); wnd:Reset(); wnd:ShowDialog(true)
        end
        return true
    end
    if not menu.netcoop_first_screen then
        menu.netcoop_first_screen = true
        if cloud_enabled() or netcoop_account_state() ~= 2 then show_login(menu); return true end
    end
    return false
end

-- Cloud callbacks contain only status and account name. Tokens remain native.
local function cloud_error_code(error)
    return string.match(error or "", "^[%w_]+") or "NETWORK_ERROR"
end
local function session_expired(error)
    error = cloud_error_code(error)
    return error == "INVALID_REFRESH_TOKEN" or error == "TOKEN_EXPIRED" or error == "USER_NOT_FOUND" or error == "INVALID_ID_TOKEN" or error == "CREDENTIAL_TOO_OLD_LOGIN_AGAIN"
end
function netcoop_login_wnd:RequireLogin()
    self.force_login = true; self.form_mode = "login"; self.editing_email = false
    if netcoop_firebase_login_email then self.ed_email:SetText(netcoop_firebase_login_email()) end
    self.focus_field = self.ed_pass
end
local function cloud_error(error)
    local code = cloud_error_code(error)
    local errors = {EMAIL_EXISTS="email_exists", INVALID_EMAIL="email_invalid", EMAIL_DOMAIN_NOT_FOUND="email_domain_invalid", INVALID_LOGIN_CREDENTIALS="bad_credentials",
        EMAIL_NOT_FOUND="bad_credentials", INVALID_PASSWORD="bad_credentials", WEAK_PASSWORD="cloud_password_invalid",
        OPERATION_NOT_ALLOWED="provider_disabled", PASSWORD_LOGIN_DISABLED="provider_disabled", TOO_MANY_ATTEMPTS_TRY_LATER="rate_limited", QUOTA_EXCEEDED="rate_limited",
        TOKEN_EXPIRED="session_expired", INVALID_REFRESH_TOKEN="session_expired", CREDENTIAL_TOO_OLD_LOGIN_AGAIN="session_expired", USER_DISABLED="account_disabled",
        CHANGE_EMAIL_REAUTH_REQUIRED="change_email_password_help", CHANGE_EMAIL_PASSWORD_INVALID="change_email_password_invalid", ACCOUNT_MISMATCH="change_email_account_error", ACCOUNT_NAME_REQUIRED="login_invalid", REMEMBER_FAILED="remember_failed", EMAIL_NOT_VERIFIED="verify_help",
        CODE_SERVICE_NOT_CONFIGURED="code_not_configured", INVALID_CODE="code_invalid", CODE_EXPIRED="code_expired",
        CODE_ATTEMPTS_EXCEEDED="code_attempts", CODE_SEND_LIMIT="code_limit", CODE_RESEND_WAIT="code_wait",
        MAIL_QUOTA_EXCEEDED="code_limit", MAIL_SEND_FAILED="code_mail_error", SERVICE_BUSY="rate_limited", SERVICE_ERROR="cloud_network_error", FIREBASE_ADMIN_PERMISSION_REQUIRED="code_not_configured"}
    return tr(errors[code] or "cloud_network_error")
end
function netcoop_login_wnd:CloudRequest(action, email, password, username)
    if auth_return == "pending" then return false end
    if self.verify_poll then
        self.deferred_cloud = {action, email or "", password or "", username or ""}
    elseif not netcoop_firebase_request(action, email or "", password or "", username or "") then
        self:SetNotice(tr("cloud_network_error"), "error"); return false
    end
    self.cloud_action = action; auth_return = "pending"; auth_message, auth_kind = nil, nil
    self:LockForm(); self:SetNotice(tr("connecting"), "info"); return true
end
function netcoop_login_wnd:ConnectCloud(register)
    local email = trim_text(self.ed_email:GetText())
    self.ed_email:SetText(email)
    if not email_valid(email) then return self:FieldError(self.ed_email, "email_invalid") end
    local username = trim_text(self.ed_login:GetText())
    if register and check_values(username, "") then return self:FieldError(self.ed_login, "login_invalid") end
    local password = self.ed_pass:GetText() or ""
    if #password < 6 or #password > 128 then return self:FieldError(self.ed_pass, "cloud_password_invalid") end
    if register and (self.ed_pass2:GetText() or "") ~= password then return self:FieldError(self.ed_pass2, "passwords_mismatch") end
    return self:CloudRequest(register and "register" or "login", email, password, username)
end
function netcoop_login_wnd:PollVerification()
    if not cloud_enabled() or self.mode ~= "account" or self.force_login or self.editing_email or account_state() ~= 1 or auth_return == "pending" or self.verify_poll then return end
    local now = now_ms()
    if now < (self.next_verify_poll or 0) then return end
    self.next_verify_poll = now + 5000
    if netcoop_firebase_request("verify", "", "", "") then self.verify_poll = true end
end
local PASSWORD_ERRORS = {INVALID_LOGIN_CREDENTIALS = true, INVALID_PASSWORD = true, EMAIL_NOT_FOUND = true, WEAK_PASSWORD = true}
function on_cloud_result(ok, error, account, verified)
    if not wnd then return end
    if error and error ~= "" then error = cloud_error_code(error) else error = "" end
    if wnd.verify_poll then
        wnd.verify_poll = nil
        wnd.next_verify_poll = now_ms() + ((not ok and error ~= "EMAIL_NOT_VERIFIED") and 20000 or 5000)
        if wnd.deferred_cloud then
            local request = wnd.deferred_cloud; wnd.deferred_cloud = nil; auth_return = nil
            if not wnd:CloudRequest(unpack(request)) then wnd:ResetCloud() end
            return
        end
        if wnd.sign_out_after_poll then wnd.sign_out_after_poll = nil; return wnd:SignOut() end
        if wnd.force_login or wnd.editing_email then return end -- the player already moved to another form
        if ok and verified then auth_message, auth_kind = "", nil; auth_return = "characters"
        elseif session_expired(error) then
            wnd:RequireLogin(); auth_message, auth_kind = cloud_error(error), "error"; auth_return = "account"
        elseif error ~= "EMAIL_NOT_VERIFIED" then wnd:SetNotice(cloud_error(error), "error") end
        return
    end
    if auth_return ~= "pending" then return end
    local action = wnd.cloud_action
    if ok then
        if action ~= "reset" then wnd.force_login = false end
    elseif session_expired(error) then
        wnd:RequireLogin()
    end
    if wnd.role_probe then
        auth_return = nil
        if ok and verified then wnd:StartServerProbe()
        else wnd.role_probe = nil; wnd:SetMsg(ok and tr("verify_help") or cloud_error(error)) end
        return
    end
    if wnd.cloud_join then
        local join = wnd.cloud_join; wnd.cloud_join = nil; auth_return = nil
        if ok and verified then wnd:EnterWorld(unpack(join))
        elseif wnd.force_login then auth_message, auth_kind = cloud_error(error), "error"; auth_return = "account"
        else wnd:SetMsg(ok and tr("verify_help") or cloud_error(error)) end
        return
    end
    if action == "reset" then
        auth_return = nil
        auth_message, auth_kind = ok and tr("reset_sent") or cloud_error(error), ok and "ok" or "error"
        wnd.focus_field = wnd.ed_pass
        return wnd:ResetCloud()
    end
    if action == "resend" or action == "change_email" then
        if ok then
            wnd.editing_email, wnd.resend_at = false, now_ms() + RESEND_DELAY
            wnd.ed_pass:SetText("")
            auth_message = action == "resend" and tr("resend_done") or string.format(tr("change_email_sent"), netcoop_firebase_email())
            auth_kind = "ok"
        else
            auth_message, auth_kind = cloud_error(error), "error"
            if action == "change_email" and PASSWORD_ERRORS[error] then auth_message = tr("change_email_password_invalid") end
            if PASSWORD_ERRORS[error] or error == "CHANGE_EMAIL_PASSWORD_INVALID" then wnd.focus_field = wnd.ed_pass end
            if error == "INVALID_EMAIL" or error == "EMAIL_DOMAIN_NOT_FOUND" or error == "EMAIL_EXISTS" then wnd.focus_field = wnd.ed_email end
        end
        auth_return = "account"
        return
    end
    -- register / login / refresh / verify
    if ok then
        wnd.ed_pass:SetText(""); wnd.ed_pass2:SetText("")
        if verified then auth_message, auth_kind = "", nil
        else
            wnd.editing_email = false
            if action == "register" or action == "login" then wnd.resend_at = now_ms() + RESEND_DELAY end
            if error ~= "" then auth_message, auth_kind = cloud_error(error), "error" else auth_message, auth_kind = nil, nil end
        end
    else
        auth_message, auth_kind = cloud_error(error), "error"
        if action == "register" and error == "EMAIL_EXISTS" then
            wnd.form_mode = "login"; wnd.focus_field = wnd.ed_pass
        elseif PASSWORD_ERRORS[error] then wnd.focus_field = wnd.ed_pass
        elseif error == "INVALID_EMAIL" or error == "EMAIL_DOMAIN_NOT_FOUND" then wnd.focus_field = wnd.ed_email
        elseif error == "ACCOUNT_NAME_REQUIRED" then wnd.focus_field = wnd.ed_login end
    end
    auth_return = ok and verified and "characters" or "account"
end
function netcoop_login_wnd:ShowSettings()
    self:OpenRoomView("settings", 3)
end
function netcoop_login_wnd:ShowRadio() self:OpenRoomView("radio", 1) end
function netcoop_login_wnd:RefreshRadio()
    local station, track, volume, enabled = netcoop_menu_radio.info()
    self.radio_station:TextControl():SetText(tr(station))
    self.radio_track:TextControl():SetText(track)
    self.radio_volume:TextControl():SetText(string.format("%s: %d%%  |  %s", tr("music_volume"), volume * 100,
        tr(enabled and "music_on" or "music_off")))
end
function netcoop_login_wnd:ShowServer()
    self:OpenRoomView("server", 0)
end
function netcoop_login_wnd:CheckServer()
    if auth_return == "pending" then return end
    local ip, port = parse_addr(self.server_edit:GetText())
    if not ip or tonumber(port) < 1 or tonumber(port) > 65535 then return self:SetMsg(tr("server_invalid")) end
    self:SaveServer()
    self.role_probe = true
    if cloud_enabled() then
        if not self:CloudRequest("refresh") then self.role_probe = nil end
    else self:StartServerProbe() end
end
function netcoop_login_wnd:StartServerProbe()
    netcoop_character(0, "", "stalker", 1, "")
    auth_return=nil
    self:WithRoute(self.pending_ip,self.pending_port,self.pending_login,0,function(cip,cport)
        auth_return="pending"
        if not netcoop_frontend_auth(string.format("%s/name=%s/port=%s",cip,self.pending_login,cport)) then return self:RouteFailure(tr("auth_failed")) end
        self:SetMsg(tr("connecting"))
    end)
end

function netcoop_login_wnd:SaveServer()
    local ip, port = parse_addr(self.server_edit:GetText())
    if not ip or tonumber(port) < 1 or tonumber(port) > 65535 then return self:SetMsg(tr("server_invalid")) end
    self.pending_ip, self.pending_port = ip, port
    write_last(self.pending_login, ip .. ":" .. port)
    self.server_panel:Show(false)
    self:ShowCharacters(); self:SetMsg("")
end
function netcoop_login_wnd:ShowProfile(slot)
    if slot < 1 or slot > self:CharacterLimit() then return end
    if self.profile_slot ~= slot then self.profile_data = nil end
    if self.room_view or self.room_pending then self:CloseRoomView() end
    self.mode = "profile"; self.profile_slot = slot
    self:ShowAccountControls(false)
    if self.character_panel then self.character_panel:Show(false) end
    netcoop_preview_clear()
    if not self.profile_panel then
        local xml = CScriptXmlInit(); xml:ParseFile("ui_netcoop_profile.xml")
        self.profile_panel = xml:InitStatic("panel", self)
        for path, text in pairs({title="profile_title", nick="character_nick", description="description", history="history", help="profile_help"}) do
            xml:InitStatic(path, self.profile_panel):TextControl():SetText(tr(text))
        end
        self.profile_name = xml:InitEditBox("input_name", self.profile_panel)
        self.profile_description = xml:InitEditBox("input_description", self.profile_panel)
        self.profile_history = xml:InitEditBox("input_history", self.profile_panel)
        self.profile_msg = xml:InitStatic("msg", self.profile_panel)
        local next = xml:Init3tButton("next", self.profile_panel); next:TextControl():SetText(tr("choose_equipment"))
        self:Register(next, "profile_next"); self:Bind("profile_next", self.ContinueProfile)
        local back = xml:Init3tButton("back", self.profile_panel); back:TextControl():SetText(tr("back"))
        self:Register(back, "profile_back"); self:Bind("profile_back", self.OnBack, true)
    end
    local profile = self.profile_data or {}
    self.profile_name:SetText(profile.name or "")
    self.profile_description:SetText(profile.description or "")
    self.profile_history:SetText(profile.history or "")
    self.profile_msg:TextControl():SetText(""); self.profile_panel:Show(true)
end
function netcoop_login_wnd:ContinueProfile()
    local name = self.profile_name:GetText() or ""
    if #name < 2 or #name > 63 or string.find(name, "[|\r\n/\\]") then
        return self.profile_msg:TextControl():SetText(tr("character_name_invalid"))
    end
    for i = 1, self:CharacterLimit() do
        if i ~= self.profile_slot and self.names and self.names[i] == name then
            return self.profile_msg:TextControl():SetText(tr("character_name_invalid"))
        end
    end
    self.profile_data = {name=name, description=self.profile_description:GetText(), history=self.profile_history:GetText()}
    self.profile_panel:Show(false); self:ShowLoadout(self.profile_slot)
end

-- Native layer callbacks: an error is logged instead of breaking the menu.
on_auth_result = guard("auth result", on_auth_result)
on_cloud_result = guard("cloud result", on_cloud_result)
