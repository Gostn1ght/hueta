-- Lost Zone: barter between players, the client side (owner 2026-10-12;
-- reworked 2026-10-24, spec 9). Look at another player within reach: a
-- prompt "[F] Offer barter". The use key sends the invitation; the other
-- player gets a request with Accept / Decline that lapses after 60 s. Only
-- his Accept opens the barter window for both: laid out as the trader's
-- window - the two offers on top, my backpack on the left, the partner's on
-- the right; items move by drag and drop or a click. The server
-- (netcoop_barter) owns the deal; this window only shows its state and
-- sends the player's choices.

local REACH = 2.5
local REQUEST_MS = 60000

local prompt
local window
local request

local function tr(id) return game.translate_string(id) end

local function key_name()
	local ok, name = pcall(function() return dik_to_keyname(bind_to_dik(key_bindings.kUSE)) end)
	return (ok and name and name ~= "") and string.upper(name) or "F"
end

-- The other player the crosshair is on, within reach.
function looked_at_player()
	if not db.actor then return nil end
	local obj = db.actor.get_actor_object_looking_at and db.actor:get_actor_object_looking_at()
	if not obj then
		local ok, target = pcall(level.get_target_obj)
		obj = ok and target or nil
	end
	-- The engine's own test: no base-game script defines IsActor on a client,
	-- and a player's class is script_actor, not clsid.actor (owner 2026-10-17:
	-- the prompt never appeared).
	if not obj or obj:id() == db.actor:id() or not (obj.is_actor and obj:is_actor()) then return nil end
	if not (obj.alive and obj:alive()) then return nil end
	if obj:position():distance_to(db.actor:position()) > REACH then return nil end
	return obj
end

local function news(text)
	if db.actor then db.actor:give_game_news(tr("st_netcoop_barter_title"), text, "ui_inGame2_Pered_zadaniyami_voennih", 0, 6000) end
end

----------------------------------------------------------------------
-- Prompt under the crosshair, in the interaction prompts' style: the key
-- in its frame, the action beside it. No name, faction or hostility of the
-- player (owner 2026-10-24, spec 6.6).
----------------------------------------------------------------------
class "UIBarterPrompt" (CUIScriptWnd)
function UIBarterPrompt:__init() super()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self.key_bg = CUIStatic()
	self.key_bg:SetAutoDelete(true)
	self.key_bg:SetWndRect(Frect():set(474, 420, 496, 448))
	self.key_bg:InitTexture("ui_catsy_keybind_bg_single_v1")
	self.key_bg:SetStretchTexture(true)
	self:AttachChild(self.key_bg)
	self.key = CUITextWnd()
	self.key:SetAutoDelete(true)
	self.key:SetWndRect(Frect():set(474, 423, 496, 448))
	self.key:SetFont(GetFontLetterica18Russian())
	self.key:SetTextAlignment(2)
	self.key:SetTextColor(GetARGB(255, 20, 20, 20))
	self:AttachChild(self.key)
	self.shadow = CUITextWnd()
	self.shadow:SetAutoDelete(true)
	self.shadow:SetWndRect(Frect():set(505, 424, 805, 450))
	self.shadow:SetFont(GetFontLetterica18Russian())
	self.shadow:SetTextColor(GetARGB(200, 0, 0, 0))
	self:AttachChild(self.shadow)
	self.text = CUITextWnd()
	self.text:SetAutoDelete(true)
	self.text:SetWndRect(Frect():set(504, 423, 804, 449))
	self.text:SetFont(GetFontLetterica18Russian())
	self.text:SetTextColor(GetARGB(255, 235, 230, 220))
	self:AttachChild(self.text)
	self.shown = false
end
function UIBarterPrompt:Set(text)
	if text then
		self.key:SetText(key_name())
		self.text:SetText(text)
		self.shadow:SetText(text)
		if not self.shown then get_hud():AddDialogToRender(self); self.shown = true end
	elseif self.shown then
		get_hud():RemoveDialogToRender(self); self.shown = false
	end
end

local function update_prompt()
	local busy = (window and window:IsShown()) or (request and request:IsShown())
	local text = not busy and looked_at_player() and tr("st_netcoop_barter_offer") or nil
	if text or prompt then
		prompt = prompt or UIBarterPrompt()
		prompt:Set(text)
	end
end

local function on_key_press(dik)
	if dik_to_bind(dik) ~= key_bindings.kUSE then return end
	if (window and window:IsShown()) or (request and request:IsShown()) then return end
	local obj = looked_at_player()
	if obj then netcoop_command("barter invite " .. obj:id()) end
end

----------------------------------------------------------------------
-- The incoming request: Accept / Decline, lapses after 60 s
----------------------------------------------------------------------
class "UIBarterRequest" (CUIScriptWnd)
function UIBarterRequest:__init(from, name) super()
	self.from, self.until_ms = from, time_global() + REQUEST_MS
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:SetAutoDelete(true)
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_netcoop_barter.xml")
	local dialog = xml:InitStatic("barter_request:background", self)
	xml:InitTextWnd("barter_request:text", dialog):SetText(string.format(tr("st_netcoop_barter_request"), name or "?"))
	self.time_left = xml:InitTextWnd("barter_request:time_left", dialog)
	self:Register(xml:Init3tButton("barter_request:btn_accept", dialog), "btn_accept")
	self:Register(xml:Init3tButton("barter_request:btn_decline", dialog), "btn_decline")
	self:AddCallback("btn_accept", ui_events.BUTTON_CLICKED, self.OnAccept, self)
	self:AddCallback("btn_decline", ui_events.BUTTON_CLICKED, self.OnDecline, self)
end

function UIBarterRequest:OnAccept()
	netcoop_command("barter accept " .. self.from)
	self:Close()
end

function UIBarterRequest:OnDecline()
	netcoop_command("barter decline " .. self.from)
	self:Close()
end

function UIBarterRequest:Close()
	if self:IsShown() then self:HideDialog() end
	if request == self then request = nil end
end

function UIBarterRequest:Update()
	CUIScriptWnd.Update(self)
	local left = self.until_ms - time_global()
	if left <= 0 then return self:OnDecline() end
	self.time_left:SetText(string.format(tr("st_netcoop_barter_time_left"), math.ceil(left / 1000)))
end

function UIBarterRequest:OnKeyboard(dik, action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, action)
	if res == false and action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then
		self:OnDecline()
		return true
	end
	return res
end

----------------------------------------------------------------------
-- The barter window
----------------------------------------------------------------------
class "UIBarter" (CUIScriptWnd)
function UIBarter:__init(partner, name) super()
	self.partner, self.partner_name = partner, name
	self.version, self.mine, self.theirs = 0, {}, {}
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:SetAutoDelete(true)
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_netcoop_barter.xml")
	self.xml = xml
	self.dialog = xml:InitStatic("barter:background", self)
	for _, panel in ipairs({"left_panel", "equipment_panel", "right_panel"}) do xml:InitStatic("barter:" .. panel, self.dialog) end
	self.caption = xml:InitTextWnd("barter:caption", self.dialog)
	self.caption:SetText(string.format(tr("st_netcoop_barter_with"), name))
	xml:InitTextWnd("barter:my_name", self.dialog):SetText(db.actor and db.actor:character_name() or "")
	xml:InitTextWnd("barter:partner_name", self.dialog):SetText(name or "")
	for _, entry in ipairs({{"my_icon", db.actor}, {"partner_icon", level.object_by_id(partner)}}) do
		local icon = xml:InitStatic("barter:" .. entry[1], self.dialog)
		if entry[2] and entry[2].character_icon then icon:InitTexture(entry[2]:character_icon()) end
	end
	xml:InitTextWnd("barter:title_bag", self.dialog):SetText(tr("st_netcoop_barter_bag"))
	xml:InitTextWnd("barter:title_their_bag", self.dialog):SetText(tr("st_netcoop_barter_their_bag"))
	xml:InitTextWnd("barter:title_give", self.dialog):SetText(tr("st_netcoop_barter_give"))
	xml:InitTextWnd("barter:title_get", self.dialog):SetText(tr("st_netcoop_barter_get"))
	self.bag = utils_ui.UICellContainer("bag", self, nil, "barter:cont_bag", self.dialog)
	self.give = utils_ui.UICellContainer("give", self, nil, "barter:cont_give", self.dialog)
	self.get = utils_ui.UICellContainer("get", self, nil, "barter:cont_get", self.dialog)
	self.their_bag = utils_ui.UICellContainer("their_bag", self, nil, "barter:cont_their_bag", self.dialog)
	self.equipment = utils_ui.UICellContainer("equipment", self, nil, "barter:cont_equipment", self.dialog)
	self.equipment.disable_drag = true
	local worn = {}
	if db.actor then for slot = 1, 16 do local item = db.actor:item_in_slot(slot); if item then worn[#worn+1] = item end end end
	self.equipment:Reinit(worn)
	self.equipment_status = xml:InitTextWnd("barter:equipment_status", self.dialog)
	-- the partner's side shows sections: his items are his to move
	for _, cc in ipairs({ self.get, self.their_bag }) do
		cc.showcase = 1
		cc.disable_drag = true
	end
	self.item_info = utils_ui.UIInfoItem(self, 500)
	xml:InitTextWnd("barter:money_label", self.dialog):SetText(tr("st_netcoop_barter_money"))
	self.money = xml:InitEditBox("barter:money_edit", self.dialog)
	self:Register(self.money, "money_edit")
	self.their_money = xml:InitTextWnd("barter:their_money", self.dialog)
	self.status_mine = xml:InitTextWnd("barter:status_mine", self.dialog)
	self.status_theirs = xml:InitTextWnd("barter:status_theirs", self.dialog)
	self.btn_ready = xml:Init3tButton("barter:btn_ready", self.dialog)
	self:Register(self.btn_ready, "btn_ready")
	self.btn_cancel = xml:Init3tButton("barter:btn_cancel", self.dialog)
	self:Register(self.btn_cancel, "btn_cancel")
	self:AddCallback("btn_ready", ui_events.BUTTON_CLICKED, self.OnReady, self)
	self:AddCallback("btn_cancel", ui_events.BUTTON_CLICKED, self.OnCancel, self)
	self:AddCallback("money_edit", ui_events.EDIT_TEXT_COMMIT, self.OnMoney, self)
	self:Apply("0", "0", "0", "0", "0", "", "", "")
end

-- My backpack: everything not worn, not on the belt and not offered.
function UIBarter:Backpack()
	local list = {}
	if not db.actor then return list end
	local worn = {}
	for slot = 1, 16 do
		local item = db.actor:item_in_slot(slot)
		if item then worn[item:id()] = true end
	end
	db.actor:iterate_ruck(function(_, item)
		if item and not worn[item:id()] and not self.mine[item:id()] and not db.actor:is_on_belt(item) then
			list[#list + 1] = item
		end
	end, db.actor)
	return list
end

local function parse_items(text)
	local out = {}
	for id, sec, cond in string.gmatch(text or "", "(%d+),([^,;]+),([%d%.]+)") do
		out[#out + 1] = { id = tonumber(id), section = sec, condition = tonumber(cond) }
	end
	return out
end

local function sections(text)
	local out = {}
	for _, it in ipairs(parse_items(text)) do
		if ini_sys:section_exist(it.section) then out[#out + 1] = it.section end
	end
	return out
end

function UIBarter:Apply(version, my_money, their_money, my_ready, their_ready, mine, theirs, their_bag)
	self.version = tonumber(version) or 0
	self.mine = {}
	local give = {}
	for _, it in ipairs(parse_items(mine)) do
		self.mine[it.id] = true
		local obj = level.object_by_id(it.id)
		if obj then give[#give + 1] = obj end
	end
	self.bag:Reinit(self:Backpack())
	self.give:Reinit(give)
	self.get:Reinit(sections(theirs))
	self.their_bag:Reinit(sections(their_bag))
	if not self.money_editing then self.money:SetText(tostring(tonumber(my_money) or 0)) end
	self.their_money:SetText(string.format(tr("st_netcoop_barter_their_money"), tonumber(their_money) or 0))
	self.ready_mine = my_ready == "1"
	self.status_mine:SetText(tr(self.ready_mine and "st_netcoop_barter_you_ready" or "st_netcoop_barter_you_wait"))
	self.status_theirs:SetText(string.format(tr(their_ready == "1" and "st_netcoop_barter_they_ready" or "st_netcoop_barter_they_wait"), self.partner_name))
end

-- My item into my offer, or back into the backpack.
function UIBarter:Move(cont, idx)
	local cc = (cont == "bag" and self.bag) or (cont == "give" and self.give) or nil
	local ci = cc and cc.cell[idx]
	if not (ci and ci.ID) then return end
	netcoop_command(string.format("barter %s %d", cont == "bag" and "add" or "remove", ci.ID))
end

function UIBarter:On_CC_Mouse1(cont, idx) self:Move(cont, idx) end
UIBarter.On_CC_Mouse1_DB = UIBarter.On_CC_Mouse1

-- Drag and drop: from the backpack onto the offer, or back.
function UIBarter:On_CC_DragDrop(cont, idx)
	local target = (cont == "bag" and self.give) or (cont == "give" and self.bag) or nil
	if target and target.prof and target.prof:IsCursorOverWindow() then self:Move(cont, idx) end
end

function UIBarter:OnMoney()
	local amount = math.max(0, math.floor(tonumber(self.money:GetText()) or 0))
	netcoop_command("barter money " .. amount)
end

function UIBarter:OnReady()
	self:OnMoney()
	netcoop_command("barter ready " .. self.version)
end

function UIBarter:OnCancel()
	netcoop_command("barter cancel")
	self:Close()
end

function UIBarter:Close()
	if self:IsShown() then self:HideDialog() end
	window = nil
end

function UIBarter:Update()
	CUIScriptWnd.Update(self)
	local found = false
	for _, cc in ipairs({ self.bag, self.give, self.get, self.their_bag, self.equipment }) do
		if cc:Update(self.item_info) then found = true end
	end
	if not found then self.item_info:Update() end
	if db.actor and time_global() >= (self.next_status or 0) then
		self.next_status = time_global() + 1000
		self.equipment_status:SetText(string.format("%s: %d%%\n%s: %d%%\n%s: %d RU", tr("ui_inv_health"), math.floor(db.actor.health*100), tr("ui_inv_power"), math.floor(db.actor.power*100), tr("st_netcoop_barter_money"), db.actor:money()))
	end
end

function UIBarter:OnKeyboard(dik, action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, action)
	if res == false and action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then
		self:OnCancel()
		return true
	end
	return res
end

----------------------------------------------------------------------
-- Server messages, channel "barter"
----------------------------------------------------------------------
function receive(data)
	local parts = {}
	for part in string.gmatch((data or "") .. "|", "([^|]*)|") do parts[#parts + 1] = part end
	local verb = parts[1]
	if verb == "invited" then
		local from = tonumber(parts[2])
		if from and not (window and window:IsShown()) then
			if request then request:Close() end
			request = UIBarterRequest(from, parts[3])
			request:ShowDialog(true)
		elseif from then
			netcoop_command("barter decline " .. from) -- busy in another barter
		end
	elseif verb == "expired" then
		if request and request.from == tonumber(parts[2]) then
			request:Close()
			news(tr("st_netcoop_barter_expired"))
		end
	elseif verb == "sent" then
		news(string.format(tr("st_netcoop_barter_sent"), parts[3] or "?"))
	elseif verb == "declined" then
		news(string.format(tr("st_netcoop_barter_declined"), parts[2] or "?"))
	elseif verb == "open" then
		if request then request:Close() end
		if window then window:Close() end
		window = UIBarter(tonumber(parts[2]), parts[3] or "?")
		window:ShowDialog(true)
	elseif verb == "state" then
		if window then window:Apply(parts[2], parts[3], parts[4], parts[5], parts[6], parts[7], parts[8], parts[9]) end
	elseif verb == "closed" then
		if window then window:Close() end
		news(tr("st_netcoop_barter_closed_" .. (parts[2] or "cancel")))
	elseif verb == "done" then
		if window then window:Close() end
		news(tr("st_netcoop_barter_done"))
	end
end

local next_prompt = 0
local function actor_on_update()
	if time_global() < next_prompt then return end
	next_prompt = time_global() + 100
	local ok, err = pcall(update_prompt)
	if not ok then printf("! [Lost Zone] barter prompt: %s", tostring(err)); next_prompt = time_global() + 5000 end
end

function on_game_start()
	if not (netcoop_pure_client and netcoop_pure_client()) then return end
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("on_key_press", on_key_press)
end

-- Tests.
function current_window() return window end
function current_request() return request end
