-- Lost Zone: compatibility layer for a pure netcoop client.
--
-- A remote client has no local ALife simulator: alife() returns nil and the
-- base-game Actor binder never runs, so db.actor is never assigned. base-game UI
-- scripts (inventory, PDA, options) assume both exist and crash.
--
-- The dedicated server owns the simulation. This layer only lets client UI
-- read the locally controlled Actor; it never simulates or changes the world.
-- Write requests (create/release/teleport/info) are dropped here and must go
-- through server messages.
--
-- Installed from the end of _g.script by scripts/patch-gamma-netcoop-client.ps1.

local installed = false
local native_alife = nil
local warned = {}

local function warn_once(what)
	if warned[what] then return end
	warned[what] = true
	printf("[Lost Zone] client has no ALife: alife():%s ignored", what)
end

local controlled_actor = nil
local controlled_actor_id = nil
local destroyed_actor_id = nil
local use_own_actor_id -- defined below
local install_actor_lifecycle
local player_state_ready = false
local next_player_state = 0
local pending_player_state = nil

-- The locally controlled Actor: set by the engine hook after spawn, or
-- recovered from the view entity when this script loaded too late for it.
local function local_actor()
	if not (level and level.present and level.present()) then
		controlled_actor = nil
		controlled_actor_id = nil
		return nil
	end
	if controlled_actor then return controlled_actor end
	local e = level.get_view_entity and level.get_view_entity()
	if e and e:clsid() == clsid.script_actor and e:id() ~= destroyed_actor_id then
		controlled_actor = e
		controlled_actor_id = e:id()
		use_own_actor_id(e)
	end
	return controlled_actor
end

local function in_game()
	return local_actor() ~= nil
end

-- base-game scripts use AC_ID (0, the story Actor) for "the player". On a client
-- the own Actor has another id: AC_ID becomes that id, and db.storage[0]
-- (captured copies of the old constant) reads the own Actor's storage.
use_own_actor_id = function(obj)
	if not obj then return end
	_G.AC_ID = obj:id()
	local storage = db and db.storage
	if type(storage) == "table" and not getmetatable(storage) then
		setmetatable(storage, { __index = function(t, k)
			if k == 0 and controlled_actor then return rawget(t, controlled_actor:id()) end
		end })
	end
end

-- base-game's "Busy Hands" handler (callbacks_gameobject) pauses the game with a
-- warning and saves on any failed engine call. A netcoop client has no saves,
-- and such errors come from single-player scripts that do not apply to it;
-- the engine already logs them.
local function quiet_busy_hands()
	_G.COnLuaBindFatalError = function(offender)
		printf("[Lost Zone] engine call failed in %s", tostring(offender))
	end
end

-- The PDA opens from its slot (8). A PDA the player gets (starter kit from
-- the server, pickups) goes to the rucksack; equip it when the slot is free.
local PDA_SLOT = 8
local function equip_pda()
	local a = db.actor
	if not a or a:item_in_slot(PDA_SLOT) then return true end
	local pda
	a:iterate_inventory(function(_, item)
		if not pda and string.find(item:section(), "device_pda", 1, true) then
			pda = item
		end
	end, a)
	if pda then
		a:move_to_slot(pda, PDA_SLOT)
		printf("[Lost Zone] %s equipped in the PDA slot", pda:section())
	end
	return true
end

local function on_item_take(item)
	if item and string.find(item:section(), "device_pda", 1, true) then
		CreateTimeEvent("netcoop_client", "equip_pda", 1, equip_pda)
	end
end

-- Engine hook (Level_network_spawn.cpp) after the local Actor is assigned.
function on_actor_spawned(obj)
	controlled_actor = obj
	player_state_ready = false
	next_player_state = 0
	controlled_actor_id = obj:id()
	destroyed_actor_id = nil
	db.actor = obj
	install_actor_lifecycle()
	use_own_actor_id(obj)
	quiet_busy_hands()
	CreateTimeEvent("netcoop_client", "equip_pda", 5, equip_pda)
	if pending_player_state then use_player_state(pending_player_state) end
end

function on_actor_destroyed(obj)
	if obj and controlled_actor_id == obj:id() then
		netcoop_emission_view.reset()
		netcoop_psi_view.reset()
		destroyed_actor_id = controlled_actor_id
		controlled_actor = nil
		controlled_actor_id = nil
		player_state_ready, next_player_state, pending_player_state = false, 0, nil
		rawset(db, "actor", nil)
	end
end

-- A dead local actor can remain as a lootable corpse after a new actor spawns.
-- Its binder must never update or tear down the new actor's global HUD/state.
install_actor_lifecycle = function()
	local binder = bind_stalker and bind_stalker.actor_binder
	if not binder or binder.__netcoop_lifecycle then return end
	binder.__netcoop_lifecycle = true
	local destroy, update = binder.net_destroy, binder.update
	binder.update = function(self, ...)
		if self.__netcoop_destroying or self.object:id() ~= controlled_actor_id then return end
		return update(self, ...)
	end
	binder.net_destroy = function(self, ...)
		if self.__netcoop_destroying then return end
		self.__netcoop_destroying = true
		if self.object:id() ~= controlled_actor_id then
			if USE_MARSHAL then UnregisterScriptCallback("save_state", self) end
			db.del_obj(self.object)
			db.delete_enemy(self.object)
			return object_binder.net_destroy(self)
		end
		local ok, err = pcall(destroy, self, ...)
		on_actor_destroyed(self.object)
		if not ok then error(err) end
	end
	-- db.del_actor in base-game ignores its argument and dereferences db.actor.
	-- Use the valid binder object, then clear the fallback pointer as well.
	db.del_actor = function(obj)
		obj = obj or rawget(db, "actor")
		if not obj then return end
		db.del_obj(obj)
		if obj:id() ~= controlled_actor_id then return end
		db.actor_proxy:net_destroy()
		on_actor_destroyed(obj)
	end
end

function is_pure_client()
	return native_alife ~= nil and native_alife() == nil and in_game()
end

----------------------------------------------------------------------
-- se_actor stand-in built from the live Actor game object
----------------------------------------------------------------------
local actor_methods = {
	character_name = function() return db.actor:character_name() end,
	community = function() return db.actor:character_community() end,
	rank = function() return db.actor:character_rank() end,
	reputation = function() return db.actor:character_reputation() end,
	character_icon = function() return db.actor:character_icon() end,
	profile_name = function() return db.actor:profile_name() end,
	name = function() return db.actor:name() end,
	section_name = function() return db.actor:section() end,
	clsid = function() return db.actor:clsid() end,
	alive = function() return db.actor:alive() end,
	money = function() return db.actor:money() end,
}

local actor_fields = {
	id = function() return db.actor:id() end,
	parent_id = function() return 65535 end,
	online = function() return true end,
	position = function() return db.actor:position() end,
	m_level_vertex_id = function() return db.actor:level_vertex_id() end,
	m_game_vertex_id = function() return db.actor:game_vertex_id() end,
	group_id = function() return 65535 end,
}

local se_actor_stub = setmetatable({}, {
	__index = function(_, k)
		local field = actor_fields[k]
		if field then return field() end
		local method = actor_methods[k]
		if method then return function() return method() end end
		warn_once("actor():" .. tostring(k))
		return function() return nil end
	end,
})

----------------------------------------------------------------------
-- alife() stand-in
----------------------------------------------------------------------
----------------------------------------------------------------------
-- Admin world changes go to the server (netanomaly_server.script)
----------------------------------------------------------------------
local function is_admin()
	return netcoop_role and netcoop_role() == 2
end

local function request_create(section, pos, lvid, gvid, parent_id)
	if not is_admin() then
		warn_once("create (admin only)")
		return nil
	end
	-- Only the admin's debug spawn menu creates objects from a client. World
	-- scripts that run on game start (stash and loot placement) belong to the
	-- server, which runs them itself.
	local trace = debug and debug.traceback and debug.traceback() or ""
	if not string.find(trace, "ui_debug", 1, true) then
		warn_once("create (only from the admin spawn menu)")
		return nil
	end
	local a = db.actor
	-- base-game spawners pass AC_ID (0, the story Actor) for "into my inventory".
	if parent_id and a and (parent_id == a:id() or parent_id == 0) then
		netcoop_command(string.format("spawn %s 1", tostring(section)))
	elseif pos then
		netcoop_command(string.format("spawn_at %s %.2f %.2f %.2f", tostring(section), pos.x, pos.y, pos.z))
	else
		netcoop_command(string.format("spawn %s 1", tostring(section)))
	end
	return nil -- the object arrives later as a normal network spawn
end

local sim_methods = {
	create = function(_, section, pos, lvid, gvid, parent_id) return request_create(section, pos, lvid, gvid, parent_id) end,
	actor = function() return db.actor and se_actor_stub or nil end,
	object = function(_, id) return nil end,
	story_object = function() return nil end,
	object_by_id = function() return nil end,
	has_info = function(_, id, info)
		local a = db.actor
		return a ~= nil and a:has_info(info) or false
	end,
	level_name = function() return level.name() end,
	level_id = function() return 0 end,
	switch_distance = function() return 150 end,
	object_count = function() return 0 end,
	iterate_info = function() end,
	iterate_objects = function() end,
	get_children = function() return {} end,
}

local sim_stub = setmetatable({}, {
	__index = function(_, k)
		local m = sim_methods[k]
		if m then return m end
		return function()
			warn_once(tostring(k))
			return nil
		end
	end,
})

local function alife_compat()
	local sim = native_alife()
	if sim then return sim end
	-- Level scripts (including the Actor binder reinit) run before the Actor
	-- becomes the view entity, so answer as soon as a level is loaded.
	if level and level.present and level.present() then return sim_stub end
	return nil
end

----------------------------------------------------------------------
-- db.actor falls back to the locally controlled Actor
----------------------------------------------------------------------
local function install_db_actor()
	local ns = db
	if type(ns) ~= "table" then return end
	local mt = getmetatable(ns)
	if not mt then
		mt = {}
		setmetatable(ns, mt)
	end
	if mt.__netcoop_actor then return end
	local previous = mt.__index
	mt.__netcoop_actor = true
	mt.__index = function(t, k)
		if k == "actor" then
			if native_alife() == nil then
				return local_actor()
			end
			return nil
		end
		if type(previous) == "function" then return previous(t, k) end
		if type(previous) == "table" then return previous[k] end
		return nil
	end
end

----------------------------------------------------------------------
-- No save games on a client: the server owns the world state
----------------------------------------------------------------------
local function no_saves(flags)
	if flags then flags.ret = true end
	printf("[Lost Zone] saving and loading are disabled: the server owns the world")
end

local function no_quick_load(dik, bind, flags)
	no_saves(flags)
end

----------------------------------------------------------------------
-- Engine callbacks (netcoop.cpp)
----------------------------------------------------------------------
local function show_text(text)
	local a = db.actor
	if a and text and text ~= "" then
		pcall(function() a:give_game_news("Server", text, "ui_inGame2_PD_Lider", 0, 7000) end)
	end
end

local admin_callbacks_installed = false
local function sync_admin_tools(ok, role)
	_G.DEV_DEBUG = ok and role == 2 or false
	if _G.DEV_DEBUG and not admin_callbacks_installed and ui_debug_launcher and ui_debug_launcher.on_game_start then
		ui_debug_launcher.on_game_start()
		admin_callbacks_installed = true
	end
end

function on_auth_result(ok, role, message)
	netcoop_login_ui.on_auth_result(ok, role, message)
	printf("[Lost Zone] login %s: role=%s %s", ok and "ok" or "failed", tostring(role), tostring(message))
	sync_admin_tools(ok, role)
end

-- The server changed this account's role while it is online (sv_account_role,
-- the master window): the admin tools work at once, as after a login.
function on_role_changed(ok, role, message)
	sync_admin_tools(ok, role)
	printf("[Lost Zone] role changed: %s", tostring(role))
end

-- The server's reasons are English; the player reads them in their language.
local TRADE_REASONS = {
	["Trader is hostile to your character"] = "st_netcoop_trade_hostile",
	["Trader is too far away"] = "st_netcoop_trade_far",
	["This character does not trade"] = "st_netcoop_trade_none",
	["Trader is wounded"] = "st_netcoop_trade_wounded",
	["Trader is not alive"] = "st_netcoop_trade_none",
	["Trader is not available"] = "st_netcoop_trade_none",
	["Trader profile is unavailable"] = "st_netcoop_trade_none",
	["Trading is disabled by this dialogue"] = "st_netcoop_trade_none",
	["Not enough money"] = "not_enough_money_actor",
	["Trader does not have enough money"] = "not_enough_money_partner",
	["Item does not meet this trader's conditions"] = "st_netcoop_trade_item",
	["Item is no longer available"] = "st_netcoop_trade_gone",
	["Item is already being traded"] = "st_netcoop_trade_gone",
}

function on_trade_result(ok, role, message)
	if not ok then
		local id = TRADE_REASONS[message or ""]
		local text = id and game.translate_string(id) or message
		-- News stay under an open trade window: the window's own message box.
		local gui = ui_inventory and ui_inventory.GUI
		local box = gui and gui.IsShown and gui:IsShown() and gui.message_box
		if box then
			pcall(function()
				box:InitMessageBox("message_box_ok")
				box:SetText(text)
				box:ShowDialog(true)
			end)
		else
			show_text(text)
		end
	end
	-- Items and money arrive as replicated events; rebuild the open window.
	local gui = ui_inventory and ui_inventory.GUI
	if gui then gui.update_info = true end
end

-- base-game's trade window (ui_inventory) moves items and money itself, which a
-- client cannot do: NPC inventories and money belong to the server. The
-- deal is sent to the server, which prices, checks and executes it.
local function install_server_trade()
	local ui = ui_inventory and ui_inventory.UIInventory
	if not ui or ui.__netcoop_trade or not netcoop_trade then return end
	ui.__netcoop_trade = true
	local function request(self, bag, actor_sells)
		local npc = self:GetPartner()
		local cc = self.CC and self.CC[bag]
		if not (npc and cc and cc.indx_id) then return end
		local ids = {}
		for id in pairs(cc.indx_id) do
			if cc:GetCell_ID(id) then ids[#ids + 1] = tostring(id) end
		end
		if #ids == 0 then return end
		if netcoop_trade(npc:id(), actor_sells, table.concat(ids, " ")) then
			printf("[Lost Zone] trade request: %s %s item(s) with %s", actor_sells and "sell" or "buy", #ids, npc:name())
			if self.PlaySND and snd_trade then self:PlaySND(snd_trade) end
		end
		self.update_info = true
	end
	ui.TMode_Sell = function(self) request(self, "actor_trade", true) end
	ui.TMode_Buy = function(self) request(self, "npc_trade", false) end
end

function on_server_text(text)
	show_text(text)
end

----------------------------------------------------------------------
-- World state from the server (netcoop_broadcast on the server)
----------------------------------------------------------------------
local server_weather = nil
local applied_actual = nil -- level.get_weather() right after applying it
local applying_server_weather = false
local engine_set_weather = nil
local engine_change_time = nil
local engine_weather = nil -- the engine's weather editor functions (install_weather_follow)

-- The server chooses the weather; this client's weather manager (and the
-- base-game fixes that extend it) must never pick its own. Installed at game
-- start, after every script has patched WeatherManager.
local function install_weather_follow()
	-- A pure client keeps its Lua state between sessions (no ALife, no
	-- restart_all): the last session's weather made the first one of a new
	-- session a slow transition from the level's default sky, so a player who
	-- reconnected saw another weather than the others (owner 2026-10-17).
	server_weather, applied_actual = nil, nil
	local wm_class = level_weathers and level_weathers.WeatherManager
	if wm_class then
		wm_class.select_weather = function(self)
			self.levelWeather = self.levelWeather or "default"
		end
		wm_class.select_custom_weather = function(self)
			self.levelWeather = self.levelWeather or "default"
		end
		wm_class.change_period = function() end
	end
	-- Local weather changes (admin debug menu, other scripts) go to the
	-- server so that everyone gets them; a player's own change is ignored.
	if not engine_set_weather and level and level.set_weather then
		engine_set_weather = level.set_weather
		level.set_weather = function(name, now)
			if applying_server_weather then
				return engine_set_weather(name, now)
			end
			if is_admin() and name and name ~= "" then
				netcoop_command(string.format("weather %s%s", tostring(name), now and " now" or ""))
			end
		end
	end
	-- The administrator's weather editor (ui_debug_weather): its pause, sun
	-- time and sky values go to the server, which gives them to everyone
	-- (netcoop_server_compat.weather_edit); here they apply at once as well.
	if weather and not engine_weather then
		engine_weather = {}
		for _, name in ipairs({ "pause", "sun_time", "set_value_numric", "set_value_vector", "set_value_string" }) do
			engine_weather[name] = weather[name]
		end
		local function share(text) if is_admin() and not applying_server_weather then netcoop_command("weather_edit " .. text) end end
		weather.pause = function(on)
			engine_weather.pause(on)
			share("pause " .. (on and "1" or "0"))
		end
		weather.sun_time = function(h, m)
			engine_weather.sun_time(h, m)
			share(string.format("sun %d %d", math.floor(tonumber(h) or 0), math.floor(tonumber(m) or 0)))
		end
		weather.set_value_numric = function(par, v)
			engine_weather.set_value_numric(par, v)
			share(string.format("num %s %.6g", tostring(par), tonumber(v) or 0))
		end
		weather.set_value_vector = function(par, x, y, z, w)
			engine_weather.set_value_vector(par, x, y, z, w)
			local text = string.format("vec %s %.6g %.6g %.6g", tostring(par), tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
			share(w ~= nil and (text .. string.format(" %.6g", tonumber(w) or 0)) or text)
		end
		weather.set_value_string = function(par, v)
			engine_weather.set_value_string(par, v)
			share(string.format("str %s %s", tostring(par), tostring(v)))
		end
	end
	-- The administrator's debug "time" goes to the server (and from there to
	-- the world master); the client's own clock follows the server.
	if not engine_change_time and level and level.change_game_time then
		engine_change_time = level.change_game_time
		level.change_game_time = function(days, hours, mins)
			local trace = debug and debug.traceback and debug.traceback() or ""
			if is_admin() and string.find(trace, "debug_cmd_list", 1, true) then
				netcoop_command(string.format("time %d %d %d", math.max(0, math.floor(tonumber(days) or 0)),
					math.max(0, math.floor(tonumber(hours) or 0)), math.max(0, math.floor(tonumber(mins) or 0))))
			end
		end
	end
end

-- data: "name" (transition) or "name|1" (switch at once). Applied whenever
-- the current weather differs, not only when the name changes: a local
-- change used to stay because the repeated name was ignored.
local function use_server_weather(data)
	local name, forced = string.match(data or "", "^([^|]+)|?(%d?)$")
	if not name or name == "" then return end
	local first = server_weather == nil
	local current = level.get_weather and level.get_weather() or nil
	-- Re-applying the same weather restarted it (rain sound cut on and off
	-- every broadcast): apply only a new weather, or when something changed
	-- the weather locally since.
	if not first and forced ~= "1" and name == server_weather and current == applied_actual then return end
	server_weather = name
	local wm = level_weathers and level_weathers.get_weather_manager()
	if wm then
		wm.weather_file = name
		wm.levelWeather = wm.levelWeather or "default"
	end
	applying_server_weather = true
	local setter = engine_set_weather or level.set_weather
	pcall(setter, name, first or forced == "1")
	applying_server_weather = false
	applied_actual = level.get_weather and level.get_weather() or name
	printf("[Lost Zone] server weather: %s%s", name, (first or forced == "1") and " (now)" or "")
end

-- The weather editor's shared state (server: netcoop_server_compat
-- weather_edit): applied when it changes; unpausing returns the server's sky.
local edit_seq = nil
local function use_weather_edit(data)
	local v = netcoop_pdanet_client and netcoop_pdanet_client.decode(data)
	if type(v) ~= "table" or v.seq == edit_seq then return end
	local first = edit_seq == nil
	edit_seq = v.seq
	local w = engine_weather
	if not w then return end
	applying_server_weather = true
	if v.paused then
		pcall(w.pause, true)
		if type(v.sun) == "table" then pcall(w.sun_time, tonumber(v.sun.h) or 0, tonumber(v.sun.m) or 0) end
		for par, x in pairs(type(v.values) == "table" and v.values or {}) do
			if type(x) == "table" then
				if x.k == "n" then pcall(w.set_value_numric, par, tonumber(x[1]) or 0)
				elseif x.k == "v" then pcall(w.set_value_vector, par, tonumber(x[1]) or 0, tonumber(x[2]) or 0, tonumber(x[3]) or 0, tonumber(x[4]))
				elseif x.k == "s" then pcall(w.set_value_string, par, tostring(x[1] or "")) end
			end
		end
	elseif not first then
		pcall(w.pause, false)
		if server_weather then pcall(engine_set_weather or level.set_weather, server_weather, true) end
	end
	applying_server_weather = false
end

-- Places this player has found (server: netcoop_map_known): level changers,
-- named places and anomaly fields on the PDA map, named on hover in this
-- client's language. "<id> <x> <y> <z> <spot> <kind>|<name>" per line.
local MAP_KINDS = { c = true, p = true, a = true }
local function map_hint(kind, name)
	local tr = game.translate_string
	if kind == "c" then return string.format(tr("st_lz_map_changer"), tr(name)) end
	if kind == "a" then return string.format(tr("st_lz_map_anomaly"), tr("st_lz_anomaly_" .. name)) end
	return tr(name)
end
local function use_map_known(data)
	local here = level.name()
	for row in string.gmatch(data or "", "[^\n]+") do
		local id, x, y, z, spot, kind, name = string.match(row, "^(%d+) (%S+) (%S+) (%S+) ([%w_]+) (%a)|([%w_%.]+)$")
		id, x, y, z = tonumber(id), tonumber(x), tonumber(y), tonumber(z)
		if id and x and y and z and MAP_KINDS[kind] and id < 65535 then
			if netcoop_map_position_set then netcoop_map_position_set(id, x, y, z, here) end
			if level.map_has_object_spot(id, spot) == 0 then
				pcall(level.map_add_object_spot_ser, id, spot, map_hint(kind, name))
			end
		end
	end
end

-- Camp fires near this player (owner 2026-10-24: light and put out, the same
-- for everyone). GAMMA finds a fire through campfires_all, which its campfire
-- binders fill; a client runs no binders of world objects (the server owns
-- them), so matches and "use" found no fire here. The fires within 30 m are
-- listed every 2 s; lighting and putting out go to the server
-- (netcoop_campfire.inc), which every client follows.
local CAMPFIRE_RANGE, CAMPFIRE_EVERY = 30, 2000
local campfire_next = 0
local function campfires_near_update()
	local list = bind_campfire and bind_campfire.campfires_all
	if not (list and db.actor) or time_global() < campfire_next then return false end
	campfire_next = time_global() + CAMPFIRE_EVERY
	local pos = db.actor:position()
	for id, entry in pairs(list) do
		if entry.netcoop and (not level.object_by_id(id) or entry.object:position():distance_to(pos) > CAMPFIRE_RANGE) then
			list[id] = nil
		end
	end
	level.iterate_nearest(pos, CAMPFIRE_RANGE, function(obj)
		local campfire = obj and obj.get_campfire and obj:get_campfire()
		if campfire and not list[obj:id()] then
			list[obj:id()] = { object = obj, campfire = campfire, netcoop = true }
		end
	end)
	return false
end

-- New Way's hands (owner 2026-10-24: opening a door and lighting a camp fire
-- in first and third person; configs/mod_system_lz_nw_gestures.ltx). The
-- other players see the gesture when the server says this player did it
-- (netcoop_consumption, the engine plays third_person_motion).
local function nw_hands_ready(section)
	return game and game.play_hud_motion and ini_sys:section_exist(section)
end

-- Lighting or putting out a camp fire: their hands with the matches instead
-- of GAMMA's matches effect (the weapon goes away first, as GAMMA's did).
local function nw_ignition()
	if actor_effects and actor_effects.use_weapon then actor_effects.use_weapon(0) end
	CreateTimeEvent("netcoop_nw_hands", "ignition", 0.5, function()
		local ms = tonumber(game.play_hud_motion(2, "anim_campfire_ignition_hud", "anm_ea_show", true, 1)) or 0
		CreateTimeEvent("netcoop_nw_hands", "ignition_end", math.max(ms, 500) / 1000 + 0.1, function()
			if actor_effects and actor_effects.use_weapon then actor_effects.use_weapon(1) end
			return true
		end)
		return true
	end)
end

local function install_campfire_hands()
	local bc = bind_campfire
	if not (bc and actor_effects and actor_effects.play_item_fx) or bc.__netcoop_hands then return end
	if not nw_hands_ready("anim_campfire_ignition_hud") then return end
	bc.__netcoop_hands = true
	local function with_hands(fn)
		return function(...)
			local fx = actor_effects.play_item_fx
			actor_effects.play_item_fx = function(name, ...)
				if name == "matches_script" then return nw_ignition() end
				return fx(name, ...)
			end
			local ok, result = pcall(fn, ...)
			actor_effects.play_item_fx = fx
			if not ok then printf("! [Lost Zone] campfire: %s", tostring(result)) end
			return result
		end
	end
	bc.campfire_go_on = with_hands(bc.campfire_go_on)
	bc.campfire_go_off = with_hands(bc.campfire_go_off)
end

-- Doors: a client runs no binders of world objects, so "use" on a door did
-- nothing here (players pushed doors open). The server opens or closes it
-- where its logic runs (netanomaly_server "door"); this player's left hand
-- reaches for it.
local DOOR_REACH, DOOR_EVERY = 2.5, 800
local door_next = 0
local function is_door(obj)
	if not (obj and obj:clsid() == clsid.obj_physic and obj.get_visual_name) then return false end
	local visual = string.lower(obj:get_visual_name() or "")
	return (string.find(visual, "door", 1, true) or string.find(visual, "vorot", 1, true)
		or string.find(visual, "gate", 1, true)) ~= nil
end

local function door_key(dik)
	if not db.actor or time_global() < door_next or not netcoop_command then return end
	local ok, use = pcall(bind_to_dik, key_bindings.kUSE)
	if not ok or dik ~= use or level.get_target_dist() > DOOR_REACH then return end
	local target = level.get_target_obj()
	if not is_door(target) then return end
	door_next = time_global() + DOOR_EVERY
	netcoop_command("door " .. target:id())
	if nw_hands_ready("anim_door_open_hud") then
		game.play_hud_motion(1, "anim_door_open_hud", "anm_ea_show", true, 1)
	end
end

-- A server dialogue action opened an NPC window for this player.
local function open_ui(data)
	local kind, id = string.match(data or "", "^(%S+)%s+(%d+)$")
	local npc = id and level.object_by_id(tonumber(id))
	local a = db.actor
	if not (npc and a) then return end
	if kind == "trade" then
		npc:start_trade(a)
	elseif kind == "upgrade" then
		npc:start_upgrade(a)
	end
end

-- Trade profile of an NPC from the server: buy/sell conditions for the trade
-- window. Supplies (restocking) stay on the server.
local function use_trade_profile(data)
	local id, rest = string.match(data or "", "^(%d+)%s+(.+)$")
	local cfg, buy, sell, factor = string.match(rest or "", "^([^|]+)|([^|]*)|([^|]*)|([^|]*)$")
	cfg = cfg or rest
	local npc = id and level.object_by_id(tonumber(id))
	if not (npc and cfg and trade_manager) then return end
	local ok, err = pcall(function()
		trade_manager.trade_init(npc, cfg)
		local config = trade_manager.get_trade_cfg(cfg)
		if config then
			trade_manager.setup_buy_sell_conditions(npc, npc:id(), config)
			-- The server's own pick wins (it decides every deal).
			local profile = trade_manager.get_trade_profile(npc:id())
			if profile and buy and buy ~= "" and config:section_exist(buy) then
				npc:buy_condition(config, buy); profile.current_buy_condition = buy
			end
			if profile and sell and sell ~= "" and config:section_exist(sell) then
				npc:sell_condition(config, sell); profile.current_sell_condition = sell
			end
			local f = tonumber(factor or "")
			if profile and f and f >= 0 and f <= 1 then
				npc:buy_item_condition_factor(f); profile.current_buy_item_condition_factor = f
			end
		end
		local gui = ui_inventory and ui_inventory.GUI
		local partner = gui and gui.GetPartner and gui:GetPartner()
		if gui and gui.mode == "trade" and partner and partner:id() == npc:id() then
		    gui:TMode_InitProfile(npc)
		    -- A late profile may have filtered every cell out during TMode_Init.
		    -- Refresh the real inventories now, preserving items already selected
		    -- for the deal; resetting whole bags would show those items twice.
		    gui:TMode_RefreshInventories()
		    gui.update_info = true
		end
	end)
	if not ok then printf("[Lost Zone] trade profile %s failed: %s", cfg, tostring(err)) end
end

-- A server NPC animation attached or detached a prop (guitar, harmonica,
-- radio). The item may still be on its way to this client: retry for 5 s.
local function set_attached(data)
	local id, on = string.match(data or "", "^(%d+)%s+(%d)$")
	id = tonumber(id)
	if not id then return end
	local tries = 0
	local function apply()
		local itm = level.object_by_id(id)
		if itm then
			pcall(itm.enable_attachable_item, itm, on == "1")
			return true
		end
		tries = tries + 1
		return tries > 10
	end
	if not apply() and CreateTimeEvent then
		CreateTimeEvent("netcoop_attach", tostring(id), 0.5, function()
			if apply() then return true end
			ResetTimeEvent("netcoop_attach", tostring(id), 0.5)
			return false
		end)
	end
end

function on_script_message(channel, data)
	if channel == "registration" then
		-- Older servers may send this notice; there is no approval queue now.
		return
	elseif channel == "emission" then
		netcoop_emission_view.receive(data)
		return
	elseif channel == "psi_storm" then
		netcoop_psi_view.receive(data)
		return
	elseif channel == "psi_vortex" then
		netcoop_psi_view.vortex(data)
		return
	elseif channel == "psi_hit" then
		netcoop_psi_view.on_hit(data)
		return
	elseif channel == "psi_kill" then
		netcoop_psi_view.killed(data)
		return
	elseif channel == "radio" then
		-- This character's walkie-talkie setting kept by the server.
		if netcoop_voice_ui then netcoop_voice_ui.receive(data) end
		return
	elseif channel == "wparts" then
		-- An item's weapon/outfit parts, kept by the server.
		if netcoop_weapon_parts_view then netcoop_weapon_parts_view.receive(data) end
		return
	elseif channel == "recipes" then
		-- Recipes this character learned from books, kept by the server.
		if netcoop_workshop_view then netcoop_workshop_view.receive_recipes(data) end
		return
	elseif channel == "pdanet" then
		-- The PDA network: contacts, chats, general channel (netcoop_pdanet).
		if netcoop_pdanet_client then netcoop_pdanet_client.receive(data) end
		return
	elseif channel == "barter" then
		-- Barter between players (netcoop_barter on the server).
		if netcoop_barter_client then netcoop_barter_client.receive(data) end
		return
	elseif channel == "mutant_loot" then
		if netcoop_mutant_loot_view then netcoop_mutant_loot_view.receive(data) end
		return
	elseif channel == "battle" then
		-- A real offline fight on this map (server, doc 43 K10).
		if netcoop_distant_sound then netcoop_distant_sound.receive(data) end
		return
	elseif channel == "trade_cfg" then
		use_trade_profile(data)
		return
	elseif channel == "attach" then
		set_attached(data)
		return
	elseif channel == "player_state" then
		use_player_state(data)
		return
	elseif channel == "taskpos" then
		-- Where this player's task targets are now (server, every 2 s).
		for id, x, y, z, lvl in string.gmatch(data or "", "(%d+) (%S+) (%S+) (%S+) ([%w_]+);") do
			if netcoop_map_position_set then netcoop_map_position_set(tonumber(id), tonumber(x), tonumber(y), tonumber(z), lvl) end
		end
		return
	elseif channel == "pda" then
		-- The character's personal PDA (map pins) from the server.
		if netcoop_pda then netcoop_pda.receive(data) end
		return
	elseif channel == "taskboard" then
		-- PDA task board: NPC offers and players' jobs from the server.
		if netcoop_taskboard_client then netcoop_taskboard_client.receive(data) end
		return
	elseif channel == "faction_ui" then
		if netcoop_faction_ui then netcoop_faction_ui.receive(data) end
		return
	elseif channel == "player_rank" then
		-- Rank and reputation are kept by the server (doc 47 §3).
		local rank, reputation = string.match(data or "", "^(%-?[%d%.]+)|(%-?[%d%.]+)$")
		local actor = db.actor
		if actor and rank then
			actor:set_character_rank(math.floor(tonumber(rank)))
			actor:set_character_reputation(math.floor(tonumber(reputation)))
		end
		return
	elseif channel == "bounty_news" then
		local name, reward, hunter = string.match(data or "", "^([^|]*)|(%d+)|?(.*)$")
		if name then
			if reward == "0" then show_text(string.format(game.translate_string("st_netcoop_bounty_collected"), hunter, name))
			else show_text(string.format(game.translate_string("st_netcoop_bounty_new"), name, reward)) end
		end
		return
	elseif channel == "squad" then
		-- Loner squads (doc 47 stage 8): an invitation or a new member.
		local kind, name = string.match(data or "", "^(%a+)|(.*)$")
		if kind == "invite" then show_text(string.format(game.translate_string("st_netcoop_squad_invite"), name))
		elseif kind == "joined" then show_text(string.format(game.translate_string("st_netcoop_squad_joined"), name)) end
		return
	elseif channel == "faction" then
		-- The server changed this character's faction (doc 47); the engine
		-- applied it already (netcoop_actor_faction).
		if type(data) == "string" and data:match("^[%w_]+$") then
			show_text(game.translate_string("st_netcoop_faction_changed") .. " " .. game.translate_string(data))
		end
		return
	elseif channel == "disguise" then
		-- The server shows this player in another faction's outfit, or his own
		-- again (netcoop_factions, GAMMA's texts).
		local state, comm = string.match(data or "", "^(%a+)|([%w_]+)$")
		if state and actor_menu and actor_menu.set_msg then
			local key = state == "on" and "ui_st_disguse_on" or "ui_st_disguse_back_to_default"
			actor_menu.set_msg(1, string.format(game.translate_string(key), game.translate_string(comm)), 10)
		end
		return
	elseif channel == "stash_spot" or channel == "stash_spot_remove" then
		use_stash_spot(data, channel == "stash_spot_remove")
		return
	end
	if channel ~= "weather" and channel ~= "weather_edit" and channel ~= "map_known" then
		printf("[Lost Zone] server message %s: %s", tostring(channel), tostring(data))
	end
	if channel == "weather" then
		use_server_weather(data)
	elseif channel == "weather_edit" then
		use_weather_edit(data)
	elseif channel == "map_known" then
		use_map_known(data)
	elseif channel == "open_ui" then
		open_ui(data)
	end
end

-- Engine (netcoop.cpp) when the task list from the server adds, completes or
-- fails a task. The server's own task news arrive as PDA news.
function on_task(task_id, kind)
	printf("[Lost Zone] task %s: %s", tostring(task_id), tostring(kind))
end

-- The base-game debug menu runs locally for an admin; its world changes are
-- routed to the server through alife():create above and admin commands.
local function install_admin_menu()
	local compat = gamma_net_compat
	if type(compat) ~= "table" then return end
	compat.admin_allowed = function() return is_admin() end
	compat.is_server = function() return is_admin() end
	compat.request_admin = function() return false end
end

-- axr_main calls on_game_start of every script after all scripts are loaded.
-- Admin debug/spawn menu: F7 (base-game default) and Num3.
local function admin_menu_key(key)
	if key ~= DIK_keys.DIK_NUMPAD3 or not is_admin() then return end
	local a = db.actor
	if not (a and a:alive()) then return end
	if ui_debug_launcher and ui_debug_launcher.start_debug_main then
		ui_debug_launcher.start_debug_main()
	end
end

-- The emission and psi-storm managers are normally created by the ALife save
-- state load, which a client does not have; level_weathers reads them. A
-- client does not start its own emission: its timer is pushed out of reach
-- until emissions come from the server.
local function init_event_managers()
	for _, m in ipairs({ { surge_manager, "get_surge_manager" }, { psi_storm_manager, "get_psi_storm_manager" } }) do
		local module, getter = m[1], m[2]
		if module and module[getter] then
			local ok, err = pcall(function()
				local mgr = module[getter]()
				if not mgr._state_loaded then
					mgr:initialize()
					mgr._state_loaded = true
				end
				mgr._delta = 1000000000
			end)
			if not ok then printf("[Lost Zone] %s init failed: %s", getter, tostring(err)) end
		end
	end
end

-- Item actions that create or release items need alife(), which exists only
-- on the server (stage 3). A client ran them halfway: a battery charged the
-- device and stayed in the inventory. These are sent to the server, which
-- checks and runs them for this player (netcoop_server_compat.item_action;
-- keep SERVER_ITEM_ACTIONS equal to its SERVER_MENU_ACTIONS).
local SERVER_ITEM_ACTIONS = {
	["txr_mines.func_prox_plant"] = true,
	["txr_mines.func_timer_plant_10"] = true,
	["txr_mines.func_timer_plant_30"] = true,
	["item_device.func_battery"] = true,
}

local function menu_functor(sec, i)
	return ini_sys and ini_sys:r_string_ex(sec, "use" .. i .. "_action_functor")
end

local function server_battery_drop(obj_b, obj_d, slot_from, slot_to)
	if not (slot_from == EDDListType.iActorBag and (slot_to == EDDListType.iActorBag or slot_to == EDDListType.iActorSlot)) then
		return
	end
	local dev = item_device
	if not (dev and obj_b and obj_d and obj_b:section() == dev.device_battery and dev.dev_consumption[obj_d:section()]) then
		return
	end
	if obj_d:condition() > obj_b:condition() then
		actor_menu.set_msg(1, game.translate_string("ui_st_battery_more_power"))
		return
	end
	if netcoop_item_action(1, obj_b:id(), obj_d:id(), "battery_swap") then
		pcall(actor_effects.play_item_fx, dev.device_battery)
		pcall(utils_obj.play_sound, "interface\\inv_batt")
	end
end

-- item_repair's window repaired the item and used up the kit on the client
-- only (the kit never ran out). The window now sends the choice; the server
-- computes and applies the repair (netcoop_server_compat repair).
local function install_server_repair()
	local repair = item_repair and item_repair.UIRepair
	if not repair or repair.__netcoop_repair then return end
	repair.__netcoop_repair = true
	repair.OnRepair = function(self)
		local obj_1 = self.CC[1]:GetCell_Selected(true)
		local obj_2 = self.CC[2] and self.CC[2]:GetCell_Selected(true)
		if not (obj_1 and self.obj and self.con_val and self.con_val[4]) then return end
		if self.CollectValidItems then self:CollectValidItems(self.obj, self.section) end
		local part = obj_2 and obj_2:id() or 65535
		if netcoop_item_action(1, self.obj:id(), obj_1:id(), "repair " .. part) then
			self.hasCraftedItem = true
			pcall(utils_obj.play_sound, "interface\\inv_properties_2")
		end
		-- Refresh once the server's result has arrived.
		if self.UpdateUi and self.last_cont and self.last_idx and CreateTimeEvent then
			if self.btn_repair then self.btn_repair:Enable(false) end
			CreateTimeEvent("netcoop_repair", "update_ui", 0.5, self.UpdateUi, self)
		else
			self:OnCancel()
		end
	end
end

-- Furniture and backpack stashes are made by the server (alife() exists only
-- there): the client sends what the player chose; the server checks the
-- place, the ownership and creates the object (netcoop_server_compat).
local function upvalue(fn, wanted)
	if type(fn) ~= "function" or not (debug and debug.getupvalue) then return nil end
	for n = 1, 64 do
		local name, value = debug.getupvalue(fn, n)
		if not name then return nil end
		if name == wanted then return value end
	end
	return nil
end

local function install_server_furniture()
	local pf = placeable_furniture
	if pf and not pf.__netcoop then
		pf.__netcoop = true
		-- GAMMA's placement key calls create_object; the item being placed is
		-- the module's local item_id (an upvalue of func_place_item).
		pf.create_object = function(section, location, rotation, lvid, gvid)
			local item_id = upvalue(pf.func_place_item, "item_id")
			if not (item_id and location) then return nil end
			local angles = rotation and rotation.w and rotation:to_euler_angles() or rotation or vector():set(0, 0, 0)
			netcoop_item_action(1, item_id, 65535, string.format("furniture_place %.2f %.2f %.2f %.3f %.3f %.3f",
				location.x, location.y, location.z, angles.x, angles.y, angles.z))
			return nil -- the object arrives as a normal network spawn
		end
	end
	local wrapper = bind_hf_base and bind_hf_base.hf_binder_wrapper
	if wrapper and not bind_hf_base.__netcoop then
		bind_hf_base.__netcoop = true
		wrapper.pickup = function(self)
			if self.object then netcoop_item_action(2, self.object:id(), 65535, "furniture_pickup") end
			return true
		end
	end
	local ib = item_backpack
	if ib and not ib.__netcoop then
		ib.__netcoop = true
		if ib.UICreateStash then
			ib.UICreateStash.OnAccept = function(self)
				local name = self.input and self.input:GetText() or ""
				netcoop_item_action(1, self.id, 65535, "stash_create " .. string.sub(string.gsub(name, "[|%c]", ""), 1, 40))
				self:Close()
			end
		end
		if type(ib.actor_on_item_use) == "function" then
			local original = ib.actor_on_item_use
			UnregisterScriptCallback("actor_on_item_use", original)
			ib.actor_on_item_use = function(obj)
				if obj and obj:section() == "itm_actor_backpack" then
					netcoop_item_action(1, obj:id(), 65535, "backpack_deploy")
					return
				end
				return original(obj)
			end
			RegisterScriptCallback("actor_on_item_use", ib.actor_on_item_use)
		end
	end
end

-- Access list of the owned object under the crosshair (owner only):
-- netcoop_client_compat.object_access("add"|"remove", login)
function object_access(op, login)
	local obj = level.get_target_obj()
	if not (obj and login and (op == "add" or op == "remove")) then return false end
	return netcoop_item_action(2, obj:id(), 65535, "access " .. op .. " " .. login)
end

-- Global: on_script_message (above) calls it.
function use_stash_spot(data, remove)
	if remove then
		local id = tonumber(data)
		if id then pcall(level.map_remove_object_spot, id, "treasure_player") end
		return
	end
	local id, name = string.match(data or "", "^(%d+)|(.*)$")
	id = tonumber(id)
	if id then pcall(level.map_add_object_spot_ser, id, "treasure_player", name or "") end
end

----------------------------------------------------------------------
-- Player state that lives on this client (satiety, stamina, GAMMA's
-- thirst) is kept by the server with the character (owner 2026-10-05).
-- The server sends the saved state when the player comes in; only after
-- that does this client report its state (every 30 s), so a fresh client
-- never overwrites a saved character.
----------------------------------------------------------------------
-- Modules whose save_state/load_state hold this player's own state.
local PLAYER_STATE_MODULES = { "actor_status_thirst" }

-- Numbers, booleans and nested tables only: "k=1;t={a=2;};b=true;"
local function state_encode(t, depth)
	if depth > 4 then return "" end
	local out = {}
	for k, v in pairs(t) do
		local key = tostring(k)
		if string.match(key, "^[%w_]+$") then
			if type(v) == "number" and v == v and math.abs(v) < math.huge then out[#out + 1] = key .. "=" .. string.format("%.6g", v) .. ";"
			elseif type(v) == "boolean" then out[#out + 1] = key .. "=" .. (v and "true" or "false") .. ";"
			elseif type(v) == "table" then out[#out + 1] = key .. "={" .. state_encode(v, depth + 1) .. "};" end
		end
	end
	return table.concat(out)
end

local function state_decode(s)
	local pos, root = 1, {}
	local function parse(into, depth)
		while pos <= #s do
			if string.sub(s, pos, pos) == "}" then pos = pos + 1; return true end
			local key, value_start = string.match(s, "^([%w_]+)=()", pos)
			if not key or depth > 4 then return false end
			pos = value_start
			local k = tonumber(key) or key
			if string.sub(s, pos, pos) == "{" then
				pos = pos + 1
				local child = {}
				if not parse(child, depth + 1) then return false end
				into[k] = child
				if string.sub(s, pos, pos) ~= ";" then return false end
				pos = pos + 1
			else
				local raw, next_pos = string.match(s, "^([^;{}]*);()", pos)
				if not raw then return false end
				pos = next_pos
				if raw == "true" then into[k] = true elseif raw == "false" then into[k] = false else into[k] = tonumber(raw) end
			end
		end
		return depth == 0
	end
	return parse(root, 0) and root or nil
end

local function collect_player_state()
	local a = db.actor
	if not a then return nil end
	local state = { satiety = a.satiety, power = a.power, modules = {} }
	-- BHS keeps limb health in the client Lua module/pstor, outside the
	-- native Actor's health. Carry both permanent and temporary healing.
	local injuries = zzz_player_injuries
	if injuries and injuries.health and injuries.timedhp then
		state.injuries = { health = {}, timedhp = {} }
		for _, limb in ipairs({"head", "torso", "leftarm", "rightarm", "leftleg", "rightleg"}) do
			state.injuries.health[limb] = injuries.health[limb]
			state.injuries.timedhp[limb] = injuries.timedhp[limb]
		end
	end
	for _, name in ipairs(PLAYER_STATE_MODULES) do
		local m = _G[name]
		if m and type(m.save_state) == "function" then
			local data = {}
			if pcall(m.save_state, data) then state.modules[name] = data end
		end
	end
	return state_encode(state, 0)
end

local function report_player_state(force)
	if not (player_state_ready and netcoop_command) or (not force and time_global() < next_player_state) then return end
	next_player_state = time_global() + 5000
	local data = collect_player_state()
	if data and #data < 3000 then netcoop_command("player_state " .. data) end
end

-- Called before the reliable, ordered level-change request. The source
-- saves this message before freezing the character for its destination.
function flush_player_state()
	report_player_state(true)
end

-- Global: on_script_message (above) calls it with the server's saved state.
function use_player_state(data)
	local a = db.actor
	if not a then pending_player_state = data; return end
	local state = (not data or data == "-") and {} or state_decode(data)
	if not state then return end
	pending_player_state = nil
	player_state_ready = true
	next_player_state = time_global() + 5000
	if type(state.satiety) == "number" then a.satiety = math.max(0, math.min(1, state.satiety)) end
	if type(state.power) == "number" then a.power = math.max(0, math.min(1, state.power)) end
	for name, saved in pairs(type(state.modules) == "table" and state.modules or {}) do
		local m = _G[name]
		if m and type(m.load_state) == "function" then pcall(m.load_state, saved) end
	end
	local injuries = zzz_player_injuries
	if injuries and injuries.maxhp and injuries.health and injuries.timedhp then
		local saved = type(state.injuries) == "table" and state.injuries or {}
		local storage = db.storage[a:id()]
		if not storage then storage = {object=a}; db.storage[a:id()] = storage end
		storage.pstor = storage.pstor or {}
		for _, limb in ipairs({"head", "torso", "leftarm", "rightarm", "leftleg", "rightleg"}) do
			local maximum = injuries.maxhp[limb]
			local hp = type(saved.health) == "table" and saved.health[limb]
			local temporary = type(saved.timedhp) == "table" and saved.timedhp[limb]
			if type(maximum) == "number" and maximum > 0 then
				hp = type(hp) == "number" and hp == hp and math.max(0, math.min(maximum, hp)) or maximum
				temporary = type(temporary) == "number" and temporary == temporary and math.max(0, math.min(hp, temporary)) or 0
				injuries.health[limb], injuries.timedhp[limb] = hp, temporary
				-- BHS's first update reads pstor again; it must see the same state.
				storage.pstor["health." .. limb], storage.pstor["timedhp." .. limb] = hp, temporary
			end
		end
	end
	printf("[Lost Zone] player state restored")
end

-- Sleep deprivation is cut from multiplayer (owner 2026-10-05): GAMMA's own
-- switch turns it off (need, indicator, effects) and stays off whatever the
-- difficulty settings ask.
function disable_sleep_need()
	local s = actor_status_sleep
	if not s or s.__netcoop_off or type(s.toggle_feature) ~= "function" then return end
	s.__netcoop_off = true
	local toggle = s.toggle_feature
	pcall(toggle, false)
	s.toggle_feature = function() pcall(toggle, false) end
end

-- FDDA's backpack animation (liz_fdda_redone_backpack) remembers the
-- backpack in slot 13 at actor_on_first_update and then follows slot
-- callbacks. Online the inventory comes from the server after that first
-- update, already in its slots, so the mod thought there was no backpack.
-- Before each opening it now reads the slot itself (its own setter).
local function install_backpack_animation()
	local m = liz_fdda_redone_backpack
	if not (m and m.try_open_backpack and m.on_item_to_slot) or m.__netcoop then return end
	m.__netcoop = true
	local base = m.try_open_backpack
	m.try_open_backpack = function(...)
		local bp = db.actor and db.actor:item_in_slot(13)
		if bp then pcall(m.on_item_to_slot, bp) end
		return base(...)
	end
end

-- Missing authoritative weapon-part metadata must not abort the entire
-- inventory/corpse context menu. Do not invent parts or reroll them here.
-- Preserve GAMMA's predicates when a real parts table is available.
function install_weapon_menu_guards()
	if not (netcoop_pure_client and netcoop_pure_client()) then return end
	local repairs = zzzz_arti_jamming_repairs
	local functors = custom_functor_autoinject
	if not (repairs and functors and item_parts and item_parts.get_parts_con) then return end
	if repairs.__netcoop_menu_parts then return end
	if type(repairs.has_parts_fieldstrip) ~= "function" or type(repairs.check_maintain) ~= "function" then return end
	local function with_parts(predicate)
		return function(obj, bag, mode)
			if not obj or type(item_parts.get_parts_con(obj, nil, false)) ~= "table" then return false end
			return predicate(obj, bag, mode)
		end
	end
	repairs.has_parts_fieldstrip = with_parts(repairs.has_parts_fieldstrip)
	repairs.check_maintain = with_parts(repairs.check_maintain)
	-- GAMMA registers function pointers: replacing the module functions alone
	-- would leave the old nil-table predicate in the inventory's registry.
	functors.add_functor("arti_fieldstrip", repairs.has_parts_fieldstrip, repairs.name_fieldstrip, nil, repairs.init_fieldstrip_menu, true)
	functors.add_functor("arti_maintain", repairs.check_maintain, repairs.name_maintain, nil, repairs.init_maintenance_menu, false)
	repairs.__netcoop_menu_parts = true
end

-- Artefact containers and item combinations (itms_manager) create and
-- release items: the server does it (netcoop_item_use.container_action);
-- here only GAMMA's animation plays.
local function install_server_containers()
	local im = itms_manager
	if not im or im.__netcoop_containers then return end
	im.__netcoop_containers = true
	local function fx(name) if actor_effects and actor_effects.play_item_fx then pcall(actor_effects.play_item_fx, name) end end
	im.dropdrop_ArtyContainer = function(obj_1, obj_2, sec_1, sec_2)
		if not ini_sys:section_exist(sec_1 .. "_" .. sec_2) then return end
		fx("container_tool_" .. sec_2 .. "_dummy")
		netcoop_item_action(1, obj_1:id(), obj_2:id(), "arty_pack")
	end
	im.dropdrop_Basic_Combination = function(obj_1, obj_2, sec_1, sec_2)
		fx("item_combination")
		netcoop_item_action(1, obj_1:id(), obj_2:id(), "combine")
	end
	local function package(obj)
		fx("package_content")
		netcoop_item_action(1, obj:id(), 65535, "package")
	end
	im.use_package, im.use_package_random = package, package
	local money = item_money
	if money then
		for _, n in ipairs({ 100, 500, 1000, 5000 }) do
			money["use_money_" .. n] = function(obj)
				netcoop_item_action(1, obj:id(), 65535, "withdraw " .. n)
				if utils_obj and utils_obj.play_sound then pcall(utils_obj.play_sound, "interface\\items\\inv_items_money_paper") end
			end
		end
	end
	im.use_arty_container = function(obj)
		local sec = obj:section()
		for _, cont in ipairs({ "lead_box", "af_iam", "af_aac", "af_aam" }) do
			if string.match(sec, "^.+_" .. cont .. "$") then
				fx(cont .. "_dummy")
				netcoop_item_action(1, obj:id(), 65535, "arty_unpack")
				return
			end
		end
	end
end

local function install_server_item_actions()
	if not (netcoop_item_action and netcoop_pure_client and netcoop_pure_client()) then return end
	install_server_containers()
	if netcoop_mutant_loot_view then netcoop_mutant_loot_view.install() end
	install_server_repair()
	install_server_furniture()
	install_weapon_menu_guards()
	install_backpack_animation()
	disable_sleep_need()
	-- Corpse loot is made by the server at death (netcoop_server_compat).
	-- Opening a corpse here ran GAMMA's loot maker without alife(): nothing
	-- spawned, but it rerolled the weapons' condition in this client's copy.
	if death_manager and not death_manager.__netcoop_server_loot then
		death_manager.__netcoop_server_loot = true
		death_manager.create_release_item = function() end
	end
	local ui = ui_inventory and ui_inventory.UIInventory
	if ui and not ui.__netcoop_item_actions then
		ui.__netcoop_item_actions = true
		local action_custom = ui.Action_Custom
		ui.Action_Custom = function(self, obj, bag, temp, i)
			local checked = self:CheckItem(obj, "Action_Custom " .. tostring(i))
			local functor = checked and menu_functor(checked:section(), i)
			if functor and SERVER_ITEM_ACTIONS[functor] then
				netcoop_item_action(0, checked:id(), 65535, functor)
				if self.PlaySND and snd_button then self:PlaySND(snd_button) end
				self:On_Item_Update()
				return
			end
			return action_custom(self, obj, bag, temp, i)
		end
	end
	-- item_device registers its battery drop handler as a local function:
	-- find it among on_game_start's upvalues and put the server request in place.
	local dev = item_device
	if dev and type(dev.on_game_start) == "function" and debug and debug.getupvalue and not dev.__netcoop_battery_drop then
		for n = 1, 64 do
			local name, fn = debug.getupvalue(dev.on_game_start, n)
			if not name then break end
			if name == "on_item_drag_dropped" and type(fn) == "function" then
				UnregisterScriptCallback("ActorMenu_on_item_drag_drop", fn)
				RegisterScriptCallback("ActorMenu_on_item_drag_drop", server_battery_drop)
				dev.__netcoop_battery_drop = true
				printf("[Lost Zone] battery swaps run on the server")
				break
			end
		end
		if not dev.__netcoop_battery_drop then printf("! [Lost Zone] item_device battery drop handler not found") end
	end
end

-- GAMMA's addons start on "the loading screen was dismissed" (engine
-- OnLoadingScreenDismissed after the single-player "press any key" intro).
-- A netcoop client enters the level through the server connection and that
-- intro never runs: Interaction Dot Marks never began scanning (no "[F] Talk /
-- Take" prompts, owner 2026-10-12), and other addons waited the same way.
-- A second after the own Actor appears the callback is sent; GAMMA guards it
-- with doOnce, so a real dismissal earlier changes nothing.
function loading_screen_done()
	CreateTimeEvent("netcoop_client", "loading_screen_done", 1, function()
		if _G.OnLoadingScreenDismissed then
			local ok, err = pcall(_G.OnLoadingScreenDismissed)
			if not ok then printf("! [Lost Zone] loading screen callbacks failed: %s", tostring(err)) end
		end
		return true
	end)
end

function on_game_start()
	admin_callbacks_installed = false
	install_actor_lifecycle()
	netcoop_pdanet_client.install_notification_sound()
	install_weather_follow()
	if AddUniqueCall then AddUniqueCall(campfires_near_update) end
	install_campfire_hands()
	-- Disguise is the server's (netcoop_factions, spec 7.2): GAMMA's switch on
	-- the client cannot change a community here and printed its own messages.
	if gameplay_disguise then gameplay_disguise.try_to_disguise = function() end end
	RegisterScriptCallback("on_key_press", door_key)
	-- Keep the faction relations the engine read from the table: base-game's
	-- reset_all_relations (run when no faction select window marked a new
	-- game) reads the table in a different column order (see server).
	pcall(function()
		local state = alife_storage_manager.get_state()
		if state and not state.new_game_relations then
			state.new_game_relations = true
		end
	end)
	quiet_busy_hands()
	install_server_trade()
	disable_sleep_need()
	RegisterScriptCallback("actor_on_update", function() report_player_state() end)
	-- After every module's on_game_start (item_device registers its handlers there).
	RegisterScriptCallback("actor_on_first_update", install_server_item_actions)
	RegisterScriptCallback("actor_on_first_update", loading_screen_done)
	RegisterScriptCallback("actor_on_item_take", on_item_take)
	init_event_managers()
	netcoop_emission_view.install()
	netcoop_psi_view.install()
	-- PDA tabs read the simulation board; the simulation itself runs on the
	-- server, so the client keeps an empty board.
	if sim_board and sim_board.get_sim_board then
		local ok, err = pcall(sim_board.get_sim_board)
		if not ok then printf("[Lost Zone] sim board init failed: %s", tostring(err)) end
	end
	RegisterScriptCallback("on_before_save_input", no_saves)
	RegisterScriptCallback("on_before_load_input", no_quick_load)
	RegisterScriptCallback("on_key_release", admin_menu_key)
end

----------------------------------------------------------------------
-- base-game callbacks: one failing handler must not skip the others
----------------------------------------------------------------------
-- axr_main.make_callback calls every handler of a callback in one loop, so a
-- handler that failed (world setup scripts that belong to the other side of
-- the connection) ended the loop and the remaining mods never ran. Handlers
-- are wrapped when registered; the first error of each is logged.
local wrapped_callbacks = {}
local failed_callbacks = {}

local function isolate_callbacks()
	local am = axr_main
	if type(am) ~= "table" or am.__netcoop_isolated or not am.callback_set then return end
	am.__netcoop_isolated = true
	local set, unset = am.callback_set, am.callback_unset
	am.callback_set = function(name, handler)
		if handler == nil then return set(name, handler) end
		local by_name = wrapped_callbacks[name]
		if not by_name then
			by_name = {}
			wrapped_callbacks[name] = by_name
		end
		local wrapper = by_name[handler]
		if not wrapper then
			wrapper = function(...)
				local ok, err
				if type(handler) == "function" then
					ok, err = pcall(handler, ...)
				elseif handler[name] then
					ok, err = pcall(handler[name], handler, ...)
				else
					ok = true
				end
				if not ok and not failed_callbacks[wrapper] then
					failed_callbacks[wrapper] = true
					printf("[Lost Zone] %s handler failed: %s", tostring(name), tostring(err))
				end
			end
			by_name[handler] = wrapper
		end
		return set(name, wrapper)
	end
	am.callback_unset = function(name, handler)
		local by_name = wrapped_callbacks[name]
		return unset(name, by_name and by_name[handler] or handler)
	end
end

function install()
	if installed then return end
	installed = true
	isolate_callbacks()
	native_alife = _G.alife
	_G.alife = alife_compat
	install_db_actor()
	install_admin_menu()
	printf("[Lost Zone] netcoop client compatibility layer installed")
end
