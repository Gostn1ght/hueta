-- PDA network tabs (owner 2026-10-10, after New Way; docs/audit/89):
-- Общий канал, Чаты, Контакты, Галерея, Фото, Диктофон, Заметки. Every
-- tab shows the PDA clock at the top and "name - UID" at the bottom. Data
-- and commands: netcoop_pdanet_client.
-- Fixed rows with paging (like the faction window) instead of scroll lists.

local function tr(id) return game.translate_string(id) end
local net = function() return netcoop_pdanet_client end
local XML = "ui_netcoop_pdanet.xml"

-- group icons ("Значок"): the faction emblems of the main menu
local ICONS = { "ui_mm_faction_stalker", "ui_mm_faction_dolg", "ui_mm_faction_freedom", "ui_mm_faction_csky",
	"ui_mm_faction_ecolog", "ui_mm_faction_army", "ui_mm_faction_bandit", "ui_mm_faction_killer",
	"ui_mm_faction_monolith", "ui_mm_faction_greh", "ui_mm_faction_isg", "ui_mm_faction_renegade" }

local function at(w, x, y, wd, h)
	w:SetWndPos(vector2():set(x, y))
	if wd then w:SetWndSize(vector2():set(wd, h)) end
	return w
end
local function text(w, s) w:TextControl():SetText(s or "") end
local function edit_text(e) return e and e:GetText() or "" end

local function icon_texture(st, icon)
	if icon and icon ~= "" then st:InitTexture(icon) else st:InitTexture("ui\\ui_noise") end
end

local function my_line()
	local me = net().me
	local dev = net().slot_device
	if net().foreign and dev then return string.format(tr("st_pdanet_foreign_footer"), dev.serial or "?") end
	if me.uid == "" then return tr("st_pdanet_connecting") end
	return string.format("%s  -  UID %s", me.name, me.uid)
end

-- Base for every tab window: frame, title, clock, footer, button helper.
local function base(self, title)
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:SetAutoDelete(false)
	self.xml = CScriptXmlInit()
	self.xml:ParseFile(XML)
	self.xml:InitFrame("frame", self)
	self.title = self.xml:InitStatic("title", self)
	text(self.title, tr(title))
	self.title:Show(false) -- the PDA's tab strip already owns the caption
	self.clock = self.xml:InitStatic("clock", self)
	self.clock:Show(false) -- the PDA's global header owns the clock
	self.status = self.xml:InitStatic("status", self)
	self.ids, self.tick_at = 0, 0
	net().on_change(function(what)
		if what~="device_reset" then return end
		self.note,self.chat,self.selected,self.viewed,self.confirm=nil,nil,nil,nil,nil
		self.scroll,self.list_scroll,self.msg_scroll,self.page=0,0,0,0
		self.saving_new=nil
		for _,key in ipairs({"input","uid","title_edit","body_edit"}) do if self[key] then self[key]:SetText("") end end
		for _,group in ipairs({"dlg","pwdlg","lock"}) do
			local controls=self[group]
			if controls then for _,key in ipairs({"name","amount","old","new","edit"}) do if controls[key] then controls[key]:SetText("") end end end
		end
		if self.Dialog then self:Dialog(nil) end
		if self.Password then self:Password(false) end
		if self.Tasks then self:Tasks(false) end
		if self.View then self:View(false) end
		if self.arc then for _,w in pairs(self.arc) do w:Show(false) end end
		if self.Fill then self:Fill() end
	end)
end
-- The lock screen of a PDA with a password (owner 2026-10-18), made on
-- first use so it is drawn over everything the tab made before.
local function lock_layer(self)
	if self.lock then return self.lock end
	local l = {}
	l.back = self.xml:InitStatic("layer_back", self)
	l.back:SetWndPos(vector2():set(36, 110)); l.back:SetWndSize(vector2():set(748, 556))
	l.title = self.xml:InitStatic("msg_name", self)
	l.title:SetWndPos(vector2():set(260, 300)); l.title:SetWndSize(vector2():set(300, 24))
	l.title:TextControl():SetText(tr("st_pdanet_locked"))
	l.edit = self.xml:InitEditBox("edit", self)
	l.edit:SetWndPos(vector2():set(260, 334)); l.edit:SetWndSize(vector2():set(300, 32))
	l.btn = self.xml:Init3tButton("button", self)
	l.btn:SetWndPos(vector2():set(260, 376)); l.btn:SetWndSize(vector2():set(300, 30))
	l.btn:TextControl():SetText(tr("st_pdanet_unlock"))
	self:Register(l.btn, "pda_unlock")
	self:AddCallback("pda_unlock", ui_events.BUTTON_CLICKED, function()
		net().unlock(l.edit:GetText()); l.edit:SetText("")
	end, self)
	l.err = self.xml:InitStatic("msg_head", self)
	l.err:SetWndPos(vector2():set(260, 414)); l.err:SetWndSize(vector2():set(300, 22))
	self.lock = l
	return l
end
local function show_lock(self)
	local on = net().locked == true
	if not on and not self.lock then return end
	local l = lock_layer(self)
	for _, w in pairs(l) do w:Show(on) end
	if on then
		local e = net().last_error
		l.err:TextControl():SetText((e == "wrong password" and tr("st_pdanet_wrong_password")) or (e == "pda held" and tr("st_pdanet_pda_held")) or "")
	end
end

local show_device -- someone else's PDA in the slot (below)

-- Clock and footer, once a second (CUIScriptWnd:Update of each tab).
local function tick(self, extra)
	if time_global() < self.tick_at then return end
	self.tick_at = time_global() + 1000
	text(self.clock, net().clock())
	show_lock(self)
	show_device(self)
	if extra then extra() end
end
local function footer(self, prefix)
	text(self.status, (prefix and prefix ~= "" and (prefix .. "     ") or "") .. my_line())
end
local function button(self, caption, x, y, w, h, fn, template)
	local b = at(self.xml:Init3tButton(template or "button", self), x, y, w, h)
	text(b, caption)
	self.ids = self.ids + 1
	local id = "b" .. self.ids
	self:Register(b, id)
	self:AddCallback(id, ui_events.BUTTON_CLICKED, fn, self)
	return b
end
local function static(self, name, x, y, w, h)
	local control = name == "panel" and self.xml:InitFrame(name, self) or self.xml:InitStatic(name, self)
	return at(control, x, y, w, h)
end
-- Original New Way XML geometry and colours, with Lost Zone data/actions.
local function layout(self, path, kind, x, y)
	local w = self.xml["Init" .. (kind or "Static")](self.xml, path, self)
	if x or y then
		local p = w:GetWndPos()
		w:SetWndPos(vector2():set(p.x + (x or 0), p.y + (y or 0)))
	end
	return w
end
local function layout_button(self, path, caption, fn, x, y)
	local b = layout(self, path, "3tButton", x, y)
	text(b, caption)
	self.ids = self.ids + 1
	local id = "b" .. self.ids
	self:Register(b, id)
	self:AddCallback(id, ui_events.BUTTON_CLICKED, fn, self)
	return b
end
local function status_of(c)
	return c.online == true and tr("st_pdanet_online") or c.online == false and tr("st_pdanet_offline") or tr("st_pdanet_status_hidden")
end
local function tip(id, ...)
	if actor_menu and actor_menu.set_msg then actor_menu.set_msg(1, string.format(tr(id), ...), 3) end
end

----------------------------------------------------------------------
-- Общий канал
----------------------------------------------------------------------
local GEN_ROWS = 8

class "pdanet_general" (CUIScriptWnd)
function pdanet_general:__init() super()
	base(self, "st_pdanet_tab_general")
	self.anon, self.scroll = false, 0
	self.layout = static(self, "msg_head", 512, 156, 260, 28)
	static(self, "panel", 36, 194, 748, 422)
	self.rows = {}
	for r = 1, GEN_ROWS do
		local y = 202 + (r - 1) * 50
		self.rows[r] = {
			icon = static(self, "icon", 44, y + 4, 48, 36),
			name = static(self, "msg_name", 100, y, 300, 20),
			head = static(self, "msg_head", 404, y, 330, 20),
			body = static(self, "msg_text", 100, y + 20, 640, 30),
		}
	end
	button(self, "^", 750, 202, 30, 30, function() self.scroll = self.scroll + 3; self:Fill() end)
	button(self, "v", 750, 574, 30, 30, function() self.scroll = math.max(0, self.scroll - 3); self:Fill() end)
	self.input = at(self.xml:InitEditBox("edit", self), 44, 628, 580, 36)
	button(self, tr("st_pdanet_send"), 636, 628, 140, 36, function() self:Send() end)
	self.anon_btn = self.xml:InitCheck("anonymous", self)
	self:Register(self.anon_btn, "anonymous")
	self:AddCallback("anonymous", ui_events.BUTTON_CLICKED, function() self.anon = not self.anon; self:Fill() end, self)
	text(self.xml:InitStatic("anon_label", self), tr("st_pdanet_anonymous_mode"))
	at(self.status, 300, 666, 480, 24) -- UID/footer and checkbox never overlap
	net().on_change(function() if self:IsShown() then self:Fill() end end)
	self:Fill()
end
function pdanet_general:Update()
	CUIScriptWnd.Update(self)
	tick(self, function()
		-- keyboard layout of the input (engine), like New Way's "Раскладка: EN"
		local lang = netcoop_keyboard_layout and netcoop_keyboard_layout() or ""
		text(self.layout, lang ~= "" and (tr("st_pdanet_layout") .. " " .. lang) or "")
	end)
end
function pdanet_general:Send()
	net().say(edit_text(self.input), self.anon)
	self.input:SetText("")
	self.scroll = 0
end
function pdanet_general:Fill()
	local list = net().general
	local last = #list - self.scroll
	for r = 1, GEN_ROWS do
		local m = list[last - GEN_ROWS + r]
		local row = self.rows[r]
		for _, w in pairs(row) do w:Show(m ~= nil) end
		if m then
			text(row.name, net().sender_name(m))
			text(row.head, net().when_long(m))
			text(row.body, m.x)
			icon_texture(row.icon, m.i)
		end
	end
	self.anon_btn:SetCheck(self.anon)
	footer(self)
end
function pdanet_general:OnKeyboard(dik, action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, action)
	if action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_RETURN then self:Send() end
	return res
end

----------------------------------------------------------------------
-- Чаты
----------------------------------------------------------------------
local LIST_ROWS, MSG_ROWS, PICK_ROWS = 8, 7, 8

-- What a message shows in a bubble.
local function message_body(m)
	if m.k == "point" then return tr("st_pdanet_point") .. ": " .. (m.x or "") end
	if m.k == "transfer" then
		return string.format(tr(m.own and "st_pdanet_transfer_out" or "st_pdanet_transfer_in"), tostring(m.d or "?"))
	end
	if m.k == "voice" then
		local secs = tonumber(string.match(m.d or "", "^%S+ (%d+)") or 0) or 0
		return string.format(tr("st_pdanet_voice_msg"), string.format("%d:%02d", math.floor(secs / 60), secs % 60))
	end
	if m.k == "photo" then
		local ph = netcoop_pdanet_photo
		return tr("st_pdanet_photo_msg") .. (ph and ("  -  " .. ph.message_place(m)) or "")
	end
	if m.k == "task" then return tr("st_pdanet_task_msg") .. ": " .. (m.x or "") end
	return m.x
end

----------------------------------------------------------------------
-- Someone else's PDA in the slot (owner 2026-10-23): every tab shows the
-- device - serial, protection, the hack - and, once it is hacked, what its
-- owner had on it and the reset that makes it the holder's own.
----------------------------------------------------------------------
local DEVICE_ROWS = 9

local function dump_entries()
	local d, out = net().dump, {}
	if not d then return out end
	local owner = d.owner or {}
	local function who(m)
		if m.own then return owner.name or "?" end
		return m.n or ("UID " .. tostring(m.f or "?"))
	end
	local lines = {}
	for _, c in ipairs(d.contacts or {}) do
		lines[#lines + 1] = string.format("%s  -  UID %s", c.name or "?", tostring(c.uid or "?"))
	end
	out[#out + 1] = { caption = string.format(tr("st_pdanet_dump_contacts"), #lines), body = table.concat(lines, "\\n") }
	for _, c in ipairs(d.chats or {}) do
		local name = c.kind == "g" and (c.name or "?") or (c.peer and (c.peer.name or ("UID " .. tostring(c.peer.uid)))) or "?"
		local msgs = {}
		for _, m in ipairs(c.msgs or {}) do
			msgs[#msgs + 1] = string.format("%s  %s: %s", net().when_short(m), who(m), message_body(m) or "")
		end
		out[#out + 1] = { caption = name, body = table.concat(msgs, "\\n") }
	end
	for _, n in ipairs(d.notes or {}) do
		out[#out + 1] = { caption = tr("st_pdanet_dump_note") .. ": " .. ((n.title or "") ~= "" and n.title or string.sub(n.text or "", 1, 16)),
			body = (n.text or "") .. "\\n\\n" .. net().when(n) }
	end
	return out
end

local function device_fill(self)
	local l = self.dev
	local entries = dump_entries()
	l.entries = entries
	local shown = net().foreign == true and net().dump ~= nil
	for r = 1, DEVICE_ROWS do
		local e = entries[l.scroll + r]
		l.rows[r]:Show(shown and e ~= nil)
		if e then text(l.rows[r], (l.pick == l.scroll + r and "> " or "") .. e.caption) end
	end
	l.up:Show(shown); l.down:Show(shown); l.view:Show(shown)
	local e = l.pick and entries[l.pick]
	text(l.view, shown and (e and e.body or tr("st_pdanet_dump_hint")) or "")
end

local function device_layer(self)
	if self.dev then return self.dev end
	local l = { rows = {}, scroll = 0 }
	self.dev = l
	l.back = static(self, "layer_back", 36, 110, 748, 556)
	l.title = static(self, "msg_name", 60, 128, 700, 24)
	l.info = static(self, "msg_head", 60, 156, 700, 22)
	l.progress = static(self, "msg_head", 60, 180, 700, 22)
	l.hack = button(self, tr("st_pdanet_hack"), 60, 208, 170, 30, function()
		if net().hack_left(net().slot_device) then net().hack_stop() else net().hack() end
	end)
	l.data = button(self, tr("st_pdanet_dump"), 240, 208, 170, 30, function() net().ask_dump() end)
	l.wipe = button(self, tr("st_pdanet_wipe"), 420, 208, 170, 30, function() net().wipe() end)
	for r = 1, DEVICE_ROWS do
		l.rows[r] = button(self, "", 60, 252 + (r - 1) * 40, 230, 36, function()
			l.pick = l.scroll + r; device_fill(self)
		end, "row")
	end
	l.up = button(self, "^", 294, 252, 28, 30, function() l.scroll = math.max(0, l.scroll - 3); device_fill(self) end)
	l.down = button(self, "v", 294, 582, 28, 30, function()
		l.scroll = math.min(l.scroll + 3, math.max(0, #(l.entries or {}) - DEVICE_ROWS)); device_fill(self)
	end)
	l.view = static(self, "note_view", 332, 252, 430, 360)
	return l
end

show_device = function(self)
	local on = net().foreign == true
	if not on and not self.dev then return end
	local l = device_layer(self)
	for _, w in pairs({ l.back, l.title, l.info, l.progress, l.hack, l.data, l.wipe }) do w:Show(on) end
	if not on then
		for _, w in ipairs(l.rows) do w:Show(false) end
		l.up:Show(false); l.down:Show(false); l.view:Show(false)
		return
	end
	local v = net().slot_device or {}
	local hacked = v.hacked == true
	local left = net().hack_left(v)
	text(l.title, tr("st_pdanet_foreign") .. "   " .. string.format(tr("st_pdanet_serial"), v.serial or "?"))
	text(l.info, string.format(tr("st_pdanet_protection"), v.level or 1, v.lock and tr("st_pdanet_protection_lock") or "")
		.. "     " .. (hacked and string.format(tr("st_pdanet_owner"), v.owner or "?") or tr("st_pdanet_owner_hidden")))
	local progress = ""
	if hacked then progress = tr("st_pdanet_hacked")
	elseif left and left > 0 then
		local total = math.max(1, v.hack_total or 1)
		progress = string.format(tr("st_pdanet_hacking"), math.floor(100 * (total - left) / total), math.ceil(left / 1000))
	elseif net().last_error == "hack interrupted" then progress = tr("st_pdanet_hack_interrupted") end
	text(l.progress, progress)
	l.hack:Show(not hacked)
	text(l.hack, tr((left and left > 0) and "st_pdanet_hack_stop" or "st_pdanet_hack"))
	l.data:Show(hacked); l.wipe:Show(hacked)
	device_fill(self)
end

class "pdanet_chats" (CUIScriptWnd)
function pdanet_chats:__init() super()
	base(self, "st_pdanet_tab_chats")
	self.list_scroll, self.msg_scroll, self.points, self.voices, self.photos = 0, 0, {}, {}, {}
	layout(self, "nw_chats:list_frame", "Frame")
	layout(self, "nw_chats:head_frame", "Frame")
	layout(self, "nw_chats:conv_frame", "Frame")
	self.rows = {}
	for r = 1, LIST_ROWS do
		local y = 158 + (r - 1) * 56
		local row = {}
		row.btn = button(self, "", 44, y, 196, 52, function() self:Pick(r) end, "row")
		row.icon = static(self, "icon", 48, y + 8, 42, 32)
		row.name = static(self, "msg_name", 96, y + 4, 112, 20)
		row.time = static(self, "msg_head", 208, y + 4, 32, 20)
		row.last = static(self, "msg_head", 96, y + 26, 124, 20)
		row.unread = static(self, "msg_name", 220, y + 26, 20, 20)
		self.rows[r] = row
	end
	button(self, "^", 244, 158, 28, 30, function() self.list_scroll = math.max(0, self.list_scroll - 1); self:Fill() end)
	button(self, "v", 244, 586, 28, 30, function() self.list_scroll = self.list_scroll + 1; self:Fill() end)
	button(self, tr("st_pdanet_new_group"), 36, 630, 240, 26, function() self:Dialog("group") end)
	-- the conversation header: Перевод (private) or Состав (group), Удалить чат
	self.peer_icon = layout(self, "nw_chats:head_avatar", nil, 284, 150)
	self.peer_name = layout(self, "nw_chats:head_name", nil, 284, 150)
	self.peer_info = layout(self, "nw_chats:head_state", nil, 284, 150)
	self.side_btn = button(self, "", 550, 165, 110, 26, function()
		local s = net().opened and net().opened.summary or {}
		if s.kind == "g" then net().ask_members(self.chat); self:Dialog("members") else self:Dialog("pay") end
	end)
	self.del_btn = button(self, tr("st_pdanet_delete_chat"), 664, 165, 110, 26, function()
		if self.chat then net().delete_chat(self.chat); self.chat = nil; net().opened = nil; self:Fill() end
	end)
	self.empty = static(self, "hint", 300, 380, 468, 48)
	self.msgs = {}
	for r = 1, MSG_ROWS do
		local y = 222 + (r - 1) * 50
		local m = {}
		m.icon = static(self, "icon", 292, y + 4, 40, 30)
		m.head = static(self, "msg_head", 340, y, 260, 20)
		m.body = static(self, "msg_text", 340, y + 20, 408, 30)
		m.own = static(self, "msg_own", 398, y + 20, 350, 30)
		m.mark = button(self, tr("st_pdanet_mark"), 620, y + 2, 156, 22, function() self:Mark(r) end)
		m.play = button(self, ">", 620, y + 2, 40, 22, function() self:Play(r) end)
		m.view = button(self, tr("st_pdanet_photo_open"), 620, y + 2, 156, 22, function() self:ViewPhoto(r) end)
		self.msgs[r] = m
	end
	button(self, "^", 750, 222, 30, 26, function() self.msg_scroll = self.msg_scroll + 2; self:Fill() end)
	button(self, "v", 750, 558, 30, 26, function() self.msg_scroll = math.max(0, self.msg_scroll - 2); self:Fill() end)
	-- Снимок: a shot from the gallery; Точка: own position or a map pin
	self.photo_btn = button(self, tr("st_pdanet_photo_btn"), 284, 602, 161, 22, function() if self.chat then self:Dialog("photo") end end)
	self.point_btn = button(self, tr("st_pdanet_point_btn"), 453, 602, 162, 22, function() if self.chat then self:Dialog("point") end end)
	self.voice_btn = button(self, tr("st_pdanet_voice_btn"), 623, 602, 161, 22, function() self:VoiceMessage() end)
	-- a photo from the chat, over the conversation
	self.pview = {}
	self.pview.back = layout(self, "nw_chats:conv_frame", "Frame")
	self.pview.img = static(self, "photo", 292, 222, 484, 272)
	self.pview.info = static(self, "hint_left", 292, 502, 484, 36)
	self.pview.keep = button(self, tr("st_pdanet_photo_keep"), 292, 544, 232, 28, function()
		local m = self.viewed
		if m and netcoop_pdanet_photo then
			netcoop_pdanet_photo.keep(string.match(m.d or "", "^(%x+)"), string.match(m.d or "", "^%x+ ([%w_]+)"))
		end
	end)
	self.pview.close = button(self, tr("st_pdanet_close"), 532, 544, 244, 28, function() self.viewed = nil; self:Fill() end)
	self.input = at(self.xml:InitEditBox("edit", self), 284, 630, 392, 26)
	button(self, tr("st_pdanet_send"), 684, 630, 100, 26, function() self:Send() end)
	-- dialogs over the conversation: new group, members, transfer
	self.dlg = {}
	self.dlg.back = static(self, "panel", 330, 150, 440, 420)
	self.dlg.title = static(self, "msg_name", 346, 158, 408, 24)
	self.dlg.icon = static(self, "icon", 346, 188, 48, 36)
	self.dlg.icon_btn = button(self, tr("st_pdanet_icon"), 400, 190, 110, 30, function()
		self.icon_n = self.icon_n % #ICONS + 1
		icon_texture(self.dlg.icon, ICONS[self.icon_n])
	end)
	self.dlg.name = at(self.xml:InitEditBox("edit", self), 516, 190, 238, 30)
	self.dlg.amount = at(self.xml:InitEditBox("edit_amount", self), 346, 230, 200, 30)
	self.dlg.rows, self.picked, self.icon_n = {}, {}, 1
	for r = 1, PICK_ROWS do
		self.dlg.rows[r] = button(self, "", 346, 230 + (r - 1) * 34, 408, 30, function() self:Toggle(r) end, "row")
	end
	self.dlg.ok = button(self, "", 346, 528, 196, 30, function() self:DialogOk() end)
	self.dlg.cancel = button(self, tr("st_pdanet_cancel"), 558, 528, 196, 30, function() self:Dialog(nil) end)
	self:Dialog(nil)
	net().on_change(function() if self:IsShown() then self:Fill() end end)
	self:Fill()
end
function pdanet_chats:Update()
	CUIScriptWnd.Update(self)
	tick(self, function()
		local v = netcoop_pdanet_voice
		local busy = v and (v.recording() or v.uploading() or (netcoop_play_pos and netcoop_play_pos() >= 0))
		if busy or net().typing_in(self.chat or "") or self.typing_shown then self:Fill() end
	end)
end
function pdanet_chats:Pick(r)
	local c = net().chats[self.list_scroll + r]
	if not c then return end
	self.chat, self.msg_scroll = c.id, 0
	net().open_chat(c.id)
	self:Fill()
end
function pdanet_chats:Send()
	if not self.chat then return end
	net().post(self.chat, edit_text(self.input))
	self.input:SetText("")
	self.msg_scroll = 0
end
function pdanet_chats:Mark(r)
	local m = self.points[r]
	if not m or not m.d then return end
	local lvl, x, y, z = string.match(m.d, "^([%w_]+) (%S+) (%S+) (%S+)$")
	if lvl ~= level.name() then
		actor_menu.set_msg(1, string.format(tr("st_pdanet_point_other_level"), game.translate_string(lvl or "")), 4)
		return
	end
	local paw = tasks_placeable_waypoints
	local sz = paw and paw.register_script_zone and paw.register_script_zone(vector():set(tonumber(x), tonumber(y), tonumber(z)), 0, 0)
	if sz and paw.func_pn_add then
		paw.func_pn_add({ id = sz.id, name = m.x ~= "" and m.x or tr("st_pdanet_point") })
		actor_menu.set_msg(1, tr("st_pdanet_point_added"), 3)
	end
end
-- Voice messages (netcoop_pdanet_voice: record, send, play).
function pdanet_chats:VoiceMessage()
	local v = netcoop_pdanet_voice
	if not (self.chat and v) then return end
	if v.recording_kind() == "msg" then
		v.stop_and_send(self.chat)
	elseif not v.recording() then
		v.set_chat(self.chat)
		v.start_message()
	end
	self:Fill()
end
function pdanet_chats:Play(r)
	local m = self.voices[r]
	if m and netcoop_pdanet_voice then netcoop_pdanet_voice.play_message(m) end
end
function pdanet_chats:ViewPhoto(r)
	local m = self.photos[r]
	if not m then return end
	self.viewed = m
	self:Fill()
end
-- The choices of the "photo" and "point" dialogs.
function pdanet_chats:Choices()
	if self.dialog == "photo" then
		local ph = netcoop_pdanet_photo
		if not ph then return {} end
		ph.load()
		local out = {}
		for i, p in ipairs(ph.photos) do
			out[#out + 1] = { text = string.format("%s   %s   %s", ph.when(p), ph.place(p.level), ph.size_text(p.bytes)), index = i }
		end
		return out
	elseif self.dialog == "point" then
		local out = { { text = tr("st_pdanet_point_here") } }
		for _, pin in ipairs(netcoop_pda and netcoop_pda.pin_points and netcoop_pda.pin_points() or {}) do
			out[#out + 1] = { text = string.format("%s   (%s)", tostring(pin.name), game.translate_string(pin.level)), at = pin, name = pin.name }
		end
		return out
	end
	return {}
end
-- mode: nil (closed), "group", "members", "pay", "photo", "point"
function pdanet_chats:Dialog(mode)
	self.dialog = mode
	for _, w in pairs(self.dlg) do if type(w) ~= "table" then w:Show(mode ~= nil) end end
	for _, w in ipairs(self.dlg.rows) do w:Show(false) end
	local group, pay = mode == "group", mode == "pay"
	local pick = mode == "photo" or mode == "point"
	for _, w in ipairs({ self.dlg.icon, self.dlg.icon_btn, self.dlg.name }) do w:Show(group) end
	self.dlg.amount:Show(pay)
	self.dlg.ok:Show(group or pay or pick)
	self.choice, self.choice_scroll = nil, 0
	text(self.dlg.cancel, tr(mode == "members" and "st_pdanet_close" or "st_pdanet_cancel"))
	if group then
		self.picked, self.icon_n = {}, 1
		self.dlg.name:SetText("")
		icon_texture(self.dlg.icon, ICONS[1])
		text(self.dlg.title, tr("st_pdanet_new_group"))
		text(self.dlg.ok, tr("st_pdanet_create"))
	elseif pay then
		self.dlg.amount:SetText("")
		local p = net().opened and net().opened.summary and net().opened.summary.peer or {}
		text(self.dlg.title, string.format(tr("st_pdanet_transfer_to"), p.name or ("UID " .. tostring(p.uid)),
			db.actor and db.actor:money() or 0))
		text(self.dlg.ok, tr("st_pdanet_send_money"))
	elseif mode == "members" then
		text(self.dlg.title, tr("st_pdanet_members_btn"))
	elseif mode == "photo" then
		text(self.dlg.title, tr("st_pdanet_pick_photo"))
		text(self.dlg.ok, tr("st_pdanet_rec_send"))
	elseif mode == "point" then
		text(self.dlg.title, tr("st_pdanet_pick_point"))
		text(self.dlg.ok, tr("st_pdanet_rec_send"))
	end
	if mode then self:FillDialog() end
end
function pdanet_chats:FillDialog()
	local rows = self.dlg.rows
	for r = 1, PICK_ROWS do rows[r]:Show(false) end
	if self.dialog == "group" then
		local list = net().contacts
		for r = 1, PICK_ROWS do
			local c = list[r]
			if c then
				rows[r]:Show(true)
				text(rows[r], string.format("[%s] %s  (UID %s)", self.picked[c.uid] and "x" or " ", c.name or "?", c.uid))
			end
		end
	elseif self.dialog == "members" then
		local list = net().members[self.chat or ""] or {}
		for r = 1, PICK_ROWS do
			local c = list[r]
			if c then
				rows[r]:Show(true)
				text(rows[r], string.format("%s  (UID %s)  -  %s", c.name or "?", c.uid, c.own and tr("st_pdanet_you") or status_of(c)))
			end
		end
	elseif self.dialog == "photo" or self.dialog == "point" then
		local list = self:Choices()
		if #list == 0 then rows[1]:Show(true); text(rows[1], tr("st_pdanet_gallery_empty")) end
		for r = 1, PICK_ROWS do
			local i = self.choice_scroll + r
			local c = list[i]
			if c then
				rows[r]:Show(true)
				text(rows[r], (self.choice == i and "> " or "") .. c.text)
			end
		end
	end
end
function pdanet_chats:Toggle(r)
	if self.dialog == "photo" or self.dialog == "point" then
		local i = self.choice_scroll + r
		if self:Choices()[i] then self.choice = i; self:FillDialog() end
		return
	end
	if self.dialog ~= "group" then return end
	local c = net().contacts[r]
	if c then self.picked[c.uid] = not self.picked[c.uid] or nil; self:FillDialog() end
end
function pdanet_chats:DialogOk()
	if self.dialog == "group" then
		local uids = {}
		for uid in pairs(self.picked) do uids[#uids + 1] = uid end
		if #uids == 0 then return end
		net().new_group(edit_text(self.dlg.name), ICONS[self.icon_n], uids)
	elseif self.dialog == "pay" then
		local amount = tonumber(edit_text(self.dlg.amount))
		if not (self.chat and amount and amount > 0) then return end
		if db.actor and amount > db.actor:money() then tip("st_pdanet_no_money") return end
		net().pay(self.chat, amount)
	elseif self.dialog == "photo" then
		local c = self.choice and self:Choices()[self.choice]
		if not (c and self.chat) then return end
		netcoop_pdanet_photo.send(c.index, self.chat)
	elseif self.dialog == "point" then
		local c = self.choice and self:Choices()[self.choice]
		if not (c and self.chat) then return end
		local caption = edit_text(self.input)
		net().post_point(self.chat, caption ~= "" and caption or (c.name and tostring(c.name)) or "", c.at)
		self.input:SetText("")
	end
	self:Dialog(nil)
end
local function summary_line(c)
	if c.kind == "g" then return c.name or "?" end
	local p = c.peer or {}
	return p.name or ("UID " .. tostring(p.uid))
end
function pdanet_chats:Fill()
	local list = net().chats
	for r = 1, LIST_ROWS do
		local c = list[self.list_scroll + r]
		local row = self.rows[r]
		for _, w in pairs(row) do w:Show(c ~= nil) end
		if c then
			text(row.name, summary_line(c))
			local last = c.last or {}
			text(row.time, last.g and string.sub(net().when(last), 1, 5) or "")
			text(row.last, last.k and message_body(last) or "")
			text(row.unread, (c.unread or 0) > 0 and tostring(c.unread) or "")
			icon_texture(row.icon, c.kind == "g" and c.icon or (c.peer and c.peer.icon))
		end
	end
	local o = net().opened
	local open = o and self.chat and o.id == self.chat
	self.empty:Show(not open)
	text(self.empty, tr("st_pdanet_chats_hint"))
	for _, w in ipairs({ self.peer_icon, self.peer_name, self.peer_info, self.del_btn, self.side_btn }) do w:Show(open and true or false) end
	self.points, self.voices, self.photos, self.typing_shown = {}, {}, {}, false
	if open then
		local s = o.summary or {}
		text(self.peer_name, summary_line(s))
		text(self.side_btn, tr(s.kind == "g" and "st_pdanet_members_btn" or "st_pdanet_transfer"))
		local typing = net().typing_in(o.id)
		if typing then
			self.typing_shown = true
			text(self.peer_info, string.format(tr("st_pdanet_typing"), summary_line(s)))
		elseif s.kind == "g" then
			text(self.peer_info, string.format(tr("st_pdanet_members"), s.members or 0, s.online or 0))
		else
			local p = s.peer or {}
			text(self.peer_info, string.format("UID %s  -  %s", tostring(p.uid), status_of(p)))
		end
		icon_texture(self.peer_icon, s.kind == "g" and s.icon or (s.peer and s.peer.icon))
	end
	local msgs = open and o.msgs or {}
	local last = #msgs - self.msg_scroll
	-- a photo being looked at covers the conversation
	if not open then self.viewed = nil end
	local ph = netcoop_pdanet_photo
	local tex = self.viewed and ph and ph.message_photo(self.viewed)
	for _, w in pairs(self.pview) do w:Show(self.viewed ~= nil) end
	if self.viewed then
		self.pview.img:Show(tex ~= nil)
		if tex then self.pview.img:InitTexture(tex) end
		text(self.pview.info, string.format("%s  %s\n%s", net().sender_name(self.viewed), net().when_short(self.viewed),
			tex and ph.message_place(self.viewed) or tr("st_pdanet_photo_loading")))
	end
	for r = 1, MSG_ROWS do
		local m = msgs[last - MSG_ROWS + r]
		local w = self.msgs[r]
		for _, x in pairs(w) do x:Show(false) end
		if self.viewed then m = nil end
		if m then
			w.head:Show(true)
			local group = o.summary and o.summary.kind == "g"
			text(w.head, ((m.own or not group) and "" or net().sender_name(m) .. "  ") .. net().when_short(m))
			local body = message_body(m)
			if m.k == "voice" and netcoop_pdanet_voice then
				body = tr("st_pdanet_voice_word") .. "   " .. (netcoop_pdanet_voice.message_progress(m))
			end
			if m.own then w.own:Show(true); text(w.own, body) else w.body:Show(true); text(w.body, body); w.icon:Show(true); icon_texture(w.icon, m.i) end
			if m.k == "point" or (m.k == "task" and m.d) then w.mark:Show(true); self.points[r] = m end
			if m.k == "voice" then w.play:Show(true); self.voices[r] = m end
			if m.k == "photo" then w.view:Show(true); self.photos[r] = m end
		end
	end
	local v = netcoop_pdanet_voice
	local rec = v and v.recording_kind() == "msg"
	text(self.voice_btn, rec and string.format(tr("st_pdanet_voice_stop"), v.recorded_text()) or tr("st_pdanet_voice_btn"))
	local up = v and v.uploading()
	if up then text(self.voice_btn, string.format(tr("st_pdanet_rec_upload"), up)) end
	if self.dialog then self:FillDialog() end
	footer(self, string.format(tr("st_pdanet_unread"), net().unread_total()))
end
function pdanet_chats:OnKeyboard(dik, action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, action)
	if action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_RETURN then
			if self.dialog then self:DialogOk() else self:Send() end
		elseif self.chat and not self.dialog then net().typed(self.chat) end
	end
	return res
end

----------------------------------------------------------------------
-- Контакты
----------------------------------------------------------------------
local CONTACT_ROWS = 10

class "pdanet_contacts" (CUIScriptWnd)
function pdanet_contacts:__init() super()
	base(self, "st_pdanet_tab_contacts")
	self.scroll = 0
	-- Original New Way contact header; extended actions stay below the list.
	layout(self, "nw_contacts:head_frame", "Frame")
	self.card_icon = static(self, "icon", 42, 138, 64, 50)
	self.card_icon:Show(false)
	self.card_name = layout(self, "nw_contacts:my_nick", nil, 36, 150)
	self.card_info = layout(self, "nw_contacts:my_uid", nil, 36, 150)
	self.card_money = static(self, "money", 560, 114, 214, 30)
	self.pw_btn = button(self, tr("st_pdanet_password"), 330, 116, 220, 28, function() self:Password(not self.pw_open) end)
	text(layout(self, "nw_contacts:add_caption", nil, 36, 150), "UID")
	self.uid = layout(self, "nw_contacts:add_edit", "EditBox", 36, 150)
	layout_button(self, "nw_contacts:btn_add", tr("st_pdanet_add"), function()
		net().add_contact(edit_text(self.uid)); self.uid:SetText("")
	end, 36, 150)
	layout_button(self, "nw_contacts:btn_open", tr("st_pdanet_open"), function()
		local c = self:Contact()
		if c then net().open_dm(c.uid) end
	end, 36, 150)
	layout_button(self, "nw_contacts:btn_del", tr("st_pdanet_delete"), function()
		local c = self:Contact()
		if c then net().remove_contact(c.uid); self.selected = nil end
	end, 36, 150)
	self.point_btn = button(self, tr("st_pdanet_send_point"), 36, 632, 364, 26, function()
		local c = self:Contact()
		if c then net().send_point_to(c.uid, ""); tip("st_pdanet_point_sent", c.name or c.uid) end
	end)
	self.task_btn = button(self, tr("st_pdanet_send_task"), 420, 632, 364, 26, function()
		if self:Contact() then self:Tasks(true) end
	end)
	-- a selected friend request: accept (add back) or decline
	self.accept_btn = button(self, tr("st_pdanet_accept"), 36, 632, 364, 26, function()
		local r = self:Request()
		if r then net().add_contact(r.uid); self.selected = nil end
	end)
	self.decline_btn = button(self, tr("st_pdanet_decline"), 420, 632, 364, 26, function()
		local r = self:Request()
		if r then net().deny_request(r.uid); self.selected = nil end
	end)
	layout(self, "nw_contacts:list_frame", "Frame")
	self.rows = {}
	for r = 1, CONTACT_ROWS do
		local y = 218 + (r - 1) * 36
		self.rows[r] = { btn = button(self, "", 40, y, 700, 33, function() if self:Entries()[self.scroll + r] then self.selected = self.scroll + r; self:Fill() end end, "row"),
			icon = static(self, "icon", 700, y + 2, 36, 28) }
	end
	button(self, "^", 748, 218, 30, 30, function() self.scroll = math.max(0, self.scroll - 3); self:Fill() end)
	button(self, "v", 748, 586, 30, 30, function() self.scroll = self.scroll + 3; self:Fill() end)
	self.empty = layout(self, "nw_contacts:empty")
	-- "Отправить задание": one of the player's active tasks to the contact
	self.tdlg = {}
	self.tdlg.back = static(self, "panel", 160, 250, 500, 340)
	self.tdlg.title = static(self, "msg_name", 176, 258, 468, 24)
	self.tdlg.rows = {}
	for r = 1, 7 do
		self.tdlg.rows[r] = button(self, "", 176, 288 + (r - 1) * 34, 468, 30, function() self.task_pick = r; self:Tasks(true) end, "row")
	end
	self.tdlg.ok = button(self, tr("st_pdanet_rec_send"), 176, 550, 228, 30, function() self:SendTask() end)
	self.tdlg.cancel = button(self, tr("st_pdanet_cancel"), 416, 550, 228, 30, function() self:Tasks(false) end)
	self:Tasks(false)
	-- "Пароль КПК": set, change or remove (an empty new password)
	self.pwdlg = {}
	self.pwdlg.back = static(self, "panel", 160, 250, 500, 260)
	self.pwdlg.title = static(self, "msg_name", 176, 258, 468, 24)
	self.pwdlg.l_old = static(self, "msg_head", 176, 290, 468, 20)
	self.pwdlg.old = at(self.xml:InitEditBox("edit", self), 176, 312, 468, 30)
	self.pwdlg.l_new = static(self, "msg_head", 176, 350, 468, 20)
	self.pwdlg.new = at(self.xml:InitEditBox("edit", self), 176, 372, 468, 30)
	self.pwdlg.ok = button(self, tr("st_pdanet_password_save"), 176, 464, 228, 30, function()
		net().set_password(edit_text(self.pwdlg.old), edit_text(self.pwdlg.new)); self:Password(false)
	end)
	self.pwdlg.cancel = button(self, tr("st_pdanet_cancel"), 416, 464, 228, 30, function() self:Password(false) end)
	text(self.pwdlg.title, tr("st_pdanet_password"))
	text(self.pwdlg.l_old, tr("st_pdanet_password_old"))
	text(self.pwdlg.l_new, tr("st_pdanet_password_new"))
	self:Password(false)
	net().on_change(function() if self:IsShown() then self:Fill() end end)
	self:Fill()
end
function pdanet_contacts:Password(on)
	self.pw_open = on
	for _, w in pairs(self.pwdlg) do w:Show(on) end
	if on then self.pwdlg.old:SetText(""); self.pwdlg.new:SetText("") end
	self.pwdlg.l_old:Show(on and net().has_lock); self.pwdlg.old:Show(on and net().has_lock)
end
function pdanet_contacts:Tasks(on)
	if not on then self.task_pick = nil end
	self.tasks_open = on
	local list = on and net().active_tasks() or {}
	self.task_list = list
	for _, w in pairs(self.tdlg) do if type(w) ~= "table" then w:Show(on) end end
	local c = self:Contact()
	text(self.tdlg.title, string.format(tr("st_pdanet_task_to"), c and (c.name or c.uid) or "?"))
	for r = 1, 7 do
		local t = list[r]
		self.tdlg.rows[r]:Show(on and (t ~= nil or (r == 1 and #list == 0)))
		if t then text(self.tdlg.rows[r], (self.task_pick == r and "> " or "") .. t.title)
		elseif r == 1 then text(self.tdlg.rows[1], tr("st_pdanet_no_tasks")) end
	end
	self.tdlg.ok:Show(on and #list > 0)
end
-- Friend requests first, then contacts (one list, one selection).
function pdanet_contacts:Entries()
	local out = {}
	for _, r in ipairs(net().requests or {}) do out[#out + 1] = { request = true, c = r } end
	for _, c in ipairs(net().contacts) do out[#out + 1] = { c = c } end
	return out
end
function pdanet_contacts:Contact()
	local e = self.selected and self:Entries()[self.selected]
	return e and not e.request and e.c or nil
end
function pdanet_contacts:Request()
	local e = self.selected and self:Entries()[self.selected]
	return e and e.request and e.c or nil
end
function pdanet_contacts:SendTask()
	local c = self:Contact()
	local t = self.task_pick and self.task_list and self.task_list[self.task_pick]
	if not (c and t) then return end
	net().send_task_to(c.uid, t)
	tip("st_pdanet_task_sent", c.name or c.uid)
	self:Tasks(false)
end
function pdanet_contacts:Update()
	CUIScriptWnd.Update(self)
	tick(self, function() self:Card() end)
end
function pdanet_contacts:Card()
	local me, a = net().me, db.actor
	text(self.card_name, me.name ~= "" and me.name or (a and a:character_name() or ""))
	local faction = a and a.character_community and tr(a:character_community()) or ""
	text(self.card_info, me.uid ~= "" and string.format("UID %s     %s", me.uid, faction) or tr("st_pdanet_connecting"))
	text(self.card_money, string.format("%d RU", a and a:money() or 0))
	icon_texture(self.card_icon, me.icon ~= "" and me.icon or (a and a.character_icon and a:character_icon()))
end
function pdanet_contacts:Fill()
	local list = self:Entries()
	if self.selected and not list[self.selected] then self.selected = nil end
	self:Card()
	self.empty:Show(#list == 0)
	text(self.empty, tr("st_pdanet_contacts_empty"))
	for r = 1, CONTACT_ROWS do
		local i = self.scroll + r
		local e = list[i]
		local c = e and e.c
		local row = self.rows[r]
		row.btn:Show(c ~= nil and not self.tasks_open); row.icon:Show(c ~= nil and not self.tasks_open)
		if e and e.request then
			text(row.btn, string.format("%s%s %s   UID %s", self.selected == i and "> " or "", tr("st_pdanet_request_row"), c.name or "?", c.uid))
			icon_texture(row.icon, c.icon)
		elseif c then
			local unread = net().contact_unread(c.uid)
			text(row.btn, string.format("%s%s   UID %s  -  %s%s", self.selected == i and "> " or "", c.name or "?", c.uid, status_of(c),
				unread > 0 and string.format("     (%d)", unread) or ""))
			icon_texture(row.icon, c.icon)
		end
	end
	local req = self:Request() ~= nil
	self.accept_btn:Show(req and not self.tasks_open); self.decline_btn:Show(req and not self.tasks_open)
	self.point_btn:Show(not req); self.task_btn:Show(not req)
	footer(self, net().last_error and (tr("st_pdanet_error") .. " " .. tostring(net().last_error)) or "")
end

----------------------------------------------------------------------
-- Заметки (New Way pda_notes): list, title, text; new, save, delete.
-- Kept on the server with the character.
----------------------------------------------------------------------
local NOTE_ROWS = 10

class "pdanet_notes" (CUIScriptWnd)
function pdanet_notes:__init() super()
	base(self, "st_pdanet_tab_notes")
	self.scroll = 0
	layout(self, "nw_notes:list_frame", "Frame")
	text(layout(self, "nw_notes:t_list_caption"), tr("st_pdanet_notes_title"))
	self.rows = {}
	for r = 1, NOTE_ROWS do
		self.rows[r] = button(self, "", 44, 158 + (r - 1) * 44, 196, 40, function() self:Pick(self.scroll + r) end, "row")
	end
	button(self, "^", 244, 158, 28, 30, function() self.scroll = math.max(0, self.scroll - 3); self:Fill() end)
	button(self, "v", 244, 586, 28, 30, function() self.scroll = self.scroll + 3; self:Fill() end)
	layout_button(self, "nw_notes:btn_new", tr("st_pdanet_notes_new"), function() self:Pick(nil) end)
	text(layout(self, "nw_notes:t_title_caption"), tr("st_pdanet_notes_title"))
	self.title_edit = layout(self, "nw_notes:title_editbox", "EditBox")
	layout(self, "nw_notes:text_frame", "Frame")
	self.body_edit = at(self.xml:InitEditBox("edit_note", self), 296, 204, 476, 30)
	self.view = static(self, "note_view", 296, 244, 476, 340)
	self.date = layout(self, "nw_notes:t_hint")
	layout_button(self, "nw_notes:btn_save", tr("st_pdanet_notes_save"), function() self:Save() end)
	self.del_btn = layout_button(self, "nw_notes:btn_delete", tr("st_pdanet_delete"), function()
		if self.note then net().delete_note(self.note); self:Pick(nil) end
	end)
	self.empty = static(self, "hint", 44, 300, 224, 120)
	net().on_change(function(what) if self:IsShown() and what == "notes" then self:Fill() end end)
	self:Pick(nil)
end
function pdanet_notes:Update()
	CUIScriptWnd.Update(self)
	tick(self)
end
function pdanet_notes:Pick(i)
	local n = i and net().notes[i]
	self.note = n and n.id or nil
	self.title_edit:SetText(n and n.title or "")
	self.body_edit:SetText(n and n.text or "")
	self:Fill()
end
function pdanet_notes:Save()
	local title, body = edit_text(self.title_edit), edit_text(self.body_edit)
	if title == "" and body == "" then return end
	net().save_note(self.note, title, body)
	if not self.note then self.saving_new = true end
end
function pdanet_notes:Fill()
	local list = net().notes
	if self.saving_new and list[1] then self.saving_new = nil; self.note = list[1].id end
	local current
	for r = 1, NOTE_ROWS do
		local n = list[self.scroll + r]
		self.rows[r]:Show(n ~= nil)
		if n then
			text(self.rows[r], (n.id == self.note and "> " or "") .. (n.title ~= "" and n.title or string.sub(n.text or "", 1, 24)))
		end
	end
	for _, n in ipairs(list) do if n.id == self.note then current = n end end
	text(self.view, current and current.text or edit_text(self.body_edit))
	text(self.date, current and net().when(current) or "")
	self.del_btn:Show(current ~= nil)
	self.empty:Show(#list == 0)
	text(self.empty, tr("st_pdanet_notes_empty"))
	footer(self, string.format(tr("st_pdanet_notes_count"), #list))
end
function pdanet_notes:OnKeyboard(dik, action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, action)
	if action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_RETURN then self:Save() end
	return res
end

----------------------------------------------------------------------
-- Physical device data, USB selection and read-only imported conversations.
----------------------------------------------------------------------
class "pdanet_storage" (CUIScriptWnd)
function pdanet_storage:__init() super()
 base(self,"st_pdanet_tab_storage")
 self.pick,self.scroll,self.confirm=nil,0,nil
 self.info=static(self,"hint_left",48,150,720,64)
 self.rows={}
 for r=1,6 do
  self.rows[r]=button(self,"",48,224+(r-1)*36,720,32,function() self.pick=self.scroll+r;self.confirm=nil;self:Fill() end,"row")
 end
 button(self,"^",48,448,48,28,function() self.scroll=math.max(0,self.scroll-6);self:Fill() end)
 button(self,"v",102,448,48,28,function() self.scroll=self.scroll+6;self:Fill() end)
 self.copy=button(self,tr("st_pdanet_usb_backup"),164,448,288,28,function() self:Copy(false) end)
 self.restore=button(self,tr("st_pdanet_usb_restore"),464,448,304,28,function() self:Copy(true) end)
 self.reset=button(self,tr("st_pdanet_wipe"),48,488,288,28,function()
  if self.confirm==tostring((net().slot_device or {}).uid).."/wipe" then net().wipe();self.confirm=nil else self.confirm=tostring((net().slot_device or {}).uid).."/wipe";self:Fill() end
 end)
 self.archive=static(self,"hint_left",48,526,720,76)
 self.archive_btn=button(self,tr("st_pdanet_usb_read_archive"),48,606,720,28,function() self:Archive(1,1) end)
 self.hint=static(self,"hint_left",48,636,720,30)
 button(self,tr("st_pdanet_usb_refresh"),464,488,304,28,function() net().ask_storage() end)
 net().on_change(function(what) if self:IsShown() and (what=="storage" or what=="device") then self:Fill() end end)
 net().ask_storage();self:Fill()
end
function pdanet_storage:Copy(restore)
 local tools=net().storage.tools or {}
 local t=self.pick and tools[self.pick]
 if not t or t.kind~="data" then return end
 if (netcoop_pda_media and not netcoop_pda_media.ready()) or (netcoop_pdanet_voice and netcoop_pdanet_voice.recording()) then tip("st_pdanet_usb_sync");return end
 if netcoop_pda and netcoop_pda.flush and not netcoop_pda.flush() then tip("st_pdanet_usb_sync");return end
 if restore then
  local target=tostring((net().slot_device or {}).uid).."/"..t.uid
  if self.confirm~=target then self.confirm=target;self:Fill();return end
  if netcoop_pda then netcoop_pda.reset() end
  net().restore(t.id)
 else net().backup(t.id) end
 self.confirm=nil
end
function pdanet_storage:Fill()
 local d=net().slot_device or {}
 text(self.info,string.format(tr("st_pdanet_usb_about"),d.serial or "?"))
 local list=net().storage.tools or {}
 for r,w in ipairs(self.rows) do
  local i=self.scroll+r;local t=list[i];w:Show(t~=nil)
  if t then
   local desc=t.kind=="hack" and string.format(tr("st_pdanet_usb_uses"),t.left or 0)
    or (t.backup and string.format(tr("st_pdanet_usb_source"),t.backup.source or "?") or tr("st_pdanet_usb_empty"))
   text(w,(i==self.pick and "> " or "")..tr(t.kind=="hack" and "st_lz_pda_hack_usb" or "st_lz_pda_data_usb").."  "..string.upper(string.sub(t.uid,-4)).."   "..desc)
  end
 end
 local t=self.pick and list[self.pick]
 self.copy:Enable(t~=nil and t.kind=="data")
 self.restore:Enable(t~=nil and t.kind=="data" and t.backup~=false)
 self.reset:Show(d.own==false and d.hacked==true)
 text(self.hint,self.confirm and tr("st_pdanet_usb_confirm") or tr("st_pdanet_usb_hint"))
 local lines={tr("st_pdanet_usb_archive")}
 for _,c in ipairs(net().storage.archive or {}) do
  lines[#lines+1]=(c.name or c.cid or "?").." ("..tostring(c.count or 0)..")"
 end
 text(self.archive,table.concat(lines,"\n"))
 self.archive_btn:Enable(#(net().storage.archive or {})>0)
 if self.arc and net().storage.view then
  local v=net().storage.view;local m=v.message or {}
  text(self.arc.title,(v.name or "").."  "..v.msg.."/"..v.total)
  text(self.arc.body,net().when(m).."   UID "..tostring(m.f or "").."\n\n"..(m.x or "").."\n"..(m.d or ""))
 end
 footer(self,net().last_error and tostring(net().last_error) or "")
end
function pdanet_storage:Archive(chat,msg)
 local list=net().storage.archive or {}
 if #list==0 then return end
 chat=math.max(1,math.min(#list,chat))
 msg=math.max(1,math.min(list[chat].count or 1,msg))
 if not self.arc then
  local a={}
  a.back=static(self,"layer_back",36,110,748,556)
  a.title=static(self,"msg_name",52,132,716,40)
  a.body=static(self,"hint_left",52,188,716,360)
  local function move(dc,dm)
   local v=net().storage.view or {chat=1,msg=1}
   self:Archive(v.chat+dc,v.msg+dm)
  end
  a.pc=button(self,"<<",52,576,100,30,function() move(-1,0) end)
  a.pm=button(self,"<",160,576,100,30,function() move(0,-1) end)
  a.nm=button(self,">",268,576,100,30,function() move(0,1) end)
  a.nc=button(self,">>",376,576,100,30,function() move(1,0) end)
  a.close=button(self,tr("st_pdanet_close"),492,576,276,30,function() for _,w in pairs(self.arc) do w:Show(false) end end)
  self.arc=a
 end
 for _,w in pairs(self.arc) do w:Show(true) end
 net().archive_message(chat,msg)
end
function pdanet_storage:Update()
 CUIScriptWnd.Update(self);tick(self)
end

----------------------------------------------------------------------
-- Not made yet (photo, gallery): say so.
----------------------------------------------------------------------
class "pdanet_soon" (CUIScriptWnd)
function pdanet_soon:__init(caption) super()
	base(self, caption)
	local h = static(self, "hint", 60, 320, 700, 80)
	text(h, tr(caption .. "_soon"))
	footer(self)
end
function pdanet_soon:Update()
	CUIScriptWnd.Update(self)
	tick(self, function() footer(self) end)
end

----------------------------------------------------------------------
-- Registration (the strip scrolls; 4 tabs visible in the PDA's top bar)
----------------------------------------------------------------------
local windows = {}
local tab_ids, shown_captions = {}, {} -- caption key -> tab id / caption shown now
local function window(key, make)
	return function()
		windows[key] = windows[key] or make()
		return windows[key]
	end
end

function on_game_start()
	if not (netcoop_pure_client and netcoop_pure_client()) or not pda_dynamic_tabs then return end
	-- after "Карта местности" (eptTasks), in this order
	local after = "eptTasks"
	local dictaphone = function()
		if netcoop_pdanet_voice and netcoop_pdanet_voice.dictaphone_window then return netcoop_pdanet_voice.dictaphone_window() end
		return pdanet_soon("st_pdanet_tab_voice")
	end
	local photo = function(which)
		return function()
			local ph = netcoop_pdanet_photo
			if ph and ph[which] then return ph[which]() end
			return pdanet_soon(which == "gallery_window" and "st_pdanet_tab_gallery" or "st_pdanet_tab_photo")
		end
	end
	local tabs = {
		{ "st_pdanet_tab_general", function() return pdanet_general() end },
		{ "st_pdanet_tab_chats", function() return pdanet_chats() end },
		{ "st_pdanet_tab_contacts", function() return pdanet_contacts() end },
		{ "st_pdanet_tab_gallery", photo("gallery_window") },
		{ "st_pdanet_tab_photo", photo("photo_window") },
		{ "st_pdanet_tab_voice", dictaphone },
		{ "st_pdanet_tab_notes", function() return pdanet_notes() end },
		{ "st_pdanet_tab_storage", function() return pdanet_storage() end },
	}
	for _, t in ipairs(tabs) do
		after = pda_dynamic_tabs.register(t[1], window(t[1], t[2]), after)
		tab_ids[t[1]] = after
	end
	net().on_change(unread_captions)
end

-- Unread marks on the tab captions: "Чаты (3)", "Контакты (1)".
function unread_captions()
	if not (pda_dynamic_tabs and pda_dynamic_tabs.set_caption) then return end
	local chats, contacts = net().unread_total(), 0
	for _, c in ipairs(net().contacts) do contacts = contacts + net().contact_unread(c.uid) end
	contacts = contacts + #(net().requests or {})
	for key, n in pairs({ st_pdanet_tab_chats = chats, st_pdanet_tab_contacts = contacts }) do
		local caption = tr(key) .. (n > 0 and string.format(" (%d)", n) or "")
		if tab_ids[key] and shown_captions[key] ~= caption then
			shown_captions[key] = caption
			pda_dynamic_tabs.set_caption(tab_ids[key], caption)
		end
	end
end

-- shared with netcoop_pdanet_voice (the dictaphone tab uses the same frame)
ui = { base = base, tick = tick, footer = footer, button = button, static = static, text = text, at = at, tr = tr,
	layout = layout, layout_button = layout_button }
