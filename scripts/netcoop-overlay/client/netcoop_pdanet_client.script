-- PDA network on the client (server: netcoop_pdanet): the state the server
-- sends (own UID, contacts, chats, general channel, open chat), commands to
-- the server, and a refresh hook for the PDA tabs (netcoop_pdanet_ui).

local MAX_BYTES, MAX_NODES, MAX_DEPTH = 262144, 8192, 16
local function finite(n) return n == n and n ~= math.huge and n ~= -math.huge end

-- The server's data format (netcoop_transit.serialize), read only.
function decode(text)
	if type(text) ~= "string" or #text == 0 or #text > MAX_BYTES then return nil end
	local pos, nodes = 1, 0
	local function count()
		local stop = string.find(text, ":", pos, true)
		assert(stop and stop - pos <= 6, "invalid length")
		local token = text:sub(pos, stop - 1)
		assert(token:match("^%d+$"), "invalid length")
		pos = stop + 1
		return tonumber(token)
	end
	local function read(depth)
		nodes = nodes + 1
		assert(nodes <= MAX_NODES and depth <= MAX_DEPTH, "too complex")
		local tag = text:sub(pos, pos); pos = pos + 1
		if tag == "S" then
			local size = count()
			assert(size <= #text - pos + 1, "truncated")
			local v = text:sub(pos, pos + size - 1); pos = pos + size
			return v
		elseif tag == "B" then
			local v = text:sub(pos, pos); pos = pos + 1
			return v == "1"
		elseif tag == "N" then
			local stop = string.find(text, ";", pos, true)
			assert(stop, "invalid number")
			local v = tonumber(text:sub(pos, stop - 1))
			assert(v and finite(v), "invalid number")
			pos = stop + 1
			return v
		elseif tag == "T" then
			local size, value = count(), {}
			for _ = 1, size do
				local k = read(depth + 1)
				value[k] = read(depth + 1)
			end
			return value
		end
		error("invalid tag")
	end
	local ok, value = pcall(read, 0)
	return ok and pos == #text + 1 and value or nil
end

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
me = { uid = "", name = "", icon = "" }
contacts = {}       -- list of { uid, name, icon, online }
locked = false      -- the PDA's password is not entered yet (server's word)
-- the PDA in the slot: { serial, own, level, lock, hacked, owner, hack_left, hack_total, at }. Not
-- "device": unset, a module global falls back to the engine's device() function.
slot_device = nil
foreign = false     -- someone else's PDA is in the slot: the tabs show the device (netcoop_pdanet_ui)
dump = nil          -- a hacked PDA's owner's data: { serial, owner, contacts, chats, notes }
npc = {}            -- an NPC's PDA item id -> { id, serial, level, info, hack_left, hack_total, at }
has_lock = false    -- the PDA has a password
requests = {}       -- friend requests: list of { uid, name, icon, t } (players who added me)
chats = {}          -- list of chat summaries (server order is any; sorted here)
general = {}        -- newest last, at most KEEP
opened = nil        -- { id, summary, msgs }
typing = {}         -- chat id -> { uid, until }
members = {}        -- group id -> list of { uid, name, icon, online, own } ("Состав")
notes = {}          -- own notes, newest first: { id, title, text, t, g }
last_error = nil
local KEEP = 150
local listeners = {}
local parts = {}
local physical_id = nil
storage = {tools={},archive={}}
library = {photos={},records={},settings={}}
local map_retry_at = 0
local told_requests = {} -- uid -> true: the request was announced this session

local function tr(id) return game and game.translate_string and game.translate_string(id) or id end
local function pda_shown()
	local ok, shown = pcall(function()
		local pda = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu()
		return pda and pda:IsShown()
	end)
	return ok and shown or false
end

-- A PDA notification on the HUD (owner 2026-10-18: nothing was shown).
local function news(title, body, icon)
	local a = db and db.actor
	if not (a and equipped()) then return end
	pcall(function() a:give_game_news(title, body, icon or "ui_inGame2_PD_Lider", 0, 6000) end)
	if xr_sound and xr_sound.set_sound_play then pcall(xr_sound.set_sound_play, a:id(), "pda_tips") end
end

local function update_map_friends()
	if not netcoop_map_friend or time_global() < map_retry_at then return false end
	map_retry_at = time_global() + 1000
	for _, contact in ipairs(contacts) do
		if contact.friend == true and type(contact.actor_id) == "number" and type(contact.actor_name) == "string" then
			netcoop_map_friend(contact.actor_id, contact.actor_name)
		end
	end
	return false
end

function current_device()
 local item=db and db.actor and db.actor:item_in_slot(8)
 local d=slot_device
 if d and item and d.item==item:id() and d.uid and not foreign and not locked then return d.uid,d.item end
end

function equipped()
	local actor = db and db.actor
	local item = actor and actor:item_in_slot(8) -- PDA_SLOT
	return item and string.find(item:section(), "device_pda", 1, true) ~= nil or false
end

function install_notification_sound()
	if not xr_sound or not xr_sound.set_sound_play or xr_sound.__netcoop_pda_sound then return end
	local play = xr_sound.set_sound_play
	xr_sound.set_sound_play = function(id, name, ...)
		if name == "pda_tips" and not equipped() then return end
		return play(id, name, ...)
	end
	xr_sound.__netcoop_pda_sound = true
end

function on_change(fn) listeners[#listeners + 1] = fn end
local function changed(what)
	for _, fn in ipairs(listeners) do pcall(fn, what) end
end
-- other PDA modules: something to show has arrived (a photo)
function notify(what) changed(what) end

local function sort_chats()
	table.sort(chats, function(a, b)
		local ta, tb = a.last and a.last.t or 0, b.last and b.last.t or 0
		if ta ~= tb then return ta > tb end
		return tostring(a.id) < tostring(b.id)
	end)
end

local function list(t)
	local out = {}
	for i = 1, #(t or {}) do out[i] = t[i] end
	return out
end

local function clear_device()
 me,contacts,chats,requests,general,notes,typing,members={uid="",name="",icon=""},{},{},{},{},{},{},{}
 opened,dump,slot_device=nil,nil,nil
 locked,has_lock,foreign=false,false,false
 storage,library={tools={},archive={}},{photos={},records={},settings={}}
 told_requests,parts={},{}
 if netcoop_map_friends_clear then netcoop_map_friends_clear() end
 changed("device_reset")
end

local function replace_content()
 if netcoop_pda_media then netcoop_pda_media.reset() end
 if netcoop_pdanet_photo and netcoop_pdanet_photo.reset_content then netcoop_pdanet_photo.reset_content() end
 if netcoop_pdanet_voice and netcoop_pdanet_voice.reset_content then netcoop_pdanet_voice.reset_content() end
 local d=slot_device
 clear_device();slot_device=d
end
local function apply(verb, v)
	if verb == "state" and type(v) == "table" then
		if me.uid~="" and v.uid and v.uid~="" and me.uid~=v.uid then replace_content();if netcoop_pda then netcoop_pda.reset() end end
		me = { uid = v.uid or "", name = v.name or "", icon = v.icon or "" }
		locked, has_lock = v.locked == true, v.has_lock == true
		if (v.foreign == true) ~= foreign then dump = nil end
		foreign = v.foreign == true
		if locked then opened = nil end
		contacts = list(v.contacts)
		requests = list(v.requests)
		for _, r in ipairs(requests) do
			if not told_requests[r.uid] then
				told_requests[r.uid] = true
				news(tr("st_pdanet_friend_request"),
					string.format(tr("st_pdanet_friend_request_text"), r.name or "?", tostring(r.uid)), (r.icon or "") ~= "" and r.icon or nil)
			end
		end
		if netcoop_map_friends_clear then netcoop_map_friends_clear() end
		map_retry_at = 0
		update_map_friends()
		table.sort(contacts, function(a, b) return (a.name or a.uid) < (b.name or b.uid) end)
		chats = list(v.chats)
		sort_chats()
	elseif verb == "general" and type(v) == "table" then
		for _, m in ipairs(v) do
			if not general[#general] or m.s > general[#general].s then general[#general + 1] = m end
		end
		while #general > KEEP do table.remove(general, 1) end
	elseif verb == "chat" and type(v) == "table" then
		opened = { id = v.id, summary = v.summary, msgs = list(v.msgs) }
		for _, c in ipairs(chats) do if c.id == v.id then c.unread = 0 end end
	elseif (verb == "new") and type(v) == "table" then
		local found = false
		for i, c in ipairs(chats) do
			if c.id == v.id then chats[i] = v.summary or c; found = true end
		end
		if not found and v.summary then chats[#chats + 1] = v.summary end
		sort_chats()
		if equipped() and opened and opened.id == v.id then
			for _, m in ipairs(v.msgs or {}) do
				if not opened.msgs[#opened.msgs] or m.s > opened.msgs[#opened.msgs].s then opened.msgs[#opened.msgs + 1] = m end
			end
			read_chat(v.id)
		end
		-- a message from someone else: on the HUD unless that chat is open now
		local reading = opened and opened.id == v.id and pda_shown()
		local newest
		for _, m in ipairs(v.msgs or {}) do if not m.own then newest = m end end
		if newest and not reading and equipped() then
			local s = v.summary or {}
			local who = newest.n or ((newest.f or "") ~= "" and ("UID " .. tostring(newest.f))) or tr("st_pdanet_anonymous")
			local where = s.kind == "g" and s.name and (who .. " (" .. s.name .. ")") or who
			news(where, string.sub(newest.k == "text" and (newest.x or "") or tr("st_pdanet_new_msg"), 1, 120), (newest.i or "") ~= "" and newest.i or nil)
		elseif equipped() and xr_sound and xr_sound.set_sound_play then
			pcall(xr_sound.set_sound_play, db.actor:id(), "pda_tips")
		end
	elseif verb == "typing" and type(v) == "table" then
		typing[v.id] = { uid = v.uid, until_ms = time_global() + 4000 }
	elseif verb == "members" and type(v) == "table" then
		members[v.id] = list(v.list)
	elseif verb == "notes" and type(v) == "table" then
		notes = list(v)
	elseif verb == "asent" then
		if netcoop_pdanet_voice then netcoop_pdanet_voice.on_sent() end
	elseif verb == "psent" then
		if netcoop_pdanet_photo then netcoop_pdanet_photo.on_sent() end
	elseif verb == "paid" and type(v) == "table" then
		local n = tonumber(v.amount) or 0
		if actor_menu and actor_menu.set_msg then
			actor_menu.set_msg(1, string.format(game.translate_string(n > 0 and "st_pdanet_paid_in" or "st_pdanet_paid_out"), math.abs(n)), 4)
		end
	elseif verb == "storage" and type(v)=="table" then
		if v.done=="usb_restore" then replace_content() end
		storage=v
		if v.done=="usb_restore" and netcoop_pda and netcoop_pda.reset then netcoop_pda.reset() end
	elseif verb == "library" and type(v)=="table" then
		library=v
		if netcoop_pda_media then netcoop_pda_media.observed(v) end
		if netcoop_pdanet_photo and netcoop_pdanet_photo.on_library then netcoop_pdanet_photo.on_library(v) end
		if netcoop_pdanet_voice and netcoop_pdanet_voice.on_library then netcoop_pdanet_voice.on_library(v) end
	elseif verb == "stored" and type(v)=="table" then
		if netcoop_pda_media then netcoop_pda_media.stored(v) end
		if v.kind=="photo" and netcoop_pdanet_photo and netcoop_pdanet_photo.on_stored then netcoop_pdanet_photo.on_stored(v) end
		if v.kind=="audio" and netcoop_pdanet_voice and netcoop_pdanet_voice.on_stored then netcoop_pdanet_voice.on_stored(v) end
	elseif verb == "device" and type(v) == "table" then
		v.at = time_global()
		if not (slot_device and slot_device.serial == v.serial) then dump = nil end
		slot_device = not v.none and v or nil
	elseif verb == "dump" and type(v) == "table" then
		dump = v
	elseif verb == "npc" and type(v) == "table" and tonumber(v.id) then
		v.at = time_global()
		npc[v.id] = v
		npc_arrived(v)
	elseif verb == "spot" and type(v) == "table" and tonumber(v.id) then
		if v.add then
			if level.map_has_object_spot(v.id, "treasure") == 0 then pcall(level.map_add_object_spot_ser, v.id, "treasure", v.h or "") end
		else
			pcall(level.map_remove_object_spot, v.id, "treasure")
		end
	elseif verb == "err" then
		last_error = v
	end
	changed(verb)
end

-- channel "pdanet": "n/total|<verb>|<data>"
function receive(data)
	local n, total, rest = string.match(data or "", "^(%d+)/(%d+)|(.*)$")
	n, total = tonumber(n), tonumber(total)
	if not n then return end
	if n == 1 then parts = {} end
	parts[n] = rest
	if n < total then return end
	local all = table.concat(parts)
	parts = {}
	local item_id,uid,body=string.match(all,"^(%d+)@([%w_]+)|(.*)$")
	if item_id then
		local held=db and db.actor and db.actor:item_in_slot(8)
		if tonumber(item_id)~=0 and (not held or held:id()~=tonumber(item_id)) then return end
		if physical_id~=tonumber(item_id) then clear_device();physical_id=tonumber(item_id) end
		all=body
	end
	local verb, body = string.match(all, "^(%a+)|(.*)$")
	if not verb then return end
	if verb == "err" then apply(verb, body) return end
	if verb == "audio" then -- a record: "<id>|<base64>", not serialized
		local aid, data = string.match(body, "^(%x+)|(.*)$")
		if netcoop_pdanet_voice then netcoop_pdanet_voice.on_audio(aid, data or "") end
		return
	end
	if verb == "photo" then -- a photo from a chat: "<id>|<base64>"
		local pid, data = string.match(body, "^(%x+)|(.*)$")
		if netcoop_pdanet_photo then netcoop_pdanet_photo.on_photo(pid, data or "") end
		return
	end
	apply(verb, decode(body))
end

----------------------------------------------------------------------
-- Commands
----------------------------------------------------------------------
local function clean(text)
	text = string.gsub(text or "", "[%c]", " ")
	return string.sub(text, 1, 400)
end
local function send(text) if netcoop_command then netcoop_command("pdanet " .. text) end end

function hello() send("hello") end
function ask_storage() send("usb_list") end
function archive_message(chat,msg) send("usb_archive "..tostring(chat).." "..tostring(msg)) end
function backup(item) send("usb_backup "..tostring(item)) end
function restore(item) send("usb_restore "..tostring(item)) end
function ask_library() send("library") end
function add_contact(uid) send("add " .. tostring(uid)) end
function deny_request(uid) send("deny " .. tostring(uid)) end
function unlock(password) send("unlock " .. string.gsub(password or "", "[%c|]", "")) end
function set_password(old, new) send("lockset " .. string.gsub(old or "", "[%c|]", "") .. "|" .. string.gsub(new or "", "[%c|]", "")) end
function remove_contact(uid) send("del " .. tostring(uid)) end
function hack(item_id) send(item_id and ("hack " .. tostring(item_id)) or "hack") end
function hack_stop() send("hack_stop") end
function ask_dump() send("dump") end
function wipe() send("wipe") end
function npc_open(item_id) send("npc_open " .. tostring(item_id)) end
function npc_stash(item_id, stash_id, hint) send(string.format("npc_stash %d %d %s", item_id, stash_id, clean(hint))) end
-- Milliseconds of a hack still to run (nil: none running).
function hack_left(v)
	if not (v and v.hack_left) then return nil end
	return math.max(0, v.hack_left - (time_global() - (v.at or 0)))
end
function say(text, anonymous)
	text = clean(text)
	if text ~= "" then send("say " .. (anonymous and "1 " or "0 ") .. text) end
end
function open_dm(uid) send("dm " .. tostring(uid)) end
function open_chat(id) send("open " .. id) end
function read_chat(id) send("open " .. id) end
function post(id, text)
	text = clean(text)
	if text ~= "" then send("msg " .. id .. " text " .. text) end
end
-- A map point at the player's position (or at "at" = { level, x, y, z }) with a caption.
function post_point(id, caption, at)
	local a = db.actor
	if not (a or at) then return end
	local p = at or a:position()
	send(string.format("msg %s point %s\t%s %.1f %.1f %.1f", id, clean(caption ~= "" and caption or game.translate_string("st_pdanet_point")),
		at and at.level or level.name(), p.x, p.y, p.z))
end

----------------------------------------------------------------------
-- Tasks: the server sends this player's task list; the engine tells
-- netcoop_client_compat.on_task(id, "new"/"complete"/"fail") for each change,
-- the whole list arriving as "new" after login.
----------------------------------------------------------------------
local task_ids = {}
function note_task(id, kind)
	if not id then return end
	if kind == "new" then task_ids[id] = true else task_ids[id] = nil end
end
-- Active tasks: { id, title, at = { level, x, y, z } or nil }
function active_tasks()
	local out = {}
	local a = db.actor
	if not (a and a.get_task) then return out end
	for id in pairs(task_ids) do
		local t = a:get_task(id, true)
		if t then
			local at
			local oid = t.get_map_object_id and t:get_map_object_id()
			local obj = oid and oid > 0 and oid < 65535 and level.object_by_id(oid)
			if obj then
				local p = obj:position()
				at = { level = level.name(), x = p.x, y = p.y, z = p.z }
			end
			out[#out + 1] = { id = id, title = game.translate_string(t:get_title() or id), at = at }
		else
			task_ids[id] = nil
		end
	end
	table.sort(out, function(x, y) return x.title < y.title end)
	return out
end
-- A task to a contact: its title and target ("Отметить на карте" for him).
function send_task_to(uid, task)
	if not (task and task.title) then return end
	send("dm " .. tostring(uid))
	local data = task.at and string.format("\t%s %.1f %.1f %.1f", task.at.level, task.at.x, task.at.y, task.at.z) or ""
	send("msg " .. dm_id(uid) .. " task " .. clean(task.title) .. data)
end
function new_group(name, icon, uids)
	send("group " .. string.gsub(clean(name), "|", " ") .. "|" .. (icon or "") .. "|" .. table.concat(uids, ","))
end
function delete_chat(id) send("delete " .. id) end
function pay(id, amount)
	amount = math.floor(tonumber(amount) or 0)
	if amount > 0 then send("pay " .. id .. " " .. amount) end
end
function ask_members(id) send("members " .. id) end
function ask_notes() send("notes") end
function save_note(id, title, body)
	title = string.gsub(clean(title), "|", "/")
	body = string.gsub(string.gsub(body or "", "[%c]", " "), "|", "/")
	send("note " .. (id or "new") .. "|" .. title .. "|" .. string.sub(body, 1, 1200))
end
function delete_note(id) send("note_del " .. id) end

-- The private chat with a UID (same id as the server's).
function dm_id(uid)
	local a, b = me.uid, tostring(uid)
	if a > b then a, b = b, a end
	return "d_" .. a .. "_" .. b
end
-- A map point (the player's position) straight to a contact.
function send_point_to(uid, caption)
	send("dm " .. tostring(uid))
	post_point(dm_id(uid), caption or "")
end
function contact_unread(uid)
	local id = dm_id(uid)
	for _, c in ipairs(chats) do if c.id == id then return c.unread or 0 end end
	return 0
end
local typed_at = 0
function typed(id)
	if time_global() - typed_at < 3000 then return end
	typed_at = time_global()
	send("typing " .. id)
end

-- Who a message is from, as this player may see it.
function sender_name(m)
	if m.f == "" then return game.translate_string("st_pdanet_anonymous") end
	if m.own then return me.name ~= "" and me.name or ("UID " .. me.uid) end
	return m.n or ("UID " .. tostring(m.f))
end

-- Game time of a message: "HH:MM, DD.MM.YYYY" (game minutes since 2012-01-01).
function when(m)
	if not m.g then return "" end
	local t = os.date("!*t", 1325376000 + m.g * 60)
	return string.format("%02d:%02d, %02d.%02d.%04d", t.hour, t.min, t.day, t.month, t.year)
end
-- General channel, like New Way: "16:24, Сентябрь 11, 2012"
function when_long(m)
	if not m.g then return "" end
	local t = os.date("!*t", 1325376000 + m.g * 60)
	return string.format("%02d:%02d, %s %d, %d", t.hour, t.min, game.translate_string("st_pdanet_month_" .. t.month), t.day, t.year)
end
-- Chat bubbles: "12.09  15:16"
function when_short(m)
	if not m.g then return "" end
	local t = os.date("!*t", 1325376000 + m.g * 60)
	return string.format("%02d.%02d  %02d:%02d", t.day, t.month, t.hour, t.min)
end
-- The PDA clock (game time).
function clock()
	if not (level and level.get_time_hours) then return "" end
	return string.format("%02d:%02d", level.get_time_hours(), level.get_time_minutes())
end

function typing_in(id)
	local t = typing[id]
	if t and time_global() < t.until_ms then return t.uid end
	return nil
end

function unread_total()
	local n = 0
	for _, c in ipairs(chats) do n = n + (c.unread or 0) end
	return n
end

----------------------------------------------------------------------
-- An NPC's PDA (GAMMA's ui_pda_npc_tab): its messages are the server's.
-- GAMMA made them on the server when the NPC died; a client had only a set
-- of its own, and its stash went nowhere. Opening asks the server, an
-- encrypted PDA gets a hack button, a stash message goes to the server,
-- which fills the stash and marks it on this player's map.
----------------------------------------------------------------------
local viewing, pending_open, npc_window, open_view = nil, nil, nil, nil

local function keep_info(id, info)
	local m = alife_storage_manager and alife_storage_manager.get_state()
	if not (m and m.se_object) then return end
	if not info then
		if m.se_object[id] then m.se_object[id].info = nil end
		return
	end
	m.se_object[id] = m.se_object[id] or {}
	m.se_object[id].info = info
end

local function hack_caption(v)
	local left = hack_left(v)
	if left and left > 0 then
		local total = math.max(1, v.hack_total or 1)
		return string.format(tr("st_pdanet_hacking"), math.floor(100 * (total - left) / total), math.ceil(left / 1000))
	end
	return string.format(tr("st_pdanet_protection"), v.level or 1, "")
end

-- The hack button on GAMMA's "access denied" screen of an encrypted PDA.
local function npc_hack_controls(wnd)
	npc_window = wnd
	local v = viewing and npc[viewing]
	local on = wnd.state == "encrypted" and v ~= nil
	if not wnd.netcoop_hack then
		if not on then return end
		local xml = CScriptXmlInit()
		xml:ParseFile("ui_netcoop_pdanet.xml")
		local b = xml:Init3tButton("button", wnd)
		b:SetWndPos(vector2():set(392, 430)); b:SetWndSize(vector2():set(240, 30))
		b:TextControl():SetText(tr("st_pdanet_hack"))
		wnd:Register(b, "netcoop_npc_hack")
		wnd:AddCallback("netcoop_npc_hack", ui_events.BUTTON_CLICKED, function()
			if viewing then hack(viewing) end
		end, wnd)
		local t = xml:InitStatic("msg_head", wnd)
		t:SetWndPos(vector2():set(392, 468)); t:SetWndSize(vector2():set(320, 22))
		wnd.netcoop_hack, wnd.netcoop_hack_text = b, t
	end
	wnd.netcoop_hack:Show(on and not hack_left(v))
	wnd.netcoop_hack_text:Show(on)
	if on then
		local text = hack_caption(v)
		if last_error == "hack interrupted" and not hack_left(v) then text = tr("st_pdanet_hack_interrupted") end
		wnd.netcoop_hack_text:TextControl():SetText(text)
	end
end

function npc_arrived(v)
	keep_info(v.id, v.info or nil)
	if pending_open == v.id then
		pending_open = nil
		if open_view then open_view(v.id) end
		return
	end
	if viewing ~= v.id or not ui_pda_npc_tab then return end
	-- the hack finished: GAMMA's tab shows the messages now
	if npc_window and npc_window.state == "encrypted" and v.info and v.info.state ~= "encrypted" then
		ui_pda_npc_tab.get_ui(v.info)
	elseif npc_window then
		npc_hack_controls(npc_window)
	end
end

function install_npc_pda()
	local tab = ui_pda_npc_tab
	if not tab or tab.__netcoop then return end
	tab.__netcoop = true
	local base_view = tab.use_view
	open_view = function(id)
		local obj = level.object_by_id(id)
		if obj then base_view(obj) end
	end
	tab.use_view = function(obj)
		local p = obj and obj:parent()
		if not (p and p:id() == AC_ID) then return end
		viewing, pending_open = obj:id(), obj:id()
		npc_open(obj:id())
	end
	local cls = tab.pda_npc_tab
	if cls then
		local base_reset = cls.Reset
		cls.Reset = function(self, info)
			base_reset(self, info)
			npc_hack_controls(self)
		end
	end
	-- GAMMA's stash message: the stash is the server's (filled there).
	local tm = treasure_manager
	if tm and tm.set_random_stash and not tm.__netcoop_pda then
		tm.__netcoop_pda = true
		local base_stash = tm.set_random_stash
		tm.set_random_stash = function(no_spot, hint, bonus_items, id, ...)
			local trace = debug and debug.traceback and debug.traceback() or ""
			if viewing and tonumber(id) and string.find(trace, "ui_pda_npc_tab", 1, true) then
				npc_stash(viewing, tonumber(id), hint or "")
				return id
			end
			return base_stash(no_spot, hint, bonus_items, id, ...)
		end
	end
end

local function on_first_update() hello(); ask_notes(); ask_library() end
local next_device_check=0
local function device_update()
 local held=db and db.actor and db.actor:item_in_slot(8)
 local id=held and held:id() or 0
 if id~=physical_id then
  clear_device();physical_id=id;next_device_check=0
  if netcoop_pda and netcoop_pda.reset then netcoop_pda.reset() end
 end
 if id~=0 and time_global()>=next_device_check then
  next_device_check=time_global()+10000
  hello();ask_notes();ask_library()
 end
 return false
end
function on_game_start()
	if not (netcoop_pure_client and netcoop_pure_client()) then return end
	if AddUniqueCall then AddUniqueCall(update_map_friends);AddUniqueCall(device_update) end
	RegisterScriptCallback("actor_on_first_update", on_first_update)
	install_npc_pda()
	-- keep the task list for "send a task" (netcoop_client_compat logs them)
	local compat = netcoop_client_compat
	if compat and compat.on_task then
		local base = compat.on_task
		compat.on_task = function(id, kind)
			note_task(id, kind)
			return base(id, kind)
		end
	end
end
