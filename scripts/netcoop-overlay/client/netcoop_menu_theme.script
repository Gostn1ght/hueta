-- Shared with the launcher's built-in add-on selector. Unknown, missing or
-- incomplete selections always return the silent 2D default. Read once per run.
local selected
function current()
    if selected then return selected end
    selected = "classic"
    local file = io.open(getFS():update_path("$app_data_root$", "netcoop_menu_theme.txt"), "r")
    if file then
        local value = (file:read(64) or ""):match("^%s*(%S+)%s*$")
        file:close()
        if value == "room" or value == "campfire" or value == "night" then selected = value end
    end
    printf("[Lost Zone][menu] theme=%s", selected)
    return selected
end
function room()
    if current() ~= "room" then return false end
    -- Only R4 implements PrepareUIModel/DrawUIModel. R1 inherits the no-op
    -- renderer methods; exposing room controls there leaves a black screen.
    return get_console_cmd(0, "renderer") == "renderer_r4"
end
function notice()
    return current() == "room" and not room() and game.translate_string("st_netcoop_room_requires_dx11") or ""
end
function background()
    local name = current()
    return "ui\\lz_addon_" .. (name == "room" and "classic" or name)
end
