----------------------------------------------------------------------
-- Lost Zone: car prompts near the crosshair (doc 100, V5)
----------------------------------------------------------------------
-- The engine says what F does at the car under the crosshair (the seat
-- behind the door looked at, a taken seat, the trunk) or that the player
-- sits in a car. At a car the prompt stands by its door the way Dot Marks
-- (Catspaw) marks objects: a dot, the key in its frame, the action
-- (owner 2026-10-13: like S.T.A.L.K.E.R. 2); in a car the controls show
-- at the bottom for the first seconds.

local prompt
local seated_since
local dashboard

local function tr(id) return game.translate_string(id) end

local function key(bind, default)
	local ok, name = pcall(function() return dik_to_keyname(bind_to_dik(key_bindings[bind])) end)
	return (ok and name and name ~= "") and string.upper(name) or default
end

-- A compact freeplay instrument panel, using the game's inventory palette.
class "UIVehicleStatus" (CUIScriptWnd)
function UIVehicleStatus:__init() super()
	self:SetWndRect(Frect():set(0,0,1024,768))
	local xml=CScriptXmlInit();xml:ParseFile("ui_netcoop_vehicle_status.xml")
	local panel=xml:InitFrame("dashboard",self)
	self.speed=xml:InitTextWnd("dashboard:speed",panel)
	self.details=xml:InitTextWnd("dashboard:details",panel)
	self.engine=xml:InitTextWnd("dashboard:engine",panel)
	self.condition=xml:InitTextWnd("dashboard:condition",panel)
	self.parking=xml:InitTextWnd("dashboard:parking",panel)
	self.controls=xml:InitTextWnd("dashboard:controls",panel)
	self.shown=false
end
function UIVehicleStatus:Set(data)
	local speed,fuel,health,rpm,gear,flags=string.match(data or "","^(%S+)|(%S+)|(%S+)|(%S+)|(%d+)|(%d+)$")
	if not speed then
		if self.shown then get_hud():RemoveDialogToRender(self);self.shown=false end
		return
	end
	speed,fuel,health,rpm,gear,flags=tonumber(speed),tonumber(fuel),tonumber(health),tonumber(rpm),tonumber(gear),tonumber(flags)
	self.speed:SetText(string.format("%03d  %s",math.floor(speed+.5),tr("st_lz_car_kmh")))
	self.details:SetText(string.format("%s %s   /   %s %d",tr("st_lz_car_gear"),gear==0 and "R" or tostring(gear),tr("st_lz_car_rpm"),rpm))
	self.engine:SetText(string.format("%s: %s",tr("st_lz_car_engine"),flags%2==1 and tr("st_lz_car_on") or tr("st_lz_car_off")))
	self.parking:SetText("");self.controls:SetText("")
	if math.floor(flags/64)%2==1 then
		local gear=tr(math.floor(flags/32)%2==1 and "st_lz_heli_gear_down" or "st_lz_heli_gear_up")
		if flags>=128 then gear=tr("st_lz_heli_gear_moving") end
		self.details:SetText(string.format("%s: %s   /   %s %d",tr("st_lz_heli_gear"),gear,tr("st_lz_car_rpm"),rpm))
	end
	if math.floor(flags/64)%2==0 then
		self.parking:SetText(string.format("%s: %s [%s]",tr("st_lz_car_parking"),tr(math.floor(flags/32)%2==1 and "st_lz_car_on" or "st_lz_car_off"),key("kJUMP","SPACE")))
		self.controls:SetText(string.format("%s/%s: %s",key("kACCEL","SHIFT"),key("kCROUCH","CTRL"),tr("st_lz_car_shift")))
	end
	self.condition:SetText(string.format("%s %d%%  /  %s %d%%",tr("st_lz_car_fuel"),math.max(0,math.min(100,fuel)),tr("st_lz_car_condition"),math.max(0,math.min(100,health))))
	self.condition:SetTextColor((fuel<15 or health<30) and GetARGB(255,220,145,90) or GetARGB(255,205,199,179))
	if not self.shown then get_hud():AddDialogToRender(self);self.shown=true end
end



class "UIVehiclePrompt" (CUIScriptWnd)
function UIVehiclePrompt:__init() super()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self.text = CUITextWnd()
	self.text:SetAutoDelete(true)
	self.text:SetWndRect(Frect():set(162, 420, 862, 476))
	self.text:SetTextComplexMode(true)
	self.text:SetFont(GetFontLetterica18Russian())
	self.text:SetTextAlignment(2)
	self.text:SetTextColor(GetARGB(255, 235, 230, 220))
	self:AttachChild(self.text)
	self.shown = false
end
function UIVehiclePrompt:Set(text, y)
	if text then
		self.text:SetWndRect(Frect():set(60, y or 420, 760, (y or 420) + 56))
		self.text:SetText(text)
		if not self.shown then get_hud():AddDialogToRender(self); self.shown = true end
	elseif self.shown then
		get_hud():RemoveDialogToRender(self); self.shown = false
	end
end

-- Dot Marks style mark at a point of the world.
class "UIVehicleMark" (CUIScriptWnd)
function UIVehicleMark:__init() super()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	local function static(texture, w, h, color)
		local s = CUIStatic()
		s:SetAutoDelete(true)
		s:InitTexture(texture)
		s:SetStretchTexture(true)
		s:SetWndRect(Frect():set(0, 0, w, h))
		if color then s:SetTextureColor(color) end
		self:AttachChild(s)
		return s
	end
	local function text(font, color, align)
		local s = CUITextWnd()
		s:SetAutoDelete(true)
		s:SetFont(font)
		s:SetTextColor(color)
		s:SetTextAlignment(align)
		s:SetWndRect(Frect():set(0, 0, 300, 20))
		self:AttachChild(s)
		return s
	end
	self.dot = static("ui_catsy_marker_intdot", 8, 8, GetARGB(255, 240, 240, 240))
	self.keybg = static("ui_catsy_keybind_bg_single_v0", 20, 20, GetARGB(200, 20, 20, 20))
	self.keyframe = static("ui_catsy_keybind_frame_v3_back", 20, 20, GetARGB(255, 230, 230, 230))
	self.key = text(GetFontLetterica16Russian(), GetARGB(255, 255, 255, 255), 1)
	self.shadow = text(GetFontLetterica16Russian(), GetARGB(255, 0, 0, 0), 0)
	self.label = text(GetFontLetterica16Russian(), GetARGB(255, 230, 230, 230), 0)
	self.shown = false
end
function UIVehicleMark:Set(key, label, x, y, taken)
	if not label then
		if self.shown then get_hud():RemoveDialogToRender(self); self.shown = false end
		return
	end
	self.dot:SetWndPos(vector2():set(x - 4, y - 4))
	local left = x + 12
	self.keybg:Show(key ~= nil); self.keyframe:Show(key ~= nil); self.key:Show(key ~= nil)
	if key then
		local w = 12 + 8 * string.len(key)
		self.keybg:SetWndRect(Frect():set(left, y - 10, left + w, y + 10))
		self.keyframe:SetWndRect(Frect():set(left, y - 10, left + w, y + 10))
		self.key:SetWndRect(Frect():set(left, y - 10, left + w, y + 10))
		self.key:SetText(key)
		left = left + w + 6
	end
	self.label:SetTextColor(taken and GetARGB(255, 230, 120, 100) or GetARGB(255, 230, 230, 230))
	self.label:SetWndRect(Frect():set(left, y - 10, left + 300, y + 10))
	self.shadow:SetWndRect(Frect():set(left + 1, y - 9, left + 301, y + 11))
	self.label:SetText(label)
	self.shadow:SetText(label)
	if not self.shown then get_hud():AddDialogToRender(self); self.shown = true end
end

local mark

local VERBS = {
	driver = "st_netcoop_car_drive",
	passenger = "st_netcoop_car_sit",
	trunk = "st_netcoop_car_trunk",
}

-- What to show for one engine answer; nil for nothing.
function prompt_text(state, now)
	if state == "taken" then return tr("st_netcoop_seat_taken") end
	if VERBS[state] then return string.format("[%s]  %s", key("kUSE", "F"), tr(VERBS[state])) end
	if state == "seated_driver" or state == "seated" or state == "seated_pilot" then
		seated_since = seated_since or now
		-- The controls for the first seconds in the seat (a pilot's a little longer).
		if now - seated_since > (state == "seated_pilot" and 15000 or 8000) then return nil end
		if state == "seated_pilot" then
			return string.format("[%s/%s] %s   [%s%s%s%s] %s   [%s/%s] %s   [%s] %s   [%s] %s   [%s] %s",
				key("kJUMP", "SPACE"), key("kCROUCH", "CTRL"), tr("st_netcoop_heli_collective"),
				key("kFWD", "W"), key("kL_STRAFE", "A"), key("kBACK", "S"), key("kR_STRAFE", "D"), tr("st_netcoop_heli_cyclic"),
				key("kL_LOOKOUT", "Q"), key("kR_LOOKOUT", "E"), tr("st_netcoop_heli_pedals"),
				key("kDETECTOR", "O"), tr("st_netcoop_heli_engine"), key("kNIGHT_VISION", "N"), tr("st_lz_heli_gear"), key("kUSE", "F"), tr("st_netcoop_car_exit"))
		end
		if state == "seated" then return string.format("[%s]  %s", key("kUSE", "F"), tr("st_netcoop_car_exit")) end
		return string.format("[%s/%s] %s   [%s/%s] %s\\n[%s] %s   [%s] %s   [%s] %s   [%s] %s",
			key("kFWD","W"),key("kBACK","S"),tr("st_lz_car_pedals"),
			key("kACCEL","SHIFT"),key("kCROUCH","CTRL"),tr("st_lz_car_shift"),
			key("kUSE", "F"), tr("st_netcoop_car_exit"),
			key("kJUMP", "SPACE"), tr("st_netcoop_car_handbrake"), key("kTORCH", "L"), tr("st_netcoop_car_lights"),
			key("kDETECTOR", "O"), tr("st_netcoop_car_engine"))
	end
	seated_since = nil
	return nil
end

local next_update = 0
local function actor_on_update()
	if time_global() < next_update then return end
	next_update = time_global() + 100
	local ok, err = pcall(function()
		local state = netcoop_vehicle_prompt and netcoop_vehicle_prompt() or ""
		local seated = state == "seated_driver" or state == "seated" or state == "seated_pilot"
		-- At a car: the mark by its door.
		local screen
		if (VERBS[state] or state == "taken") and netcoop_vehicle_prompt_point then
			local p = netcoop_vehicle_prompt_point()
			local v = game.world2ui(vector():set(p.x, p.y, p.z), false)
			if v and v.x ~= -9999 and v.y ~= 0 and v.x > 0 and v.x < 1024 and v.y > 0 and v.y < 768 then screen = v end
		end
		if screen or mark then
			mark = mark or UIVehicleMark()
			if screen then
				local key_name = state ~= "taken" and key("kUSE", "F") or nil
				local label = state == "taken" and tr("st_netcoop_seat_taken") or tr(VERBS[state])
				mark:Set(key_name, label, screen.x, screen.y, state == "taken")
			else
				mark:Set(nil)
			end
		end
		local text = (seated or not screen) and prompt_text(state, time_global()) or nil
		if not seated then seated_since = nil end
		if text or prompt then
			prompt = prompt or UIVehiclePrompt()
			prompt:Set(text, seated and 690 or 420)
		end
	end)
	if not ok then printf("! [Lost Zone] vehicle prompt: %s", tostring(err)); next_update = time_global() + 5000 end
end

function on_game_start()
	if not (netcoop_pure_client and netcoop_pure_client()) then return end
	RegisterScriptCallback("actor_on_net_destroy",function()
		if dashboard then dashboard:Set("") end
		if mark then mark:Set(nil) end
		if prompt then prompt:Set(nil) end
		seated_since=nil
	end)
	RegisterScriptCallback("actor_on_update",function()
		if not netcoop_vehicle_status then return end
		local data=netcoop_vehicle_status()
		if data~="" or dashboard then dashboard=dashboard or UIVehicleStatus();dashboard:Set(data) end
	end)
	RegisterScriptCallback("actor_on_update", actor_on_update)
end
