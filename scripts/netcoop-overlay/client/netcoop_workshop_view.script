-- The workshop on a netcoop client (server: netcoop_workshop). GAMMA's
-- windows and checks stay; where GAMMA would create or release items the
-- client asks the server, which runs the same GAMMA code for this player:
-- - crafting: "craft_recipe <type> <key>" from the workshop the window was opened
--   with (a toolkit in the inventory, a mechanic's vise, a furniture workshop);
-- - disassembly: GAMMA picks the tool and asks for confirmation as before,
--   the server takes the item apart;
-- - recipes from books: the server learns and keeps them with the character
--   and sends the list ("recipes" channel), the encyclopedia unlocks them here.
-- - cooking: the server confirms inventory changes for the selected kit.

local function tip(id)
	if actor_menu and actor_menu.set_msg then actor_menu.set_msg(1, game.translate_string(id), 3) end
end
local function fx(name)
	if actor_effects and actor_effects.play_item_fx then pcall(actor_effects.play_item_fx, name) end
end

-- The workshop the open window belongs to: { kind = 1|2, id }.
opened_from = nil

----------------------------------------------------------------------
-- Recipes
----------------------------------------------------------------------
function receive_recipes(data)
	local enc = ui_pda_encyclopedia_tab
	if not enc then return end
	for sec in string.gmatch(data or "", "[%w_]+") do
		if not enc.is_unlocked_note("encyclopedia__notes_" .. sec) then
			SendScriptCallback("actor_on_interaction", "notes", nil, sec)
		end
	end
end

local function install_recipes()
	local ir = item_recipe
	if not ir or ir.__netcoop then return end
	ir.__netcoop = true
	ir.func_recipe = function(obj)
		local sec = obj:section()
		if not IsItem("recipe", sec) then return end
		if ui_pda_encyclopedia_tab.is_unlocked_note("encyclopedia__notes_" .. sec) then
			actor_menu.set_msg(1, game.translate_string("st_recipe_is_known"), 3)
		else
			netcoop_item_action(1, obj:id(), 65535, "recipe_read")
		end
		if get_hud() then hide_hud_inventory() end
		if ir.start then ir.start(sec) end
	end
end

----------------------------------------------------------------------
-- Crafting
----------------------------------------------------------------------
local function install_craft()
	local ws = ui_workshop and ui_workshop.UIWorkshopCraft
	if not ws or ws.__netcoop then return end
	ws.__netcoop = true
	-- remember which workshop opened the window
	local wt = workshop_tool
	if wt then
		for _, name in ipairs({ "start_workshop_basic", "start_workshop_advanced", "start_workshop_expert",
			"start_workshop_medic", "start_workshop_ammo", "start_workshop_artefacts" }) do
			local base = wt[name]
			if type(base) == "function" then
				wt[name] = function(obj, ...)
					opened_from = obj and obj.id and { kind = 1, id = obj:id() } or opened_from
					return base(obj, ...)
				end
			end
		end
	end
	local fw = ui_furniture_workshop
	if fw and type(fw.OpenWorkshop) == "function" then
		local base = fw.OpenWorkshop
		fw.OpenWorkshop = function(stash_id, ...)
			if stash_id then opened_from = { kind = 2, id = stash_id } end
			return base(stash_id, ...)
		end
	end
	ws.Craft = function(self)
		if not self.craft_allow_r then return end
		local from = opened_from
		if not (from and self.last_type and self.selected_index) then tip("st_netcoop_workshop_unknown") return end
		local tab = self.recipes and self.recipes[self.last_type]
		local recipe = tab and tab[self.selected_index]
		local key = netcoop_workshop_recipe and netcoop_workshop_recipe.key(recipe)
		if not key then tip("st_netcoop_workshop_unknown") return end
		if not netcoop_item_action(from.kind, from.id, 65535, string.format("craft_recipe %d %s", self.last_type, key)) then return end
		if self.btn_craft then self.btn_craft:Enable(false) end
		-- refresh the window once the server's result has arrived
		if self.UpdateUi and self.last_cont and self.last_idx and CreateTimeEvent then
			CreateTimeEvent("netcoop_craft", "update_ui", 0.6, function()
				pcall(self.UpdateUi, self, self.last_cont, self.last_idx)
				return true
			end)
		end
	end
end

----------------------------------------------------------------------
-- Upgrades: the cells the player checked, the server installs them
----------------------------------------------------------------------
local function install_upgrades()
	local up = ui_workshop and ui_workshop.UIWorkshopUpgrade
	if not up or up.__netcoop then return end
	up.__netcoop = true
	up.Upgrade = function(self)
		local obj = self.CC and self.CC:GetCell_Selected(true)
		if not obj then return end
		local before = utils_item.get_upgrades_installed(obj, nil, true) or {}
		local picks = {}
		for row, cols in pairs(self.upgr or {}) do
			for col, v in pairs(cols) do
				local cell = self.upgr_xml[row] and self.upgr_xml[row][col]
				if cell and cell.btn and cell.btn:GetCheck() and not before[v.section] then picks[#picks + 1] = row .. "." .. col end
			end
		end
		if #picks == 0 then return end
		local stash = self.stashId or (self.owner and self.owner.stashId) or 0
		local action = "upgrade " .. stash .. " " .. table.concat(picks, " ")
		if #action > 63 then tip("st_netcoop_upgrade_too_many") return end
		if netcoop_item_action(1, obj:id(), 65535, action) then
			if utils_obj and utils_obj.play_sound then pcall(utils_obj.play_sound, "interface\\inv_properties_2") end
		end
		if self.Close then self:Close() end
	end
end

----------------------------------------------------------------------
-- A mechanic NPC's window (ui_inventory "repair" mode): the server repairs
-- and installs, with the mechanic's rules and the player's server money.
----------------------------------------------------------------------
local function refresh_later(self)
	if CreateTimeEvent then
		CreateTimeEvent("netcoop_mechanic", "update", 0.6, function()
			if self.IsShown and self:IsShown() then
				if self.RMode_InitItem and self.upgr and self.upgr.id then
					local obj = level.object_by_id(self.upgr.id)
					if obj then pcall(self.RMode_InitItem, self, obj) end
				end
				if self.On_Item_Update then pcall(self.On_Item_Update, self) end
			end
			return true
		end)
	end
end

local function install_mechanic()
	local ui = ui_inventory and ui_inventory.UIInventory
	if not ui or ui.__netcoop_mechanic then return end
	ui.__netcoop_mechanic = true
	ui.RMode_UpgradeYes = function(self)
		local row, col = self.upgr_last_row, self.upgr_last_col
		if not (row and col and self.npc_id and self.upgr and self.upgr.id) then return end
		if netcoop_item_action(2, self.npc_id, 65535, string.format("mupgrade %d %d.%d", self.upgr.id, row, col)) then
			refresh_later(self)
		end
	end
	ui.RMode_RepairYes = function(self)
		if not (self.npc_id and self.upgr and self.upgr.id) then return end
		if netcoop_item_action(2, self.npc_id, 65535, string.format("mrepair %d", self.upgr.id)) then
			if self.npc_up_repair then self.npc_up_repair:Enable(false) end
			refresh_later(self)
		end
	end
end

-- a mechanic's vise used (bind_awr opens the window from this callback)
local function on_use(obj, who)
	if obj and string.match(obj:name() or "", "awr_tiski") then opened_from = { kind = 2, id = obj:id() } end
end

----------------------------------------------------------------------
-- Disassembly
----------------------------------------------------------------------
local function install_disassembly()
	local ip = item_parts
	if not ip or ip.__netcoop then return end
	ip.__netcoop = true
	for _, name in ipairs({ "disassembly_item", "disassembly_weapon", "disassembly_outfit" }) do
		ip[name] = function(obj, obj_d)
			if not (obj and obj_d) then return end
			if netcoop_item_action(1, obj:id(), obj_d:id(), "disassemble") then
				fx(IsWeapon(obj) and "disassemble_metal_fast" or (IsOutfit(obj) or IsHeadgear(obj)) and "disassemble_cloth_fast"
					or "disassemble_metal_fast")
			end
		end
	end
end

local cooking_pending
local cooking_request

local function refresh_cooking(request)
	local menu = request.menu
	if not menu:IsShown() then return false end
	local tool = level.object_by_id(request.tool)
	if not tool or (request.spent_tool and not request.failed) or
		(menu.cooking_limited and tool:get_remaining_uses() == 0) then
		menu:Close()
		return false
	elseif menu.last_cont and menu.last_idx then
		menu:On_CC_Mouse1(menu.last_cont, menu.last_idx)
	end
	return true
end

function on_cooking_result(data)
	local id, result = string.match(data or "", "^(%d+)|(%a+)$")
	local request = cooking_pending
	if not request or tonumber(id) ~= request.id or request.replied or (result ~= "ok" and result ~= "failed") then return end
	request.replied = true
	request.failed = result == "failed"
	request.expires = time_global() + 300
	if result == "ok" and request.menu:IsShown() then
		request.menu.hasCraftedItem = true
	end
end

local function install_cooking()
	local cook = item_cooking and item_cooking.UICook
	if not cook or cook.__netcoop_cooking or type(cook.Update) ~= "function" or
		type(cook.On_CC_Mouse1) ~= "function" then return end
	cook.__netcoop_cooking = true
	local eat = _G.CInventory__eat
	if eat and item_cooking.start then
		-- Opening the kit is a UI action, so it costs no uses.
		_G.CInventory__eat = function(item, ...)
			if item and IsItem("cook", item:section()) then
				item_cooking.start(item, item:section())
				return false
			end
			return eat(item, ...)
		end
	end
	local update, select_meal, close = cook.Update, cook.On_CC_Mouse1, cook.Close
	cook.Update = function(self, ...)
		local request = cooking_pending
		if request and request.menu == self and time_global() >= request.expires then
			cooking_pending = nil
			if not request.replied then request.failed = true end
			if not refresh_cooking(request) then return end
		end
		-- The base hover path returns early if a refresh removed the meal.
		if self.item_info and not self:GetSelectedMeal() then self.item_info:Update() end
		return update(self, ...)
	end
	cook.On_CC_Mouse1 = function(self, ...)
		-- Fuel/ingredient IDs can change while the network inventory updates.
		-- Rebuild the snapshot before the original kit and fuel-tier checks.
		if self.objs and db and db.actor then
			for section in pairs(self.objs) do self.objs[section] = nil end
			self:Load_ActorItems()
		end
		if self.cooking_campfire and bind_campfire then
			local fire = bind_campfire.get_nearby_campfire(1.5, true)
			self.is_campfire = fire and fire:is_on() or false
		end
		local result = select_meal(self, ...)
		local meal = self:GetSelectedMeal()
		if self.btn_cook and self.CheckAvail_main then
			local usable = self.obj and (not self.cooking_limited or self.obj:get_remaining_uses() > 0)
			self.btn_cook:Enable(not cooking_pending and usable and meal ~= nil and self:CheckAvail_main(meal) or false)
		end
		return result
	end
	-- The server consumes carried items. Match its inventory view instead
	-- of promising fuel from a stash the player has not taken it out of.
	cook.Load_ActorItems = function(self)
		local needed = {}
		for _, meal in ipairs(self.meals or {}) do
			for _, ingredient in ipairs(meal) do needed[ingredient.sec] = true end
		end
		if not (db and db.actor and db.actor.iterate_inventory) then return end
		db.actor:iterate_inventory(function(_, item)
			local section = item:section()
			if needed[section] or self.fuel[section] then
				local uses = IsItem("multiuse", nil, item) and item:get_remaining_uses() or 1
				if uses and uses > 0 then
					self.objs[section] = self.objs[section] or {}
					self.objs[section][item:id()] = uses
				end
			end
		end, nil)
	end
	cook.OnCook = function(self)
		if cooking_pending then return end
		local meal = self:GetSelectedMeal()
		local tool = self.obj
		if not (meal and tool and netcoop_workshop_recipe) then return end
		local recipe = {sec = meal.sec, tool = meal.fuel_tier, rsp = ""}
		for _, row in ipairs(meal) do recipe[#recipe + 1] = {row.sec, row.amt} end
		local key = netcoop_workshop_recipe.key(recipe)
		if not key then return end
		local section = tool:section()
		local kind = (section == "placeable_stove1" or section == "placeable_stove2") and 2 or 1
		cooking_request = ((cooking_request or time_global()) % 999999999) + 1
		local id = tool:id()
		if netcoop_item_action(kind, id, 65535, string.format("cook %d %s", cooking_request, key)) then
			cooking_pending = {menu = self, id = cooking_request, tool = id, expires = time_global() + 3000,
				spent_tool = self.cooking_limited and tool:get_remaining_uses() == 1}
			if self.btn_cook then self.btn_cook:Enable(false) end
		end
	end
	if close then
		cook.Close = function(self, ...)
			if cooking_pending and cooking_pending.menu == self then cooking_pending = nil end
			return close(self, ...)
		end
	end
end

local function install()
	if not netcoop_item_action then return end
	install_recipes()
	install_craft()
	install_upgrades()
	install_mechanic()
	install_disassembly()
	install_cooking()
	if netcoop_command then netcoop_command("recipes get") end
end

function on_game_start()
	if not (netcoop_pure_client and netcoop_pure_client()) then return end
	-- after every mod's on_game_start patched the workshop
	RegisterScriptCallback("actor_on_first_update", install)
	RegisterScriptCallback("physic_object_on_use_callback", on_use)
end
