[disable]
linear_factor			= 0.5
angular_factor    		= 0.5

;-------------------------------------------------------------------------------
;-------------------------------------------------------------------------------

[car_definition]
character_scraper
time_to_explosion			= 0 ;-- time to explode when damaged (ms)
camera_pos        			= -0.404, 2.08, 0.87	;смещение камеры в кабине влево-вправо, вверх-вниз, вперед-назад
	
camera_pos_firsteye			= -0.404, 2.08, 0.87
camera_pos_lookat			= 0.0, 2.6, -0.83
camera_pos_free				= 0.0, 2.7, -1.03		
								
driving_wheels    			= back_left_wheel,back_right_wheel					; ведущие колёса
steering_wheels   			= front_left_wheel,front_right_wheel					; рулевые колёса
breaking_wheels   			= back_left_wheel,back_right_wheel,front_left_wheel,front_right_wheel	; тормозящие колёса
doors             			= left_door,right_door							; двери
steer             			= stearing_wheel							; руль
driver_place      			= seat_left								; место водителя
exhausts          			= exhausts								; выхлопная труба
exhaust_particles 			= vehiclefx\exhaust_kamaz
damage						= damage_bones
trunk_bone					= kuzov
nitro						= true
nitro_power_factor			= 1.2
nitro_fuel_factor			= 1.4
nitro_particles_enabled		= false

collision_hit_threshold = 0.2 ; [LA DC] minimum physical collision damage to be applied to car (vanilla is 5.0)

;-------------------------------------------------------------------------------
;------ Factory parameters of Engine -------------------------------------------

fuel_tank					= 150         	; L
fuel_consumption			= 0				; L / (100k R); liters per 100 000 rotations
engine_power				= 39.5        	; horse_power (kW=hp*0.808) max power
max_power_rpm				= 3300        	; (nominal rpm ) on this rpm value engine power reaches maximum
max_torque_rpm				= 2250       	; on this rpm engine torque reaches maximum

power_increment_factor		= 0.01
power_decrement_factor		= 0.1
rpm_increment_factor		= 0.03
rpm_decrement_factor		= 0.15
m_power_neutral_factor		= 0.55

; additional engine parameters

max_engine_rpm			= 4000		; rpm (5000) rpm will never be more
idling_engine_rpm		= 850       	; rpm (750) min rpm - starts from this rpm value

;-------------------------------------------------------------------------------
;------ Adjustment a wheel -----------------------------------------------------

reference_radius		= 0.59		; Радиус колеса, используемый при просчёте двигателя
axle_friction     		= 3       	; Ослабление скорости в неетральной позиции. (N*m)
steering_speed    		= 0.55         	; Время поворота рулевого колеса, в максимум. rps (1)
steering_torque   		= 200000    	; Сила гидроусилителя руля. (N*m)
break_torque			= 0.070		; Сила тормозных колодок. (N*m
hand_break_torque		= 0.070		; сила торможения пробелом (по умолчанию = break_torque)
break_time        		= 1.0         	; время нарастания силы торможения до максимума, при подтормаживании (стрелка назад)

;-------------------------------------------------------------------------------
;------ Gearbox ----------------------------------------------------------------

main_gear_ratio    		= 24.9         ; Передаточное отношение
auto_transmission  		= on           ; Автоматическая коробка (on/off)

[transmission_gear_ratio]
; shift down/ shift up. (rpm, необходимое для переключения)
R	= 3.60, 1700, 3750	
N1	= 3.60, 1700, 3750
N2	= 1.87, 1700, 3750
N3	= 1.11, 1800, 3750
N4	= 0.72, 1900, 3750

;-------------------------------------------------------------------------------
;------ Rest Adjustment --------------------------------------------------------

[lights]
headlights				= f1,f2

[f1]
bone               		= left_light
color              		= 1.27,1.2,1.1,1
range              		= 44
cone_angle         		= 58
spot_texture       		= lights\lights_bspot01_cv
glow_texture       		= glow\glow_Yellow
glow_radius        		= 1.1

[f2]
bone               		= right_light
color              		= 1.27,1.2,1.1,1
range              		= 44
cone_angle         		= 58
spot_texture       		= lights\lights_bspot01_cv
glow_texture       		= glow\glow_Yellow
glow_radius        		= 1.1

[car_sound]
