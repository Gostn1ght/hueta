engine_sound_start_dellay	= 0.5
engine_start			    = car\l_zil_start
engine_stop				    = car\l_zil_stop
transmission_switch		    = car\o_truck_gear
explosion_sound    		    = weapons\heli_explosion
relative_pos       			= -0.1,0.5,2.5

