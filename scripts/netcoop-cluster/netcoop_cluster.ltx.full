; Location cluster: one dedicated server per map (generated, then edit hosts).
; host = the address clients use for that map; a machine runs the maps whose
; host is its own (netcoop_cluster_watchdog.ps1). All machines share app data.
[cluster]
max_players = 512
per_server = 128
; Players enter only this computer's address: the world master answers on
; this TCP port (default 5446, 0 = off) and sends them to their map. Open
; it in the router (TCP) together with the maps' UDP ports.
entry_port = 5446

[locations]
jupiter = 127.0.0.1:1301
jupiter_underground = 127.0.0.1:1343
k00_marsh = 127.0.0.1:1267
k01_darkscape = 127.0.0.1:1303
