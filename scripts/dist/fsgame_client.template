$game_saves$            = true 	| false	| $app_data_root$| savedgames\		| *.scop;*.scoc
$downloads$             = false	| false	| $app_data_root$
$game_text$				= true 	| false	| $game_config$	 | text\
$textures_ui$ 			= true 	| true 	| $textures$	 | ui\
