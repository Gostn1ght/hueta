# STALKER .script, .s files as Lua files
**/*.script linguist-language=Lua
**/*.s linguist-language=Lua

# STALKER .ltx files as INI files
**/*.ltx linguist-language=INI

# STALKER .ps, .gs, .vs, .cs files as HLSL files
**/*.ps linguist-language=HLSL
**/*.gs linguist-language=HLSL
**/*.vs linguist-language=HLSL
**/*.cs linguist-language=HLSL

# cmd.exe misparses UTF-8 batch files after chcp 65001 with LF-only lines.
# Distributable launchers must keep Windows line endings on every checkout.
scripts/dist/*.cmd text eol=crlf

